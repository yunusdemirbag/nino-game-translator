        ],
        [
          64,
          "tr.error",
          429
        ],
        [
          65,
          "tr.error",
          429
        ],
        [
          66,
          "tr.error",
          429
        ],
        [
          67,
          "tr.error",
          429
        ],
        [
          68,
          "tr.ok"
        ],
        [
          69,
          "tr.ok"
        ],
        [
          70,
          "tr.ok"
        ],
        [
          71,
          "tr.ok"
        ]
      ],
      "expect": [
        {
          "at": 69,
          "rule": "tr.errors",
          "cause": "quota",
          "sev": "warn"
        }
      ],
      "note": "t=69'da 10. istek: son 10 istekte 8 hata (%80 > %30), en az 10 istek şartı ilk kez sağlanıyor."
    },
    {
      "name": "Aynı oturumda ikinci kez: aynı kural bir kez gider",
      "timeline": [
        [
          0,
          "session.start"
        ],
        [
          100,
          "ps5.drop"
        ],
        [
          400,
          "ps5.connect"
        ],
        [
          500,
          "ps5.drop"
        ],
        [
          900,
          "ps5.connect"
        ]
      ],
      "expect": [
        {
          "at": 280,
          "rule": "ps5.no_return",
          "cause": "timeout",
          "sev": "error"
        }
      ],
      "note": "İkinci kopma (500, 400 sn dönmedi) da eşiği aşar ama aynı kural oturumda bir kez gider. Sebep işareti yok → timeout."
    }
  ]
}
<!-- Copyright (C) 2026 Nino contributors -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nino.Core\Nino.Core.csproj" />
    <InternalsVisibleTo Include="Nino.RemotePlay.Tests" />
  </ItemGroup>
  <!--
    Yerel köprü (nino_native) varsa çıktıya ve yayın klasörüne kopyalanır; yoksa köprüsüz derlenir
    (köprü gerektiren testler atlanır). CI DLL'i native/bin/ altına koyar; Mac'te test için derlenen
    .dylib native/build/bin/ altındadır.
  -->
  <PropertyGroup>
    <NinoNativeDir>$(MSBuildThisFileDirectory)..\..\native\</NinoNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NinoNativeDir)bin\nino_native.dll" Condition="Exists('$(NinoNativeDir)bin\nino_native.dll')"
          Link="nino_native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NinoNativeDir)bin\nino_native.so" Condition="Exists('$(NinoNativeDir)bin\nino_native.so')"
          Link="nino_native.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NinoNativeDir)build\bin\nino_native.dylib" Condition="Exists('$(NinoNativeDir)build\bin\nino_native.dylib')"
          Link="nino_native.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" />
  </ItemGroup>
</Project>

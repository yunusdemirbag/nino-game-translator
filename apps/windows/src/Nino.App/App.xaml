<Application x:Class="Nino.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Renk, ölçü ve yazı tipi kaynakları ThemeManager.Install ile koddan eklenir (tasarım belirteçlerinden). -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/Text.xaml" />
        <ResourceDictionary Source="Theme/Buttons.xaml" />
        <ResourceDictionary Source="Theme/Inputs.xaml" />
        <ResourceDictionary Source="Theme/Misc.xaml" />
        <ResourceDictionary Source="Theme/Layout.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>

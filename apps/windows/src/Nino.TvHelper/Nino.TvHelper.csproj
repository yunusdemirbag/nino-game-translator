  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nino-tv-helper</AssemblyName>
    <RootNamespace>Nino.TvHelper</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nino.TvInstall\Nino.TvInstall.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- XML imzası ve TizenSdb yansımayla çalışıyor: kırpılmasınlar. -->

    "psn.why.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لو استعمل Remote Play حسابك نفسه، لاستولى على ذراع التحكم وأوقف لعبتك. لكن بحساب ثانٍ بلا مقابل، يدع PS5 الهاتف يرى الصورة وأنت تكمل اللعب على التلفزيون. أنشئ الحساب من PS5 عبر «إضافة مستخدم» أو من موقع playstation.com."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play নিজের অ্যাকাউন্টে চললে সেটি কন্ট্রোলারের দখল নিয়ে আপনার গেম থামিয়ে দিত। আলাদা একটি ফ্রি অ্যাকাউন্টে PS5 ফোনকে দৃশ্যটা দেখার সুযোগ দেয়, আপনি এদিকে TV-তে খেলেই যান। এমন অ্যাকাউন্ট PS5-এ (Add User) কিংবা playstation.com-এ বানানো যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Remote Play signed in as you, it would grab your controller and pause the game. An extra free account lets the phone see the picture as you go on playing. Make one on the console (Add User) or via playstation.com."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung sarili ninyong account ang gamit ng Remote Play, kukunin nito ang controller ninyo at ipo-pause ang laro. Kapag libreng ikalawang account, pinapayagan ng PS5 ang telepono na makita ang larawan habang tuloy kayong naglalaro sa TV. Puwedeng gumawa nito sa playstation.com, o sa Add User ng PS5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play अगर आपका ही खाता लेता, तो कंट्रोलर अपने हाथ में लेकर गेम रोक देता। मुफ़्त दूसरा खाता हो तो PS5 तस्वीर फ़ोन को दिखाता रहता है और आप टीवी पर खेल जारी रखते हैं। यह खाता PS5 में Add User से, या playstation.com पर बन जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau Remote Play memakai akun milik Anda, controller akan direbut dan game ikut terjeda. Dengan akun tambahan yang gratis, PS5 membolehkan ponsel ikut melihat layar selagi Anda terus main di TV. Akun itu bisa dibuat di PS5 (Tambah Pengguna) maupun di playstation.com."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau Remote Play memakai akaun anda sendiri, ia akan merampas alat kawalan dan menjeda permainan. Dengan akaun kedua percuma, telefon dapat melihat paparan PS5 sambil anda terus main di TV. Akaun ini boleh dibuat di PS5 (Add User) ataupun di playstation.com."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zou Remote Play jouw account gebruiken, dan nam het je controller over en pauzeerde het de game. Met een extra, gratis account kan de telefoon meekijken terwijl jij op de tv verder speelt. Maak er een op de console (Gebruiker toevoegen) of via playstation.com."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้า Remote Play ใช้บัญชีของคุณเอง มันจะแย่งการควบคุมจอยและทำให้เกมหยุด แต่ถ้าใช้บัญชีที่สองแบบฟรี PS5 จะให้มือถือดูภาพได้ ขณะที่คุณเล่นบนทีวีต่อไป สร้างบัญชีได้บนเครื่อง PS5 (เพิ่มผู้ใช้) หรือที่เว็บ playstation.com"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play kendi hesabınızla bağlansa kolunuzu ele geçirir ve oyunu duraklatırdı. Ücretsiz ek bir hesap sayesinde siz TV'de oynarken telefon görüntüyü görebilir. Böyle bir hesabı PS5'in Kullanıcı Ekle menüsünden veya playstation.com üzerinden açabilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play اگر آپ ہی کا اکاؤنٹ لیتا تو کنٹرولر اپنے قبضے میں لے کر گیم روک دیتا۔ مفت دوسرا اکاؤنٹ ہو تو PS5 تصویر فون کو دکھاتا رہتا ہے اور آپ TV پر کھیل جاری رکھتے ہیں۔ یہ اکاؤنٹ PS5 میں Add User سے، یا playstation.com پر بن جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu Remote Play dùng chính tài khoản bạn đang chơi, nó sẽ giành lấy tay cầm và khiến game tạm dừng. Có một tài khoản phụ miễn phí thì PS5 cho điện thoại nhận hình trong lúc bạn cứ chơi tiếp trên TV. Bạn tạo tài khoản đó ngay trên PS5 (Add User) hoặc tại playstation.com."
          }
        }
      }
    },

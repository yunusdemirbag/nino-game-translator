            "state": "translated",
            "value": "منفذ التصحيح مُغلق"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিবাগ পোর্ট বন্ধ আছে"
          }
        },
        "en": {

    "ob.p1.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ هاتفك النص الإنجليزي في اللعبة ويترجمه، ثم يعرضه على التلفزيون أو على شاشته. لن تترك يد التحكم يديك أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন গেমের ইংরেজি লেখাগুলো পড়ে নিয়ে অনুবাদ করে, তারপর তা TV-তে বা ফোনের পর্দায় দেখায়। কন্ট্রোলার হাতেই থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone picks up each English subtitle, translates it, then shows it on your TV screen or right on the phone. You keep holding the controller."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabasa ng telepono ang subtitle ng laro na nasa English, isinasalin ito, at inilalabas sa TV o kaya sa sariling screen. Hindi ninyo kailangang bitawan ang controller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन खेल की अंग्रेज़ी पंक्तियाँ पढ़ता है, उन्हें अनुवाद करता है, फिर टीवी या ख़ुद की स्क्रीन पर दिखा देता है। कंट्रोलर हाथ में ही रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel membaca subtitle berbahasa Inggris dari game, menerjemahkannya, lalu menampilkannya di TV maupun di layar ponsel itu sendiri. Controller tetap Anda pegang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon membaca sari kata Inggeris permainan itu, menterjemahkannya, lalu memaparkannya di TV ataupun di skrin telefon itu sendiri. Alat kawalan kekal di tangan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon pikt elke Engelse ondertitel op, vertaalt hem en laat hem zien op je tv-scherm of op de telefoon zelf. Jij houdt gewoon de controller vast."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์ของคุณจะอ่านคำบรรยายภาษาอังกฤษของเกม แปล แล้วแสดงบนทีวีหรือบนหน้าจอของตัวเอง จอยไม่ต้องหลุดมือเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz oyundaki İngilizce altyazıları okur, çevirir; sonra bunları TV'nizde veya kendi ekranında gösterir. Kol hep sizin elinizde kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون گیم کی انگریزی لائنیں پڑھ کر انہیں ترجمہ کرتا ہے، پھر TV پر یا خود اپنی اسکرین پر دکھا دیتا ہے۔ کنٹرولر ہاتھ میں ہی رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại đọc phụ đề gốc bằng tiếng Anh của trò chơi, dịch sang tiếng bạn chọn rồi đưa lên TV hoặc hiện ngay trên chính nó. Tay cầm vẫn nằm trong tay bạn suốt lúc chơi."
          }
        }
      }
    },
    "ob.p1.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألعاب PS5 بترجمة عربية"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",

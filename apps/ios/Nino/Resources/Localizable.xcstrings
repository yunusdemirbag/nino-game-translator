    "langpack.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج ترجمة Apple على الجهاز إلى حزمة %1$@ ← %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসে Apple অনুবাদের জন্য %1$@ → %2$@ প্যাক লাগবে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's offline translation needs its %1$@ → %2$@ pack"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng pagsasalin ng Apple sa device ang %1$@ → %2$@ pack"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर Apple अनुवाद को %1$@ → %2$@ पैक चाहिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerjemah bawaan Apple perlu paket %1$@ → %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penterjemah dalam peranti Apple perlukan pek %1$@ → %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples vertaling op het apparaat heeft het pakket %1$@ → %2$@ nodig"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีแพ็ก %1$@ → %2$@ สำหรับการแปลฟรีของ Apple ในเครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple'ın cihaz içi çevirisi %1$@ → %2$@ paketini istiyor"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آلے پر Apple ترجمہ کو %1$@ ← %2$@ پیک چاہیے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dịch ngoại tuyến của Apple cần gói %1$@ → %2$@"
          }
        }
      }
    },

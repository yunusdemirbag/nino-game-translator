          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size nereden dönelim? (isteğe bağlı)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ تک کیسے پہنچیں؟ (اختیاری)"
          }
        },
        "vi": {
          "stringUnit": {

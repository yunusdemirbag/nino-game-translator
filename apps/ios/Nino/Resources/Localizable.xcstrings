    "subtitle.background.solidhint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب شريط الخلفية حتى «معتمة» لتغطية النص الإنجليزي في اللعبة بالكامل. ويخفي الشريط الممتد بعرض الشاشة الحواف أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গেমের ইংরেজি সাবটাইটেল একদম ঢেকে দিতে ব্যাকড্রপ স্লাইডার নিরেট অবধি সরান। পুরো চওড়া পট্টিটা পাশের কিনারাও ঢেকে রাখে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide Backdrop to Solid to cover the game's English subtitle completely. The full-width band hides the edges as well."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itakda ang Background sa Buo para hindi na makita ang subtitle ng laro na nasa English. Natatakpan din ang mga gilid ng bandang sakop ang buong lapad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खेल की अंग्रेज़ी पंक्ति पूरी तरह छिपानी हो, तो पृष्ठभूमि वाला स्लाइडर “ठोस” तक ले जाएँ। पूरी चौड़ाई वाली पट्टी किनारे भी ढक लेती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser Latar ke Pekat agar subtitle Inggris dari game tertutup penuh. Pita selebar layar ikut menutupi bagian tepinya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakkan Latar ke Pejal untuk menutup terus sari kata Inggeris permainan itu. Jalur selebar skrin turut menyembunyikan bahagian tepi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuif Achtergrond naar Massief, dan dek je de Engelse ondertitel van het spel volledig af. Een balk over de hele breedte verbergt ook de randen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนพื้นหลังไปที่ “ทึบ” เพื่อปิดคำบรรยายภาษาอังกฤษของเกมทั้งหมด แถบเต็มความกว้างจะซ่อนขอบด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zemin kaydırıcısını Opak'a getirirseniz oyundaki İngilizce altyazı tümüyle örtülür. Ekranı boydan boya kaplayan bant kenarları da saklar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھیل کی انگریزی لائن پوری طرح چھپانی ہو تو پس منظر والا سلائیڈر «ٹھوس» تک لے جائیں۔ پوری چوڑائی والی پٹی کناروں کو بھی ڈھک لیتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo Nền sang Đặc để che kín phụ đề gốc tiếng Anh. Dải nền trải hết bề ngang nên che luôn cả hai mép."
          }
        }
      }
    },

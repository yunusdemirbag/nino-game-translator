    "tv.install.lg.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع تطبيق Nino للتلفزيون على تلفزيون LG (webOS) مباشرةً من هذا الهاتف، بلا حاجة إلى حاسوب. ينبغي أن يتصل الهاتف والتلفزيون بشبكة Wi-Fi واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটার লাগবে না: এই ফোন থেকেই Nino TV অ্যাপটি LG-র (webOS) TV-তে বসিয়ে দেয়। ফোন আর TV, দুটোই এক Wi-Fi-তে থাকা চাই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs Nino's TV app straight onto your LG (webOS) TV, using only this phone — no computer required. The phone and TV need to share one Wi-Fi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini-install sa LG TV ninyo (webOS) ang TV app ng Nino diretso mula sa teleponong ito, kahit walang computer. Kailangang nasa iisang Wi-Fi ang telepono at TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Nino का टीवी ऐप सीधे इसी फ़ोन से आपके webOS वाले LG TV पर डाल देता है, कंप्यूटर नहीं चाहिए। फ़ोन और टीवी दोनों एक ही Wi-Fi से जुड़े हों।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang aplikasi TV Nino ke TV LG (webOS) langsung lewat ponsel ini; komputer tidak diperlukan. Ponsel serta TV wajib tersambung ke Wi-Fi yang sama."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang apl Nino TV ke TV LG (webOS) anda terus dari telefon ini, komputer tidak diperlukan. Telefon serta TV perlu menggunakan Wi-Fi sama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeert Nino's tv-app direct vanaf deze telefoon op je LG-tv met webOS; een computer is niet nodig. Telefoon en tv moeten hetzelfde Wi-Fi-netwerk delen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งแอป Nino สำหรับทีวีลงในทีวี LG (webOS) ของคุณโดยตรงจากโทรศัพท์เครื่องนี้ ไม่ต้องใช้คอมพิวเตอร์ โทรศัพท์และทีวีต้องเชื่อมต่อ Wi-Fi เดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun TV uygulamasını doğrudan bu telefondan, bilgisayarsız olarak LG (webOS) TV'nize yükler. Telefon ile TV'nin aynı Wi-Fi'a bağlı olması gerekir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Nino کی TV ایپ سیدھا اسی فون سے آپ کے webOS والے LG TV میں ڈال دیتا ہے، کمپیوٹر درکار نہیں۔ فون اور TV دونوں ایک ہی Wi-Fi سے جڑے ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài app Nino TV vào TV LG (webOS) thẳng từ điện thoại, khỏi cần dùng máy tính. Cả hai máy đều phải chung một Wi-Fi."
          }
        }
      }
    },
    "tv.install.samsung.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع تطبيق Nino للتلفزيون على تلفزيون Samsung من هذا الهاتف مباشرةً، بلا حاجة إلى حاسوب. ينبغي أن يتصل الهاتف والتلفزيون بشبكة Wi-Fi واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটার লাগবে না: এই ফোন থেকেই Nino TV অ্যাপটি আপনার Samsung TV-তে বসিয়ে দেয়। ফোন আর TV, দুটোই এক Wi-Fi-তে থাকা চাই।"
          }

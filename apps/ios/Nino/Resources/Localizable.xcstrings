    "settings.profile.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا تجد أجهزتك، وحسابك في PSN، وخيارات الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যন্ত্র, PSN অ্যাকাউন্ট আর অনুবাদের সেটিংস সব এখানে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices, your PSN account and the translation options live here."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito makikita ang inyong mga device, ang PSN account, at ang mga setting sa pagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस, PSN खाता और अनुवाद से जुड़ी सेटिंग्स यहीं मिलेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat, akun PSN, serta setelan terjemahan ada di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti anda, akaun PSN serta seting terjemahan ada di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staan je apparaten, je PSN-account en de vertaalopties."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูอุปกรณ์ บัญชี PSN และการตั้งค่าการแปลได้ตรงนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazlarınız, PSN hesabınız ile çeviri seçenekleriniz burada."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیوائسز، آپ کا PSN اکاؤنٹ اور ترجمہ، ان سب کی ترتیبات یہیں ملیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị của bạn, tài khoản PSN cùng tùy chọn dịch đều nằm ở đây."
          }
        }
      }
    },

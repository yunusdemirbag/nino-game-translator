            "value": "Nederlandse ondertitels voor PS5-games"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำบรรยายภาษาไทยสำหรับเกม PS5"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 Oyunları İçin Türkçe Altyazı"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 گیمز اب اردو سب ٹائٹلز میں"
          }
        },
        "vi": {

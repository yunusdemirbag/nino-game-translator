          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Filipino na Subtitle sa Mga Laro ng PS5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 गेम के लिए हिन्दी सबटाइटल"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",

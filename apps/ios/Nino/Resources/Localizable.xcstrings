    "console.xbox.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد على البث المنزلي من Xbox وحساب Microsoft الذي تستخدمه أصلًا؛ لن تحتاج إلى إنشاء حساب آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox-এর হোম স্ট্রিমিং আর আপনার চালু Microsoft অ্যাকাউন্টেই কাজ করে; নতুন অ্যাকাউন্ট খুলতে হবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on Xbox home streaming with the Microsoft account you already use; you don't need to create another one."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagana sa home streaming ng Xbox gamit ang Microsoft account na gamit na ninyo; walang bagong account na kailangang gawin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox की होम स्ट्रीमिंग और आपके मौजूदा Microsoft खाते पर काम करता है; नया खाता बनाने की ज़रूरत नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan lewat streaming rumah Xbox dan akun Microsoft yang sudah Anda pakai; tidak perlu membuat akun baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berfungsi melalui penstriman rumah Xbox dan akaun Microsoft yang sedia anda guna; tiada akaun baharu perlu dibuat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait op Xbox-thuisstreaming met het Microsoft-account dat je al gebruikt; je hoeft niets nieuws aan te maken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานผ่านการสตรีมในบ้านของ Xbox กับบัญชี Microsoft ที่คุณมีอยู่แล้ว ไม่จำเป็นต้องสร้างบัญชีใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox ev yayınıyla, zaten kullandığınız Microsoft hesabı üzerinden çalışır; yeni bir hesap açmanız gerekmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox کی ہوم اسٹریمنگ اور آپ کے موجودہ Microsoft اکاؤنٹ پر چلتا ہے؛ نیا اکاؤنٹ بنانے کی ضرورت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy qua tính năng phát trong nhà của Xbox với tài khoản Microsoft bạn đang dùng; không cần lập tài khoản mới."
          }
        }
      }
    },

    "tvi.step.play": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play مفتوح الآن في التلفزيون: انقر «تثبيت» (أو «تحديث») من الريموت. وحين ينتهي يفتح Nino وحده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে Google Play খোলা আছে: রিমোট দিয়ে ইনস্টল করুন (বা আপডেট করুন) চাপুন। শেষ হলে Nino নিজেই চালু হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play is now showing on the TV: use the remote to choose Install (or Update). Nino launches by itself once it's finished."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakabukas sa TV ang Google Play: pindutin sa remote ang I-install (o I-update). Kusang magbubukas ang Nino pagkatapos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी में Google Play खुला है: रिमोट से “इंस्टॉल” (या “अपडेट”) दबाएँ। काम पूरा होते ही Nino ख़ुद खुल जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play sudah terbuka di TV: pakai remote untuk menekan Instal (atau Update). Nino akan terbuka sendiri setelah selesai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play terbuka di TV: tekan Pasang (atau Kemas kini) menggunakan alat kawalan jauh. Nino akan bermula sendiri sebaik sahaja selesai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play staat nu op je tv: kies met de afstandsbediening Installeren (of Updaten). Zodra dat klaar is, start Nino vanzelf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play เปิดอยู่บนทีวีแล้ว: ใช้รีโมตกด ติดตั้ง (หรือ อัปเดต) เมื่อเสร็จ Nino จะเปิดขึ้นมาเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play şu anda TV'de açık: kumandayla Yükle düğmesine (veya Güncelle'ye) basın. İş bitince Nino kendiliğinden açılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV میں Google Play کھلا ہے: ریموٹ سے «انسٹال» (یا «اپ ڈیٹ») دبائیں۔ کام پورا ہوتے ہی Nino خود کھل جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên TV đã mở Google Play: dùng remote bấm Cài đặt (hay Cập nhật). Xong là Nino tự chạy."
          }
        }
      }
    },

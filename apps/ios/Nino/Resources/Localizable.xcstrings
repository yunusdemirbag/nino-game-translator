{
  "sourceLanguage": "en",
  "strings": {
    "about.license": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج مجاني ومفتوح المصدر مرخّص بموجب GNU AGPL-3.0. يعتمد اتصال Remote Play على chiaki-ng، وهو مرخّص أيضًا بموجب AGPL-3.0."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি বিনামূল্যের, মুক্ত উৎসের সফটওয়্যার; লাইসেন্স GNU AGPL-3.0। Remote Play সংযোগের ভিত্তি chiaki-ng (AGPL-3.0)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free, open-source software, licensed GNU AGPL-3.0. Remote Play runs on chiaki-ng (AGPL-3.0)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Software na libre at bukas ang source, lisensyado sa GNU AGPL-3.0. Nakabatay sa chiaki-ng (AGPL-3.0) ang koneksiyon ng Remote Play."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सॉफ़्टवेयर निःशुल्क है और इसका सोर्स कोड खुला है, लाइसेंस GNU AGPL-3.0 है। Remote Play का कनेक्शन chiaki-ng (AGPL-3.0) पर बना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat lunak gratis dan sumber terbuka berlisensi GNU AGPL-3.0. Koneksi Remote Play dibangun di atas chiaki-ng (AGPL-3.0)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perisian sumber terbuka yang percuma, berlesen GNU AGPL-3.0. Sambungan Remote Play dibina atas chiaki-ng (AGPL-3.0)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis software met open broncode, onder licentie GNU AGPL-3.0. Remote Play draait op chiaki-ng (AGPL-3.0)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino เป็นซอฟต์แวร์โอเพนซอร์สที่ใช้ได้ฟรี อยู่ภายใต้สัญญาอนุญาต GNU AGPL-3.0 ส่วนการเชื่อมต่อ Remote Play สร้างบนพื้นฐานของ chiaki-ng (AGPL-3.0)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsizdir, kaynak kodu açıktır; lisansı GNU AGPL-3.0. Remote Play, chiaki-ng üzerine kuruludur (AGPL-3.0)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ سافٹ ویئر مفت ہے، اس کا سورس کوڈ کھلا ہے اور لائسنس GNU AGPL-3.0 ہے۔ Remote Play کا کنکشن chiaki-ng (AGPL-3.0) پر بنا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần mềm mã nguồn mở, miễn phí, cấp phép GNU AGPL-3.0. Phần kết nối qua Remote Play được xây dựng trên chiaki-ng (AGPL-3.0)."
          }
        }
      }
    },
    "about.source": {
      "extractionState": "manual",

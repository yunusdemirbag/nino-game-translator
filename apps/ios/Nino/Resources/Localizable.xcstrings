    "diag.deviceinfo.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرفق مع بلاغات المشكلات لنعرف أجهزتك دون سؤالك. لا تشمل أسماء ولا أرقامًا تسلسلية ولا عناوين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্যা রিপোর্টের সঙ্গে এটি যায়, তাই আলাদা করে না জিজ্ঞেস করেই আমরা আপনার সেটআপ বুঝতে পারি। এতে কারও নাম, ঠিকানা কিংবা সিরিয়াল নম্বর থাকে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attached to every problem report, so we can tell your setup without asking you. Your name, serial numbers and addresses stay out of it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasama ito sa bawat ulat ng problema para alam namin ang inyong setup nang hindi na nagtatanong. Hindi kasama ang pangalan, serial number, at address."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समस्या रिपोर्ट के साथ जुड़कर जाता है, जिससे बिना पूछे हमें आपका सेटअप पता रहे। इसमें नाम, सीरियल नंबर और पते नहीं होते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikut terkirim bersama laporan masalah, jadi kami bisa tahu perangkat Anda tanpa bertanya. Nama, nomor seri, dan alamat tidak disertakan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Turut dihantar bersama laporan masalah, jadi kami faham persediaan anda tanpa perlu bertanya. Nama, nombor siri dan alamat tidak dimasukkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat mee met elke probleemmelding, zodat we je opstelling zien zonder het te vragen. Je naam, serienummers en adressen blijven erbuiten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งไปพร้อมรายงานปัญหาของคุณ เพื่อให้เราทราบอุปกรณ์ของคุณโดยไม่ต้องถาม ไม่มีชื่อ หมายเลขซีเรียล หรือที่อยู่รวมอยู่ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sorun bildirimine eklenir; böylece kurulumunuzu size sormadan görürüz. Adınız, seri numaralarınız ve adresleriniz bunun dışında kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسئلہ رپورٹ کرتے وقت ساتھ جاتا ہے تاکہ ہمیں پوچھے بغیر آپ کا سیٹ اپ معلوم رہے۔ اس میں نام، سیریل نمبر اور پتے نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi kèm theo mỗi lần bạn báo lỗi, nhờ vậy chúng tôi nắm được thiết bị bạn dùng mà không phải hỏi. Thông tin này không có tên, địa chỉ hay số sê-ri."
          }
        }
      }
    },

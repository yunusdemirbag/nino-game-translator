    "tv.test.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة للتجربة. هل تظهر لك فوق اللعبة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি পরীক্ষামূলক সাবটাইটেল। গেমের উপরে দেখা যাচ্ছে?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test subtitle here. Is it showing over the game?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pansubok na subtitle ito. Nakikita ba ito sa itaas ng laro?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज़माइशी सबटाइटल। क्या यह खेल के ऊपर नज़र आया?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini subtitle uji. Apakah tampil di atas game?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini sari kata percubaan. Adakah ia kelihatan di atas permainan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staat een testondertitel. Verschijnt hij over de game?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือคำบรรยายทดสอบ แสดงทับเกมอยู่หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir deneme. Altyazı oyunun üstünde görünüyor mu?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آزمائشی سب ٹائٹل۔ کیا یہ کھیل کے اوپر دکھ رہا ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ đề thử nằm ở đây. Nó có phủ lên game không?"
          }
        }
      }
    },

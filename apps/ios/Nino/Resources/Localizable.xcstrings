    "settings.read.fastcheck": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة قراءة منطقة الترجمة الثابتة بوتيرة أعلى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থির সাবটাইটেল অংশ আরও ঘন ঘন পড়ুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-read a still subtitle area more often"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas madalas basahin muli ang hindi gumagalaw na subtitle"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रुका हुआ सबटाइटल हिस्सा और जल्दी-जल्दी पढ़ें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca ulang area subtitle yang diam lebih sering"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca lebih kerap ruang sari kata yang kekal sama"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stilstaand ondertitelgebied vaker opnieuw lezen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านพื้นที่คำบรรยายที่นิ่งอยู่ซ้ำบ่อยขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişmeyen altyazı alanını sık sık yeniden oku"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ساکن سب ٹائٹل حصے کو زیادہ کثرت سے دوبارہ پڑھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc lại vùng phụ đề đứng yên thường xuyên hơn"
          }
        }
      }
    },
    "settings.read.fastcheck.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن بدت منطقة الترجمة بلا تغيير، فاقرأها ثانيةً بعد إطارين لا بعد 20. يستهلك المعالج أكثر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবটাইটেল অংশ একই মনে হলে ২০ ফ্রেমের বদলে ২ ফ্রেম পরে আবার পড়ে। বেশি CPU লাগে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the subtitle region looks unchanged, check again 2 frames later rather than 20. This takes more CPU."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag mukhang walang pagbabago sa bahagi ng subtitle, basahin itong muli matapos ang 2 frame, hindi 20. Mas malakas sa CPU."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर सबटाइटल क्षेत्र वैसा ही लगे, तो उसे 20 के बजाय 2 फ़्रेम बाद दोबारा पढ़ें। इसमें CPU ज़्यादा लगता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila area subtitle terlihat sama saja, baca ulang sesudah 2 frame, tidak 20. CPU lebih terpakai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kawasan sari kata nampak tidak berubah, baca sekali lagi sesudah 2 bingkai, bukan 20. Lebih banyak CPU digunakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziet het ondertitelgebied er hetzelfde uit, kijk dan al na 2 beelden opnieuw, niet pas na 20. Vraagt meer CPU."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าบริเวณคำบรรยายดูไม่เปลี่ยน จะอ่านซ้ำหลังผ่านไป 2 เฟรมแทนที่จะรอ 20 เฟรม กิน CPU มากกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazı alanı değişmemiş gibi görünüyorsa 20 kare beklemeden, 2 kare sonra tekrar okunur. İşlemciyi daha fazla yorar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب ٹائٹل والی جگہ بدلی ہوئی نہ لگے، تب بھی 20 کی جگہ 2 فریم بعد اسے پھر پڑھیں۔ اس میں CPU زیادہ لگتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi vùng chữ trông như cũ, chỉ chờ 2 khung hình (không phải 20) rồi đọc lại. Tốn CPU nhiều hơn."
          }
        }
      }
    },

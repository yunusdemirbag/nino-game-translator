    "pair.searching.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليكن PS5 شغّالًا أو بوضع الراحة، ومتصلًا بشبكة Wi-Fi ذاتها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 চালু রাখুন বা রেস্ট মোডে, একই Wi-Fi-তে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the PS5 switched on or resting, on your Wi-Fi"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat naka-on o naka-rest mode ang PS5, sa iisang Wi-Fi"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ऑन रहे या रेस्ट मोड पर, और उसी Wi-Fi से जुड़ा हो"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 harus menyala atau sedang mode istirahat, pada Wi-Fi yang sama"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 perlu hidup ataupun dalam mod rehat, menggunakan Wi-Fi sama"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de PS5 aan staan of rusten, op jouw Wi-Fi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด PS5 หรือให้อยู่ในโหมดพัก และอยู่ใน Wi-Fi เดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 açık veya dinlenmede olsun, Wi-Fi'nize bağlı kalsın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 چالو یا ریسٹ موڈ میں ہو اور اسی Wi-Fi سے جڑا ہو"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 cần bật hoặc đang nghỉ, chung Wi-Fi"
          }
        }
      }
    },
    "pair.title": {
      "extractionState": "manual",
      "localizations": {

    "settings.packs.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحصل الألعاب الشائعة على ترجماتها فورًا من ترجمات جاهزة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জনপ্রিয় গেমে আগেভাগে করা অনুবাদ থেকে সাবটাইটেল সঙ্গে সঙ্গে চলে আসে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Popular games get their subtitles instantly from ready-made translations."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Agad may subtitle ang mga kilalang laro dahil sa mga salin na handa na."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकप्रिय गेम को पहले से बने अनुवादों से सबटाइटल फ़ौरन मिलते हैं।"
          }
        },
        "id": {

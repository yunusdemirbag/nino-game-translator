    "tvi.dev.otherip": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير Host PC IP إلى جهاز آخر: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP-তে অন্য যন্ত্রের ঠিকানা: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP points to another device: %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibang device ang tinuturo ng Host PC IP: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP के ख़ाने में किसी और डिवाइस का पता है: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP mengarah ke perangkat lain: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP menghala ke peranti lain: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP wijst naar een ander apparaat: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP ชี้ไปยังอุปกรณ์อื่น: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP şu an başka bir cihazı işaret ediyor: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP والے خانے میں کسی دوسرے آلے کا پتہ ہے: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP đang trỏ tới thiết bị khác: %@"
          }
        }
      }
    },
    "tvi.dev.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل التلفزيون في وضع المطوّرين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-কে ডেভেলপার মোডে নিন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your TV into developer mode"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang TV sa developer mode"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी को डेवलपर मोड में डालें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alihkan TV ke mode pengembang"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar TV ke mod pembangun"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je tv in ontwikkelaarsmodus"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งทีวีให้อยู่ในโหมดนักพัฒนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'yi geliştirici moduna alın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV کو ڈیولپر موڈ میں لائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển TV sang chế độ nhà phát triển"
          }
        }
      }
    },
    "tvi.done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم: يجري تشغيل Nino %@ على التلفزيون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হয়ে গেছে: TV-তে Nino %@ চালু হচ্ছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done: Nino %@ is starting on the TV."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapos na: nagsisimula na sa TV ang Nino %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो गया: TV पर Nino %@ शुरू हो रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beres: Nino %@ mulai terbuka di TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai: Nino %@ sedang dimulakan pada TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar: Nino %@ wordt gestart op de tv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสร็จแล้ว: กำลังเปิด Nino %@ บนทีวี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuruldu: Nino %@ TV'de açılıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہو گیا: TV پر Nino %@ شروع ہو رہا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong: Nino %@ đang khởi động trên TV."
          }
        }
      }
    },
    "tvi.err.connection": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بالتلفزيون خلال التثبيت. أبقِ التلفزيون شغّالًا ومتصلًا بشبكة Wi-Fi ذاتها مع هذا الهاتف، ولا تغلق هذه الشاشة، ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনস্টলের মাঝপথে TV-র সঙ্গে যোগাযোগ কেটে গেছে। TV চালু রাখুন, ফোনটা যে Wi-Fi-তে সেখানেই রাখুন, এই পর্দা খোলা রাখুন, তারপর ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We lost the TV in the middle of installing. Leave the TV switched on and sharing this phone's Wi-Fi, stay on this screen, and retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawala ang koneksiyon sa TV habang ini-install. Panatilihing bukas ang TV at iisa ang Wi-Fi nito at ng telepono, huwag isara ang screen, at subukan muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल होते-होते टीवी का कनेक्शन टूट गया। टीवी ऑन रखें और उसी Wi-Fi से जुड़ा रहने दें जिस पर यह फ़ोन है, यह स्क्रीन भी खुली रखें, फिर आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan ke TV putus di tengah pemasangan. Jaga TV tetap hidup dan memakai Wi-Fi yang sama seperti ponsel ini, jangan tutup layar ini, lalu ulangi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan dengan TV terputus sewaktu memasang. Biarkan TV hidup dan menggunakan Wi-Fi sama seperti telefon ini, jangan tutup skrin ini, lalu cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het installeren raakten we de tv kwijt. Laat de tv ingeschakeld en op de Wi-Fi van deze telefoon, blijf op dit scherm en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อกับทีวีขาดหายระหว่างการติดตั้ง เปิดทีวีไว้และใช้ Wi-Fi เดียวกับโทรศัพท์เครื่องนี้ เปิดหน้าจอนี้ค้างไว้ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum sürerken TV ile bağlantı kesildi. TV'yi açık ve telefonunuzla aynı Wi-Fi'da tutun, bu ekrandan çıkmayın ve yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انسٹال ہوتے ہوتے TV سے رابطہ ٹوٹ گیا۔ TV چالو رکھیں اور اسی Wi-Fi سے جڑا رہنے دیں جس پر یہ فون ہے، یہ اسکرین بھی کھلی رکھیں، پھر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang cài thì TV bị rớt mạng. Để TV luôn bật và chung Wi-Fi với máy này, đừng đóng màn hình này, rồi thử lần nữa."
          }
        }
      }
    },
    "tvi.err.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Nino من وضع التطبيق على التلفزيون. حاول مرة أخرى، وإن لم ينجح ذلك أيضًا فأرسل لنا سجل التثبيت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino TV-তে অ্যাপটি বসাতে পারেনি। আরেকবার চেষ্টা করুন; এবারও না হলে ইনস্টলের লগ আমাদের পাঠান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino couldn't put the app on your TV. Give it another try; if that fails too, please send us the install log."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nailagay ng Nino ang app sa TV. Subukan ulit; kung bigo pa rin, ipadala sa amin ang install log."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino टीवी पर ऐप नहीं डाल सका। एक बार और कोशिश करें; तब भी न हो तो इंस्टॉल लॉग हमें भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak bisa memasang aplikasi di TV. Coba sekali lagi; jika masih gagal, kirimi kami log pemasangannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak dapat memasang apl pada TV. Cuba sekali lagi; jika masih gagal, hantarkan log pemasangan kepada kami."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino kreeg de app niet op je tv. Probeer het opnieuw; lukt het dan ook niet, stuur ons dan het installatielog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ติดตั้งแอปลงทีวีไม่สำเร็จ ลองใหม่อีกรอบ ถ้ายังไม่ได้ ส่งบันทึกการติดตั้งให้เราด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino uygulamayı TV'ye kuramadı. Bir kez daha deneyin; yine olmazsa kurulum kaydını bize gönderin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino TV پر ایپ نہیں ڈال سکا۔ ایک بار اور کوشش کریں؛ پھر بھی نہ ہو تو انسٹال لاگ ہمیں بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino không cài được app lên TV. Thử thêm một lần; nếu vẫn không được, gửi cho chúng tôi nhật ký cài đặt."
          }
        }
      }
    },
    "tvi.err.package": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حزمة تطبيق التلفزيون غير متوفرة على هذا الهاتف بعد. اتصل بالإنترنت مرة واحدة ليتمكن Nino من تنزيلها، ثم أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV অ্যাপের প্যাকেজ এখনো এই ফোনে আসেনি। একবার ইন্টারনেটে যুক্ত হোন, Nino সেটি নামিয়ে নেবে, তারপর ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone doesn't have the TV app package yet. Go online once so Nino can fetch it, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pa ang package ng TV app sa teleponong ito. Kumonekta minsan sa internet para ma-download ito ng Nino, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV ऐप का पैकेज अभी इस फ़ोन पर नहीं है। एक बार इंटरनेट से कनेक्ट करें ताकि Nino उसे डाउनलोड कर सके, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket aplikasi TV belum ada di ponsel ini. Sambungkan ke internet sekali agar Nino dapat mengunduhnya, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakej aplikasi TV belum ada pada telefon ini. Sambung ke internet sekali supaya Nino dapat memuat turunnya, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het tv-app-pakket ontbreekt nog op deze telefoon. Ga één keer online zodat Nino het kan ophalen en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีแพ็กเกจแอปทีวีในโทรศัพท์เครื่องนี้ เชื่อมต่ออินเทอร์เน็ตหนึ่งครั้งเพื่อให้ Nino ดาวน์โหลดได้ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV uygulamasının paketi bu telefonda henüz yok. Nino'nun indirebilmesi için bir kez internete bağlanın ve tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV ایپ کا پیکج ابھی اس فون میں نہیں آیا۔ ایک دفعہ انٹرنیٹ سے جڑیں تاکہ Nino پیکج لے آئے، پھر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại chưa có gói ứng dụng TV. Bạn bật Internet một lần để Nino tải gói về, rồi thử lần nữa."
          }
        }
      }
    },
    "tvi.err.space": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد هناك مساحة فارغة على التلفزيون. أزل تثبيت تطبيق لا تستخدمه على التلفزيون، ثم أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র জায়গা ফুরিয়ে গেছে। TV থেকে অব্যবহৃত কোনো অ্যাপ সরিয়ে দিয়ে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV has run out of storage. Delete an app you no longer use and retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puno na ang storage ng TV. Mag-uninstall sa TV ng isang app na hindi ninyo ginagamit, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी की मेमोरी भर चुकी है। टीवी से कोई बेकार पड़ा ऐप हटाएँ, फिर आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori TV sudah habis. Copot satu aplikasi TV yang jarang dipakai, kemudian coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV tiada ruang kosong lagi. Nyahpasang aplikasi yang anda tidak guna pada TV, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opslag van de tv is vol. Haal een ongebruikte app van je tv af en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีไม่มีพื้นที่ว่างเหลือแล้ว ถอนการติดตั้งแอปที่คุณไม่ได้ใช้บนทีวี แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de yer kalmadı. TV'de kullanmadığınız bir uygulamayı kaldırıp tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV کی میموری بھر چکی ہے۔ کوئی ایسی ایپ ہٹائیں جو آپ نہیں چلاتے، پھر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ TV đã đầy. Gỡ bớt một ứng dụng không dùng trên TV, rồi thử lần nữa."
          }
        }
      }
    },
    "tvi.home": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اذهب إلى شاشة البداية"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোম পর্দায় ফিরুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to home"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumalik sa home screen"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम स्क्रीन खोलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke layar utama"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke skrin utama"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terug naar beginscherm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่หน้าจอหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekrana dön"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہوم اسکرین کھولیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Về trang chính"
          }
        }
      }
    },
    "tvi.lg.badip": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان IP غير صحيح. اكتبه على هذا النحو: 192.168.1.20، بلا http:// وبلا رقم منفذ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি বৈধ IP ঠিকানা নয়। 192.168.1.20-এর মতো লিখুন, http:// এবং পোর্ট নম্বর ছাড়া।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That IP address isn't right. Type it as 192.168.1.20 — no http:// and no port number."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali ang IP address na iyan. Isulat ito gaya ng 192.168.1.20, nang walang http:// at walang port number."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह IP पता सही नहीं। इसे ऐसे लिखें: 192.168.1.20, http:// और पोर्ट नंबर छोड़कर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat IP itu tidak sah. Tulis dengan format 192.168.1.20, tanpa http:// maupun nomor port."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat IP itu tidak sah. Tulis begini: 192.168.1.20, tanpa http:// dan tanpa port."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat IP-adres klopt niet. Typ het als 192.168.1.20, dus zonder http:// en zonder poortnummer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่ไม่ใช่ที่อยู่ IP ที่ถูกต้อง เขียนแบบ 192.168.1.20 โดยไม่มี http:// และไม่มีหมายเลขพอร์ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu IP adresi doğru değil. Başına http:// koymadan ve port eklemeden 192.168.1.20 biçiminde girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ IP پتہ ٹھیک نہیں۔ اسے یوں لکھیں: 192.168.1.20، http:// اور پورٹ نمبر چھوڑ کر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "IP này không đúng định dạng. Hãy viết kiểu 192.168.1.20, bỏ http:// và số cổng."
          }
        }
      }
    },
    "tvi.lg.err.keyrefused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض التلفزيون المفتاح. فعّل Key Server وأدخل الـ passphrase مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV কী-টা নেয়নি। Key Server অন করে passphrase ফের লিখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV rejected the key. Switch Key Server on and enter the passphrase again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw tanggapin ng TV ang inyong key. I-enable ang Key Server, saka ilagay ulit ang passphrase."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी ने कुंजी नहीं मानी। Key Server ऑन करके passphrase दोबारा लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci ditolak TV. Nyalakan Key Server, lalu isi passphrase sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV menolak kunci itu. Aktifkan Key Server, kemudian masukkan passphrase sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv accepteerde de sleutel niet. Schakel Key Server in en vul de passphrase opnieuw in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีปฏิเสธคีย์ เปิด Key Server แล้วป้อน passphrase อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV bu anahtarı reddetti. Key Server'ı etkinleştirip passphrase'i tekrar girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV نے کلید نہیں مانی۔ Key Server چالو کر کے passphrase پھر سے لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bị TV từ chối. Bật Key Server rồi gõ lại passphrase."
          }
        }
      }
    },
    "tvi.lg.err.keyserver": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server متوقف. افتح تطبيق Developer Mode من LG وفعّل Key Server، ثم اترك التطبيق ظاهرًا على التلفزيون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server বন্ধ আছে। LG-র Developer Mode অ্যাপ খুলে Key Server চালু করুন, তারপর অ্যাপটা TV-তে খোলা রেখে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Key Server is off. Open LG's Developer Mode app, switch Key Server on and leave the app open on the TV."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang Key Server. Buksan ang Developer Mode app ng LG, i-on ang Key Server, at iwanang bukas ang app sa TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server बंद है। LG का Developer Mode ऐप खोलकर Key Server चालू करें, फिर ऐप को टीवी पर खुला छोड़ दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server mati. Buka aplikasi Developer Mode dari LG, hidupkan Key Server, dan biarkan aplikasi itu terbuka di TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server dimatikan. Buka apl Developer Mode LG, hidupkan Key Server dan biarkan apl itu terbuka pada TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server staat uit. Open de Developer Mode-app van LG, zet Key Server aan en laat de app open op de tv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server ไม่ได้เปิด เปิดแอป Developer Mode ของ LG แล้วเปิด Key Server จากนั้นปล่อยแอปไว้บนจอทีวี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server kapalı. LG'nin Developer Mode uygulamasını açıp Key Server'ı açın ve uygulamayı TV'de açık bırakın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server بند ہے۔ LG کی Developer Mode ایپ کھول کر Key Server آن کریں، پھر ایپ کو TV پر کھلا چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Server đang tắt. Mở app Developer Mode của LG, bật Key Server rồi để app mở sẵn trên TV."
          }
        }
      }
    },
    "tvi.lg.err.passphrase": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ passphrase غير صحيح. قارنه بالظاهر على شاشة التلفزيون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই passphrase ভুল। TV স্ক্রিনে থাকাটির সঙ্গে মিলিয়ে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong passphrase. Check it against what the TV is showing."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali ang passphrase na iyan. Itapat ito sa nakasulat sa screen ng inyong TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह passphrase ग़लत है। इसे टीवी पर दिख रहे passphrase से मिलाकर देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase itu salah. Bandingkan dengan yang ada di layar TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase itu salah. Bandingkan dengan passphrase di skrin TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die passphrase klopt niet. Vergelijk hem met die op het tv-scherm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "passphrase ไม่ถูกต้อง เทียบกับที่แสดงบนหน้าจอทีวี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase yanlış. TV ekranındakiyle karşılaştırın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ passphrase غلط ہے۔ اسے TV اسکرین پر موجود passphrase سے ملائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase chưa đúng. Bạn đối chiếu với passphrase đang hiện trên TV."
          }
        }
      }
    },
    "tvi.lg.err.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجيب التلفزيون. تحقّق أنه شغّال ومتصل بشبكة Wi-Fi ذاتها مع هذا الهاتف، وأن خيار Dev Mode Status يعمل داخل Developer Mode."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV সাড়া দিল না। সেটি চালু কিনা, ফোনটা যে Wi-Fi-তে সেখানেই কিনা দেখুন; আর Developer Mode নামের অ্যাপে গিয়ে Dev Mode Status অন রাখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reply from the TV. Check that it's switched on, shares this phone's Wi-Fi, and has Dev Mode Status enabled inside the LG Developer Mode app."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang tugon mula sa TV. Siguraduhing bukas ito at iisa ang Wi-Fi nito at ng telepono, at naka-enable sa loob ng Developer Mode app ang opsyong Dev Mode Status."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी की तरफ़ से जवाब नहीं आया। देखें कि वह ऑन हो, उसी Wi-Fi से जुड़ा हो जिस पर यह फ़ोन है, और साथ ही उसमें Developer Mode खोलकर Dev Mode Status ऑन किया हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV tidak menjawab. Cek apakah TV hidup dan memakai Wi-Fi yang sama seperti ponsel ini, serta Dev Mode Status sudah dinyalakan pada aplikasi Developer Mode."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV tidak memberi jawapan. Pastikan TV hidup dan menggunakan Wi-Fi sama seperti telefon ini, serta Dev Mode Status diaktifkan dalam Developer Mode (apl di TV)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen reactie van de tv. Kijk of hij is ingeschakeld, dezelfde Wi-Fi als deze telefoon gebruikt en of Dev Mode Status is ingeschakeld in LG's app Developer Mode."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีไม่ตอบกลับ ตรวจดูว่าทีวีเปิดอยู่ ต่อ Wi-Fi วงเดียวกับมือถือนี้ และในแอป Developer Mode ได้เปิด Dev Mode Status ไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'den cevap gelmedi. TV'nin açık olduğunu, telefonunuzla aynı Wi-Fi'ı kullandığını ve Developer Mode uygulamasının içinde Dev Mode Status'un etkin olduğunu doğrulayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV کی طرف سے جواب نہیں آیا۔ دیکھیں کہ وہ چالو ہو، اسی Wi-Fi سے جڑا ہو جس پر یہ فون ہے، اور ساتھ ہی Developer Mode کے اندر Dev Mode Status چالو ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV không đáp lại. Xem TV đã bật chưa, có chung Wi-Fi với máy này không, và mục Dev Mode Status trong app Developer Mode có đang bật không."
          }
        }
      }
    },
    "tvi.lg.list": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلفزيونات LG على هذه الشبكة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নেটওয়ার্কের LG TV"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LG TVs found on this network"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga LG TV na nasa network ninyo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Wi‑Fi पर मौजूद LG TV"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV LG dalam jaringan ini"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV LG dalam rangkaian ini"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LG-tv's in dit netwerk"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวี LG ในเครือข่ายนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ağdaki LG TV'ler"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Wi‑Fi پر موجود LG TV"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các TV LG có trong mạng"
          }
        }
      }
    },
    "tvi.lg.needpass": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل أولًا الـ passphrase المكوّن من 6 أحرف الظاهر على التلفزيون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে TV-তে দেখানো 6 অক্ষরের passphrase লিখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type in the 6-character passphrase from the TV screen first."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-type muna ang passphrase na makikita sa TV (6 character)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले टीवी पर दिखा 6 अक्षरों वाला passphrase लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi dulu kode passphrase berisi 6 karakter yang terlihat di layar TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan dahulu passphrase 6 aksara yang tertera di TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ eerst de passphrase van zes tekens die je tv laat zien."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อน passphrase 6 ตัวอักษรที่แสดงบนทีวีก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce TV ekranındaki 6 karakterlik passphrase'i yazın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے TV پر دکھا 6 حرفی passphrase لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước hết, gõ passphrase gồm 6 ký tự đang hiện trên TV."
          }
        }
      }
    },
    "tvi.lg.needtv": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أولًا، حدّد تلفزيونك من القائمة في الأعلى أو اكتب عنوانه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুতে ওপরের তালিকা থেকে TV বাছুন, কিংবা তার ঠিকানা লিখে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your TV from the list first, or type in its address."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili muna ng TV sa listahang nasa itaas, o i-type mismo ang address."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले ऊपर वाली लिस्ट में अपना टीवी चुनें, या उसका पता लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih TV dulu dari daftar tadi, atau ketik alamatnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih TV anda dahulu daripada senarai di atas, ataupun taipkan alamatnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies eerst welke tv het is in de lijst, of typ zijn adres in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกทีวีของคุณจากรายการด้านบนหรือพิมพ์ที่อยู่ของทีวีก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce listeden TV'nizi seçin veya adresini elle girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے اوپر والی لسٹ میں اپنا TV چنیں، یا اس کا پتہ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước hết, chọn một TV ở danh sách bên trên hoặc tự gõ địa chỉ TV."
          }
        }
      }
    },
    "tvi.lg.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد تلفزيون LG. هل هو شغّال ومتصل بشبكة Wi-Fi ذاتها؟ يمكنك كتابة عنوانه بالأسفل (في التلفزيون: الإعدادات › عام › الشبكة، ثم الشبكة التي يتصل بها)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "LG TV মেলেনি। সেটি কি অন, আর একই Wi-Fi-তে? নিচে ঠিকানাটা নিজে লিখে দিতে পারেন (TV-র সেটিংস খুলে সাধারণ, তারপর নেটওয়ার্ক থেকে যুক্ত থাকা নেটওয়ার্ক)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No LG TV turned up. Is it switched on and on your Wi-Fi? You may also enter its address below (the TV lists it under Settings › General › Network, then your connected network)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang LG TV na nakita. Bukas ba ito at nasa iisang Wi-Fi? Puwedeng i-type sa ibaba ang address (makikita sa TV, sa Settings › General › Network, sa network na nakakonekta)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LG TV नहीं दिखा। क्या वह ऑन है, और इसी Wi-Fi पर है? उसका पता नीचे ख़ुद लिखा जा सकता है (टीवी में: सेटिंग्स › सामान्य › नेटवर्क, फिर वह नेटवर्क जिससे टीवी जुड़ा है)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV LG tak ditemukan. Sudahkah TV menyala dan memakai Wi-Fi yang sama? Alamatnya bisa diketik di bawah (pada TV: Pengaturan › Umum › Jaringan › jaringan yang sedang dipakai)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV LG tidak dijumpai. Adakah TV hidup dan menggunakan Wi-Fi sama? Alamatnya boleh ditaip di bawah (di TV: Tetapan › Umum › Rangkaian › rangkaian yang sedang disambung)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen LG-tv gevonden. Is hij ingeschakeld en verbonden met jouw Wi-Fi? Typ zijn adres anders hieronder (te vinden in de tv-instellingen bij Algemeen › Netwerk, onder het netwerk waarmee hij verbonden is)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เจอทีวี LG ทีวีเปิดอยู่และต่อ Wi-Fi วงเดียวกันหรือเปล่า พิมพ์ที่อยู่ทีวีเองด้านล่างได้ (ที่ทีวี: การตั้งค่า › ทั่วไป › เครือข่าย › เลือกเครือข่ายที่ต่ออยู่)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiç LG TV bulunamadı. Açık mı, Wi-Fi'nize bağlı mı? Adresini aşağıya da girebilirsiniz (TV'nin Ayarlar menüsünde Genel › Ağ altında, bağlandığınız ağa girerek bulursunuz)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "LG TV نظر نہیں آیا۔ کیا وہ چالو ہے، اور فون والے Wi-Fi سے ہی جڑا ہے؟ اس کا پتہ نیچے خود لکھا جا سکتا ہے (TV میں: ترتیبات › عمومی › نیٹ ورک، پھر وہ نیٹ ورک جس سے TV جڑا ہے)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thấy TV LG nào. TV đã bật, đã chung Wi-Fi chưa? Có thể gõ địa chỉ TV ở ô dưới (xem trên TV: vào Cài đặt, mục Chung › Mạng, chọn mạng đang dùng)."
          }
        }
      }
    },
    "tvi.lg.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إلى تطبيق Developer Mode الخاص بـ LG على التلفزيون، وإلى حساب مطوّر مجاني لدى LG. ويحرص Nino على ألا ينتهي وضع المطوّر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে লাগবে Developer Mode নামের LG অ্যাপ, সঙ্গে LG-র একটি বিনামূল্যের ডেভেলপার অ্যাকাউন্ট। ডেভেলপার মোডের মেয়াদ যাতে না ফুরোয়, Nino সেদিকে খেয়াল রাখে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need LG's Developer Mode on your TV, plus a free developer account with LG. Nino stops developer mode from running out."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan sa TV ang app ng LG na Developer Mode, at isang LG developer account na libre. Hindi hinahayaan ng Nino na mag-expire ang developer mode."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए टीवी में Developer Mode नाम का LG ऐप और LG का मुफ़्त डेवलपर खाता चाहिए। Nino डेवलपर मोड की मियाद ख़त्म नहीं होने देता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlu aplikasi Developer Mode milik LG di TV serta akun developer LG yang gratis. Nino menjaga mode developer supaya tidak habis masa berlakunya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlukan apl LG Developer Mode di TV serta akaun pembangun LG yang percuma. Nino memastikan mod pembangun tidak tamat tempoh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt LG's Developer Mode-app op je tv nodig, plus een gratis ontwikkelaarsaccount bij LG. Nino voorkomt dat de ontwikkelaarsmodus afloopt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีต้องมีแอป LG Developer Mode และต้องมีบัญชีนักพัฒนา LG (ฟรี) Nino จะดูแลไม่ให้โหมดนักพัฒนาหมดอายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nizde LG'nin Developer Mode adlı uygulaması ile ücretsiz bir LG geliştirici hesabına ihtiyaç var. Nino, geliştirici modunun süresinin dolmasını engeller."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے لیے TV میں Developer Mode نام کی LG ایپ اور LG کا مفت ڈیولپر اکاؤنٹ چاہیے۔ Nino ڈیولپر موڈ کی مدت ختم نہیں ہونے دیتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV cần cài app Developer Mode của hãng LG, kèm một tài khoản LG Developer (free). Nino sẽ giữ cho Developer Mode không bị hết hạn."
          }
        }
      }
    },
    "tvi.lg.pass": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (يظهر على التلفزيون، 6 أحرف)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (TV-তে দেখায়, 6 অক্ষর)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (6 characters, shown on your TV)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (nasa TV, 6 character)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (TV पर दिखता है, 6 अक्षर)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (tampil di TV, 6 karakter)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (dipaparkan pada TV, 6 aksara)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (staat op de tv, 6 tekens)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (แสดงบนทีวี 6 ตัวอักษร)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (6 karakter, TV ekranında yazar)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (TV پر دکھائی دیتا ہے، 6 حروف)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (gồm 6 ký tự, xem trên TV)"
          }
        }
      }
    },
    "tvi.lg.pass.saved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (المفتاح محفوظ؛ عند الطلب فقط)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (কী সংরক্ষিত; শুধু চাওয়া হলে)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (key saved; only if asked)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (naka-save ang key; kung hihingin lang)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (कुंजी सहेजी गई; केवल पूछे जाने पर)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (kunci tersimpan; hanya jika diminta)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (kunci disimpan; hanya jika diminta)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (sleutel opgeslagen; alleen als erom gevraagd wordt)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (บันทึกคีย์แล้ว ป้อนเฉพาะเมื่อถูกถาม)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (anahtar kaydedildi; yalnızca istenirse)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (کلید محفوظ ہے؛ صرف پوچھے جانے پر)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase (khóa đã lưu; chỉ gõ khi được hỏi)"
          }
        }
      }
    },
    "tvi.lg.session": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل وضع المطوّر شغّالًا حتى 1000 ساعة. وكلما استطاع هذا الهاتف بلوغ التلفزيون، يمدّده Nino مرة كل يوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেভেলপার মোড বড়জোর 1000 ঘণ্টা অন থাকে। ফোন থেকে TV-র নাগাল পেলেই Nino দিনে একবার মেয়াদটা বাড়িয়ে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer mode lasts up to 1000 hours. As long as this phone can see the TV, Nino renews it once every day."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukas ang developer mode hanggang 1000 oras. Basta naaabot ng teleponong ito ang TV, pinapahaba ito ng Nino minsan bawat araw."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेवलपर मोड 1000 घंटों तक ऑन रह सकता है। जब-जब यह फ़ोन टीवी से संपर्क कर पाए, Nino रोज़ एक दफ़ा उसकी मियाद बढ़ा देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode pengembang tetap aktif hingga 1000 jam. Selama ponsel ini bisa menjangkau TV, Nino memperpanjangnya sekali sehari."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod pembangun kekal aktif hingga 1000 jam. Setiap kali telefon ini boleh mencapai TV, Nino melanjutkannya sekali sehari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ontwikkelaarsmodus houdt het hooguit 1000 uur vol. Zolang deze telefoon de tv ziet, vernieuwt Nino hem dagelijks."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดนักพัฒนาจะเปิดอยู่ได้นานสูงสุด 1000 ชั่วโมง เมื่อใดที่โทรศัพท์เครื่องนี้เข้าถึงทีวีได้ Nino จะต่ออายุให้วันละครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici modu en fazla 1000 saat sürer. Bu telefon TV'yi görebildiği müddetçe Nino süreyi her gün bir defa yeniler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیولپر موڈ 1000 گھنٹوں تک چالو رہ سکتا ہے۔ جب جب یہ فون TV سے رابطہ کر پائے، Nino روزانہ ایک دفعہ اس کی مدت بڑھا دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode bật được lâu nhất 1000 giờ. Hễ điện thoại liên lạc được với TV, mỗi ngày Nino gia hạn thêm một lần."
          }
        }
      }
    },
    "tvi.lg.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. افتح حسابًا مجانيًا للمطوّرين لدى LG عبر webostv.developer.lge.com."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "1. webostv.developer.lge.com-এ একটি বিনামূল্যের LG ডেভেলপার অ্যাকাউন্ট খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Sign up for a free developer account with LG on webostv.developer.lge.com."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Gumawa ng LG developer account (libre) sa webostv.developer.lge.com."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. webostv.developer.lge.com पर जाकर LG का मुफ़्त डेवलपर खाता बना लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Daftar akun developer LG secara gratis di webostv.developer.lge.com."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Daftar akaun pembangun LG secara percuma di webostv.developer.lge.com."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Registreer op webostv.developer.lge.com een gratis LG-ontwikkelaarsaccount."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1. สมัครบัญชีนักพัฒนา LG ได้ฟรีที่ webostv.developer.lge.com"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. webostv.developer.lge.com adresinden bedava bir LG geliştirici hesabı oluşturun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "1. webostv.developer.lge.com پر جا کر LG کا مفت ڈیولپر اکاؤنٹ بنا لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Lập tài khoản LG Developer (free) tại webostv.developer.lge.com."
          }
        }
      }
    },
    "tvi.lg.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. في التلفزيون، نزّل Developer Mode من متجر LG Content Store، ثم افتحه وادخل بحسابك، وشغّل Dev Mode Status. سيُعيد التلفزيون التشغيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "2. TV-র LG Content Store খুলে Developer Mode অ্যাপটি নামান, চালু করুন, নিজের অ্যাকাউন্টে লগ ইন করুন, এরপর Dev Mode Status অন করুন। TV তখন নিজে রিস্টার্ট নেবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. On your TV, get Developer Mode from LG's Content Store, launch it, log in with your developer account, and turn Dev Mode Status on. The TV will reboot."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Sa TV, kunin sa Content Store ng LG ang app na Developer Mode. Buksan ito, mag-log in sa inyong account, at i-enable ang opsyong Dev Mode Status. Pagkatapos, magre-restart ang TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. टीवी में LG Content Store खोलकर Developer Mode ऐप लें, फिर उसमें अपने खाते से लॉगिन करके Dev Mode Status ऑन कर दें। टीवी दोबारा चालू होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Pada TV, unduh Developer Mode lewat LG Content Store, jalankan, login memakai akun tadi, lalu hidupkan Dev Mode Status. Setelah itu TV menyala ulang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Di TV, muat turun apl Developer Mode dari LG Content Store lalu bukanya. Log masuk menggunakan akaun itu, kemudian aktifkan Dev Mode Status. Selepas itu, TV dimulakan semula dengan sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Installeer Developer Mode op je tv vanuit LG's Content Store, start die app, meld je aan met je ontwikkelaarsaccount en schakel Dev Mode Status in. Daarna herstart de tv vanzelf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ที่ทีวี ลงแอป Developer Mode ซึ่งมีใน LG Content Store แล้วเปิดขึ้นมา ลงชื่อเข้าใช้ด้วยบัญชีของคุณ จากนั้นเปิด Dev Mode Status ทีวีจะรีสตาร์ทเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. TV'nizde LG Content Store üzerinden Developer Mode'u kurun, başlatın, hesabınızla oturum açın ve ardından Dev Mode Status'u etkinleştirin. TV kendini yeniden başlatır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "2. TV میں LG Content Store کھول کر Developer Mode ایپ لیں، پھر اس میں اپنے اکاؤنٹ سے لاگ اِن کر کے Dev Mode Status چالو کر دیں۔ TV دوبارہ چلے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Trên TV, vào LG Content Store, tải app Developer Mode, mở ra, đăng nhập tài khoản vừa tạo rồi chuyển Dev Mode Status sang bật. TV sẽ tự khởi động lại."
          }
        }
      }
    },
    "tvi.lg.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3. عُد إلى تطبيق Developer Mode وشغّل Key Server. لا تغلق التطبيق؛ فالـ Passphrase ذو الأحرف الستة (6) يظهر أسفل يسار الشاشة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Developer Mode অ্যাপটা ফের খুলে Key Server অন করুন। অ্যাপ পর্দায় খোলা রাখুন; 6 অক্ষরের Passphrase নিচের বাঁ কোণে লেখা থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Launch Developer Mode once more and turn Key Server on. Keep the app showing; the 6-character Passphrase appears in the lower-left corner."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Muling buksan ang app na Developer Mode, saka i-enable ang Key Server. Hayaang nakabukas ang app; nasa kaliwang ibaba ang Passphrase na may 6 na character."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Developer Mode वाला ऐप दोबारा खोलकर Key Server ऑन करें। ऐप को सामने खुला रहने दें; 6 अक्षरों वाला Passphrase नीचे बाएँ कोने में दिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Jalankan aplikasi Developer Mode sekali lagi, lalu hidupkan Key Server. Jangan tutup aplikasinya; Passphrase 6 karakter terlihat di pojok kiri bawah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Buka semula apl Developer Mode, kemudian aktifkan Key Server. Jangan tutup apl itu; Passphrase 6 aksara tertera di sudut kiri bawah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Start Developer Mode nog een keer en schakel Key Server in. Houd de app in beeld; de Passphrase van zes tekens verschijnt in de linkerbenedenhoek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "3. กลับไปเปิดแอป Developer Mode อีกรอบ แล้วเปิด Key Server ทิ้งแอปไว้บนจอ จะเห็น Passphrase 6 ตัวอักษรที่มุมล่างซ้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Developer Mode'u bir kez daha başlatın ve Key Server'ı etkinleştirin. Uygulama ekranda kalsın; 6 karakterlik Passphrase sol alt köşede belirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Developer Mode والی ایپ پھر کھول کر Key Server چالو کریں۔ ایپ کو سامنے کھلا رہنے دیں؛ 6 حرفی Passphrase نیچے بائیں کونے میں نظر آتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Mở app Developer Mode thêm lần nữa, rồi bật Key Server lên. Để app hiện nguyên trên màn hình; Passphrase gồm 6 ký tự nằm ở góc trái phía dưới."
          }
        }
      }
    },
    "tvi.lg.step4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "4. أدخل Passphrase في الأعلى واضغط على ثبّت وافتح. تحتاج إليه في المرة الأولى فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "4. উপরে Passphrase লিখুন এবং ইনস্টল করুন ও খুলুন ট্যাপ করুন। এটি শুধু প্রথমবার লাগে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Enter the Passphrase in the field above, then tap Install & open. It's only needed the first time."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "4. I-type sa itaas ang Passphrase, saka i-tap ang button na I-install at buksan. Kailangan lang ito sa unang beses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "4. ऊपर Passphrase लिखकर “इंस्टॉल करके खोलें” दबाएँ। यह सिर्फ़ पहली दफ़ा चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Isi Passphrase pada kolom di atas, lalu ketuk Instal & buka. Cukup sekali, saat pertama kali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Masukkan Passphrase tersebut di atas, kemudian ketik Pasang & buka. Ia cuma diperlukan pada kali pertama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Vul de Passphrase in het veld hierboven in en kies dan Installeren en openen. Dat hoeft alleen de eerste keer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "4. ป้อน Passphrase ด้านบนแล้วแตะ ติดตั้งและเปิด ต้องใช้เฉพาะครั้งแรกเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Passphrase'i yukarıdaki alana girin, sonra Yükle ve aç'a dokunun. Bu yalnızca ilk seferde gerekir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "4. اوپر Passphrase لکھ کر «انسٹال کر کے کھولیں» دبائیں۔ یہ صرف پہلی دفعہ چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Gõ Passphrase vào ô phía trên rồi chạm Cài đặt & mở. Chỉ lần đầu mới cần."
          }
        }
      }
    },

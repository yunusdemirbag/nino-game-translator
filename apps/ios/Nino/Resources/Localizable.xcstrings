    "pair.help.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق أن PS5 يعمل كليًا (لا بوضع الراحة) ومتصل بشبكة Wi-Fi ذاتها، وأن Nino مسموح له من الإعدادات › الخصوصية والأمان › الشبكة المحلية. أو اكتب عنوان IP لجهازك PS5 يدويًا (تجده على PS5 داخل الإعدادات › الشبكة، ثم «حالة الاتصال»)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 পুরোপুরি চালু তো (রেস্ট মোডে নয়), একই Wi-Fi-তে তো, দেখে নিন; তারপর Settings › Privacy & Security খুলে Local Network অংশে Nino-কে অনুমতি দিন। নয়তো PS5-এর IP ঠিকানা নিজে লিখুন (PS5-এ: Settings খুলে Network-এর Connection Status)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is the PS5 properly switched on (rest mode won't do) and on your Wi-Fi? Is Nino allowed to use the Local Network (iPhone Settings › Privacy & Security)? Or just type the console's IP yourself (on the PS5: Settings › Network, then Connection Status)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguraduhing buong bukas ang PS5 (hindi nasa rest mode), iisa ang Wi-Fi, at may pahintulot ang Nino sa iPhone (Settings › Privacy & Security › Local Network). Kayo rin mismo ang puwedeng mag-type ng IP ng console (makikita sa PS5, nasa Settings › Network › Connection Status)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि PS5 पूरी तरह ऑन हो (रेस्ट मोड वाला नहीं), उसी Wi-Fi से जुड़ा हो, और Nino को सेटिंग्स › गोपनीयता व सुरक्षा › लोकल नेटवर्क वाले हिस्से में इजाज़त मिली हो। या PS5 का IP पता ख़ुद लिखें (PS5 में: Settings › Network, फिर Connection Status)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan PS5 benar-benar hidup (bukan mode istirahat), tersambung ke Wi-Fi yang sama, dan Nino sudah diberi izin Jaringan Lokal (lihat Pengaturan › Privasi & Keamanan). Bisa juga isi sendiri alamat IP PS5 (lihat di PS5: Setelan › Jaringan › Status Koneksi)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan PS5 hidup sepenuhnya (tidak dalam mod rehat), menggunakan Wi-Fi sama, dan Nino diberi kebenaran dalam Seting › Privasi & Keselamatan › Rangkaian Setempat. Ataupun taipkan sendiri alamat IP konsol itu (lihat di PS5, bahagian Settings › Network › Connection Status)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg dat de PS5 echt aan is (rustmodus is niet genoeg) en op jouw Wi-Fi zit, en dat Nino het lokale netwerk mag gebruiken (iPhone-instellingen › Privacy en beveiliging). Of typ zelf het IP-adres van je PS5 (op de console: Instellingen › Netwerk, dan Verbindingsstatus)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจดูว่า PS5 เปิดเต็มที่ (ไม่ใช่โหมดพัก) และต่อ Wi-Fi วงเดียวกันอยู่ และ Nino ได้รับสิทธิ์ใน การตั้งค่า › ความเป็นส่วนตัวและความปลอดภัย › เครือข่ายเฉพาะที่ หรือใส่ที่อยู่ IP ของ PS5 ด้วยตัวเอง (ดูบน PS5 ได้ที่ การตั้งค่า › เครือข่าย › สถานะการเชื่อมต่อ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'in tam olarak açık olduğundan (dinlenme modu yetmez) ve Wi-Fi'nize bağlı olduğundan, ayrıca iPhone Ayarları'nda Gizlilik ve Güvenlik bölümündeki Yerel Ağ izninin Nino'ya verildiğinden emin olun. İsterseniz PS5'in IP adresini elle de girebilirsiniz (PS5'te: Ayarlar › Ağ, oradan Bağlantı Durumu)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھیں کہ PS5 مکمل چالو ہو (ریسٹ موڈ میں نہ ہو)، اسی Wi-Fi پر ہو، اور Nino کو Settings › Privacy & Security کے Local Network حصے میں اجازت ملی ہو۔ یا PS5 کا IP پتہ خود لکھیں (PS5 میں: Settings › Network، پھر Connection Status)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra xem PS5 đã bật hẳn chưa (không phải chế độ nghỉ), có chung Wi-Fi không, và Nino có quyền ở mục Mạng cục bộ trong phần quyền riêng tư của Cài đặt chưa. Hoặc tự gõ IP của PS5 (xem trên PS5 tại Settings › Network › Connection Status)."
          }
        }
      }
    },

    "ob.p3.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع النصوص فوق اللعبة على التلفزيون، أو بحروف كبيرة في هاتفك. الإعداد يحتاج دقائق قليلة فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবটাইটেল দেখুন TV-তে গেমের ওপর, কিংবা ফোনে বড় অক্ষরে। সেটআপ সারতে কয়েক মিনিটই যথেষ্ট।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read subtitles laid over the TV picture, or big and clear on the phone itself. Setup only needs a few minutes."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makikita ang subtitle sa itaas ng laro sa TV, o malalaking titik sa telepono. Sandali lang ang pag-setup, ilang minuto lang."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबटाइटल टीवी पर खेल के ऊपर देखें, या फ़ोन पर बड़े अक्षरों में। सेटअप में बस कुछ ही मिनट लगेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan subtitle di atas gambar game pada TV, atau dalam huruf besar di ponsel. Penyiapannya cuma beberapa menit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat sari kata atas permainan di TV, ataupun dalam tulisan besar di telefon. Persediaan cuma beberapa minit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees de ondertitels over het tv-beeld heen, of groot op de telefoon zelf. Instellen duurt maar een paar minuten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูคำบรรยายทับเกมบนทีวี หรือเป็นตัวอักษรใหญ่บนโทรศัพท์ การตั้งค่าใช้เวลาเพียงไม่กี่นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazıları TV'de oyunun üzerinde veya telefonunuzda iri yazıyla izleyin. Kurulum yalnızca birkaç dakikanızı alır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب ٹائٹلز کو TV پر کھیل کے اوپر دیکھیں، یا فون پر بڑے حروف میں۔ سیٹ اپ میں بس چند منٹ لگیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem phụ đề phủ lên game trên TV, hoặc chữ to trên điện thoại. Chỉ vài phút là thiết lập xong."
          }
        }
      }
    },

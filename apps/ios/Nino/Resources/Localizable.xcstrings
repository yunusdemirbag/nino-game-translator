    "tvi.android.err.notapproved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُفض التصحيح على التلفزيون. جرّب ثانيةً واختر «سماح» على التلفزيون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV ডিবাগিং করতে দেয়নি। ফের চেষ্টা করুন, আর TV-তে Allow বাছুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV didn't permit debugging. Retry, and pick Allow once the TV prompts you."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pinahintulutan sa TV ang debugging. Subukan ulit at pindutin ang Payagan sa TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी ने डीबगिंग की इजाज़त नहीं दी। फिर आज़माएँ और टीवी पर “अनुमति दें” चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV tidak mengizinkan debugging. Ulangi, lalu pilih Izinkan di layar TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV tidak membenarkan penyahpepijatan. Cuba semula, kemudian pilih Benarkan di TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv stond foutopsporing niet toe. Probeer nog eens en kies Toestaan zodra de tv het vraagt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีไม่ได้อนุญาตการแก้ไขข้อบกพร่อง ลองอีกครั้งและเลือก อนุญาต บนทีวี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV hata ayıklamaya izin vermedi. Yeniden deneyin ve TV sorduğunda İzin ver'i seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV نے ڈیبگنگ کرنے نہیں دی۔ پھر آزمائیں اور TV پر «اجازت دیں» چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV chưa đồng ý cho gỡ lỗi. Thử lần nữa, rồi bấm Cho phép ngay trên TV."
          }
        }
      }
    },
    "tvi.android.err.notpaired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتعرّف التلفزيون على هذا الهاتف بعد. مع التصحيح اللاسلكي يلزم الاقتران أولًا: اختر “إقران الجهاز برمز الإقران” على التلفزيون، واكتب العنوان والرمز الظاهرين في تلك النافذة، ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV এই ফোনকে এখনো চেনে না। তারহীন ডিবাগিং হলে প্রথমে জোড়া লাগাতে হবে: TV-তে পেয়ারিং কোড দিয়ে যুক্ত করার অপশনটি খুলুন, ওই উইন্ডোর ঠিকানা আর কোড লিখে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone isn't known to the TV yet. For wireless debugging, pairing comes first: on the TV, pick “Pair device with pairing code”, then enter that window's address and code here and retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa nakikilala ng TV ang teleponong ito. Kapag wireless debugging, mag-pair muna: sa TV, piliin ninyo “Pair device with pairing code”, ilagay dito ang address pati ang code mula roon, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी ने यह फ़ोन अभी तक नहीं पहचाना। वायरलेस डीबगिंग में पहले पेयर करना ज़रूरी है: टीवी पर “पेयरिंग कोड से डिवाइस पेयर करें” चुनें, उस विंडो में दिखा पता और कोड यहाँ भरें, फिर आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV belum mengenal ponsel ini. Untuk debug nirkabel, sandingkan lebih dulu: pilih “Sambungkan perangkat dengan kode penyambungan” di TV, isi alamat serta kode yang terlihat pada jendela tersebut, kemudian coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV belum kenal telefon ini. Untuk penyahpepijatan wayarles, gandingkan dahulu: pilih “Gandingkan peranti dengan kod gandingan” pada TV, masukkan alamat dan kod tetingkap itu, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon is nog onbekend bij de tv. Bij draadloze foutopsporing moet je eerst koppelen: kies op je tv “Apparaat koppelen met koppelingscode”, neem adres en code uit dat scherm hier over en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวียังไม่รู้จักโทรศัพท์เครื่องนี้ หากใช้การแก้ไขข้อบกพร่องผ่าน Wi-Fi ให้จับคู่ก่อน: เลือก “จับคู่อุปกรณ์ด้วยรหัสการจับคู่” บนทีวี ป้อนที่อยู่และรหัสของหน้าต่างนั้น แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon TV'ye henüz tanıtılmadı. Kablosuz hata ayıklamada ilk adım eşlemedir: TV'deki “Cihazı eşleme kodu ile eşle” seçeneğine girin, o penceredeki adresle kodu buraya girip yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV نے یہ فون ابھی تک نہیں پہچانا۔ وائرلیس ڈیبگنگ میں پہلے جوڑنا ضروری ہے: TV پر “جوڑنے کے کوڈ سے آلہ جوڑیں” چنیں، اس ونڈو میں دکھا پتہ اور کوڈ لکھیں، پھر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV chưa nhận ra điện thoại. Khi gỡ lỗi qua Wi-Fi, bạn cần ghép đôi trước: trên TV mở mục ghép đôi bằng mã, gõ địa chỉ cùng mã trong cửa sổ đó vào đây, rồi thử lần nữa."
          }
        }
      }
    },
    "tvi.android.err.othercopy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة Nino TV على التلفزيون موقّعة بمفتاح آخر (استعملت الإصدارات حتى 0.9.18 مفتاحًا قديمًا) أو أنها أحدث مما في هذا الهاتف، فلا يمكن وضع هذا الإصدار مكانها. الزر بالأسفل يحذف نسخة التلفزيون ويضع الجديدة، وستُحذف إعدادات تطبيق التلفزيون. وإن لم ينجح ذلك، فاحذف التطبيق من التلفزيون (من الإعدادات افتح التطبيقات ثم Nino TV ثم إزالة)، ثم اضغط «ثبّت وافتح» هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র Nino TV-তে অন্য একটি কী-র সই আছে (0.9.18 অবধি সংস্করণে পুরোনো কী ছিল), নয়তো সেটি এই ফোনের সংস্করণের চেয়ে নতুন; তাই এটি ওপরে বসানো যাবে না। নিচের বোতাম TV-র কপিটা মুছে নতুনটা বসাবে; TV অ্যাপের সেটিংস হারিয়ে যাবে। তাতেও না হলে TV থেকে নিজেই সরিয়ে দিন (Settings খুলে Apps-এ Nino TV বেছে Uninstall চাপুন), এরপর এখানে ইনস্টল ও চালু-তে ট্যাপ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Nino TV installed there uses another signing key (versions through 0.9.18 had an old one) or is a newer version than this phone has, so it can't be overwritten. Tap the button below to delete the copy on your TV and put the new one in its place; all TV app settings will be lost. If that doesn't work, uninstall it by hand (TV Settings › Apps, then Nino TV, then Uninstall) and tap Install & open here."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibang key ang pumirma sa Nino TV na nasa TV (lumang key ang gamit ng mga bersyong hanggang 0.9.18), o mas bago iyon sa nasa teleponong ito, kaya hindi maipapatong ang bersyong ito. Buburahin ng button sa ilalim ang kopya ng TV at ilalagay ang bago; mabubura rin ang lahat ng setting ng app. Kapag hindi ito gumana, i-uninstall ito mismo (sa TV ninyo: Settings › Apps › Nino TV › Uninstall), pagkatapos ay pindutin dito ang button na I-install at buksan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी वाला Nino TV किसी और कुंजी से साइन किया गया है (0.9.18 तक के संस्करणों में पुरानी कुंजी थी), या फिर फ़ोन में रखे संस्करण से ज़्यादा नया है, इस कारण यह संस्करण उसकी जगह नहीं लग सकता। नीचे वाला बटन टीवी वाली कॉपी मिटाकर नई लगा देगा; टीवी ऐप की सारी सेटिंग्स साफ़ हो जाएँगी। यह न चले तो टीवी में ख़ुद हटाएँ (सेटिंग्स में ऐप्स, फिर Nino TV, फिर अनइंस्टॉल), उसके बाद यहाँ “इंस्टॉल करके खोलें” दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino TV yang ada di TV memakai tanda tangan kunci berbeda (versi sampai 0.9.18 memakai kunci lama) atau versinya lebih baru daripada milik ponsel ini, sehingga tidak bisa ditimpa. Tombol berikut akan menghapus versi yang ada di TV lalu memasang yang baru; setelan aplikasi TV ikut terhapus. Bila gagal, copot dari TV (Setelan › Aplikasi › Nino TV › Uninstal), lalu ketuk Instal & buka di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino TV di TV itu ditandatangani menggunakan kunci berlainan (versi hingga 0.9.18 memakai kunci lama) ataupun versinya lebih baharu berbanding versi di telefon ini, maka versi ini tidak boleh dipasang menindihnya. Butang di bawah akan membuang salinan pada TV lalu memasang versi baharu; semua tetapan dalam apl TV akan terpadam. Jika tidak berjaya, nyahpasangnya pada TV (Tetapan › Apl › Nino TV › Nyahpasang), kemudian ketik Pasang & buka di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Nino TV op je tv is met een ander certificaat getekend (tot en met 0.9.18 werd een oud certificaat gebruikt) of is een nieuwere versie dan die van deze telefoon, dus overschrijven lukt niet. Met de knop hieronder wis je de kopie op je tv en komt de nieuwe ervoor in de plaats; alle tv-app-instellingen gaan dan verloren. Werkt dat niet, haal de app dan zelf van de tv af (in de tv-instellingen: Apps, dan Nino TV, dan Verwijderen) en kies hier daarna Installeren en openen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino TV บนทีวีลงนามด้วยคีย์อื่น (เวอร์ชันถึง 0.9.18 ใช้คีย์เก่า) หรือใหม่กว่าตัวที่อยู่ในมือถือนี้ จึงลงเวอร์ชันนี้ทับไม่ได้ ปุ่มด้านล่างจะลบตัวบนทีวีแล้วลงตัวใหม่ให้ และการตั้งค่าของแอปบนทีวีจะหายไป ถ้ายังไม่ได้ ให้ถอนการติดตั้งที่ทีวีเอง (การตั้งค่า › แอป › เลือก Nino TV › ถอนการติดตั้ง) แล้วแตะ ติดตั้งแล้วเปิด ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de kurulu Nino TV farklı bir anahtarla imzalanmış (0.9.18 ve öncesi eski bir anahtarla geliyordu) veya bu telefondaki sürümden daha yeni; o yüzden üzerine yazılamıyor. Alttaki düğmeye dokunursanız TV'deki kopya silinir ve yerine yenisi kurulur; TV uygulamasındaki ayarlar sıfırlanır. İşe yaramazsa uygulamayı TV'den kendiniz kaldırın (TV'nin Ayarlar menüsünde Uygulamalar, sonra Nino TV, sonra Kaldır) ve buradan Yükle ve aç'a dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV والی Nino TV ایپ کسی دوسری کلید سے سائن کی گئی ہے (0.9.18 تک کے ورژنز میں پرانی کلید تھی) یا وہ اس فون والی سے نئی ہے، لہٰذا یہ ورژن اس کی جگہ نہیں لگ سکتا۔ نیچے کا بٹن TV والی کاپی مٹا کر نئی لگا دے گا؛ TV ایپ کی ترتیبات صاف ہو جائیں گی۔ یہ نہ چلے تو TV میں خود ہٹائیں (ترتیبات › ایپس › Nino TV › ان انسٹال)، پھر یہاں «انسٹال کر کے کھولیں» دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản Nino TV đang có trên TV dùng khóa ký khác (các bản tới 0.9.18 dùng một khóa cũ) hay mới hơn bản trong điện thoại, nên không cài chồng bản này lên được. Nút dưới đây sẽ xóa bản trên TV rồi cài bản mới; tùy chọn của app TV sẽ mất. Nếu vẫn không được, bạn tự gỡ app trên TV (trong Cài đặt, vào Ứng dụng, tìm Nino TV rồi bấm Gỡ cài đặt), xong chạm Cài đặt & mở ở đây."
          }
        }
      }
    },
    "tvi.android.err.pairing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاقتران: إما أن الرمز خاطئ وإما أن نافذة الاقتران على التلفزيون انغلقت. افتح النافذة ثانيةً، واكتب المنفذ والرمز الجديدين، ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জোড়া লাগল না: কোড ভুল ছিল, নয়তো TV-তে পেয়ারিংয়ের উইন্ডো আর খোলা নেই। উইন্ডোটা ফের খুলে নতুন কোড আর পোর্ট দিয়ে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing didn't work: either the code was incorrect or the TV's pairing window had closed. Reopen that window, type the fresh code plus port, and retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nag-pair: maling code, o sarado na sa TV ang pairing window. Buksan muli ang window, ilagay ang panibagong code at port, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयरिंग नहीं हुई: या तो कोड ग़लत था या टीवी पर पेयरिंग वाली विंडो बंद हो चुकी थी। विंडो दोबारा खोलें, नया कोड व पोर्ट भरें, और एक बार और आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyandingan gagal: kodenya keliru atau jendela penyandingan di TV telah ditutup. Buka jendela itu lagi, isi kode serta port terbaru, kemudian coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gandingan gagal: kod tidak betul ataupun tetingkap gandingan di TV sudah tertutup. Buka semula tetingkap itu, masukkan kod serta port yang baharu, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen is niet gelukt: de code klopte niet of het koppelscherm op de tv was al dicht. Open dat scherm nog eens, typ de verse code plus poort, en probeer nogmaals."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับคู่ไม่สำเร็จ: รหัสไม่ถูกต้องหรือหน้าต่างจับคู่บนทีวีปิดไปแล้ว เปิดหน้าต่างอีกครั้ง ป้อนรหัสและพอร์ตใหม่ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleme başarısız: kod hatalıydı veya TV'deki eşleme ekranı kapanmıştı. O ekranı tekrar açın, çıkan yeni kodla portu girin ve yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوڑا نہیں جا سکا: یا تو کوڈ غلط تھا یا TV پر جوڑنے کی ونڈو بند ہو چکی تھی۔ ونڈو پھر کھولیں، تازہ کوڈ اور پورٹ بھریں، اور ایک بار اور آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép đôi không thành: mã không đúng, hay cửa sổ ghép đôi trên TV bị đóng mất. Mở cửa sổ đó thêm lần nữa, gõ mã cùng cổng mới, sau đó thử lại."
          }
        }
      }
    },
    "tvi.android.err.playcopy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino على التلفزيون جاء من Google Play، ولا يمكن وضع هذا الإصدار مكانه. لا مانع من إبقاء نسخة Play؛ فـ Play يحدّثها لك. وإن أردت هذا الإصدار الآن، فالزر بالأسفل يحذف نسخة التلفزيون ويضع الجديدة (وستُحذف إعدادات تطبيق التلفزيون)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র Nino এসেছে Google Play থেকে, তাই এই সংস্করণ সেটির ওপর বসে না। চাইলে Play-এর সংস্করণই রাখুন; Play নিজেই সেটি হালনাগাদ রাখে। এখনই এই সংস্করণ চাইলে নিচের বোতাম TV-র কপিটা মুছে নতুনটা বসাবে (TV অ্যাপের সেটিংস হারিয়ে যাবে)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Nino on your TV came via Google Play, so this build can't replace it directly. Keeping the Play version is fine; Play keeps it up to date. If you'd rather install this build right away, the button below deletes the copy on your TV and puts this one in its place (all TV app settings will be lost)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Galing sa Play Store ang Nino na nasa TV, kaya hindi maipapatong dito ang bersyong ito. Puwedeng manatili ang Play version; ang Play ang mag-a-update nito. Kung gusto ninyong i-install ngayon ang bersyong ito, buburahin ng button sa ilalim ang kopya ng TV at ilalagay ang bago (mabubura rin ang lahat ng setting ng app)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी वाला Nino ऐप Google Play से आया है, और यह संस्करण उसकी जगह नहीं लग सकता। Play वाला ऐप रखना ठीक है; Play ख़ुद उसे ताज़ा रखता है। यह संस्करण अभी लगाना हो, तो नीचे वाला बटन टीवी वाली कॉपी मिटाकर नई लगा देगा (टीवी ऐप की सारी सेटिंग्स साफ़ हो जाएँगी)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino yang ada di TV berasal dari Google Play, sehingga versi ini tidak bisa ditimpakan. Versi Play boleh tetap dipakai; Play yang akan memperbaruinya. Kalau mau langsung memakai versi ini, tombol berikut akan menghapus versi yang ada di TV lalu memasang yang baru (setelan aplikasi TV ikut terhapus)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino di TV itu dipasang dari Google Play, maka versi ini tidak boleh dipasang menindihnya. Versi Play boleh dikekalkan; Play akan mengemas kininya sendiri. Jika mahu memasang versi ini kini, butang di bawah akan membuang salinan pada TV lalu memasang versi baharu (semua tetapan dalam apl TV akan terpadam)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Nino op je tv komt uit Google Play, dus deze build kan die niet zomaar vervangen. Prima als je de Play-versie houdt; Play houdt hem actueel. Wil je toch meteen deze build, dan wist de knop hieronder eerst de kopie op je tv en zet hij deze ervoor in de plaats (alle tv-app-instellingen gaan dan verloren)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino บนทีวีลงมาจาก Google Play จึงติดตั้งเวอร์ชันนี้ทับไม่ได้ จะใช้เวอร์ชัน Play ต่อไปก็ได้ เพราะ Play อัปเดตให้เอง ถ้าอยากลงเวอร์ชันนี้ตอนนี้ ปุ่มด้านล่างจะลบตัวบนทีวีแล้วลงตัวใหม่ให้ (การตั้งค่าของแอปบนทีวีจะหายไป)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nizdeki Nino, Google Play üzerinden yüklenmiş; bu derleme onun yerine doğrudan geçemiyor. Play sürümünü tutabilirsiniz; Play onu güncel tutar. Bu derlemeyi şimdi yüklemeyi tercih ederseniz alttaki düğme TV'deki kopyayı siler ve bunu yerine kurar (TV uygulamasındaki ayarlar sıfırlanır)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV والی Nino ایپ Google Play سے آئی ہے، لہٰذا یہ ورژن اس کی جگہ نہیں لگ سکتا۔ Play والی ایپ رکھنا ٹھیک ہے؛ Play خود اسے تازہ رکھتا ہے۔ اگر یہی ورژن ابھی لگانا ہو تو نیچے کا بٹن TV والی کاپی مٹا کر نئی لگا دے گا (TV ایپ کی ترتیبات صاف ہو جائیں گی)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản Nino đang có trên TV được tải từ Google Play, nên không cài chồng bản này lên được. Bạn cứ giữ bản Play cũng được; Play tự lo việc cập nhật. Còn nếu muốn dùng bản này luôn, nút dưới đây sẽ xóa bản trên TV rồi cài bản mới (tùy chọn của app TV sẽ mất)."
          }
        }
      }
    },
    "tvi.android.err.removemanually": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نستطع حذف النسخة القديمة من Nino TV على التلفزيون، فلا يمكن وضع الجديدة. احذفها من التلفزيون بنفسك: الإعدادات › التطبيقات › إظهار جميع التطبيقات › Nino TV › إزالة. بعدها اضغط «ثبّت وافتح» هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরোনো Nino TV মোছা যায়নি, তাই নতুনটা বসানো যাচ্ছে না। TV থেকে নিজেই সরিয়ে দিন: Settings খুলে Apps-এ See all apps, সেখান থেকে Nino TV বেছে Uninstall চাপুন। এরপর এখানে ইনস্টল ও চালু-তে ট্যাপ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino couldn't delete the previous Nino TV from your TV, so the update can't go on. Uninstall it by hand — in TV Settings › Apps, choose See all apps, pick Nino TV, then Uninstall. After that, tap Install & open here."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naalis ang dating Nino TV app, kaya hindi mailagay ang bago. Kayo na mismo ang mag-uninstall (sa TV ninyo: Settings › Apps › See all apps › Nino TV › Uninstall). Pagkatapos, pindutin dito ang button na I-install at buksan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी से पुराना Nino TV नहीं हट पाया, इस वजह से नया नहीं लग पा रहा। टीवी में ख़ुद हटाएँ: सेटिंग्स › ऐप्स › सारे ऐप्स, फिर Nino TV चुनकर अनइंस्टॉल करें। इसके बाद यहाँ “इंस्टॉल करके खोलें” दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino TV versi lama gagal dihapus dari TV, sehingga versi baru belum bisa dipasang. Copot sendiri di TV: Setelan › Aplikasi › Lihat semua aplikasi › Nino TV › Uninstal. Setelah itu ketuk Instal & buka di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino TV versi lama gagal dibuang daripada TV, maka versi baharu tidak boleh dipasang. Nyahpasangnya sendiri pada TV: Tetapan › Apl › Lihat semua apl › Nino TV › Nyahpasang. Kemudian ketik Pasang & buka di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino kreeg de vorige Nino TV niet van je tv af, dus de update kan niet verder. Haal hem met de hand weg: open in de tv-instellingen Apps, kies Alle apps bekijken, dan Nino TV en dan Verwijderen. Kies hier daarna Installeren en openen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ Nino TV ตัวเก่าออกจากทีวีไม่ได้ จึงลงตัวใหม่ไม่ได้ ให้ถอนการติดตั้งที่ทีวีเอง: การตั้งค่า › แอป › ดูแอปทั้งหมด › เลือก Nino TV › ถอนการติดตั้ง แล้วแตะ ติดตั้งแล้วเปิด ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki Nino TV, TV'nizden silinemedi; bu nedenle güncelleme kurulamıyor. Onu TV'de elle kaldırın: Ayarlar'da Uygulamalar'a, oradan Tüm uygulamalar'a girin, Nino TV'yi seçip Kaldır'a basın. Ardından buradan Yükle ve aç'a dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV سے پرانی Nino TV نہیں ہٹ سکی، اس وجہ سے نئی نہیں لگ پا رہی۔ TV میں خود ہٹائیں: ترتیبات › ایپس › ساری ایپس › Nino TV › ان انسٹال۔ اس کے بعد یہاں «انسٹال کر کے کھولیں» دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xóa được bản Nino TV cũ trên TV, nên bản mới không cài vào được. Bạn tự gỡ nó trên TV nhé: trong Cài đặt, mở Ứng dụng › Xem mọi ứng dụng, tìm Nino TV rồi bấm Gỡ cài đặt. Xong chạm Cài đặt & mở ở đây."
          }
        }
      }
    },
    "tvi.android.err.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجيب التلفزيون. تحقّق أنه شغّال ومتصل بشبكة Wi-Fi ذاتها مع هذا الهاتف، وأن التصحيح مُفعّل من خيارات المطوّر فيه. مع التصحيح اللاسلكي يتبدّل رقم المنفذ كل مرة؛ اكتب الرقم الذي تراه على الشاشة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV সাড়া দিল না। সেটি চালু কিনা, এই ফোনের Wi-Fi-তেই কিনা, আর ডেভেলপার অপশনে ডিবাগিং অন কিনা দেখে নিন। ওয়্যারলেস ডিবাগিংয়ে পোর্ট প্রতিবার পাল্টায়; পর্দায় যেটা দেখাচ্ছে সেটাই লিখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reply from the TV. Check that it's switched on, shares this phone's Wi-Fi, and has debugging enabled under Developer options. For wireless debugging, its port number is different every time, so type the current one from the screen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang tugon mula sa TV. Siguraduhing bukas ito at iisa ang Wi-Fi nito at ng telepono, at naka-enable ang debugging (nasa developer options). Kapag wireless debugging, iba-iba ang port tuwing bubuksan; i-type ang nakikita sa screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी की तरफ़ से जवाब नहीं आया। देखें कि वह ऑन हो, उसी Wi-Fi से जुड़ा हो जिस पर यह फ़ोन है, और डेवलपर ऑप्शन में डीबगिंग ऑन हो। बिना तार वाली डीबगिंग में पोर्ट नंबर हर दफ़ा नया होता है; जो स्क्रीन पर दिखे वही लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV tidak menjawab. Cek apakah TV hidup dan memakai Wi-Fi yang sama seperti ponsel ini, serta debugging sudah dinyalakan dalam opsi pengembang. Pada debug nirkabel, port selalu berganti; masukkan port yang sedang terlihat di layar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV tidak memberi jawapan. Pastikan TV hidup dan menggunakan Wi-Fi sama seperti telefon ini, serta penyahpepijatan diaktifkan dalam pilihan pembangun. Bagi penyahpepijatan wayarles, port bertukar setiap kali; masukkan port yang tertera di skrin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen reactie van de tv. Kijk of hij is ingeschakeld, dezelfde Wi-Fi als deze telefoon gebruikt en of foutopsporing is ingeschakeld bij Ontwikkelaarsopties. Draadloos verandert de poort telkens, dus neem de poort over die nu in beeld staat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีไม่ตอบสนอง ตรวจสอบว่าทีวีเปิดอยู่และใช้ Wi-Fi เดียวกับโทรศัพท์เครื่องนี้ และเปิดการแก้ไขข้อบกพร่องในตัวเลือกสำหรับนักพัฒนาแล้ว หากใช้การแก้ไขข้อบกพร่องผ่าน Wi-Fi พอร์ตจะเปลี่ยนทุกครั้ง ให้ป้อนพอร์ตที่แสดงบนหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'den cevap gelmedi. TV'nin açık olduğunu, telefonunuzla aynı Wi-Fi'ı kullandığını ve Geliştirici seçenekleri altında hata ayıklamanın etkin olduğunu doğrulayın. Kablosuz modda port numarası her defasında farklıdır; ekranda o an yazanı girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV کی طرف سے جواب نہیں آیا۔ دیکھیں کہ وہ چالو ہو، اسی Wi-Fi سے جڑا ہو جس پر یہ فون ہے، اور ڈیولپر آپشنز کے اندر ڈیبگنگ چالو ہو۔ بغیر تار والی ڈیبگنگ میں پورٹ نمبر ہر دفعہ نیا ہوتا ہے؛ جو اسکرین پر دکھے وہی لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV không đáp lại. Xem TV đã bật chưa, có chung Wi-Fi với máy này không, và đã bật gỡ lỗi ở phần tùy chọn lập trình viên chưa. Khi gỡ lỗi qua Wi-Fi, mỗi lần cổng một khác; hãy gõ đúng cổng đang hiện."
          }
        }
      }
    },
    "tvi.android.list": {

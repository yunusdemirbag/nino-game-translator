    "subtitle.position.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك المنزلق لترى ترجمة تجريبية على التلفزيون. وعند اختيار «ثابت»، يحرّك زرّا ▲ و▼ في ريموت التلفزيون الترجمة كذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্লাইডার ছেড়ে দিলেই TV-র পর্দায় নমুনা সাবটাইটেল ভেসে উঠবে। স্থির বাছলে TV রিমোটের ▲ আর ▼ বোতামেও সাবটাইটেল সরে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the slider to preview a subtitle on your TV. When Fixed is chosen, the TV remote's ▲ and ▼ keys also move the subtitles."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitawan ang slider para makita sa TV ang isang halimbawang subtitle. Kapag Nakapirmi ang pinili, naigagalaw din ang subtitle ng ▲ at ▼ sa remote control."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लाइडर छोड़ें तो टीवी पर नमूने का सबटाइटल दिखेगा। “स्थिर” चुना हो, तो टीवी रिमोट के ▲ व ▼ बटन दबाकर भी सबटाइटल ऊपर-नीचे होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepas penggeser untuk melihat subtitle contoh di TV. Saat Tetap dipilih, subtitle juga bisa dipindah lewat remote TV memakai ▲ dan ▼."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepaskan peluncur untuk melihat contoh sari kata di TV. Apabila Tetap dipilih, butang ▲ dan ▼ di alat kawalan jauh juga mengalihkan sari kata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de schuifregelaar los voor een proefondertitel op je tv. Staat Vast aan, dan schuiven ▲ en ▼ van de afstandsbediening de ondertitels ook."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปล่อยแถบเลื่อนเพื่อดูคำบรรยายตัวอย่างบนทีวี เมื่อเลือก “คงที่” คุณยังใช้ปุ่ม ▲ และ ▼ บนรีโมททีวีเลื่อนคำบรรยายได้ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırıcıyı bıraktığınızda TV'de bir örnek altyazı belirir. Sabit seçiliyken altyazıyı TV kumandasındaki ▲ ve ▼ tuşlarıyla da kaydırabilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلائیڈر چھوڑیں تو TV پر نمونے کا سب ٹائٹل نظر آئے گا۔ «مقررہ» چنا ہو تو TV کے ریموٹ پر ▲ اور ▼ بٹن دبا کر بھی سب ٹائٹلز اوپر نیچے ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buông thanh trượt ra để xem phụ đề thử trên TV. Khi đang chọn Cố định, nút ▲ và ▼ trên remote TV cũng dời được phụ đề."
          }
        }
      }
    },

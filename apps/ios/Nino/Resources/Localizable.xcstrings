    },
    "ps5.reason.passcode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب محمي برمز دخول على PS5. أدخل الرمز في الإعدادات، أو أوقف رمز هذا الحساب من الجهاز نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এ এই অ্যাকাউন্টে লগইন পাসকোড চালু আছে। পাসকোডটি সেটিংসে লিখুন, অথবা কনসোলে গিয়ে এই অ্যাকাউন্টের পাসকোড তুলে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has a sign-in passcode on the PS5. Enter it in Settings, or turn the passcode off for this account on the console."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May login passcode ang account na ito sa PS5. Ilagay ito sa Settings, o alisin ang passcode ng account sa console mismo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 पर इस खाते में लॉगिन पासकोड लगा है। पासकोड सेटिंग्स में डालें, या कंसोल पर इस खाते का पासकोड बंद कर दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini dilindungi kode sandi login di PS5. Masukkan kodenya di Pengaturan, atau nonaktifkan kode akun ini langsung di konsol."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini dilindungi kod laluan masuk pada PS5. Masukkan kod itu dalam Tetapan, atau matikan kod akaun ini terus di konsol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account heeft een inlogcode op de PS5. Voer die in bij Instellingen, of zet de code voor dit account uit op de console."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้ตั้งรหัสผ่านเข้าสู่ระบบไว้บน PS5 กรอกรหัสในการตั้งค่า หรือยกเลิกรหัสของบัญชีนี้ที่ตัวเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap PS5'te giriş şifresiyle korunuyor. Şifreyi Ayarlar'a yazın ya da konsolda bu hesabın şifresini kapatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 پر اس اکاؤنٹ کا لاگ اِن پاس کوڈ لگا ہے۔ پاس کوڈ ترتیبات میں درج کریں، یا کنسول پر اس اکاؤنٹ کا پاس کوڈ بند کر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này có mật mã đăng nhập trên PS5. Nhập mật mã vào Cài đặt, hoặc tắt mật mã của tài khoản này ngay trên máy."
          }
        }
      }
    },
    "ps5.reason.passcodeWrong": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل PS5 رمز الدخول الموجود في الإعدادات. صحّح الرمز، أو أوقف رمز هذا الحساب من الجهاز نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসের লগইন পাসকোডটি PS5 গ্রহণ করেনি। পাসকোডটি ঠিক করুন, অথবা কনসোলে গিয়ে এই অ্যাকাউন্টের পাসকোড তুলে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 didn't accept the sign-in passcode in Settings. Correct it, or turn the passcode off for this account on the console."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tinanggap ng PS5 ang login passcode na nasa Settings. Ayusin ito, o alisin ang passcode ng account sa console mismo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स वाला लॉगिन पासकोड PS5 ने स्वीकार नहीं किया। पासकोड ठीक करें, या कंसोल पर इस खाते का पासकोड बंद कर दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak menerima kode sandi login yang ada di Pengaturan. Betulkan kodenya, atau nonaktifkan kode akun ini langsung di konsol."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak menerima kod laluan masuk yang ada dalam Tetapan. Betulkan kod itu, atau matikan kod akaun ini terus di konsol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 accepteerde de inlogcode uit Instellingen niet. Pas hem aan, of zet de code voor dit account uit op de console."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่รับรหัสผ่านเข้าสู่ระบบที่อยู่ในการตั้งค่า แก้รหัสให้ถูก หรือยกเลิกรหัสของบัญชีนี้ที่ตัวเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, Ayarlar'daki giriş şifresini kabul etmedi. Şifreyi düzeltin ya da konsolda bu hesabın şifresini kapatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیبات والا لاگ اِن پاس کوڈ PS5 نے قبول نہیں کیا۔ پاس کوڈ درست کریں، یا کنسول پر اس اکاؤنٹ کا پاس کوڈ بند کر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không nhận mật mã đăng nhập trong Cài đặt. Sửa lại mật mã, hoặc tắt mật mã của tài khoản này ngay trên máy."
          }
        }
      }
    },

    "passcode.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يلزم إلا إذا كان الحساب الثاني يطلب رمزًا عند الدخول على PS5. يكتبه Nino كلما طلبه PS5، ويحفظه في سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্বিতীয় অ্যাকাউন্টে PS5-এ লগইন পাসকোড থাকলে তবেই এটা লাগবে। PS5 চাওয়ামাত্র Nino নিজেই সেটি বসিয়ে দেয়, আর Keychain-এ রেখে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed only if the extra account has a sign-in passcode on its PS5. Nino fills it in each time the console asks and keeps it in the Keychain."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan lang ito kapag gumagamit ng login passcode ang ikalawang account pagbukas sa PS5. Si Nino ang magta-type nito tuwing hihingin ng PS5, at nakatago ito sa Keychain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह तभी चाहिए जब दूसरा खाता PS5 में लॉगिन के लिए पासकोड रखता हो। PS5 जब भी माँगे, Nino ख़ुद लिख देता है और इसे कीचेन में रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya perlu bila akun kedua memakai kode sandi login di PS5. Nino akan mengetikkannya tiap kali PS5 meminta, dan menyimpannya di Rantai Kunci."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan hanya jika akaun kedua memakai kod laluan masuk di PS5. Nino menaipkannya tiap kali PS5 memintanya, dan menyimpannya dalam Rantai Kunci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen nodig wanneer dat tweede account een inlogcode op de PS5 heeft. Nino vult die code in zodra de console erom vraagt en bewaart hem in de sleutelhanger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นเฉพาะเมื่อบัญชีที่สองใช้รหัสผ่านเข้าสู่ระบบบน PS5 Nino จะพิมพ์ให้ทุกครั้งที่ PS5 ถาม และเก็บไว้ในพวงกุญแจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece ikinci hesap PS5'te bir giriş şifresi kullanıyorsa gerekir. Konsol her istediğinde Nino bu şifreyi kendisi girer ve Anahtar Zinciri'nde saklar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ تبھی چاہیے جب دوسرا اکاؤنٹ PS5 میں لاگ اِن کے لیے پاس کوڈ رکھتا ہو۔ PS5 جب بھی مانگے، Nino خود لکھ دیتا ہے اور اسے Keychain میں رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng khi tài khoản phụ được đặt mật mã để đăng nhập PS5. Mỗi lần PS5 hỏi, Nino sẽ tự gõ vào; mật mã được giữ trong Chuỗi khóa."
          }
        }
      }
    },

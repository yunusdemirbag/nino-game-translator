    "tvi.android.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع Nino TV على تلفزيون Google TV / Android TV مباشرةً من هاتفك هذا، بلا حاجة إلى حاسوب. ينبغي أن يتصل الهاتف والتلفزيون بشبكة Wi-Fi واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটার লাগবে না: এই ফোন থেকেই Nino TV অ্যাপটি Android TV কিংবা Google TV-তে বসিয়ে দেয়। ফোন আর TV, দুটোই এক Wi-Fi-তে থাকা চাই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs Nino's TV app straight onto your Google TV or Android TV set, using only this phone — no computer required. The phone and TV need to share one Wi-Fi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Diretsong ini-install ng teleponong ito ang TV app ng Nino sa inyong Android TV o kaya Google TV, kahit walang computer. Kailangang nasa iisang Wi-Fi ang telepono at TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Nino TV ऐप सीधे इसी फ़ोन से Google TV / Android TV पर डाल देता है, कंप्यूटर नहीं चाहिए। फ़ोन और टीवी दोनों एक ही Wi-Fi से जुड़े हों।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang aplikasi TV Nino ke Android TV maupun Google TV langsung lewat ponsel ini, komputer tidak diperlukan. Ponsel serta TV wajib tersambung ke Wi-Fi yang sama."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang apl Nino TV ke Android TV ataupun Google TV anda terus dari telefon ini, komputer tidak diperlukan. Telefon serta TV perlu menggunakan Wi-Fi sama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeert Nino's tv-app direct vanaf deze telefoon op je Google TV of Android TV; een computer is niet nodig. Telefoon en tv moeten hetzelfde Wi-Fi-netwerk delen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงแอป Nino TV ให้ทีวีระบบ Android TV หรือทีวี Google TV ได้จากมือถือเครื่องนี้โดยตรง ไม่ต้องพึ่งคอมพิวเตอร์ มือถือกับทีวีต้องต่อ Wi-Fi วงเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun TV uygulamasını doğrudan bu telefondan, bilgisayarsız olarak Android TV veya Google TV'nize yükler. Telefon ile TV'nin aynı Wi-Fi'a bağlı olması gerekir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Nino TV ایپ سیدھا اسی فون سے Google TV / Android TV میں ڈال دیتا ہے، کمپیوٹر درکار نہیں۔ فون اور TV دونوں ایک ہی Wi-Fi سے جڑے ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài app Nino TV vào Android TV hay Google TV thẳng từ điện thoại, khỏi cần dùng máy tính. Cả hai máy đều phải chung một Wi-Fi."
          }
        }
      }
    },
    "tvi.android.debug.off": {
      "extractionState": "manual",
      "localizations": {

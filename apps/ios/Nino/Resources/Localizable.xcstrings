    "ip.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان IP غير صحيح. اكتبه هكذا 192.168.1.20، بلا http:// وبلا رقم منفذ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "IP ঠিকানাটি সঠিক নয়। 192.168.1.20 আকারে লিখুন, http:// ও পোর্ট নম্বর বাদ দিয়ে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That IP address isn't valid. Enter it in the form 192.168.1.20, leaving out http:// and any port number."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi wasto ang IP address na iyon. Ilagay ito sa anyong 192.168.1.20, nang walang http:// at port number."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह IP पता सही नहीं। इसे ऐसे लिखें: 192.168.1.20, http:// और पोर्ट नंबर छोड़कर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat IP itu tidak valid. Masukkan dalam bentuk 192.168.1.20, tanpa http:// dan nomor port."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat IP itu tidak sah. Masukkan dalam bentuk 192.168.1.20, tanpa http:// dan nombor port."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat IP-adres is ongeldig. Voer het in als 192.168.1.20, zonder http:// en zonder poortnummer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่ IP นี้ไม่ถูกต้อง โปรดป้อนในรูปแบบ 192.168.1.20 โดยไม่ต้องใส่ http:// และหมายเลขพอร์ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu IP adresi geçersiz. 192.168.1.20 biçiminde girin; başına http:// ya da sonuna port eklemeyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ IP پتہ ٹھیک نہیں۔ اسے یوں لکھیں: 192.168.1.20، http:// اور پورٹ نمبر چھوڑ کر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ IP này sai định dạng. Hãy gõ giống 192.168.1.20, bỏ http:// và số cổng."
          }
        }
      }
    },

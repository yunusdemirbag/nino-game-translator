    "pair.code.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي صلاحية الرموز بعد 5 دقائق. إذا فشل الإقران، فسترى السبب هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোডের মেয়াদ ৫ মিনিটে শেষ হয়। পেয়ারিং ব্যর্থ হলে কারণটি এখানেই দেখবেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes expire after 5 minutes. If pairing fails, you'll see why right here."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-e-expire ang code makalipas ang 5 minuto. Kung pumalya ang pag-pair, makikita ninyo rito ang dahilan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड 5 मिनट में बेकार हो जाते हैं। पेयरिंग न हो पाए तो वजह इसी जगह दिखेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode kedaluwarsa setelah 5 menit. Jika pemasangan gagal, alasannya akan tampil di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod tamat tempoh selepas 5 minit. Jika pemasangan gagal, anda akan melihat sebabnya di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes verlopen na 5 minuten. Mislukt het koppelen, dan zie je hier waarom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสจะหมดอายุภายใน 5 นาที หากจับคู่ไม่สำเร็จ สาเหตุจะแสดงตรงนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun süresi 5 dakikada dolar. Eşleştirme başarısız olursa nedeni burada yazar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوڈ 5 منٹ بعد ختم ہو جاتے ہیں۔ اگر جوڑنا ناکام ہو تو وجہ یہیں نظر آئے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã hết hạn sau 5 phút. Nếu ghép nối không thành công, lý do sẽ hiện ngay tại đây."
          }
        }
      }
    },
    "pair.connecting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري الاتصال مع PS5… امنحه ما يصل إلى 30 ثانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এ যুক্ত হচ্ছে… ৩০ সেকেন্ড অবধি সময় নিতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaching the PS5… Give it as long as 30 seconds."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumokonekta sa PS5… Maaaring umabot nang 30 segundo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 से जुड़ रहा है… ज़्यादा से ज़्यादा 30 सेकंड लगेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyambung ke PS5… Tunggu maksimal 30 detik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyambung ke PS5… Tunggu sehingga 30 saat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezig met verbinden met PS5… Duurt hooguit een halve minuut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเชื่อมกับ PS5… อาจนานได้ถึง 30 วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'e bağlanılıyor… 30 saniye kadar sürebilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 سے رابطہ ہو رہا ہے… زیادہ سے زیادہ 30 سیکنڈ لگیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kết nối PS5… Chờ tối đa 30 giây."
          }
        }
      }
    },
    "pair.error.badcode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض PS5 هذا الرمز. عُد إلى «إقران الجهاز» على PS5 واكتب الرمز الجديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 কোডটি মানেনি। PS5-এ ফের Pair Device চালু করে নতুন কোডটা দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 rejected that code. Reopen Pair Device on the console and type the fresh code."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pumasa sa PS5 ang inyong code. Buksan ulit sa PS5 ang Pair Device, saka i-type ang panibagong code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ने यह कोड नहीं माना। PS5 में Pair Device दोबारा खोलकर नया कोड लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode ditolak oleh PS5. Buka Pasangkan Perangkat di PS5 sekali lagi dan masukkan kode yang baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod ditolak oleh PS5. Buka Pair Device di PS5 sekali lagi, kemudian taipkan kod yang baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 wees die code af. Open Apparaat koppelen nog een keer op de console en typ de verse code."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่รับรหัสนี้ ให้เปิดเมนู “จับคู่อุปกรณ์” บนเครื่อง PS5 ใหม่อีกรอบ แล้วใส่รหัสที่ได้ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 kodu reddetti. Cihazı Eşleştir ekranını PS5'te tekrar açın ve yeni çıkan kodu girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 نے یہ کوڈ نہیں مانا۔ PS5 میں Pair Device پھر سے کھول کر نیا کوڈ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 từ chối mã này. Mở Pair Device trên PS5 thêm lần nữa và gõ mã mới vào."
          }
        }
      }
    },
    "pair.error.codelength": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل أرقام الرمز الثمانية كلها."
          }

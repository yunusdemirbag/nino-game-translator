            "value": "Paket baru terunduh otomatis, gratis"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek baharu dimuat turun sendiri, secara percuma"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe pakketten worden vanzelf en gratis gedownload"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพ็กใหม่ดาวน์โหลดเองโดยอัตโนมัติ ฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni paketler ücretsiz ve kendi kendine iner"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئے پیکس خود بخود، بغیر کسی قیمت کے ڈاؤن لوڈ ہوتے ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói mới tự tải xuống, không mất phí"
          }
        }
      }
    },
    "pair.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعمل الحساب الثاني على PS5، وافتح الإعدادات ثم النظام ثم التشغيل عن بُعد ثم «إقران الجهاز»، ثم اكتب الرمز الذي يظهر هناك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এ দ্বিতীয় অ্যাকাউন্টে থেকে Settings › System খুলে Remote Play-এর Pair Device-এ যান, তারপর পর্দায় যে কোড আসে সেটি লিখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the PS5, using the second account, open Settings, then System, then Remote Play, then Pair Device. Type in the code you see."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa PS5, habang naka-sign in ang ikalawang account, Settings › System › Remote Play › Pair Device ang buksan, tapos i-type dito ang lalabas na code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 पर दूसरा खाता खोलकर Settings › System में जाएँ, फिर Remote Play के अंदर Pair Device, और वहाँ दिखने वाला कोड लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di PS5, memakai akun kedua, buka Setelan › Sistem › Remote Play, pilih Pasangkan Perangkat, kemudian masukkan kode yang muncul."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan akaun kedua di PS5, buka menu Settings › System › Remote Play › Pair Device, kemudian taipkan kod yang muncul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open op de console, ingelogd met dat tweede account, eerst Instellingen, dan Systeem, dan Remote Play, dan Apparaat koppelen. Typ de code over die je ziet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน PS5 ให้ใช้บัญชีที่สองไปที่ การตั้งค่า › ระบบ › การเล่นระยะไกล › จับคู่อุปกรณ์ แล้วป้อนรหัสที่แสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'te ikinci hesapla oturum açıkken Ayarlar, sonra Sistem, sonra Uzaktan Oynatma, sonra Cihazı Eşleştir'i açın. Gördüğünüz kodu girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 پر دوسرا اکاؤنٹ کھول کر Settings › System میں جائیں، پھر Remote Play کے اندر Pair Device، اور وہاں نظر آنے والا کوڈ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên PS5, dùng tài khoản phụ, vào Settings › System › mục Remote Play › Pair Device, rồi nhập mã xuất hiện trên đó."
          }
        }
      }
    },

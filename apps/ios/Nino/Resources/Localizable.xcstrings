    "tvi.step.pairing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الاقتران بالتلفزيون…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র সঙ্গে পেয়ার করা হচ্ছে…"

    "translate.error.unsupportedlang": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه اللغة لم تصل بعد إلى ترجمة Apple بلا مقابل. اختر ترجمة بالذكاء الاصطناعي في الإعدادات › الترجمة، فـ Gemini لا يكلّف شيئًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভাষাটি এখনো Apple-এর বিনামূল্যের অনুবাদে নেই। সেটিংস › অনুবাদ-এ গিয়ে AI অনুবাদে যান; Gemini বিনামূল্যে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This language isn't in Apple's free translation yet. Pick AI translation under Settings › Translation — Gemini costs nothing."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pa ang wikang ito sa libreng pagsasalin ng Apple. Lumipat sa AI: Mga Setting › Pagsasalin. Walang bayad ang Gemini."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह भाषा Apple वाले निःशुल्क अनुवाद में अभी नहीं आई। सेटिंग्स › अनुवाद पर जाकर AI अनुवाद चुनें; Gemini का कोई ख़र्च नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa ini belum didukung terjemahan gratis Apple. Ganti ke terjemahan AI lewat Pengaturan › Terjemahan; Gemini tidak berbayar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa ini belum tersedia dalam terjemahan percuma Apple. Tukar kepada terjemahan AI dalam Seting › Terjemahan; Gemini tidak berbayar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's gratis vertaling biedt die taal nog niet. Kies AI-vertaling onder Instellingen › Vertaling — Gemini kost niets."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบแปลฟรีของ Apple ยังไม่รองรับภาษานี้ เปลี่ยนไปใช้การแปลด้วย AI ได้ใน การตั้งค่า › การแปล ซึ่ง Gemini ใช้ฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dil Apple'ın ücretsiz çevirisinde şimdilik bulunmuyor. Ayarlar › Çeviri bölümünden yapay zekâ çevirisini seçin; Gemini ücretsizdir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ زبان Apple والے مفت ترجمے میں ابھی نہیں آئی۔ ترتیبات › ترجمہ میں جا کر AI ترجمہ چنیں؛ Gemini کا کوئی خرچ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dịch free của Apple hiện chưa có ngôn ngữ này. Vào Cài đặt › Dịch để đổi sang dịch bằng AI; dùng Gemini thì không tốn tiền."
          }
        }
      }
    },
    "tv.error.connect": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من الاتصال بالتلفزيون. وافق على الطلب الذي يظهر عليه، ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে যুক্ত হওয়া গেল না। TV-র পর্দায় আসা অনুরোধটি মেনে নিয়ে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino couldn't reach the TV. Please accept the prompt that pops up on your TV, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nakakonekta sa TV. Aprubahan ang hiling na lumabas sa TV, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी से जुड़ नहीं पाए। टीवी पर आया अनुरोध स्वीकार करें, फिर एक बार और आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat tersambung ke TV. Setujui permintaan yang muncul di TV, lalu coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV gagal disambungkan. Luluskan permintaan yang muncul di TV, kemudian cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact met de tv lukt niet. Accepteer de vraag die de tv toont en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อทีวีไม่ได้ โปรดอนุมัติคำขอที่แสดงบนทีวี แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV ile bağlantı kurulamadı. TV'de çıkan isteği kabul edip bir kez daha deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV سے جڑ نہیں سکے۔ TV پر آئی درخواست قبول کریں، پھر ایک بار اور آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa kết nối tới TV được. Bạn đồng ý yêu cầu đang hiện trên TV, rồi thử thêm lần nữa."
          }
        }
      }
    },

    "settings.speaker.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى اسم الشخصية في بداية السطر (ARTHUR: …). لا تُترجم الأسماء أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইনের গোড়ায় চরিত্রের নাম থেকে যায় (ARTHUR: …)। নামের অনুবাদ হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The character's name stays at the start of the line (ARTHUR: …). Names are never translated."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa simula ng linya ang pangalan ng tauhan (ARTHUR: …). Hindi isinasalin kailanman ang mga pangalan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किरदार का नाम पंक्ति के शुरू में रहता है (ARTHUR: …)। किसी नाम का अनुवाद कभी नहीं होता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama karakter tetap di awal baris (ARTHUR: …). Nama tidak pernah diterjemahkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama watak kekal di awal baris (ARTHUR: …). Nama tidak pernah diterjemahkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam van wie er praat blijft vooraan de regel staan (ARTHUR: …). Namen worden nooit vertaald."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อตัวละครจะอยู่ต้นบรรทัด (ARTHUR: …) ชื่อจะไม่ถูกแปลเด็ดขาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırın başında karakterin adı durur (ARTHUR: …). Adlar asla çevrilmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کردار کا نام لائن کے شروع میں رہتا ہے (ARTHUR: …)۔ نام کبھی ترجمہ نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên nhân vật được giữ ở đầu câu (ARTHUR: …). Tên riêng luôn được giữ nguyên."
          }
        }
      }
    },
    "settings.stack.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن أوقفت هذا الخيار، يأخذ كل سطر جديد مكان الذي قبله. يحتاج تطبيق التلفزيون 0.9.16 أو أحدث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটা অফ থাকলে নতুন লাইন এসে আগের লাইনটা সরিয়ে দেয়। এর জন্য TV-র অ্যাপে 0.9.16 বা তার পরের সংস্করণ চাই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this off, every new line takes over from the line before. Needs version 0.9.16 or later of the TV app."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naka-off, ang bawat panibagong linya ang papalit sa nauna. Kailangan ang bersyong 0.9.16 pataas ng TV app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बंद हो तो हर नई पंक्ति पुरानी को हटाकर उसकी जगह आती है। इसके लिए टीवी ऐप का 0.9.16 या नया संस्करण चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila dimatikan, tiap baris baru akan menimpa baris terakhir. Butuh aplikasi TV versi 0.9.16 ke atas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ini dimatikan, baris baharu akan mengambil tempat baris terdahulu. Perlu apl TV 0.9.16 ke atas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat dit uit, dan komt elke nieuwe regel in plaats van de regel ervoor. Werkt vanaf versie 0.9.16 van de tv-app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดไว้ บรรทัดใหม่แต่ละบรรทัดจะแทนที่บรรทัดก่อนหน้า ต้องใช้แอปทีวี 0.9.16 ขึ้นไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kapalı olduğunda her yeni satır bir öncekinin yerine geçer. TV uygulamasının 0.9.16 ya da daha yeni sürümünü ister."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ بند ہو تو ہر نئی لائن پرانی لائن کو ہٹا کر اس کی جگہ آتی ہے۔ اس کے لیے TV ایپ کا ورژن 0.9.16 یا اس سے نیا چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, dòng mới sẽ đè lên chỗ của dòng cũ. Yêu cầu ứng dụng TV bản 0.9.16 hoặc mới hơn."
          }
        }
      }
    },
    "settings.stack.lines": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الحوار السريع، اترك الأسطر السابقة ظاهرة في الأعلى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত কথোপকথনে আগের লাইনগুলো উপরে জমা রাখুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stack earlier lines on top in quick dialogue"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa mabilis na usapan, ipatong sa ibabaw ang mga linyang nauna"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तेज़ संवाद में पिछली पंक्तियाँ ऊपर रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat dialog cepat, tumpuk baris lama di bagian atas"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun baris terdahulu di bahagian atas semasa dialog laju"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere regels bovenaan stapelen bij snelle dialogen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ้อนบรรทัดก่อนหน้าไว้ด้านบนเมื่อบทสนทนาเร็ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

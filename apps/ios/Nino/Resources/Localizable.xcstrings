    "settings.target.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فوق اللعبة على التلفزيون، أو في هذا الهاتف. اضغط لتبدّل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে গেমের ওপর, কিংবা এই ফোনে। পাল্টাতে ট্যাপ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the TV picture, or here on the phone. Tap to switch."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakapatong sa laro sa TV, o dito sa telepono. I-tap para palitan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी पर खेल के ऊपर, या फिर इसी फ़ोन में। टैप करके बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menimpa game pada TV, atau tampil di ponsel ini. Ganti dengan mengetuknya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atas permainan di TV, ataupun di telefon ini. Ketik jika mahu menukar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de tv boven het spel, of hier op de telefoon. Tik om te veranderen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนเกมในทีวี หรือบนโทรศัพท์เครื่องนี้ แตะเพื่อสลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazı TV'de oyunun üzerinde veya bu telefonda görünür. Değiştirmek için dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV پر کھیل کے اوپر، یا اسی فون پر۔ بدلنا ہو تو تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phủ lên game trên TV, hoặc ngay trên máy này. Chạm để đổi."
          }
        }
      }
    },

    "console.choose.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد جهاز الألعاب الذي ستُترجم نصوص ألعابه. تستطيع تبديله في أي وقت من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন কনসোলের সাবটাইটেল অনুবাদ হবে, বাছাই করুন। চাইলে পরে সেটিংস থেকে পাল্টাতে পারবেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the console you want subtitles translated for. You can switch later in Settings."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin kung aling console ang isasalin ang subtitle. Puwede itong palitan sa Mga Setting kahit kailan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस कंसोल को चुनें जिसके गेम के सबटाइटल अनुवाद होंगे। सेटिंग्स से इसे कभी भी बदला जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih konsol yang subtitle-nya ingin diterjemahkan. Anda dapat menggantinya nanti di Pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih konsol untuk diterjemahkan sari katanya. Pilihan ini boleh diubah kemudian dalam Seting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies voor welke console je de ondertitels vertaald wilt hebben. Wisselen kan later in Instellingen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคอนโซลที่ต้องการแปลคำบรรยาย คุณเปลี่ยนได้ภายหลังในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazısı çevrilecek konsolu seçin. Bunu daha sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ کنسول چنیں جس کی گیمز کے سب ٹائٹلز ترجمہ ہوں گے۔ ترتیبات سے یہ بعد میں بھی بدلا جا سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn máy console bạn muốn dịch phụ đề. Sau này vẫn đổi được trong Cài đặt."
          }
        }
      }
    },
    "console.ps5.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل عبر Remote Play مع حساب PSN ثانٍ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play আর আরেকটি PSN অ্যাকাউন্ট লাগে।"

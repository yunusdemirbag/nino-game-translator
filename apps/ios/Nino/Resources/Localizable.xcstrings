    "settings.gameask.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر السؤال مرة واحدة فقط، بعد دقيقتين على بدء الترجمة، إن لم تعرف أي حزمة هذه اللعبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো প্যাক যদি গেম শনাক্ত না করে, অনুবাদের দুই মিনিটের মাথায় একবারই জানতে চাওয়া হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We ask just once, after two minutes of translating, if no pack knows the game."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itatanong nang minsan, dalawang minuto matapos magsimula ang pagsasalin, kapag walang pack na tumugma sa laro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर किसी पैक से गेम पहचाना न जाए, तो अनुवाद चलने के दो मिनट पूरे होने पर सिर्फ़ एक दफ़ा पूछा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditanyakan satu kali, dua menit sesudah penerjemahan berjalan, bila game tidak dikenali paket mana pun."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditanya sekali sahaja, dua minit selepas mula menterjemah, jika permainan tidak dikenali oleh mana-mana pek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We vragen het maar één keer, na twee minuten vertalen, wanneer geen pakket bij de game past."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามครั้งเดียว หลังเริ่มแปลได้สองนาที เมื่อไม่มีแพ็กใดรู้จักเกมนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunu tanıyan bir paket yoksa, çeviri iki dakikayı geçince tek bir kez sorulur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر کسی پیک سے گیم پہچانی نہ جائے تو ترجمہ چلتے ہوئے دو منٹ ہونے پر صرف ایک دفعہ پوچھا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi duy nhất một lần, khi đã dịch được hai phút mà chưa gói nào nhận diện được game."
          }
        }
      }
    },

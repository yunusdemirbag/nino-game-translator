    "home.preview.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر صورة اللعبة هنا فور بدء الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুবাদ চালু হলে এখানে গেমের দৃশ্য দেখা যাবে।"

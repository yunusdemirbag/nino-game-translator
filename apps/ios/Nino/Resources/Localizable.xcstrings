          "stringUnit": {
            "state": "translated",
            "value": "PS5'inizi çalıştırın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 چالو کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật PS5 lên"
          }
        }
      }
    },
    "psn.again": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول مرة أخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফের লগ ইন করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In Once More"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign In Ulit"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा साइन इन करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk Sekali Lagi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log Masuk Sekali Lagi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog een keer inloggen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar Giriş Yapın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار پھر سائن اِن"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập thêm lần nữa"
          }
        }
      }
    },
    "psn.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتبط الهاتف بـ PS5 من خلال Remote Play. ادخل بحساب PSN آخر مجاني، لا بالحساب الذي تلعب عليه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন Remote Play-এর মাধ্যমে PS5-এ যুক্ত হয়। দ্বিতীয় একটি ফ্রি PSN অ্যাকাউন্ট দিয়ে লগ ইন করুন, খেলার অ্যাকাউন্ট দিয়ে নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone reaches the PS5 via Remote Play. Use a second free PSN account to sign in, not your gaming account."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumokonekta sa PS5 ang telepono sa tulong ng Remote Play. Gumamit ng ikalawa at libreng PSN account sa pag-sign in, hindi ang account na pinanglalaro ninyo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन PS5 के साथ Remote Play से जुड़ता है। किसी दूसरे मुफ़्त PSN खाते से लॉगिन करें, खेलने वाले खाते से नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel tersambung dengan PS5 lewat Remote Play. Login memakai akun PSN tambahan yang gratis, bukan akun yang biasa Anda pakai bermain."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon bersambung ke PS5 menerusi Remote Play. Gunakan akaun PSN lain yang percuma, bukan akaun yang anda pakai bermain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon maakt via Remote Play contact met de PS5. Gebruik daarvoor een extra, gratis PSN-account, niet het account waarop je speelt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือถือจะเชื่อมกับ PS5 โดยใช้ Remote Play ให้ลงชื่อเข้าใช้ด้วยบัญชี PSN บัญชีที่สองที่สมัครฟรี ไม่ใช่บัญชีที่ใช้เล่นเกม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz PS5'e Remote Play üzerinden bağlanır. Oyun oynadığınız hesabı değil, ücretsiz ek bir PSN hesabını kullanarak girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون Remote Play سے PS5 کے ساتھ جڑتا ہے۔ کسی دوسرے مفت PSN اکاؤنٹ سے داخل ہوں، جس پر آپ کھیلتے ہیں وہ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại nối với PS5 thông qua Remote Play. Bạn đăng nhập vào một tài khoản phụ (miễn phí) trên PSN, không phải tài khoản bạn vẫn chơi."
          }
        }
      }
    },
    "psn.controller.warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين تشغّل ذراع التحكم لتلعب، اختر حسابك «الرئيسي» على PS5. اللعب بالحساب الثاني الذي يستعمله Nino يعني أن الذراع لن تستجيب داخل اللعبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খেলার জন্য কন্ট্রোলার অন করলে PS5-এ নিজের প্রধান অ্যাকাউন্ট বাছুন। Nino-র দ্বিতীয় অ্যাকাউন্টে খেললে গেমে কন্ট্রোলার সাড়া দেবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you power up the controller, choose your own MAIN account on that console. If you play on Nino's second account, the controller won't respond in-game."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pag-on ninyo ng controller para sa laro, piliin sa PS5 ang inyong PANGUNAHING account. Kung ang ikalawang account na gamit ni Nino ang pipiliin, hindi gagana sa laro ang controller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खेलने को कंट्रोलर ऑन करते वक़्त PS5 पर अपना असली खाता चुनें। Nino वाले दूसरे खाते पर खेलेंगे तो कंट्रोलर गेम के अंदर नहीं चलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketika menyalakan controller untuk main, pilih akun UTAMA di PS5. Bila Anda main memakai akun kedua milik Nino, controller tidak bisa dipakai dalam game."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sewaktu alat kawalan dihidupkan untuk main, pilih akaun UTAMA di PS5. Kalau anda main menggunakan akaun kedua milik Nino, alat kawalan tidak berfungsi di dalam permainan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je de controller aan, kies dan op de console je HOOFDaccount. Speel je op het extra account van Nino, dan reageert de controller in de game niet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดจอยเพื่อเล่น โปรดเลือกบัญชี “หลัก” ของคุณบน PS5 หากเล่นด้วยบัญชีที่สองที่ Nino ใช้ จอยจะใช้งานในเกมไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynamak için kolu açtığınızda PS5'te ANA hesabınızı seçin. Nino'nun kullandığı ikinci hesapla oynarsanız kol oyunda çalışmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھیلنے کو کنٹرولر چالو کرتے وقت PS5 میں اپنا اصل اکاؤنٹ چنیں۔ Nino والے دوسرے اکاؤنٹ پر کھیلیں گے تو کنٹرولر گیم کے اندر نہیں چلے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc bật tay cầm lên chơi, nhớ chọn đúng tài khoản CHÍNH trên PS5. Nếu vào game với tài khoản phụ Nino đang dùng, tay cầm sẽ chẳng điều khiển được game."
          }
        }
      }
    },
    "psn.error.badresponse": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يفهم Nino الرد القادم من Sony. أعد تسجيل الدخول، وإن تكرّر الأمر فحدّث التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony-র জবাব Nino বুঝতে পারেনি। ফের লগ ইন করুন; বারবার এমন ঘটলে Nino-র নতুন সংস্করণ নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino couldn't make sense of Sony's answer. Sign in once more; if it still fails, update Nino."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naintindihan ni Nino ang tugon ng Sony. Subukang mag-sign in ulit; kapag naulit pa, i-update ang Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony का जवाब Nino की समझ में नहीं आया। दोबारा साइन इन करें; दिक़्क़त बार-बार आए तो ऐप अपडेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan dari Sony tidak dapat dipahami Nino. Masuk lagi; kalau terus begini, perbarui Nino."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan Sony tidak difahami oleh Nino. Log masuk sekali lagi; jika masalah ini berulang, kemas kinikan Nino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino snapte de reactie van Sony niet. Log opnieuw in; gebeurt dit vaker, installeer dan de nieuwste Nino."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ไม่เข้าใจการตอบกลับจาก Sony โปรดลงชื่อเข้าใช้อีกครั้ง หากยังเกิดขึ้นอีก โปรดอัปเดต Nino"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'den gelen yanıt anlaşılamadı. Tekrar giriş yapın; sorun devam ederse Nino'yu güncelleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony کا جواب Nino کی سمجھ میں نہیں آیا۔ دوبارہ سائن اِن کر لیں؛ مسئلہ بار بار آئے تو Nino کو تازہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời từ Sony khiến Nino không hiểu được. Hãy đăng nhập lần nữa; nếu lỗi cứ lặp lại, bạn cập nhật Nino nhé."
          }
        }
      }
    },
    "psn.error.network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن بلوغ خادم الدخول الخاص بـ Sony. تحقّق أنك متصل بالإنترنت، ثم ادخل ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony-র লগ ইন সার্ভারে পৌঁছানো যাচ্ছে না। ইন্টারনেট আছে কিনা দেখে ফের লগ ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's sign-in server is unreachable. Check that you're online, then sign in once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maabot ang server ng Sony para sa pag-sign in. Siguraduhing may internet, at subukang mag-sign in ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony वाला साइन-इन सर्वर नहीं मिल रहा। देख लें कि इंटरनेट चल रहा है, फिर दोबारा साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server login Sony tak bisa dihubungi. Pastikan Anda terhubung ke internet, lalu masuk sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan log masuk milik Sony tidak boleh dihubungi. Pastikan anda dalam talian, kemudian log masuk sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's inlogserver is onbereikbaar. Kijk of je online bent en log daarna opnieuw in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถติดต่อเซิร์ฟเวอร์ลงชื่อเข้าใช้ของ Sony ได้ โปรดตรวจสอบว่าคุณออนไลน์อยู่ แล้วลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sunucusuna bağlanılamıyor. İnternete bağlı olduğunuzu kontrol edin, ardından tekrar giriş yapın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony والا سائن اِن سرور نہیں مل رہا۔ دیکھ لیں کہ انٹرنیٹ چل رہا ہے، اس کے بعد سائن اِن کر لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không liên lạc được với máy chủ của Sony để đăng nhập. Bạn xem máy đã có mạng chưa, rồi đăng nhập lần nữa."
          }
        }
      }
    },
    "psn.error.notcompleted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل الدخول من جهة Sony. انتظر دقيقة، واضغط «تسجيل الدخول» ثانيةً، واستعمل الحساب الثاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony লগ ইন সারেনি। মিনিটখানেক থেমে ফের লগ ইন-এ ট্যাপ করুন, দ্বিতীয় অ্যাকাউন্ট দিয়ে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony didn't complete your sign-in. Give it a minute, tap Sign in once more and use the second account."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naputol ang pagla-log in sa Sony. Isang minuto muna ang hintayin, pindutin ulit ang Mag-sign in, tapos gamitin ang ikalawang account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony की तरफ़ से साइन-इन अधूरा रह गया। एक मिनट रुककर “साइन इन” दोबारा दबाएँ और दूसरा खाता इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses masuk di Sony belum tuntas. Tunggu satu menit, ketuk Masuk lagi, dan pakai akun kedua."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk tidak diselesaikan oleh Sony. Tunggu seminit, ketik Log masuk sekali lagi, dan pakai akaun kedua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony rondde het inloggen niet af. Wacht een minuut, tik nog een keer op Inloggen en kies dan het tweede account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony ยังไม่ได้ทำการลงชื่อเข้าใช้ให้เสร็จ โปรดรอหนึ่งนาที แตะ “ลงชื่อเข้าใช้” อีกครั้ง และใช้บัญชีที่สอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony oturum açmayı bitiremedi. Bir dakika kadar bekleyin, sonra Giriş yap'a yine basıp ikinci hesapla girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony کی طرف سے سائن اِن ادھورا رہ گیا۔ ایک منٹ رک کر «سائن اِن» پھر دبائیں اور دوسرا اکاؤنٹ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony chưa xử lý xong việc đăng nhập. Chờ chừng một phút, chạm lại Đăng nhập và dùng tài khoản phụ."
          }
        }
      }
    },
    "psn.error.ratelimit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصدت Sony محاولات دخول كثيرة. انتظر قرابة 15 دقيقة قبل أن تحاول الدخول ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony খুব বেশি লগ ইনের চেষ্টা টের পেয়েছে। ফের লগ ইন করার আগে মোটামুটি ১৫ মিনিট থামুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony got too many sign-in tries. Give it about 15 minutes before you sign in again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrang dami ng sinubukang pag-sign in ayon sa Sony. Hintayin ang humigit-kumulang 15 minuto bago mag-sign in ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony ने साइन-इन की बहुत सी कोशिशें देखीं। दोबारा साइन इन से पहले क़रीब 15 मिनट रुकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony melihat terlalu banyak upaya login. Tunggu kira-kira 15 menit sebelum masuk lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony mengesan cubaan log masuk yang terlalu kerap. Tunggu lebih kurang 15 minit sebelum mencuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony kreeg te veel inlogpogingen. Wacht zo'n 15 minuten voordat je opnieuw inlogt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony พบการพยายามลงชื่อเข้าใช้มากเกินไป โปรดรอประมาณ 15 นาทีก่อนลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony çok sayıda giriş denemesi algıladı. Tekrar giriş yapmadan önce yaklaşık 15 dakika bekleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony نے بہت سی سائن اِن کوششیں دیکھیں۔ دوبارہ سائن اِن سے پہلے لگ بھگ 15 منٹ رکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony thấy bạn đã thử đăng nhập quá nhiều lần. Chờ chừng 15 phút rồi mới đăng nhập lần nữa."
          }
        }
      }
    },
    "psn.error.server": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغ خادم الدخول في Sony عن خطأ. انتظر عدة دقائق قبل أن تحاول الدخول ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony-র লগ ইন সার্ভার একটি ত্রুটি জানিয়েছে। ফের লগ ইন করার আগে কয়েক মিনিট থামুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's sign-in server hit an error. Give it a few minutes before you sign in again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May error na iniulat ang server ng Sony para sa pag-sign in. Maghintay nang ilang minuto bago mag-sign in ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony के सर्वर ने साइन-इन में गड़बड़ी बताई। दोबारा साइन इन से पहले कुछ मिनट रुकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server login Sony mengalami kesalahan. Tunggu sebentar, beberapa menit, sebelum login lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan log masuk milik Sony melaporkan ralat. Tunggu sebentar sebelum log masuk sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's inlogserver gaf een foutmelding. Wacht een paar minuutjes voordat je opnieuw inlogt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ลงชื่อเข้าใช้ของ Sony แจ้งข้อผิดพลาด โปรดรอสักครู่ก่อนลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sunucusu bir hata bildirdi. Tekrar giriş yapmadan önce birkaç dakika bekleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony کے سرور نے سائن اِن میں خرابی بتائی۔ دوبارہ سائن اِن سے پہلے کچھ منٹ رکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ của Sony gặp lỗi khi đăng nhập. Chờ dăm phút, sau đó đăng nhập lần nữa."
          }
        }
      }
    },
    "psn.error.signinfirst": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل المتابعة، ادخل إلى PlayStation Network."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগোনোর আগে PlayStation Network-এ লগ ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue, sign in to your PlayStation Network account."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bago magpatuloy, kailangan munang naka-sign in kayo sa PlayStation Network."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे जाने के लिए पहले PlayStation Network पर साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Login ke PlayStation Network dulu sebelum lanjut."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk PlayStation Network dahulu sebelum meneruskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan bij PlayStation Network om verder te gaan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดลงชื่อเข้าใช้ PlayStation Network ก่อนดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam edebilmek için PlayStation Network hesabınıza girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آگے جانے کے لیے پہلے PlayStation Network پر سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy vào PlayStation Network trước, rồi mới đi tiếp."
          }
        }
      }
    },
    "psn.error.windowclosed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انغلقت نافذة الدخول قبل أن تُكمل. اضغط «تسجيل الدخول» ثم أتمّ الخطوات داخل النافذة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজ শেষের আগেই লগ ইন উইন্ডো বন্ধ হলো। লগ ইন-এ ট্যাপ করে সেই উইন্ডোর ধাপগুলো সেরে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in window closed before you finished. Tap Sign in and complete the steps in that window."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsara ang window ng pag-sign in bago kayo natapos. I-tap ulit ang Mag-sign in, saka kumpletuhin doon ang mga hakbang."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन-इन ख़त्म होने से पहले ही विंडो बंद हुई। “साइन इन” पर टैप करें और उसी विंडो में सारे चरण पूरे करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela masuk tertutup sebelum Anda selesai. Ketuk Masuk dan selesaikan langkah-langkahnya di jendela tersebut."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetingkap log masuk tertutup sebelum anda selesai. Ketik Log masuk dan habiskan langkahnya dalam tetingkap itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het inlogvenster ging dicht voordat je klaar was. Tik op Inloggen en rond de stappen in dat venster af."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่างลงชื่อเข้าใช้ปิดไปก่อนที่คุณจะทำเสร็จ โปรดแตะ “ลงชื่อเข้าใช้” และทำตามขั้นตอนในหน้าต่างนั้นให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş bitmeden pencere kapandı. Giriş yap'a dokunup adımları o pencerede bitirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن اِن ونڈو آپ کے مکمل کرنے سے پہلے بند ہو گئی۔ «سائن اِن» پر تھپتھپائیں اور اسی ونڈو میں مراحل مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ để đăng nhập bị đóng khi bạn chưa làm xong. Chạm Đăng nhập rồi làm đủ các bước trong cửa sổ ấy."
          }
        }
      }
    },

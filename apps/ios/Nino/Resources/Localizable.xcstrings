    "tvi.step.approve": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين يسألك التلفزيون “السماح بتصحيح USB؟”، اختر «سماح» وضع علامة على “السماح دائمًا لهذا الحاسوب”."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে যখন “USB ডিবাগিং-এর অনুমতি দেবেন?” জিজ্ঞাসা করবে, তখন অনুমতি দিন বেছে নিন এবং “এই কম্পিউটার থেকে সর্বদা অনুমতি দিন”-এ টিক দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the TV prompts you about USB debugging, pick Allow and tick the box to always trust this computer."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa TV, kapag tinanong kung papayagan ang USB debugging, piliin ang Payagan at i-tsek ang opsyong laging payagan ang computer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी जब “USB डीबगिंग की इजाज़त दें?” पूछे, तब “अनुमति दें” चुनें और “इस कंप्यूटर को हमेशा इजाज़त दें” पर टिक लगाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada TV, pilih Izinkan ketika muncul “Izinkan proses debug USB?”, dan centang opsi “Selalu izinkan…” untuk komputer ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada TV, pilih Benarkan apabila ia bertanya “Benarkan penyahpepijatan USB?” dan tandakan “Sentiasa benarkan daripada komputer ini”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt je tv om USB-foutopsporing toe te staan, kies dan Toestaan en vink aan dat deze computer het altijd mag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนทีวี เมื่อถามว่า “อนุญาตการแก้ไขข้อบกพร่อง USB หรือไม่” ให้เลือก อนุญาต และทำเครื่องหมาย “อนุญาตจากคอมพิวเตอร์เครื่องนี้เสมอ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV, USB hata ayıklamaya izin isteyince İzin ver'e basın ve bu bilgisayara her zaman güvenme kutusunu da işaretleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV پر جب “USB ڈیبگنگ کی اجازت دیں؟” پوچھا جائے تو اجازت دیں منتخب کریں اور “اس کمپیوٹر سے ہمیشہ اجازت دیں” پر نشان لگائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi TV hỏi có cho gỡ lỗi USB không, chọn Cho phép và đánh dấu ô luôn cho phép máy tính này."
          }
        }
      }
    },

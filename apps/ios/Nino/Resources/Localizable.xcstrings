    "settings.engine.packnote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت للعبة حزمة جاهزة، فهذا المحرك يترجم فقط ما ينقص الحزمة من أسطر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব গেমের তৈরি প্যাক আছে, সেগুলোতে এই ইঞ্জিন শুধু প্যাকে না থাকা লাইনগুলো অনুবাদ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a game has its own ready-made pack, this engine fills in only what that pack is missing."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag may nakahandang pack ang laro, isasalin lang ng engine ang mga linyang kulang sa pack."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन गेम के लिए तैयार पैक मौजूद है, वहाँ यह इंजन बस वही पंक्तियाँ संभालता है जो पैक में छूट गई हों।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagi game yang punya paket siap, mesin ini cuma mengurus baris yang belum tercakup paket."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagi permainan yang ada pek sedia, enjin ini cuma menterjemah baris yang tidak ada dalam pek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft een game een kant-en-klaar pakket, dan vult deze engine alleen aan wat daarin ontbreekt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับเกมที่มีแพ็กสำเร็จรูป เอนจินนี้จะแปลเฉพาะบรรทัดที่ไม่มีในแพ็ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır paketi bulunan oyunlarda bu motor, yalnızca pakette olmayan satırları çevirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جن گیمز کا تیار پیک موجود ہے، ان کی صرف وہ لائنیں یہ انجن سنبھالتا ہے جو پیک میں نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với game đã có gói dịch sẵn, công cụ dịch này chỉ xử lý những dòng gói còn thiếu."
          }
        }
      }
    },

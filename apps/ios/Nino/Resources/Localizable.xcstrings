    "report.privacy.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل ما كتبته مع صورك وسجل التطبيق (إذا فعّلته) إلى خادم Nino لنصلح المشكلة. لا تكتب أي كلمة مرور من فضلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিবরণ, ছবি ও অ্যাপের লগ (চালু থাকলে) Nino-র সার্ভারে যায়, যাতে আমরা সমস্যাটি ঠিক করতে পারি। দয়া করে কোনো পাসওয়ার্ড লিখবেন না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you write, your photos and the app log (when enabled) go to Nino's server to help us fix the problem. Please don't include passwords."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipapadala sa server namin ang inyong paliwanag, mga litrato, at log ng app (kung naka-on) para maayos ang problema. Huwag mag-type ng anumang password."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका लिखा हुआ, आपकी फ़ोटो और ऐप लॉग (अगर ऑन हो) Nino के सर्वर तक जाते हैं, ताकि गड़बड़ी दूर की जा सके। कोई पासवर्ड न लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsi, foto, dan log aplikasi (jika aktif) dikirimkan ke server Nino supaya masalahnya bisa kami perbaiki. Jangan ketik kata sandi apa pun."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerangan, foto dan log apl anda (jika dihidupkan) dikirim ke pelayan Nino untuk membantu kami membaiki masalah. Jangan taip sebarang kata laluan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je schrijft, je foto's en het app-logboek (als het aan staat) gaan naar Nino's server, zodat wij het kunnen verhelpen. Zet er geen wachtwoorden in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำอธิบาย รูปภาพ และล็อกของแอป (ถ้าเปิดไว้) จะถูกส่งไปที่เซิร์ฟเวอร์ของ Nino เพื่อให้เราแก้ปัญหาได้ กรุณาอย่าพิมพ์รหัสผ่านใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunu çözebilmemiz için açıklamanız, fotoğraflarınız ve uygulama günlüğü (açıksa) Nino'nun sunucusuna gider. Lütfen parola yazmayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا لکھا ہوا، آپ کی تصویریں اور ایپ لاگ (اگر آن ہو) Nino کے سرور تک جاتے ہیں، تاکہ خرابی دور کی جا سکے۔ کوئی پاس ورڈ نہ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần mô tả, ảnh của bạn và nhật ký (nếu bật) được gửi tới máy chủ Nino giúp chúng tôi xử lý lỗi. Xin đừng gõ mật khẩu nào vào đây."
          }
        }
      }
    },

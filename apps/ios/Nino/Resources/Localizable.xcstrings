    "xbox.signin.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط الزر لتحصل على رمز. صفحة دخول Microsoft لا يمكن عرضها في التطبيق، فاكتب الرمز في microsoft.com/link عبر متصفحك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বোতামে ট্যাপ করলে একটা কোড আসবে। Microsoft-এর লগ ইন পাতা অ্যাপে খোলে না, তাই ব্রাউজারে microsoft.com/link খুলে কোডটা লিখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap below and a code appears. Microsoft's sign-in can't load inside Nino, so enter the code in your browser at microsoft.com/link."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindutin ang button at bibigyan kayo ng code. Hindi mabubuksan sa app ang Microsoft page para mag-sign in, kaya pumunta sa microsoft.com/link sa inyong browser at ilagay roon ang code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बटन दबाएँ तो एक कोड मिलेगा। Microsoft का लॉगिन पेज यह ऐप नहीं खोल सकता, इसलिए ब्राउज़र खोलकर microsoft.com/link पर यह कोड लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombolnya untuk mendapat kode. Halaman login Microsoft tak bisa dibuka di dalam aplikasi, karena itu ketik kodenya di microsoft.com/link lewat browser."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik butang untuk menerima kod. Laman log masuk Microsoft tak boleh dibuka dalam apl, jadi taipkan kod itu di microsoft.com/link menggunakan pelayar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik hieronder voor een code. Aanmelden bij Microsoft kan niet binnen de app, dus vul de code in je browser in op microsoft.com/link."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มแล้วคุณจะได้รับรหัส หน้าลงชื่อเข้าใช้ของ Microsoft เปิดในแอปไม่ได้ จึงต้องพิมพ์รหัสที่ microsoft.com/link ในเบราว์เซอร์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düğmeye dokununca size bir kod verilir. Microsoft oturum sayfası uygulamanın içinde açılamıyor; kodu tarayıcıda microsoft.com/link adresine girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بٹن دبائیں تو ایک کوڈ ملے گا۔ Microsoft کا لاگ اِن صفحہ یہ ایپ نہیں کھول سکتی، لہٰذا براؤزر کھول کر microsoft.com/link پر یہ کوڈ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm nút để nhận một mã. Ứng dụng không mở được trang Microsoft để đăng nhập bên trong, nên bạn hãy gõ mã vào microsoft.com/link bằng trình duyệt."
          }
        }
      }
    },
    "xbox.signin.waiting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل تسجيل الدخول، وسيتابع Nino تلقائيًا…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন ইন শেষ করুন; এরপর Nino নিজেই এগোবে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish signing in; Nino will carry on by itself…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapusin ang pag-sign in; kusang magpapatuloy ang Nino…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन पूरा करें; उसके बाद Nino अपने-आप आगे बढ़ेगा…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan login; Nino akan lanjut sendiri…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan log masuk; Nino akan teruskan sendiri…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond het inloggen af; Nino gaat daarna zelf verder…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ให้เสร็จ แล้ว Nino จะทำต่อเอง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişi bitirin; Nino ardından kendisi devam edecek…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن اِن مکمل کریں؛ اس کے بعد Nino خود آگے بڑھے گا…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng nhập xong; Nino sẽ tự tiếp tục…"
          }
        }
      }
    }
  },
  "version": "1.0"
}

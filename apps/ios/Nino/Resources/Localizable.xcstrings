    "packs.auto.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُختار الحزمة المناسبة تلقائيًا مع بدء اللعبة. والأسطر التي ليست في الحزمة يترجمها المحرك الذي اخترته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গেম চালু হলে মানানসই প্যাক আপনাআপনি বাছাই হয়। প্যাকে যে লাইন নেই, সেগুলো যায় আপনার বাছাই করা ইঞ্জিনে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a game starts, its pack is chosen for you. Any line the pack lacks is sent to your selected engine."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusang napipili ang tamang pack pagsimula ng laro. Kung may linyang hindi nasa pack, ipapasa ito sa engine na pinili ninyo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम शुरू होते ही सही पैक ख़ुद चुन लिया जाता है। जो पंक्तियाँ पैक में नहीं, वे आपके चुने इंजन को जाती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket yang cocok dipilih secara otomatis begitu game dimulai. Baris yang tidak tercakup paket akan diterjemahkan oleh mesin pilihan Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek yang sesuai dipilih sendiri apabila permainan bermula. Baris yang tidak ada dalam pek akan dihantar ke enjin pilihan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een game, dan wordt het juiste pakket vanzelf gekozen. Regels die ontbreken, gaan naar de engine van jouw keuze."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะเลือกแพ็กที่เหมาะสมให้อัตโนมัติเมื่อเกมเริ่ม บรรทัดที่ไม่มีในแพ็กจะส่งไปยังเอนจินที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun başladığında uygun paket otomatik seçilir. Pakette bulunmayan satırları seçtiğiniz motor çevirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گیم شروع ہوتے ہی صحیح پیک خود چن لیا جاتا ہے۔ پیک سے باہر رہ جانے والی لائنیں آپ کے چنے ہوئے انجن کو جاتی ہیں۔"

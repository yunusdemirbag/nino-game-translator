    "settings.watermark": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار علامة Nino على التلفزيون"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে Nino চিহ্ন দেখান"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the Nino mark on the TV"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita ang marka ng Nino sa TV"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी पर Nino का निशान दिखाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan tanda Nino di TV"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan tanda Nino pada TV"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon het Nino-logo op de tv"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเครื่องหมาย Nino บนทีวี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de Nino işaretini göster"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV پر Nino کا نشان دکھائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện dấu Nino trên TV"
          }
        }
      }
    },
    "settings.watermark.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف لا يتغيّر شيء سوى اختفاء شارة Nino الصغيرة أسفل يسار شاشة التلفزيون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ থাকলে কেবল একটাই বদল: TV-র বাঁ দিকের নিচে Nino-র ছোট চিহ্ন আর দেখা যায় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the only change is that the small Nino mark in the bottom-left of the TV goes away."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naka-off, iisa lang ang nagbabago: hindi na lalabas ang maliit na tatak ng Nino sa ibabang kaliwa ng TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद रहने पर फ़र्क़ बस इतना है कि टीवी पर नीचे बाईं ओर Nino का छोटा निशान नहीं दिखता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat nonaktif, satu-satunya bedanya ialah tanda kecil Nino di kiri bawah TV tidak muncul."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila dimatikan, satu-satunya perubahan ialah tanda kecil Nino di bahagian kiri bawah TV tidak dipaparkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat dit uit, dan verandert er maar één ding: het kleine Nino-teken linksonder op de tv is weg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดไว้ สิ่งเดียวที่เปลี่ยนคือสัญลักษณ์ Nino ขนาดเล็กด้านล่างซ้ายของทีวีจะไม่แสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıyken tek fark, TV'de sol altta duran küçük Nino işaretinin gösterilmemesidir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند ہونے پر فرق صرف اتنا ہے کہ TV پر نیچے بائیں طرف Nino کا چھوٹا نشان نظر نہیں آتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, khác biệt duy nhất là dấu Nino nhỏ ở góc dưới bên trái TV sẽ không hiện."
          }
        }
      }
    },

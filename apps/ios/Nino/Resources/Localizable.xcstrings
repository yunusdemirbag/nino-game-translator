      }
    },
    "pair.error.crashed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف Remote Play في PS5 فجأة. أعد تشغيل جهاز PS5 ثم اكتب الرمز الجديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর Remote Play আচমকা থেমে গেছে। PS5 একবার বন্ধ করে আবার চালান, তারপর নতুন কোডটা দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5's Remote Play quit unexpectedly. Turn the PS5 off and on, then type the fresh code."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Biglang tumigil sa PS5 ang Remote Play. Paki-restart ang console, saka i-type ang panibagong code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 का Remote Play अचानक बंद हो गया। PS5 रीस्टार्ट करके नया कोड लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play di PS5 mendadak berhenti. Nyalakan ulang PS5, lalu isi kode yang baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play di PS5 terhenti secara tiba-tiba. Hidupkan semula PS5, kemudian taipkan kod yang baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play op de PS5 is plots gestopt. Zet de PS5 uit en weer aan en typ daarna de verse code."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play ในเครื่อง PS5 หยุดไปกะทันหัน ให้รีสตาร์ท PS5 แล้วใส่รหัสที่ได้ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'teki Remote Play beklenmedik biçimde kapandı. PS5'i yeniden başlatıp yeni kodu girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کا Remote Play اچانک بند ہو گیا۔ PS5 ری اسٹارٹ کر کے نیا کوڈ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play trên PS5 bị dừng bất ngờ. Bạn cho PS5 khởi động lại, sau đó gõ mã mới vào."
          }
        }
      }
    },
    "pair.error.inUse": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play شغّال الآن في جهاز آخر. أغلقه من هناك ثم أدخل الرمز الجديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য কোনো যন্ত্রে Remote Play চলছে। সেখানে ওটা বন্ধ করে নতুন কোডটা দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device is using Remote Play right now. Quit it there, then type the fresh code."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May ibang device na gumagamit ng Remote Play. Isara iyon doon, saka i-type ang panibagong code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play इस वक़्त किसी और डिवाइस पर खुला है। उसे वहाँ से बंद करके नया कोड लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play sedang dipakai perangkat lain. Tutup dulu di sana, lalu isi kode yang baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play sedang dipakai oleh peranti lain. Tutup di peranti itu, kemudian taipkan kod yang baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play is nu bezig op een ander toestel. Sluit het daar af en typ daarna de verse code."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play กำลังใช้งานอยู่บนอุปกรณ์อื่น ปิดที่นั่นก่อน แล้วป้อนรหัสใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play şu an başka bir cihazda kullanımda. Orada kapatıp yeni çıkan kodu girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play اس وقت کسی دوسری ڈیوائس پر کھلا ہے۔ وہاں سے بند کر کے نیا کوڈ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thiết bị khác đang dùng Remote Play. Tắt nó ở thiết bị đó và gõ mã mới vào."
          }
        }
      }
    },
    "pair.error.late": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل الطلب إلى PS5 لكن الرد تأخر. افتح «إقران الجهاز» على PS5 ثانيةً وأدخل الرمز الجديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুরোধ PS5-এ পৌঁছেছে, কিন্তু সময়ের মধ্যে জবাব আসেনি। PS5-এ ফের Pair Device চালু করে নতুন কোডটা দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 got the request, but its reply came too late. Reopen Pair Device on the console and type the fresh code."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakuha ng PS5 ang hiling pero hindi ito sumagot agad. Buksan ulit sa PS5 ang Pair Device, saka i-type ang panibagong code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध PS5 तक पहुँचा, लेकिन जवाब समय से नहीं आया। PS5 में Pair Device दोबारा खोलकर नया कोड लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan sudah diterima PS5, tetapi jawabannya terlambat. Buka lagi Pasangkan Perangkat di PS5, lalu isi kode yang baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan sampai ke PS5, namun jawapannya terlewat. Buka Pair Device di PS5 sekali lagi, kemudian taipkan kod yang baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 kreeg het verzoek, maar reageerde te laat. Open Apparaat koppelen nog een keer op de console en typ de verse code."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ได้รับคำขอแต่ไม่ตอบกลับทันเวลา เปิด จับคู่อุปกรณ์ ที่ PS5 อีกครั้ง แล้วป้อนรหัสใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek PS5'e ulaştı ama cevap geç geldi. Cihazı Eşleştir ekranını PS5'te tekrar açın ve yeni çıkan kodu girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست PS5 تک پہنچی لیکن جواب وقت پر نہیں آیا۔ PS5 میں Pair Device پھر سے کھول کر نیا کوڈ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu đã tới PS5, nhưng máy trả lời quá muộn. Mở Pair Device trên PS5 thêm lần nữa và gõ mã mới vào."
          }
        }
      }
    },
    "pair.error.notatAddress": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد PS5 على هذا العنوان. راجع عنوان IP في PS5 من الإعدادات › الشبكة، ثم «حالة الاتصال»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ঠিকানাতে PS5 মেলেনি। PS5-এর IP ঠিকানা মিলিয়ে নিন: Settings খুলে Network-এর Connection Status।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no PS5 at that address. Its IP is listed on the console under Settings › Network, then Connection Status."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakitang console sa address na iyan. Makikita ang IP ng PS5 sa console mismo, nasa Settings › Network › Connection Status."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पते पर PS5 नहीं है। PS5 का IP पता Settings › Network में Connection Status के अंदर मिलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak ditemukan pada alamat tersebut. Cek alamat IP-nya di PS5 lewat Setelan › Jaringan › Status Koneksi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak dijumpai pada alamat ini. Lihat alamat IP PS5 dalam Settings › Network › Connection Status."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dat adres zit geen PS5. Het IP-adres staat op de console bij Instellingen › Netwerk, dan Verbindingsstatus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบ PS5 ที่ที่อยู่นี้ ตรวจสอบที่อยู่ IP ของ PS5 ได้ที่ การตั้งค่า › เครือข่าย › สถานะการเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adreste PS5 yok. PS5'in IP adresi konsolda Ayarlar › Ağ, oradan Bağlantı Durumu altında yazar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس پتے پر کوئی PS5 موجود نہیں۔ PS5 کا IP پتہ Settings › Network میں Connection Status کے اندر ملے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có PS5 nào ở địa chỉ đó. Xem IP của PS5 tại Settings › Network › Connection Status."
          }
        }
      }
    },
    "pair.error.notfound": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد PS5. تحقّق أنه شغّال ومتصل بالشبكة ذاتها، أو اكتب عنوان IP له."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 খুঁজে পাওয়া গেল না। সেটি চালু কিনা, আর একই নেটওয়ার্কে কিনা দেখুন, নয়তো IP ঠিকানা লিখে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No PS5 turned up. Make sure it's switched on and shares your network, or type in its IP address."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakitang PS5. Siguraduhing bukas ito at iisa ang network ninyo, o i-type mismo ang IP address."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 नहीं दिखा। देखें कि वह ऑन हो और उसी Wi‑Fi पर हो, वरना उसका IP पता ख़ुद लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tak ditemukan. Cek apakah PS5 sudah menyala dan memakai jaringan yang sama. Bisa juga ketik alamat IP-nya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak dijumpai. Pastikan PS5 hidup dan menggunakan rangkaian sama, ataupun taipkan alamat IP-nya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen PS5 gevonden. Kijk of hij is ingeschakeld en jouw netwerk deelt, of typ zijn IP-adres in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบ PS5 โปรดตรวจสอบว่าเปิดอยู่และอยู่ในเครือข่ายเดียวกัน หรือพิมพ์ที่อยู่ IP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bulunamadı. Cihazın açık ve sizinle aynı ağa bağlı olduğundan emin olun veya IP adresini elle girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 نظر نہیں آیا۔ دیکھیں کہ وہ چالو ہو اور اسی Wi‑Fi پر ہو، ورنہ اس کا IP پتہ خود لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thấy PS5 đâu. Kiểm tra xem máy có đang bật và chung mạng không, hoặc gõ IP của máy."
          }
        }
      }
    },
    "pair.error.version": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ندعم هذا الإصدار من نظام PS5 حتى الآن. حدّث تطبيق Nino ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর এই সিস্টেম সংস্করণে এখনো সমর্থন নেই। Nino আপডেট করে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino doesn't support this PS5 firmware yet. Get the latest Nino, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa sinusuportahan ang system version na ito ng PS5. I-update ang Nino, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 के इस सिस्टम संस्करण का सपोर्ट अभी नहीं आया। Nino को अपडेट करके फिर आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi sistem PS5 tersebut belum didukung. Silakan perbarui Nino, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi sistem PS5 tersebut belum disokong. Kemas kinikan Nino, kemudian cuba semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino kan nog niet overweg met deze PS5-firmware. Installeer de nieuwste Nino en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่รองรับระบบ PS5 เวอร์ชันนี้ อัปเดต Nino แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu PS5 yazılım sürümü şimdilik desteklenmiyor. Nino'nun yeni sürümünü yükleyip tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کے اس سسٹم ورژن کی سپورٹ ابھی نہیں آئی۔ Nino کو تازہ کر کے پھر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino chưa hỗ trợ phiên bản phần mềm PS5 này. Bạn cập nhật Nino rồi thử lại."
          }
        }
      }
    },
    "pair.error.wrongAccount": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعرف PS5 هذا الحساب. خذ الرمز من ذلك المستخدم على PS5 الذي يستعمل الحساب نفسه المستخدم في Nino، أو أعد تسجيل الدخول بحساب ذلك المستخدم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 এই অ্যাকাউন্ট চিনল না। Nino-তে যে অ্যাকাউন্ট দিয়েছেন, PS5-এ সেই অ্যাকাউন্টে ঢোকা ব্যবহারকারীর কাছ থেকে কোড নিন, নয়তো সেই ব্যবহারকারীর অ্যাকাউন্টে ফের লগ ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is unknown to the PS5. Ask for a code from whoever uses your Nino account on that PS5, or log in to Nino with that person's account instead."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nakikilala ng console ang account na iyan. Humingi ng code sa user ng PS5 na naka-sign in sa parehong account na nasa Nino, o kaya mag-sign in muli sa Nino sa account ng taong iyon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 इस खाते को नहीं जानता। कोड उसी PS5 उपयोगकर्ता से लें जिसका खाता Nino में लगा है, या नए सिरे से उसी उपयोगकर्ता के खाते से लॉगिन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini tidak dikenali oleh PS5. Minta kode dari pengguna di PS5 yang login memakai akun yang sama seperti di Nino, atau login ulang memakai akun pengguna tersebut."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini tidak dikenali oleh PS5. Minta kod itu daripada pengguna di PS5 yang memakai akaun sama seperti dalam Nino, ataupun log masuk sekali lagi menggunakan akaun pengguna tersebut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 kent dit account niet. Vraag de code aan wie er met jouw Nino-account op die PS5 is ingelogd, of gebruik in Nino juist het account van diegene."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่รู้จักบัญชีนี้ ให้รับรหัสจากผู้ใช้ PS5 ที่ลงชื่อเข้าด้วยบัญชีที่คุณใช้ใน Nino หรือลงชื่อเข้าใหม่ด้วยบัญชีของผู้ใช้นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bu hesabı tanımıyor. Kodu, Nino'daki hesabınızla PS5'e girmiş kullanıcıdan isteyin veya Nino'ya o kişinin hesabıyla tekrar girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 اس اکاؤنٹ کو پہچان نہیں سکا۔ کوڈ اسی PS5 صارف سے لیں جس کا اکاؤنٹ Nino میں لگا ہے، یا نئے سرے سے اسی صارف کے اکاؤنٹ سے لاگ اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này lạ với PS5. Hãy xin mã từ người đang đăng nhập PS5 bằng đúng tài khoản đã dùng ở Nino, hoặc vào Nino đăng nhập lần nữa bằng tài khoản người ấy."
          }
        }
      }
    },
    "pair.error.wrongCode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز خاطئ أو قديم. افتح «إقران الجهاز» على PS5 ثانيةً وأدخل الرمز الجديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোডটি ভুল, নয়তো মেয়াদ ফুরিয়েছে। PS5-এ ফের Pair Device চালু করে নতুন কোডটা দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code is incorrect or no longer valid. Reopen Pair Device on the console and type the fresh code."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali o luma na ang code. Pakibuksan ulit sa PS5 ang Pair Device, saka i-type ang panibagong code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड ग़लत या पुराना है। PS5 में Pair Device दोबारा खोलकर नया कोड लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodenya salah atau kedaluwarsa. Buka lagi Pasangkan Perangkat di PS5, lalu isi kode yang baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod tidak betul ataupun sudah luput. Buka Pair Device di PS5 sekali lagi, kemudian taipkan kod yang baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die code klopt niet of is niet meer geldig. Open Apparaat koppelen nog een keer op de console en typ de verse code."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสไม่ถูกต้องหรือหมดอายุแล้ว เปิด จับคู่อุปกรณ์ ที่ PS5 อีกครั้ง แล้วป้อนรหัสใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod hatalı veya artık geçerli değil. Cihazı Eşleştir ekranını PS5'te tekrar açın ve yeni çıkan kodu girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کوڈ غلط یا پرانا ہے۔ PS5 میں Pair Device پھر سے کھول کر نیا کوڈ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã không đúng hoặc đã quá hạn. Mở Pair Device trên PS5 thêm lần nữa và gõ mã mới vào."
          }
        }
      }
    },

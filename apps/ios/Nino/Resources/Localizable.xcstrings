    "settings.autoreport": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال بلاغات المشكلات تلقائيًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্যার রিপোর্ট নিজে থেকে পাঠান"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send problem reports automatically"
          }
        },
        "fil": {
          "stringUnit": {

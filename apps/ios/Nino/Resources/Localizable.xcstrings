    "region.edit.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الإطار لتحريكه، واسحب أحد أركانه لتغيير حجمه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রেম সরাতে সেটি টেনে নিন; মাপ বদলাতে কোণ ধরে টানুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the box to reposition it; drag a corner to make it bigger or smaller."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-drag ang kahon para ilipat ito; i-drag ang isang sulok para palakihin o paliitin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्रेम खिसकाने को उसे खींचें; आकार बदलना हो तो कोना खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser bingkai untuk memindahkan; tarik salah satu sudut untuk mengubah ukurannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret bingkai untuk mengalihkan; seret satu penjuru untuk mengubah saiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep het vak om het te verschuiven; sleep een hoek om het groter of kleiner te maken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากกรอบเพื่อย้าย ลากมุมเพื่อปรับขนาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerini değiştirmek için çerçeveyi, boyutunu değiştirmek için bir köşesini sürükleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فریم ہلانے کو اسے گھسیٹیں؛ سائز بدلنا ہو تو کونا گھسیٹیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo khung để dời chỗ; kéo ở góc để chỉnh kích cỡ."
          }
        }
      }
    },

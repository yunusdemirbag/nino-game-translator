    "history.clear.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف كل سطر محفوظ من هذا الهاتف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে সংরক্ষিত প্রতিটি লাইন মুছে ফেলা হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every saved line is deleted from this phone."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buburahin ang bawat linyang nakatago sa teleponong ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई हर पंक्ति इस फ़ोन से मिट जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh baris tersimpan akan terhapus dari ponsel ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua baris tersimpan akan dipadam dari telefon ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke opgeslagen regel verdwijnt van deze telefoon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บรรทัดที่เก็บไว้ทุกบรรทัดจะถูกลบจากมือถือเครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı tüm satırlar bu telefondan kaldırılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کی گئی ہر لائن اس فون سے حذف ہو جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi câu đã lưu trên máy này sẽ mất hết."
          }
        }
      }
    },
    "history.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء هنا بعد. ستظهر هنا الأسطر المترجمة الآن وفي الجلسات السابقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো ফাঁকা। এখনকার ও আগের সেশনের অনূদিত লাইন এখানে জমা হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here yet. Lines translated now and in past sessions will show up here."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pa rito. Makikita rito ang mga isinaling linya, ngayon man o sa mga nakaraang session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ अभी कुछ नहीं है। अभी और पिछले सत्रों में अनुवादित पंक्तियाँ यहाँ दिखेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih kosong. Baris yang diterjemahkan sekarang maupun di sesi lalu akan tampil di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa-apa. Baris yang diterjemah sekarang dan dalam sesi lalu akan dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets te zien. Hier komen regels die nu of eerder zijn vertaald."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไรที่นี่ บรรทัดที่แปลตอนนี้และในเซสชันก่อนหน้าจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz burası boş. Bu oturumda ve daha önce çevrilmiş satırlar burada görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی یہاں کچھ نہیں۔ اس وقت اور گزشتہ سیشنز میں ترجمہ ہونے والی لائنیں یہیں دکھیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có dòng nào. Những câu dịch lúc này và ở các lần chơi trước sẽ nằm tại đây."
          }
        }
      }
    },
    "history.limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ هذا الهاتف بآخر %lld سطر مترجم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে শেষ %lldটি অনূদিত লাইন জমা থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone keeps the most recent %lld translated lines."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinatago ng teleponong ito ang %lld pinakabagong isinaling linya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन हाल की %lld अनुवादित पंक्तियाँ सहेजकर रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini menyimpan %lld baris terjemahan terbaru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon ini menyimpan %lld baris terjemahan terkini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon houdt de %lld meest recent vertaalde regels bij."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์เครื่องนี้เก็บบรรทัดที่แปลล่าสุด %lld บรรทัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon, en son çevrilen %lld satırı saklar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فون ترجمہ کی گئی آخری %lld لائنیں رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại này lưu %lld dòng được dịch gần nhất."
          }
        }
      }
    },
    "home.foreground.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ Nino ظاهرًا على الشاشة طوال اللعب. يقطع iOS الاتصال حين يصبح التطبيق في الخلفية؛ ولن تنطفئ الشاشة خلال الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খেলার সময় Nino সামনে খোলা রাখুন। অ্যাপ পেছনে চলে গেলে iOS সংযোগ বিচ্ছিন্ন করে; অনুবাদ চলাকালীন স্ক্রিন নিভবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave Nino open on screen during play. iOS cuts the connection once the app moves to the background; while translating, the screen won't turn off."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Panatilihing nakabukas ang Nino sa screen habang naglalaro. Kapag napunta sa likod ang app, puputulin ng iOS ang koneksiyon; habang may pagsasalin, mananatiling bukas ang screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खेलते वक़्त Nino स्क्रीन पर खुली रहने दें। ऐप पीछे जाते ही iOS कनेक्शन तोड़ देता है; अनुवाद चलते वक़्त स्क्रीन बंद नहीं होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan Nino terbuka di layar selama bermain. iOS memutus koneksi begitu aplikasi berpindah ke latar belakang; selama menerjemahkan, layar tidak akan mati."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan Nino dibuka di skrin sepanjang bermain. iOS memutuskan sambungan sebaik apl ke latar belakang; semasa menterjemah, skrin tidak akan padam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd Nino tijdens het spelen in beeld. Zodra de app op de achtergrond belandt, sluit iOS de verbinding; tijdens het vertalen gaat het scherm niet uit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Nino ค้างไว้บนหน้าจอระหว่างเล่น iOS จะตัดการเชื่อมต่อเมื่อแอปไปอยู่เบื้องหลัง ระหว่างแปล หน้าจอจะไม่ดับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun boyunca Nino'yu ekranda açık bırakın. Uygulama arka plana geçtiğinde iOS bağlantıyı kapatır; çeviri sırasında ekran kapanmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھیل کے دوران Nino اسکرین پر کھلی رہنے دیں۔ ایپ پیچھے جاتے ہی iOS کنکشن ختم کر دیتا ہے؛ ترجمہ چلتے وقت اسکرین بند نہیں ہوگی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi chơi, hãy giữ Nino luôn mở trước mặt. Ứng dụng xuống nền là iOS cắt kết nối; đang dịch thì màn hình sẽ không tự tắt."
          }
        }
      }
    },

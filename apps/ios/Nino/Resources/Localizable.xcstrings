    "phone.keepon.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تنطفئ الشاشة · وتخفت إضاءتها من تلقاء نفسها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিন ঘুমোবে না · উজ্জ্বলতা নিজেই কমে যাবে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen won't sleep · it dims on its own"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi matutulog ang screen · kusa itong lalabo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन सोएगी नहीं · रोशनी अपने-आप कम होगी"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar terus menyala · cahayanya meredup otomatis"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin kekal menyala · cahayanya malap secara automatik"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scherm blijft aan · en wordt zelf wat donkerder"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จอจะไม่ดับ · และหรี่แสงลงโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

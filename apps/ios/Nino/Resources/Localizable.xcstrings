    },
    "report.description.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما المشكلة؟ وفي أي لعبة؟ وما الذي كان ينبغي أن يحدث؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী ভুল হয়েছে? কোন গেমে, আর কী হওয়ার কথা ছিল?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What went wrong? In which game, and what should have happened?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano ang nagkaproblema? Sa anong laro, at ano dapat ang nangyari?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या गड़बड़ हुई? किस गेम में, और क्या होना चाहिए था?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa masalahnya? Terjadi di game mana, dan seharusnya bagaimana?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang tidak kena? Dalam permainan apa, dan apa yang sepatutnya berlaku?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat ging er mis? In welke game, en wat had er moeten gebeuren?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดอะไรผิดพลาด ในเกมไหน และควรจะเป็นอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne ters gitti? Hangi oyunda oldu, ne olmasını bekliyordunuz?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا غلط ہوا؟ کس گیم میں، اور کیا ہونا چاہیے تھا؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra sự cố gì? Ở trò chơi nào, và lẽ ra phải như thế nào?"
          }
        }
      }
    },
    "report.error.dailylimit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلت اليوم بلاغات كثيرة. جرّب ثانيةً في الغد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ অনেকগুলো রিপোর্ট পাঠানো হয়ে গেছে। কাল ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a lot of reports for today. Try again tomorrow."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Marami na kayong naipadalang ulat ngayon. Subukan ulit bukas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आप ढेर सारी रिपोर्ट भेज चुके हैं। कल फिर आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari ini laporan yang Anda kirim sudah banyak. Coba kirim lagi besok, ya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari ini anda sudah menghantar terlalu banyak laporan. Cuba semula esok, ya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn veel meldingen voor vandaag. Probeer morgen nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณส่งรายงานมาหลายครั้งแล้ว ลองใหม่ในวันพรุ่งนี้นะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün epey fazla bildirim yolladınız. Yarın tekrar deneyin lütfen."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج آپ کی بھیجی ہوئی رپورٹس بہت ہو گئیں۔ کل پھر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay bạn gửi khá nhiều báo cáo rồi. Mai bạn gửi tiếp nhé."
          }
        }
      }
    },
    "report.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصل بلاغك. جرّب ثانيةً بعد لحظات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোর্টটি যায়নি। খানিক বাদে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your report didn't go through. Please try again a little later."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naipadala ang inyong ulat. Pakisubukan muli mamaya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रिपोर्ट नहीं पहुँची। ज़रा रुककर दोबारा आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan Anda tidak terkirim. Silakan coba lagi beberapa saat lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan anda gagal dihantar. Cuba semula sebentar lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je melding is niet aangekomen. Probeer het straks nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรายงานไม่สำเร็จ โปรดลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildiriminiz iletilemedi. Lütfen biraz sonra yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی رپورٹ نہیں پہنچی۔ ذرا رک کر پھر سے آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo chưa gửi đi được. Bạn chờ một lát rồi gửi lại nhé."
          }
        }
      }
    },
    "report.error.network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصل بلاغك. تحقّق أنك متصل بالإنترنت ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোর্টটি যায়নি। ইন্টারনেট চালু কিনা দেখে ফের চেষ্টা করুন।"

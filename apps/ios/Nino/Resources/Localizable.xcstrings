    "xbox.audio.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في اللعب عن بُعد على Xbox يخرج صوت اللعبة من هذا الجهاز، لذا قد يؤدي إيقاف هذا الخيار إلى لعبة بلا صوت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox রিমোট প্লে-তে গেমের আওয়াজ এই ডিভাইস থেকেই আসে, তাই এটি বন্ধ করলে গেম চুপ হয়ে যেতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Xbox remote play the game's audio comes out of this device, so turning this off may leave the game silent."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Xbox remote play, sa device na ito lumalabas ang tunog ng laro, kaya baka tumahimik ang laro kapag in-off ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox रिमोट प्ले में गेम की आवाज़ इसी डिवाइस से निकलती है, इसलिए इसे बंद करने से गेम बेआवाज़ हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada remote play Xbox, suara game keluar dari perangkat ini, jadi mematikannya bisa membuat game senyap."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam main jauh Xbox, bunyi permainan keluar dari peranti ini, jadi mematikannya boleh menyebabkan permainan senyap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij Xbox-remote play komt het spelgeluid uit dit apparaat; schakel je dit uit, dan kan de game stil worden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Xbox remote play เสียงเกมจะออกจากอุปกรณ์นี้ การปิดตัวเลือกนี้จึงอาจทำให้เกมเงียบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox uzaktan oynatmada oyun sesi bu cihazdan çıkar; bunu kapatmak oyunu sessiz bırakabilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox ریموٹ پلے میں گیم کی آواز اسی ڈیوائس سے آتی ہے، اس لیے اسے بند کرنے سے گیم خاموش ہو سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với Xbox remote play, âm thanh game phát ra từ thiết bị này, nên tắt mục này có thể khiến game im lặng."
          }
        }
      }
    },
    "xbox.audio.toggle": {
      "extractionState": "manual",
      "localizations": {

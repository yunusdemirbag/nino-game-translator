    "session.error.inuse": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play مشغول الآن على جهاز مختلف"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play এখন আরেকটি ডিভাইসে চলছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play is busy on a different device"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ngayon ng ibang device ang Remote Play"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play अभी दूसरे डिवाइस पर चल रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play sedang dipakai di perangkat berbeda"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play sedang digunakan pada peranti berlainan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ander apparaat gebruikt Remote Play al"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play กำลังทำงานอยู่บนอุปกรณ์เครื่องอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play'i şu an farklı bir cihaz kullanıyor"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play ابھی کسی اور ڈیوائس پر چل رہا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play đang chạy trên một máy khác"
          }
        }
      }
    },
    "session.error.noanswer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجيب PS5. تحقّق أنه شغّال (لا بوضع الراحة)، ومتصل بشبكة Wi-Fi ذاتها مع هذا الهاتف، وأن خيار Remote Play مُفعّل لديه، ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 সাড়া দিচ্ছে না। সেটি চালু কিনা (রেস্ট মোড নয়), ফোনটা যে Wi-Fi-তে সেখানেই আছে কিনা, আর Remote Play অন করা কিনা দেখে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 isn't answering. Make sure it's switched on (rest mode won't do), shares this phone's Wi-Fi network and has Remote Play enabled, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sumasagot ang PS5. Siguraduhing bukas ito (hindi nasa rest mode), iisa ang Wi-Fi nito at ng telepono, at naka-enable ang Remote Play. Pagkatapos, subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 जवाब नहीं दे रहा। देखें कि वह ऑन हो (रेस्ट मोड वाला नहीं), उसी Wi-Fi से जुड़ा हो जिस पर यह फ़ोन है, और उसमें Remote Play ऑन हो; फिर एक बार और आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak menjawab. Cek apakah PS5 hidup (bukan mode istirahat), terhubung ke Wi-Fi yang sama seperti ponsel ini, serta Remote Play sudah diaktifkan, lalu coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada balasan daripada PS5. Pastikan PS5 hidup (tidak dalam mod rehat), menggunakan Wi-Fi sama seperti telefon ini, serta Remote Play diaktifkan, kemudian cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 reageert niet. Zorg dat hij echt aan is (rustmodus is niet genoeg), op de Wi-Fi van deze telefoon zit en Remote Play heeft ingeschakeld, en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่ตอบ ตรวจดูว่าเครื่องเปิดอยู่ (ไม่ใช่โหมดพัก) ต่อ Wi-Fi วงเดียวกับมือถือเครื่องนี้ และเปิดใช้ Remote Play แล้ว จากนั้นลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'ten yanıt gelmedi. PS5'in açık olduğundan (dinlenme modu yetmez), telefonunuzla aynı Wi-Fi'ı paylaştığından ve Remote Play'i etkin tuttuğundan emin olup tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 جواب نہیں دے رہا۔ دیکھیں کہ وہ چالو ہو (ریسٹ موڈ میں نہ ہو)، اسی Wi-Fi پر ہو جس پر یہ فون ہے، اور اس میں Remote Play چالو ہو؛ پھر ایک بار اور آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không trả lời. Bạn xem máy đã bật chưa (không phải chế độ nghỉ), có chung Wi-Fi với máy này không, đã mở Remote Play chưa, rồi thử thêm lần nữa."
          }
        }
      }
    },
    "session.error.nopicture": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تصل صورة من PS5. تأكّد أن Remote Play غير مُطفأ وأن PS5 ليس بوضع الراحة، ثم أعد البدء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 থেকে কোনো দৃশ্য আসছে না। দেখুন Remote Play অফ কিনা, বা PS5 রেস্ট মোডে চলে গেছে কিনা; তারপর গোড়া থেকে শুরু করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No picture is coming from the PS5. See whether Remote Play is disabled or the PS5 is resting, then start again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang larawang ipinapadala ang PS5. Tingnan kung naka-disable ang Remote Play nito, o kung nasa rest mode ito, saka magsimula ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 से तस्वीर नहीं आ रही। देखें कहीं Remote Play बंद तो नहीं, या कहीं PS5 रेस्ट मोड पर तो नहीं; फिर नए सिरे से शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar tidak dikirim oleh PS5. Cek apakah Remote Play dimatikan atau PS5 sedang mode istirahat, lalu mulai dari awal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak menghantar gambar. Periksa sama ada Remote Play dinyahaktifkan atau PS5 sedang dalam mod rehat, kemudian mula semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 stuurt geen beeld door. Kijk of Remote Play uit staat of de PS5 rust, en begin daarna opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่ส่งภาพมา โปรดตรวจสอบว่า Remote Play ปิดอยู่หรือ PS5 อยู่ในโหมดพักหรือไม่ แล้วเริ่มใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'ten görüntü gelmiyor. Remote Play kapalı ya da PS5 dinlenme modunda olabilir; kontrol edip baştan başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 سے تصویر نہیں آ رہی۔ دیکھیں کہیں Remote Play بند تو نہیں، یا کہیں PS5 ریسٹ موڈ پر تو نہیں؛ پھر نئے سرے سے شروع کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không truyền hình sang. Xem thử Remote Play có đang tắt, hoặc PS5 đang nghỉ không, rồi làm lại từ đầu."
          }
        }
      }
    },
    "session.error.notatip": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد PS5 عند %@. تحقّق أنه شغّال ومتصل بالشبكة ذاتها. نحاول الاتصال ثانيةً…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ঠিকানাতে PS5 মেলেনি। সেটি চালু কিনা, একই নেটওয়ার্কে কিনা দেখুন। ফের যুক্ত হওয়ার চেষ্টা চলছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no PS5 at %@. Make sure it's switched on and shares your network. Reconnecting…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang PS5 sa %@. Siguraduhing bukas ito at iisa ang network. Sinusubukang kumonekta ulit…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर PS5 मौजूद नहीं। देखें कि वह ऑन हो और उसी Wi‑Fi पर हो। दोबारा जोड़ने की कोशिश जारी है…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada PS5 di %@. Cek apakah PS5 sudah menyala dan memakai jaringan yang sama. Mencoba menyambung ulang…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak dijumpai di %@. Pastikan PS5 hidup dan menggunakan rangkaian sama. Sedang cuba menyambung semula…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op %@ is geen PS5 gevonden. Kijk of hij is ingeschakeld en jouw netwerk deelt. Bezig met opnieuw verbinden…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เจอ PS5 ที่ %@ ตรวจดูว่าเครื่องเปิดอยู่และใช้เครือข่ายเดียวกัน กำลังลองเชื่อมใหม่…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresinde PS5 yok. Cihazın açık ve sizinle aynı ağa bağlı olduğundan emin olun. Bağlantı yeniden deneniyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ پر PS5 موجود نہیں۔ دیکھیں کہ وہ چالو ہو اور اسی Wi‑Fi پر ہو۔ پھر سے جوڑنے کی کوشش جاری ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thấy PS5 ở %@. Bạn xem máy đã bật và chung mạng chưa. Đang nối lại…"
          }
        }
      }
    },
    "session.error.notstarted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبدأ PS5 أي جلسة. ربما PS Remote Play مفتوح في مكان آخر، أو أن PS5 مشغول بجلسة أخرى. أغلق تطبيق PS Remote Play، ثم أعد تشغيل جهاز PS5، وجرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 সেশন চালু করল না। হয়তো PS Remote Play অন্য কোথাও খোলা, কিংবা PS5 ইতিমধ্যে কোনো সেশনে ব্যস্ত। PS Remote Play থেকে বেরিয়ে আসুন, PS5 রিস্টার্ট দিন, তারপর ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 refused to begin a session. PS Remote Play might be running elsewhere, or the PS5 might be busy with another session. Quit PS Remote Play, reboot the PS5, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw magsimula ng session ng PS5. Baka may nakabukas na PS Remote Play sa iba pang device, o may session na ang PS5. Isara muna ang app na PS Remote Play, tapos i-restart ang console at subukan muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ने सत्र नहीं खोला। शायद किसी और जगह PS Remote Play ऐप खुला है, या PS5 पहले ही किसी सत्र में लगा है। सबसे पहले PS Remote Play ऐप बंद करें, उसके बाद PS5 रीस्टार्ट करके आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak mau memulai sesi. Mungkin PS Remote Play sedang terbuka di perangkat lain, atau PS5 sudah dalam sesi. Tutup aplikasi PS Remote Play, nyalakan ulang PS5, kemudian ulangi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 enggan memulakan sesi. PS Remote Play barangkali terbuka di tempat lain, atau PS5 sudah berada dalam sesi. Tutup apl PS Remote Play, hidupkan semula PS5, lalu cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 wilde geen sessie beginnen. Misschien draait PS Remote Play ergens anders, of zit de PS5 al in een sessie. Stop eerst PS Remote Play, start je console opnieuw en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่ยอมเริ่มเซสชัน PS Remote Play อาจเปิดอยู่ที่อื่น หรือ PS5 อาจอยู่ในเซสชันอยู่แล้ว โปรดปิด PS Remote Play รีสตาร์ท PS5 แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 oturumu başlatmadı. PS Remote Play başka yerde açık kalmış veya PS5 hâlihazırda başka bir oturuma bağlı olabilir. PS Remote Play'den çıkın, PS5'i kapatıp açın ve tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 نے سیشن نہیں کھولا۔ شاید PS Remote Play کہیں اور کھلا ہے، یا PS5 پہلے ہی کسی سیشن میں ہے۔ PS Remote Play ایپ بند کریں، PS5 کو ری اسٹارٹ کر کے پھر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không chịu mở phiên. Có lẽ PS Remote Play còn mở ở chỗ khác, hoặc PS5 đã có một phiên đang chạy. Hãy thoát PS Remote Play, cho PS5 khởi động lại rồi thử thêm lần nữa."
          }
        }
      }
    },
    "session.error.refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يسمح PS5 لـ Nino بالاتصال. أعد إقران الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 Nino-কে যুক্ত হতে দেয়নি। কনসোলটি আবার পেয়ার করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 wouldn't let Nino connect. Pair the console again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pinayagan ng PS5 na kumonekta ang Nino. I-pair muli ang console."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ने Nino को जुड़ने नहीं दिया। कंसोल को फिर से पेयर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak mengizinkan Nino tersambung. Pasangkan ulang konsolnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak membenarkan Nino bersambung. Gandingkan semula konsol itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 liet Nino niet verbinden. Koppel de console opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่ให้ Nino เชื่อมต่อ จับคู่เครื่องใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, Nino'nun bağlanmasına izin vermedi. Konsolu yeniden eşleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 نے Nino کو جڑنے نہیں دیا۔ کنسول کو دوبارہ پیئر کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không cho Nino kết nối. Hãy ghép đôi máy lại."
          }
        }
      }
    },
    "session.error.rejected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض PS5 الاتصال (رمز الخطأ %@). ربما PS Remote Play مفتوح في مكان آخر، أو أن PS5 مشغول بجلسة أخرى. أغلق تطبيق PS Remote Play، ثم أعد تشغيل جهاز PS5، وجرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 সংযোগে রাজি হয়নি (কোড %@)। হয়তো PS Remote Play অন্য কোথাও খোলা, কিংবা PS5 ইতিমধ্যে কোনো সেশনে ব্যস্ত। PS Remote Play থেকে বেরিয়ে আসুন, PS5 রিস্টার্ট দিন, তারপর ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 turned the connection away (code %@). PS Remote Play might be running elsewhere, or the PS5 might be busy with another session. Quit PS Remote Play, reboot the PS5, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw tanggapin ng PS5 ang pagkonekta (code %@). Baka may nakabukas na PS Remote Play sa iba pang device, o may session na ang PS5. Isara muna ang app na PS Remote Play, tapos i-restart ang console at subukan muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ने कनेक्शन नहीं माना (कोड %@)। शायद किसी और जगह PS Remote Play ऐप खुला है, या PS5 पहले ही किसी सत्र में लगा है। सबसे पहले PS Remote Play ऐप बंद करें, उसके बाद PS5 रीस्टार्ट करके आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi ditolak oleh PS5 (kode %@). Mungkin PS Remote Play sedang terbuka di perangkat lain, atau PS5 sudah dalam sesi. Tutup aplikasi PS Remote Play, nyalakan ulang PS5, kemudian ulangi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan ditolak oleh PS5 (kod %@). PS Remote Play barangkali terbuka di tempat lain, atau PS5 sudah berada dalam sesi. Tutup apl PS Remote Play, hidupkan semula PS5, lalu cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 wees de verbinding af (code %@). Misschien draait PS Remote Play ergens anders, of zit de PS5 al in een sessie. Stop eerst PS Remote Play, start je console opnieuw en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ปฏิเสธการเชื่อมต่อ (รหัส %@) PS Remote Play อาจเปิดอยู่ที่อื่น หรือ PS5 อาจอยู่ในเซสชันอยู่แล้ว โปรดปิด PS Remote Play รีสตาร์ท PS5 แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bağlantıyı geri çevirdi (kod %@). PS Remote Play başka yerde açık kalmış veya PS5 hâlihazırda başka bir oturuma bağlı olabilir. PS Remote Play'den çıkın, PS5'i kapatıp açın ve tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 نے کنکشن نہیں مانا (کوڈ %@)۔ شاید PS Remote Play کہیں اور کھلا ہے، یا PS5 پہلے ہی کسی سیشن میں ہے۔ PS Remote Play ایپ بند کریں، PS5 کو ری اسٹارٹ کر کے پھر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không cho kết nối (lỗi %@). Có lẽ PS Remote Play còn mở ở chỗ khác, hoặc PS5 đã có một phiên đang chạy. Hãy thoát PS Remote Play, cho PS5 khởi động lại rồi thử thêm lần nữa."
          }
        }
      }
    },
    "session.error.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز PS5 لا يستجيب. جارٍ محاولة إعادة الاتصال…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 সাড়া দিচ্ছে না। আবার সংযোগের চেষ্টা চলছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 isn't responding. Trying to reconnect…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sumasagot ang PS5. Sinusubukang kumonekta muli…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 जवाब नहीं दे रहा। दोबारा जोड़ने की कोशिश जारी है…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak merespons. Mencoba menyambung ulang…"
          }
        },
        "ms": {
          "stringUnit": {

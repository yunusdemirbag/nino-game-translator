    "notify.stopped": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت الترجمة. افتح تطبيق Nino لتتصل من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবটাইটেল থেমে গেছে। ফের যুক্ত হতে Nino খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitles have stopped. To reconnect, open Nino."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumigil ang subtitle. Buksan ulit ang Nino para muling kumonekta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबटाइटल बंद हो गए हैं। दोबारा जोड़ने को Nino खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitle terhenti. Buka Nino agar tersambung kembali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sari kata sudah berhenti. Buka Nino supaya bersambung semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ondertitels zijn gestopt. Open Nino als je weer wilt verbinden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำบรรยายหยุดแล้ว เปิด Nino เพื่อเชื่อมต่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazılar durdu. Tekrar bağlanmak için Nino'yu açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب ٹائٹلز بند ہو گئے ہیں۔ پھر جوڑنے کو Nino کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ đề đã ngừng. Hãy mở Nino để nối lại."
          }
        }
      }
    },

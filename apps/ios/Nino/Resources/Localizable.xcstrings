    "oldios.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار iOS في هذا الـ iPhone هو %@. تحتاج ترجمة Apple المجانية داخل الجهاز إلى iOS 26 فما فوق. ما زالت GTA 6 تعمل، وتصلك نصوصها مجانًا من الترجمة التي يتشاركها مستخدمو Nino. ولأي لعبة غيرها، أدخل مفتاحًا مجانيًا لـ Gemini من الإعدادات › خدمة الترجمة › Gemini. الحصول عليه من Google يأخذ دقيقة تقريبًا ولا يكلّف شيئًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এ চলছে iOS %@। ফোনের ভেতরে Apple-এর ফ্রি অনুবাদ চালাতে iOS 26 বা তার পরের সংস্করণ দরকার। GTA 6 এরপরও কাজ করে: Nino-র যৌথ অনুবাদ ভান্ডার থেকে সাবটাইটেল আসে, বিনামূল্যে। বাকি সব গেমে একটি ফ্রি Gemini কী বসিয়ে নিন (সেটিংস › ইঞ্জিন বাছাই › Gemini)। কী পেতে Google-এ মিনিটখানেক লাগে, পয়সাও লাগে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone is on iOS %@. Apple's built-in free translation requires iOS 26 or newer. GTA 6 keeps working: Nino's shared library gives you its subtitles for free. For any other game, add a Gemini key at no cost (Settings › Translation engine, then Gemini). Google gives you one in roughly a minute, for free."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-iOS %@ ang iPhone mo. Para sa libreng on-device na pagsasalin ng Apple, kailangan ang iOS 26 pataas. Gagana pa ang GTA 6, dahil libre ang subtitle mula sa pinagsasaluhang salin ng Nino. Sa iba pang laro, maglagay ng Gemini key na libre (Mga Setting › Engine ng pagsasalin › Gemini). Halos isang minuto ang pagkuha nito sa Google, at walang bayad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह iPhone अभी iOS %@ पर है। Apple वाला मुफ़्त अनुवाद फ़ोन के अंदर ही होता है और iOS 26 या उससे नए संस्करण पर ही चलता है। GTA 6 अब भी चलता है; उसके सबटाइटल सभी Nino उपयोगकर्ताओं के साझा किए अनुवादों से मुफ़्त मिलते हैं। बाकी गेम के लिए Gemini की मुफ़्त कुंजी डालें (सेटिंग्स › अनुवाद सेवा › Gemini)। Google से यह कुंजी क़रीब एक मिनट में बिना किसी शुल्क के मिल जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi iOS di iPhone ini %@. Terjemahan bawaan Apple yang gratis butuh iOS 26 ke atas. GTA 6 masih bisa dipakai, karena subtitlenya didapat gratis lewat terjemahan bersama milik Nino. Bagi game lainnya, pasang kunci Gemini yang gratis (Pengaturan › Layanan terjemahan › Gemini). Membuatnya di Google kira-kira satu menit saja dan tanpa biaya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi iOS pada iPhone ini ialah %@. Terjemahan Apple pada peranti yang percuma itu perlukan iOS 26 ke atas. GTA 6 masih boleh dimainkan, sari katanya datang percuma dari terjemahan bersama Nino. Bagi permainan lain, masukkan kunci Gemini yang percuma (Seting › Enjin terjemahan › Gemini). Kunci itu boleh diperoleh daripada Google dalam lebih kurang seminit, tanpa bayaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op deze iPhone draait iOS %@. Apple vertaalt alleen gratis op het toestel vanaf iOS 26. GTA 6 blijft werken: Nino levert die ondertitels kosteloos uit de gedeelde bibliotheek. Wil je andere games spelen, voeg dan zonder kosten een Gemini-sleutel in (Instellingen › Vertaalengine › Gemini). Google geeft je er in zo'n minuut een, kosteloos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone นี้ใช้ iOS %@ อยู่ ระบบแปลฟรีบนเครื่องของ Apple ต้องการ iOS 26 หรือใหม่กว่า สำหรับ GTA 6 ยังเล่นได้ตามปกติ เพราะได้คำบรรยายฟรีจากคำแปลที่ Nino แชร์ร่วมกัน ส่วนเกมอื่นให้เพิ่มคีย์ Gemini แบบฟรี (การตั้งค่า › บริการแปล › Gemini) ขอคีย์จาก Google ได้ในราวหนึ่งนาที ไม่เสียเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone iOS %@ sürümünde. Apple'ın telefonda çalışan bedava çevirisi iOS 26 veya üstünü istiyor. GTA 6 çalışmaya devam eder; altyazıları Nino'nun paylaşılan çeviri havuzundan bedava gelir. Başka bir oyun oynayacaksanız bedava bir Gemini anahtarı girin (Ayarlar › Çeviri motoru, sonra Gemini). Google'dan almak yaklaşık bir dakikanızı alır, ücret ödemezsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ iPhone ابھی iOS %@ استعمال کر رہا ہے۔ Apple والا مفت ترجمہ فون کے اندر ہی ہوتا ہے اور iOS 26 یا اس سے نئے ورژن پر ہی چلتا ہے۔ GTA 6 اب بھی چلتی ہے؛ اس کی سب ٹائٹلز Nino کے سانجھے ترجمے سے مفت ملتی ہیں۔ باقی گیمز کے لیے Gemini کی مفت کلید ڈالیں (ترتیبات › ترجمہ انجن › Gemini)۔ یہ کلید Google قریب ایک منٹ میں بلا معاوضہ دے دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy này chạy iOS %@. Tính năng dịch miễn phí có sẵn của Apple đòi hỏi iOS 26 hoặc mới hơn. Với GTA 6 thì vẫn ổn, phụ đề lấy miễn phí từ kho dịch dùng chung của Nino. Còn game khác, bạn hãy thêm một khóa Gemini free (Cài đặt › Dịch vụ dịch › Gemini). Xin khóa ở Google mất chừng một phút, hoàn toàn không tốn đồng nào."
          }
        }
      }
    },

    "settings.engine.badkey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعمل هذا المفتاح. تحقق منه وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী-টি কাজ করেনি। আবার মিলিয়ে দেখে চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That key didn't work. Double-check it and try once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tinanggap ang key na iyan. Tingnan itong mabuti, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कुंजी काम नहीं आई। इसे दोबारा जाँचें और एक बार और कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci itu tidak berfungsi. Periksa kembali dan coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci itu tidak berfungsi. Semak semula dan cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutel doet het niet. Kijk hem goed na en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์นี้ใช้ไม่ได้ โปรดตรวจสอบอีกครั้งแล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtar işe yaramadı. Gözden geçirip bir kez daha deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کلید نہیں چلی۔ اسے غور سے دیکھیں اور ایک بار اور آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa này không dùng được. Bạn kiểm tra kỹ rồi thử thêm lần nữa."
          }
        }
      }
    },

        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs Nino's TV app straight onto your Samsung TV, using only this phone — no computer required. The phone and TV need to share one Wi-Fi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini-install sa Samsung TV ninyo ang TV app ng Nino diretso mula sa teleponong ito, kahit walang computer. Kailangang nasa iisang Wi-Fi ang telepono at TV."

    "report.contact.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف نتواصل معك؟ (اختياري)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা আপনার সাথে কীভাবে যোগাযোগ করব? (ঐচ্ছিক)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How should we contact you? (optional)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paano namin kayo makokontak? (opsiyonal)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप तक कैसे पहुँचें? (वैकल्पिक)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana kami menghubungi Anda? (opsional)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana cara menghubungi anda? (tidak wajib)"
          }
        },
        "nl": {
          "stringUnit": {

          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่ตอบสนอง กำลังพยายามเชื่อมต่อใหม่…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 yanıt vermiyor. Tekrar bağlanmaya çalışılıyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 جواب نہیں دے رہا۔ پھر سے جوڑنے کی کوشش جاری ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không đáp lại. Đang nối lại…"
          }
        }
      }
    },

    "home.start.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط حين تكون اللعبة مفتوحة على PS5. سيلتقط الهاتف المشهد، ويقرأ النصوص، ثم يترجمها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এ গেম খুলে গেলে ট্যাপ করুন। ফোন দৃশ্যটি ধরে, সাবটাইটেল পড়ে তা অনুবাদ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap when the game is running on your PS5. Your phone captures the image, reads each subtitle and translates it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap kapag nakabukas na sa PS5 ang laro. Kukunin ng telepono ang imahe, babasahin ang subtitle, at isasalin ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब PS5 पर गेम खुल जाए, तब टैप करें। इसके बाद फ़ोन तस्वीर लेकर सबटाइटल पढ़ेगा और अनुवाद कर देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk setelah game terbuka di PS5. Ponsel menangkap gambar, membaca subtitle, lalu menerjemahkannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik apabila permainan sudah dibuka di PS5. Telefon akan menangkap gambar, membaca sari katanya lalu menterjemahkannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik zodra de game draait op je PS5. Je telefoon pakt het beeld, leest elke ondertitel en vertaalt hem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเมื่อเปิดเกมบน PS5 แล้ว โทรศัพท์จะจับภาพ อ่านคำบรรยาย และแปลให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun PS5'te açılınca dokunun. Telefon görüntüyü yakalar, altyazıları okur ve çevirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب PS5 پر گیم کھل جائے تو تھپتھپائیں۔ فون تصویر لے کر سب ٹائٹلز پڑھے گا اور ترجمہ کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm khi game đã mở trên PS5. Lúc đó điện thoại sẽ lấy hình, đọc phần phụ đề rồi dịch ra."
          }
        }
      }
    },

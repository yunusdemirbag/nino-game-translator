    "tvi.android.localnet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج تصحيح الأخطاء اللاسلكي إلى إذن الشبكة المحلية لتطبيق Nino على هذا الـ iPhone (الإعدادات › Nino)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়্যারলেস ডিবাগিং-এর জন্য এই iPhone-এ Nino-র লোকাল নেটওয়ার্ক অনুমতি লাগবে (সেটিংস › Nino)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wireless debugging needs Nino's Local Network permission on this iPhone (Settings › Nino)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa wireless debugging, kailangang may pahintulot ang Nino na gumamit ng Local Network sa iPhone (Settings › Nino)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वायरलेस डीबगिंग चलाने को इस iPhone पर Nino को “लोकल नेटवर्क” इस्तेमाल करने की इजाज़त चाहिए (सेटिंग्स › Nino)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug nirkabel butuh izin Jaringan Lokal bagi Nino di iPhone ini (Pengaturan › Nino)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk penyahpepijatan wayarles, Nino perlu kebenaran Rangkaian Setempat di iPhone ini (Tetapan › Nino)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor draadloze foutopsporing heeft Nino toestemming voor Lokaal netwerk nodig op deze iPhone (Instellingen › Nino)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแก้ไขข้อบกพร่องผ่าน Wi-Fi ต้องให้สิทธิ์ เครือข่ายเฉพาะที่ แก่ Nino บน iPhone เครื่องนี้ (การตั้งค่า › Nino)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kablosuz hata ayıklamanın çalışması için Nino'ya bu iPhone'da Yerel Ağ izni verilmeli (Ayarlar › Nino)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وائرلیس ڈیبگنگ چلانے کو اس iPhone پر Nino کو «لوکل نیٹ ورک» استعمال کرنے دیں (ترتیبات › Nino)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muốn gỡ lỗi qua Wi-Fi, Nino cần quyền dùng Mạng cục bộ trên iPhone (Cài đặt › Nino)."
          }
        }
      }
    },

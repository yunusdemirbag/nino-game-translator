    "langpack.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزّلها مرة واحدة، وبعدها تعمل الترجمة دون إنترنت أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার ডাউনলোড করুন; তারপর ইন্টারনেট ছাড়াও অনুবাদ চলবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download it once; after that, translation also works offline."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang download lang; mula roon, gumagana ang pagsasalin offline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे एक बार डाउनलोड करें; उसके बाद अनुवाद बिना इंटरनेट भी चलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh sekali saja; setelah itu terjemahan juga jalan tanpa internet."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun sekali; selepas itu terjemahan juga berfungsi tanpa internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer downloaden; daarna werkt vertalen ook zonder internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดครั้งเดียว จากนั้นแปลได้แม้ไม่มีอินเทอร์เน็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez indirin; sonra çeviri internetsiz de çalışır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف ایک ڈاؤن لوڈ؛ اس کے بعد ترجمہ آف لائن چلتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần tải về một lần; từ đó dịch được cả ngoại tuyến."
          }
        }
      }
    },

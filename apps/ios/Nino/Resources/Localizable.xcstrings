          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun 8 hanesini de girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوڈ کے تمام 8 ہندسے درج کریں۔"
          }
        },

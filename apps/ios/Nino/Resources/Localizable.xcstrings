    "report.log.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعدنا ذلك على تحديد سبب المشكلة. لا تُضاف كلمات المرور والمفاتيح أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে সমস্যাটি খুঁজে পেতে আমাদের সুবিধা হয়। পাসওয়ার্ড ও কী কখনো যোগ করা হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This helps us track down the issue. Passwords and keys are never added."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakakatulong ito para mahanap namin ang problema. Hindi kailanman isinasama ang mga password at key."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे हमें समस्या का पता लगाने में मदद मिलती है। पासवर्ड और कुंजियाँ कभी नहीं जोड़ी जातीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membantu kami melacak masalahnya. Kata sandi dan kunci tidak pernah disertakan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membantu kami mengesan masalah. Kata laluan dan kunci tidak pernah disertakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo kunnen we het probleem opsporen. Wachtwoorden en sleutels worden nooit toegevoegd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยให้เราหาสาเหตุของปัญหาได้ จะไม่มีการแนบรหัสผ่านและคีย์ใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunun kaynağını bulmamızı kolaylaştırır. Parolalar ve anahtarlar asla eklenmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے ہمیں مسئلہ تلاش کرنے میں مدد ملتی ہے۔ پاس ورڈز اور کلیدیں کبھی شامل نہیں کی جاتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhờ vậy chúng tôi dễ lần ra lỗi hơn. Mật khẩu và khóa không bao giờ có trong đó."
          }
        }
      }
    },

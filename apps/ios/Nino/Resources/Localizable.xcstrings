    "xbox.beta.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعم Xbox في مرحلة تجريبية (Beta). إذا تعطّل أي شيء، فأخبرنا وسنصلحه سريعًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox সমর্থন বেটা পর্যায়ে আছে। কিছু ভাঙলে আমাদের জানান, আমরা দ্রুত ঠিক করে দেব।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox support is still a Beta. Something broken? Tell us — we'll sort it out fast."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta pa lang ang Xbox. Kapag may nasira, sabihan kami at aayusin namin agad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox सपोर्ट अभी Beta है। कोई दिक़्क़त आए तो हमें बता दें, हम जल्द सुधार देंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur Xbox masih tahap Beta. Kalau ada yang tidak jalan, kabari kami, nanti segera kami perbaiki."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sokongan Xbox masih Beta. Jika ada yang tidak berfungsi, maklumkan kepada kami, kami akan segera membaikinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox-ondersteuning is nog in bèta. Werkt iets niet, vertel het ons en we pakken het snel aan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรองรับ Xbox ยังเป็นรุ่น Beta หากมีอะไรผิดพลาด โปรดแจ้งเรา แล้วเราจะรีบแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox desteği Beta aşamasında. Bir şey ters giderse bize haber verin, en kısa sürede düzeltelim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox سپورٹ ابھی Beta ہے۔ کوئی مسئلہ آئے تو ہمیں بتا دیں، ہم جلد درست کر دیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỗ trợ Xbox còn là bản Beta. Có gì hỏng, bạn cứ nói, chúng tôi sẽ sửa sớm."
          }
        }
      }
    },
    "xbox.choose.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجهزة Xbox المرتبطة بحسابك. في جهاز Xbox، افتح الإعدادات › الأجهزة والاتصالات وشغّل «الميزات عن بُعد»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্টে যুক্ত Xbox-গুলো। Xbox-এ Settings খুলে Devices & connections-এর Remote features অন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xboxes linked to you. On the Xbox, enable Remote features under Settings › Devices & connections."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga Xbox na naka-link sa account ninyo. Sa console, buksan ang Remote features (nasa Settings › Devices & connections)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खाते से जुड़े Xbox। Xbox में Settings › Devices & connections के अंदर Remote features ऑन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar Xbox yang tertaut ke akun Anda. Pada Xbox, nyalakan Remote features (ada di Settings, lalu Devices & connections)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox yang dipautkan pada akaun ini. Di Xbox, aktifkan Settings › Devices & connections › Remote features."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xboxen die bij je account horen. Schakel op de Xbox Externe functies in, te vinden in Instellingen bij Apparaten en verbindingen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox ที่เชื่อมโยงกับบัญชีของคุณ บน Xbox ให้เปิด การตั้งค่า › อุปกรณ์และการเชื่อมต่อ › ฟีเจอร์ระยะไกล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınıza kayıtlı Xbox'lar. Xbox'ın Ayarlar'ında Cihazlar ve bağlantılar altından Uzak özellikler'i açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے اکاؤنٹ سے جڑے Xbox۔ Xbox میں Settings › Devices & connections کے اندر Remote features چالو کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những Xbox đã gắn với tài khoản. Trên Xbox, vào Settings, chọn Devices & connections, rồi bật Remote features."
          }
        }
      }
    },
    "xbox.choose.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب لم يرتبط به أي Xbox حتى الآن. ادخل إلى Xbox بهذا الحساب ذاته، ثم شغّل «الميزات عن بُعد»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টে এখনো Xbox যুক্ত হয়নি। Xbox-এ এই অ্যাকাউন্টেই লগ ইন করে Remote features অন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no Xbox on this account yet. Sign in on the Xbox with this same account and switch on remote features."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang Xbox sa account. Mag-log in sa Xbox sa account ding ito at buksan ang remote features."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते से अभी कोई Xbox नहीं जुड़ा। Xbox में यही खाता लगाकर Remote features ऑन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini belum punya Xbox. Login di Xbox memakai akun yang sama, lalu nyalakan Remote features."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada Xbox dalam akaun ini. Di Xbox, log masuk menggunakan akaun yang serupa, kemudian aktifkan ciri jauh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij dit account hoort nog geen Xbox. Meld je met ditzelfde account op de Xbox aan en schakel externe functies in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้ยังไม่มี Xbox ลงชื่อเข้าใช้บน Xbox ด้วยบัญชีเดียวกันนี้ แล้วเปิดฟีเจอร์ระยะไกล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesaba bağlı bir Xbox henüz yok. Aynı hesapla Xbox'ta oturum açıp uzak özellikleri etkinleştirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ سے ابھی کوئی Xbox نہیں جڑا۔ Xbox میں یہی اکاؤنٹ لگا کر Remote features چالو کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này chưa gắn Xbox nào. Trên Xbox, đăng nhập đúng tài khoản này rồi bật tính năng điều khiển từ xa."
          }
        }
      }
    },
    "xbox.choose.off": {

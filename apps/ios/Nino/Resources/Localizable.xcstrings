    "ob.p3.wifi.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِل PS5 والتلفزيون والهاتف بشبكة واحدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, TV আর ফোন এক নেটওয়ার্কে রাখুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the PS5, the TV and your phone on one network"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang network lang para sa telepono, TV, at PS5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, टीवी और फ़ोन एक ही Wi‑Fi से जुड़े हों"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan PS5, TV, serta ponsel ke jaringan yang sama"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan PS5, TV serta telefon pada satu rangkaian"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd PS5, tv én telefoon op één netwerk"

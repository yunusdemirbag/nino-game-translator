    "ask.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسئلة كثيرة في هذه اللحظة. جرّب ثانيةً بعد لحظات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে প্রশ্নের ভিড় চলছে। খানিক বাদে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lots of questions right now. Please try again shortly."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maraming tanong ngayon. Pakisubukan muli mamaya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय सवालों की भीड़ है। ज़रा रुककर दोबारा पूछें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang banyak pertanyaan. Mohon coba lagi nanti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak soalan sekarang. Sila cuba lagi sebentar nanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er komen nu veel vragen binnen. Probeer het zo meteen opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้มีคำถามเข้ามาเยอะมาก โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an çok fazla soru var. Lütfen az sonra yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی بہت سے سوالات آ رہے ہیں۔ براہِ کرم تھوڑی دیر بعد کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc này đang có rất nhiều câu hỏi. Bạn chờ chút rồi hỏi lại nhé."
          }
        }
      }
    },
    "ask.error.dailylimit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه أسئلة كثيرة لليوم 🙂 لنكمل غدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ তো অনেক প্রশ্ন হলো 🙂 বাকিটা কাল হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a lot of questions for today 🙂 Let's pick up tomorrow."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang dami nang tanong para sa araw na ito 🙂 Ituloy natin bukas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के लिए काफ़ी सवाल हो गए 🙂 कल वहीं से आगे बढ़ते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Banyak sekali pertanyaan hari ini 🙂 Kita lanjutkan besok, ya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah banyak soalan hari ini 🙂 Esok kita teruskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn veel vragen voor vandaag 🙂 We gaan morgen verder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ถามมาเยอะแล้ว 🙂 ไว้ต่อกันพรุ่งนี้นะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün epey soru sordunuz 🙂 Yarın kaldığımız yerden devam edelim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کافی سوال ہو چکے 🙂 باقی کل دیکھیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay mình đã trò chuyện khá nhiều 🙂 Hẹn bạn ngày mai nhé."
          }
        }
      }
    },
    "ask.error.network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا رد من الخادم. افحص الإنترنت لديك ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভার থেকে উত্তর আসেনি। ইন্টারনেট সংযোগ পরীক্ষা করে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer from the server. Make sure you're online, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sumagot ang server. Tingnan ang inyong koneksiyon at subukan muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर से कोई जवाब नहीं आया। इंटरनेट देख लें, फिर एक बार और आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak merespons. Cek internet Anda, lalu coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan tidak menjawab. Periksa sambungan internet, kemudian cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen antwoord van de server. Kijk of je online bent en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ไม่ตอบสนอง โปรดตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yanıt vermedi. Bağlantınızı kontrol edip bir kez daha deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور کی طرف سے جواب نہیں آیا۔ انٹرنیٹ دیکھ لیں، پھر ایک بار اور آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ chưa trả lời. Bạn xem lại mạng rồi thử thêm lần nữa."
          }
        }
      }
    },
    "ask.error.notready": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتربتُ من الاكتمال! حاليًا، ابعث سؤالك من «الإبلاغ عن مشكلة» وسيجيبك الفريق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি প্রায় প্রস্তুত! আপাতত সমস্যা রিপোর্ট করুন অংশ থেকে প্রশ্ন পাঠান, আমাদের দল জবাব দেবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearly done! Meanwhile, ask through Report an Issue — the team answers there."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Halos handa na ako! Sa ngayon, ipadala ninyo ang tanong sa pamamagitan ng Mag-ulat ng Problema; sasagutin ito ng team."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं बस तैयार होने वाला हूँ! तब तक “समस्या रिपोर्ट करें” से सवाल भेज दें, टीम आपको जवाब देगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya hampir siap! Untuk sementara, kirim pertanyaan Anda melalui Laporkan Masalah dan tim akan membalas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya hampir siap! Buat masa ini, kirim soalan anda melalui Laporkan Masalah; pasukan kami akan menjawabnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna zover! Heb je nu al een vraag, stuur hem dan met de knop Probleem melden; het team reageert daar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใกล้พร้อมแล้ว! ระหว่างนี้โปรดส่งคำถามผ่าน “รายงานปัญหา” แล้วทีมงานจะตอบกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır olmama az kaldı! O zamana kadar sorunuzu Sorunu Bildir ile gönderin, ekip size yanıt versin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں بس تیار ہونے والا ہوں! فی الحال «مسئلہ رپورٹ کریں» میں سوال لکھ بھیجیں، ٹیم آپ کو جواب دے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình gần xong rồi! Tạm thời bạn hãy dùng mục Báo lỗi để gửi câu hỏi, nhóm sẽ phản hồi."
          }
        }
      }
    },
    "ask.error.toolarge": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا أكبر مما أستطيع استقباله. أزل صورة واحدة وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতটা আমি নিতে পারছি না। একটা ছবি বাদ দিয়ে ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's more than I can take. Remove one photo and try once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrang laki niyan para sa akin. Magtanggal ng isang litrato, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतना मैं नहीं संभाल सकता। कोई एक फ़ोटो निकालें और फिर आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu terlalu besar untuk saya. Hapus satu foto dan coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu melebihi had saya. Keluarkan sekeping foto, kemudian cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is te veel voor mij. Haal één foto eruit en probeer nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใหญ่เกินกว่าที่ฉันรับได้ โปรดลบรูปภาพออกหนึ่งรูปแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu benim için fazla büyük. Bir fotoğrafı çıkarıp bir kez daha deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اتنا بوجھ میں نہیں اٹھا سکتا۔ ایک تصویر نکالیں اور پھر سے آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung này hơi nhiều với mình. Bạn gỡ đi một tấm ảnh rồi gửi lại nhé."
          }
        }
      }
    },
    "ask.error.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أفهم هذه الرسالة. هل يمكنك صياغتها بطريقة أخرى؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বার্তাটি আমি বুঝতে পারিনি। অন্যভাবে লিখে দেখবেন?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't make sense of that message. Could you phrase it another way?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ko naintindihan ang mensaheng iyon. Puwede ba ninyong sabihin sa ibang paraan?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं यह संदेश समझ नहीं पाया। क्या आप इसे किसी और तरह से लिख सकते हैं?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tidak memahami pesan itu. Bisakah Anda menuliskannya dengan cara lain?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tidak faham mesej itu. Boleh anda tulis dengan cara lain?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begreep dat bericht niet. Kun je het anders verwoorden?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันไม่เข้าใจข้อความนั้น ช่วยเขียนใหม่อีกแบบได้ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesajı anlayamadım. Başka bir şekilde yazabilir misiniz?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں یہ پیغام سمجھ نہیں سکا۔ کیا آپ اسے کسی اور طرح لکھ سکتے ہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chưa hiểu được tin này. Bạn diễn đạt kiểu khác thử nhé?"
          }
        }
      }
    },
    "ask.greeting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أهلًا، معك Nino 👋 اسألني ما شئت عن خطوات الإعداد. بدايةً، ما الأجهزة الموجودة عندك؟ (PS5 أو Xbox، تلفزيون أو شاشة عرض، هاتف أو حاسوب) وعلى أي جهاز تودّ الإعداد؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নমস্কার, আমি Nino 👋 সেটআপের যেকোনো বিষয়ে প্রশ্ন করুন। প্রথমে জানান, আপনার হাতে কী কী যন্ত্র আছে? (PS5 অথবা Xbox, TV অথবা মনিটর, ফোন অথবা কম্পিউটার) আর কোন যন্ত্রে সেটআপ করতে চান?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'm Nino 👋 Ask me whatever you like about setup. First: what do you own? A PS5 or an Xbox? A TV or a monitor? A phone or a computer? And where should Nino run?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumusta! Nino ako 👋 Magtanong lang tungkol sa pag-setup. Bilang simula, anong mga gamit ninyo? (PS5 man o Xbox, TV man o monitor, telepono man o computer) At alin doon ang gusto ninyong i-setup?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हैलो, Nino यहाँ है 👋 सेटअप से जुड़ा कोई भी सवाल पूछिए। पहले यह बताइए, आपके पास क्या-क्या है? (PS5 या फिर Xbox, कोई टीवी या मॉनिटर, कोई फ़ोन या कंप्यूटर) और सेटअप किस डिवाइस पर करना है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halo, saya Nino 👋 Silakan tanya apa pun soal penyiapan. Pertama, Anda punya perangkat apa saja? Konsolnya PS5 atau Xbox? Layarnya berupa TV atau monitor? Lalu ada ponsel atau komputer? Terakhir, mau disiapkan di perangkat yang mana?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai, saya Nino 👋 Tanyalah apa sahaja tentang cara menyediakan. Pertama sekali, apakah peranti anda? (PS5 ataupun Xbox, TV ataupun monitor, telefon ataupun komputer) Dan pada peranti yang mana anda mahu menyediakannya?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo! Ik ben Nino 👋 Stel me gerust je vragen over de installatie. Eerst: wat heb je allemaal? Een PS5 of een Xbox? Een tv of een monitor? Een telefoon of een computer? En waarop moet Nino draaien?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวัสดี ฉันชื่อ Nino 👋 สงสัยเรื่องการตั้งค่าตรงไหนถามได้เลย เริ่มจากบอกหน่อยว่ามีเครื่องอะไรบ้าง (PS5 หรือ Xbox, ทีวีหรือจอภาพ, มือถือหรือคอมพิวเตอร์) แล้วอยากตั้งค่าบนเครื่องไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selam, ben Nino 👋 Kurulumda ne merak ederseniz sorun. Önce şunu söyleyin: elinizde neler var? (PS5 veya Xbox; TV veya monitör; telefon veya bilgisayar) Nino'yu hangisine kuralım?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہیلو، Nino حاضر ہے 👋 سیٹ اپ سے متعلق جو چاہیں پوچھیں۔ پہلے یہ بتائیں کہ آپ کے پاس کیا کیا ہے؟ (PS5 یا پھر Xbox، کوئی TV یا مانیٹر، کوئی فون یا کمپیوٹر) اور سیٹ اپ کس ڈیوائس پر کرنا ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin chào, Nino đây 👋 Có gì về việc thiết lập, bạn cứ hỏi. Trước hết, bạn đang có những máy nào? (PS5 hoặc Xbox; TV hoặc một chiếc màn hình; một điện thoại hoặc máy tính) Và bạn muốn cài đặt trên máy nào?"
          }
        }
      }
    },

    "xbox.session.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox مشغول الآن بجلسة تشغيل أخرى عن بُعد. أغلقها؛ نحاول ثانيةً…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox আরেকটা রিমোট প্লে সেশনে ব্যস্ত। সেটা বন্ধ করুন; ফের চেষ্টা চলছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Xbox is already streaming to something else. Close that session; retrying…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May iba pang remote play session sa Xbox ninyo. Isara iyon; sinusubukan ulit…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox अभी किसी और रिमोट प्ले सत्र में लगा है। वह सत्र बंद कर दें; हम फिर आज़मा रहे हैं…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox sedang dipakai untuk sesi remote play yang lain. Tutup sesi tersebut; mencoba lagi…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox anda sedang sibuk dengan sesi main jauh lain. Tutup sesi itu; mencuba lagi…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Xbox is bezig met een andere sessie op afstand. Sluit die af; we proberen het opnieuw…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox ของคุณกำลังใช้งานการเล่นระยะไกลอีกเซสชันหนึ่ง ปิดเซสชันนั้น กำลังลองอีกครั้ง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox'ınızda şu an başka bir uzak oynatma oturumu açık. O oturumu kapatın; yeniden deneniyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox اس وقت ایک دوسرے ریموٹ سیشن میں مصروف ہے۔ اسے بند کر دیں؛ ہم پھر آزما رہے ہیں…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox đang bận với một lượt chơi từ xa ở nơi khác. Bạn đóng lượt đó đi; đang thử lần nữa…"
          }
        }
      }
    },
    "xbox.session.dropped": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بجهاز Xbox. تجري إعادة الاتصال…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox-এর সঙ্গে যোগাযোগ কেটে গেছে। ফের যুক্ত হচ্ছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost the link to the Xbox. Connecting again…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawala ang koneksiyon sa Xbox. Sinusubukang kumonekta…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox से संपर्क कट गया। दोबारा जोड़ रहे हैं…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi Xbox terputus. Menyambung ulang…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungan dengan Xbox terputus. Sedang menyambung semula…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding met de Xbox weggevallen. Weer verbinden…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมกับ Xbox ขาดไป กำลังเชื่อมอีกครั้ง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox ile bağlantı koptu. Yeniden bağlanılıyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox سے رابطہ کٹ گیا۔ پھر سے جوڑ رہے ہیں…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất liên lạc với Xbox. Đang nối lại…"
          }
        }
      }
    },
    "xbox.session.gaveup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى بث Xbox وتوقف Nino عن المحاولة. أعد تشغيل Xbox، ثم ابدأ الترجمة من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox স্ট্রিম থেমে গেছে, Nino আর চেষ্টা করছে না। Xbox রিস্টার্ট দিয়ে অনুবাদ ফের চালু করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Xbox stream ended and Nino has stopped trying. Restart the Xbox, then start translating again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Natapos ang Xbox stream at tumigil na sa pagsubok ang Nino. I-restart ang Xbox, saka simulan muli ang pagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox स्ट्रीम ख़त्म हो गई और Nino ने कोशिश करना बंद कर दिया। Xbox को रीस्टार्ट करें, फिर अनुवाद दोबारा शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming Xbox berakhir dan Nino berhenti mencoba. Mulai ulang Xbox, lalu mulai menerjemahkan lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Strim Xbox telah tamat dan Nino berhenti mencuba. Mulakan semula Xbox, kemudian mulakan terjemahan semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Xbox-stream is gestopt en Nino probeert het niet meer. Herstart de Xbox en start het vertalen opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สตรีม Xbox จบลงแล้ว และ Nino หยุดลองแล้ว รีสตาร์ต Xbox แล้วเริ่มแปลใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox yayını sona erdi ve Nino denemeyi bıraktı. Xbox'ı yeniden başlatın, sonra çeviriyi yeniden başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox کی اسٹریم بند ہو گئی اور Nino نے کوشش روک دی۔ Xbox کو ایک بار بند کر کے چلائیں، پھر سے ترجمہ چالو کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luồng phát Xbox đã ngắt và Nino thôi không thử nữa. Khởi động Xbox lại, xong bắt đầu dịch lần nữa."
          }
        }
      }
    },
    "xbox.session.startfailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Xbox بدء البث. اضغط زر التشغيل 10 ثوانٍ لإعادة تشغيله كليًا، ثم أوقف التشغيل عن بُعد وشغّله مجددًا في Settings › Devices & connections › Remote features، وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox স্ট্রিম শুরু করতে পারেনি। পাওয়ার বোতাম 10 সেকেন্ড চেপে রেখে সেটিকে পুরো রিস্টার্ট করুন, তারপর Settings › Devices & connections › Remote features-এ রিমোট প্লে বন্ধ করে আবার চালু করুন এবং আরেকবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Xbox refused to begin streaming. Fully restart it (hold the power button 10 seconds), turn remote play off then on under Settings › Devices & connections › Remote features, and try again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumanggi ang Xbox na magsimula ng stream. I-restart ito nang buo (10 segundong pindot sa power button), patayin at buksan ulit ang remote play (Settings › Devices & connections › Remote features), saka subukan muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox स्ट्रीम शुरू नहीं कर पाया। पावर बटन 10 सेकंड दबाकर उसे पूरी तरह फिर से चालू करें, फिर Settings › Devices & connections › Remote features में रिमोट प्ले बंद करके दोबारा चालू करें और एक बार और आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox gagal memulai siaran. Tahan tombol dayanya 10 detik untuk memulai ulang sepenuhnya, lalu matikan dan nyalakan lagi main jarak jauh di Settings › Devices & connections › Remote features, dan coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox gagal memulakan strim. Tekan butang kuasanya selama 10 saat untuk mula semula sepenuhnya, kemudian matikan dan hidupkan semula main jauh di Settings › Devices & connections › Remote features, dan cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Xbox kon de stream niet starten. Houd de aan/uit-knop 10 seconden ingedrukt om hem volledig te herstarten, zet daarna remote play uit en weer aan via Settings › Devices & connections › Remote features en probeer het nog een keer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox เริ่มสตรีมไม่ได้ กดปุ่มเปิดปิดค้างไว้ 10 วินาทีเพื่อรีสตาร์ตทั้งหมด จากนั้นปิดแล้วเปิดการเล่นระยะไกลใหม่ใน Settings › Devices & connections › Remote features แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox yayını başlatamadı. Güç düğmesine 10 saniye basılı tutup Xbox'ı tamamen yeniden başlatın, sonra Ayarlar › Devices & connections › Remote features'da uzaktan oynatmayı kapatıp açın ve bir kez daha deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox سلسلہ شروع نہ کر سکا۔ پاور بٹن 10 سیکنڈ دبا کر اسے پوری طرح دوبارہ شروع کریں، پھر Settings › Devices & connections › Remote features میں ریموٹ پلے بند کر کے دوبارہ آن کریں اور ایک بار پھر کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox từ chối bắt đầu phát. Khởi động lại hẳn (giữ nút nguồn 10 giây), tắt rồi bật lại chơi từ xa ở Settings › Devices & connections › Remote features, rồi thử tiếp."
          }
        }
      }
    },
    "xbox.session.timeout": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب جهاز Xbox. تجري إعادة المحاولة…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Xbox সাড়া দেয়নি। আবার চেষ্টা হচ্ছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Xbox didn't respond. Trying again…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tumugon ang inyong Xbox. Sinusubukang muli…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox की तरफ़ से जवाब नहीं आया। फिर आज़मा रहे हैं…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox tidak menjawab. Mencoba lagi…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox anda tidak membalas. Mencuba lagi…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen reactie van je Xbox. We proberen het opnieuw…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox ของคุณไม่ตอบสนอง กำลังลองอีกครั้ง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox'ınızdan cevap gelmedi. Yeniden deneniyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox کی طرف سے جواب نہیں آیا۔ پھر آزما رہے ہیں…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox chưa đáp lại. Đang thử lần nữa…"
          }
        }
      }
    },
    "xbox.session.unexpected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّت خدمة Xbox بطريقة غير متوقعة. تجري إعادة المحاولة…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox পরিষেবা অপ্রত্যাশিতভাবে উত্তর দিয়েছে। আবার চেষ্টা হচ্ছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Xbox service answered in an unexpected way. Trying again…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi inaasahan ang sagot ng Xbox service. Sinusubukang muli…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox सेवा का जवाब अजीब आया। फिर आज़मा रहे हैं…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan Xbox memberi jawaban yang tak terduga. Sedang dicoba lagi…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan Xbox memberikan jawapan luar jangka. Sedang mencuba lagi…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Xbox-dienst antwoordde onverwacht. Opnieuw proberen…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการ Xbox ตอบกลับแบบไม่คาดคิด กำลังลองอีกครั้ง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox hizmetinden beklenmedik bir cevap geldi. Yeniden deneniyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox سروس کا جواب عجیب آیا۔ پھر آزما رہے ہیں…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ Xbox phản hồi bất thường. Đang thử lại…"
          }
        }
      }
    },
    "xbox.session.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا نستطيع بلوغ Xbox. هل هو شغّال، والتشغيل عن بُعد مسموح من الإعدادات › الأجهزة والاتصالات، ثم «الميزات عن بُعد»؟ نحاول ثانيةً…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox-এর নাগাল পাওয়া যাচ্ছে না। সেটি কি অন, আর Settings খুলে Devices & connections-এর Remote features-এ রিমোট খেলার অনুমতি দেওয়া তো? ফের চেষ্টা চলছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Xbox can't be reached. Is it switched on, with remote play allowed under Settings › Devices & connections, then Remote features? Retrying…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makontak ang Xbox ninyo. Bukas ba ito, at pinapayagan ba sa Remote features (Settings › Devices & connections) ang remote play? Sinusubukan ulit…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox तक पहुँच नहीं हो पा रही। क्या Xbox ऑन है, और Settings › Devices & connections के अंदर Remote features में रिमोट प्ले की इजाज़त दी गई है? फिर आज़मा रहे हैं…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox tak bisa dihubungi. Apakah sudah hidup, dan remote play diizinkan (Settings, lalu Devices & connections, lalu Remote features)? Sedang dicoba lagi…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox anda tidak dapat dihubungi. Adakah Xbox hidup, dan main jauh dibenarkan (Settings › Devices & connections › Remote features)? Sedang mencuba lagi…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We komen niet bij je Xbox. Is hij ingeschakeld, en mag spelen op afstand (in Instellingen bij Apparaten en verbindingen, dan Externe functies)? We proberen het opnieuw…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ Xbox ไม่ได้ เปิดเครื่องอยู่และอนุญาตการเล่นระยะไกลใน การตั้งค่า › อุปกรณ์และการเชื่อมต่อ › ฟีเจอร์ระยะไกล แล้วหรือยัง กำลังลองอีกครั้ง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox'ınıza erişilemiyor. Xbox açık mı, Ayarlar'da Cihazlar ve bağlantılar altındaki Uzak özellikler bölümünde uzaktan oynatmaya izin var mı? Yeniden deneniyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox تک پہنچ نہیں ہو پا رہی۔ کیا وہ چالو ہے، اور Settings › Devices & connections کے اندر Remote features کھول کر ریموٹ پلے کی اجازت دی گئی ہے؟ پھر آزما رہے ہیں…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không liên lạc được Xbox. Máy đã bật chưa? Trong Settings, mục Devices & connections đã bật Remote features cho phép chơi từ xa chưa? Đang thử lần nữa…"
          }
        }
      }
    },
    "xbox.signin.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حساب Microsoft الذي تلعب به على Xbox. يشاهد الهاتف البث المنزلي من Xbox بينما تستمر لعبتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox-এ খেলার জন্য যে Microsoft অ্যাকাউন্ট দেন, সেটাই দিন। গেম চলতে থাকে, আর ফোন পাশে বসে Xbox-এর হোম স্ট্রিম দেখে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same Microsoft account as on your Xbox. Your phone follows the Xbox home stream while the game goes on."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang Microsoft account ninyo sa paglalaro sa Xbox. Habang tuloy ang laro, pinapanood ng telepono ang stream mula sa home ng console."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वही Microsoft खाता लें जिससे आप Xbox पर खेलते हैं। आप खेलते रहेंगे और फ़ोन साथ-साथ Xbox की घरेलू स्ट्रीम देखता रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai akun Microsoft yang biasa Anda gunakan untuk main di Xbox. Ponsel melihat streaming rumah dari Xbox selagi game tetap berjalan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai akaun Microsoft yang sama seperti semasa bermain di Xbox. Telefon memantau strim rumah dari Xbox sementara anda terus bermain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan met hetzelfde Microsoft-account als op je Xbox. Je telefoon volgt de thuisstream van de Xbox terwijl jij gewoon verder speelt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้บัญชี Microsoft ที่คุณใช้เล่นบน Xbox โทรศัพท์จะดูสตรีมภายในบ้านของ Xbox ขณะที่เกมของคุณดำเนินต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox'ta oynadığınız Microsoft hesabını kullanın. Siz oynamaya devam ederken telefonunuz Xbox'ın ev yayınını takip eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہی Microsoft اکاؤنٹ لیں جس سے آپ Xbox پر کھیلتے ہیں۔ آپ کھیلتے رہیں گے اور فون ساتھ ساتھ Xbox کی گھریلو اسٹریم دیکھتا رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng tài khoản Microsoft mà bạn chơi trên Xbox. Lúc đó điện thoại xem luồng phát trong nhà của Xbox, còn bạn cứ chơi tiếp."
          }
        }
      }
    },
    "xbox.signin.button": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول باستخدام Microsoft"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft-এ লগ ইন"
          }
        },
        "en": {

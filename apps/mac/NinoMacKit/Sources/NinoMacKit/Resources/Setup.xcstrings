    "setup.account.window.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا على Mac يأخذ Nino الترجمة من chiaki-ng مباشرةً (ويصلح PS Remote Play كذلك). لن تحتاج حسابًا ثانيًا ولا ربطًا مع PS5، وبإمكانك إضافة تلفاز لاحقًا متى شئت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এ থাকলে Nino সাবটাইটেল সোজা chiaki-ng-এর উইন্ডো থেকেই তুলে নিতে পারে (চাইলে PS Remote Play দিয়েও হয়)। দ্বিতীয় অ্যাকাউন্ট লাগে না, PS5-এর সঙ্গে জোড়া লাগাতেও হয় না, আর TV যেকোনো সময় যোগ করা যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here on your Mac, Nino can take subtitles directly from chiaki-ng (PS Remote Play works too). There's no second account involved, no pairing with the PS5, and a TV can be added any time."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito sa Mac mo, direktang nakukuha ni Nino ang subtitle galing chiaki-ng (gumagana rin naman itong PS Remote Play). Walang pangalawang account, walang pag-pair sa PS5, at puwedeng magdagdag ng TV kahit kailan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसी Mac पर Nino सबटाइटल सीधे chiaki-ng से उठा लेता है; चाहें तो PS Remote Play भी चल जाएगा। न दूसरा अकाउंट चाहिए, न PS5 से पेयरिंग, और टीवी जब चाहें जोड़ सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsung dari Mac ini, Nino bisa mengambil subtitel dari chiaki-ng (PS Remote Play juga bisa). Tak perlu akun kedua, tak perlu memasangkan PS5, dan TV bisa ditambahkan kapan saja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerusi Mac ini, Nino boleh terus mengambil sari kata daripada chiaki-ng (PS Remote Play juga berfungsi). Akaun kedua tidak perlu, PS5 tidak perlu dipasangkan, dan TV boleh ditambah kemudian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op deze Mac haalt Nino de ondertitels rechtstreeks uit chiaki-ng (PS Remote Play kan ook). Geen tweede account, je hoeft de PS5 niet te koppelen, en een tv voeg je later toe wanneer je wilt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ Mac ตรงนี้ Nino อ่านซับจาก chiaki-ng ได้เลย (PS Remote Play ก็ใช้ได้เหมือนกัน) ไม่จำเป็นต้องมีแอคเคานต์สำรอง ไม่ต้องจับคู่กับ PS5 และจะเพิ่มทีวีภายหลังเมื่อไรก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino altyazıları bu Mac'teki chiaki-ng veya PS Remote Play penceresinden doğrudan alabilir. İkinci hesap ya da PS5 eşleştirmesi gerekmiyor; TV'yi istediğiniz zaman ekleyebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac پر Nino سب ٹائٹل سیدھے chiaki-ng سے لے سکتا ہے (PS Remote Play بھی چلتا ہے)۔ نہ دوسرا اکاؤنٹ درکار، نہ PS5 سے جوڑنا، اور ٹی وی جب چاہیں شامل کر لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay tại Mac, Nino có thể lấy chữ phụ đề thẳng từ chiaki-ng (PS Remote Play cũng được). Chẳng cần thêm tài khoản, không phải ghép đôi với PS5, và lúc nào cũng có thể thêm TV."
          }
        }
      }
    },
    "setup.account.window.missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد PS Remote Play ولا chiaki-ng مثبّتين في جهاز Mac الذي تستخدمه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS Remote Play কিংবা chiaki-ng, দুটোর কোনোটিই এই Mac-এ ইনস্টল করা নেই।"
          }

    "setup.ps5.step3.path": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل في الأسفل الأرقام الثمانية. ينتهي كل رمز بعد 5 دقائق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিচের আট অঙ্কের কোডটি লিখুন। প্রতিটি কোড ৫ মিনিট কাজ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the eight-digit code underneath. Each code works for 5 minutes."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay sa ibaba ang walong-numerong code. Tumatagal ng 5 minuto ang bisa ng bawat code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे वह आठ अंकों का कोड भरें। हर कोड की मियाद 5 मिनट होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kode delapan angka di bawah. Tiap kode berlaku 5 menit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Isikan kod lapan digit yang tertera. Setiap kod tamat tempoh selepas 5 minit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ hieronder de code van 8 cijfers. Hij blijft 5 minuten geldig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์รหัสแปดหลักลงในช่องข้างล่าง รหัสแต่ละชุดหมดอายุใน 5 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekiz haneli kodu aşağıya girin. Her kod 5 dakika boyunca çalışır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیچے آٹھ ہندسوں والا کوڈ درج کریں۔ ہر کوڈ کی مدت 5 منٹ ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mã tám chữ số ở ô bên dưới. Mã nào cũng chỉ dùng được 5 phút."
          }
        }
      }
    },

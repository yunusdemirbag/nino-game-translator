    "setup.xboxList.install.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق Mac مجاني لـ Xbox. يعطي أوضح صورة، فتصبح قراءة الترجمة أسهل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox-এর জন্য Mac-এর একটি ফ্রি অ্যাপ। এতে ছবি সবচেয়ে পরিষ্কার আসে, তাই সাবটাইটেল পড়াও সবচেয়ে সহজ হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A free Mac app for Xbox. It gives the clearest picture, which makes subtitles easiest to read."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreng Mac app para sa Xbox. Ito ang pinakamalinaw ang larawan, kaya pinakamadaling basahin ang subtitle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox के लिए एक मुफ़्त Mac ऐप। इसकी तस्वीर सबसे साफ़ आती है, इसलिए सबटाइटल पढ़ना सबसे आसान रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi Mac gratis untuk Xbox. Gambarnya paling jernih, jadi subtitel paling mudah dibaca."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi Mac percuma untuk Xbox. Gambarnya paling jelas, jadi sari kata paling mudah dibaca."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gratis Mac-app voor Xbox. Deze levert het helderste beeld, waardoor je de ondertitels het makkelijkst leest."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอป Mac ฟรีสำหรับ Xbox ให้ภาพคมที่สุด ซับเลยอ่านสบายตา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox için ücretsiz bir Mac uygulaması. En berrak görüntüyü sağladığı için altyazılar en isabetli bununla okunur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox کے لیے Mac کی ایک مفت ایپ۔ اس کی تصویر سب سے صاف ہوتی ہے، جس سے سب ٹائٹل پڑھنا سب سے آسان رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Mac miễn phí dành cho Xbox. Hình ảnh rõ nét nhất, vì thế đọc phụ đề dễ nhất."
          }
        }
      }
    },

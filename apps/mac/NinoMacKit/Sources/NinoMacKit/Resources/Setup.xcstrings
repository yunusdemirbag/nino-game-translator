    "setup.tvApp.lg.extends": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجدّد Nino مدة Developer Mode تلقائيًا كلما فتحته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যতবার ব্যবহার করবেন, Nino নিজেই Developer Mode-এর মেয়াদ বাড়িয়ে দেবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whenever you open Nino, it renews Developer Mode for you."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuwing bubuksan mo si Nino, siya na ang nagre-renew ng Developer Mode."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी आप Nino इस्तेमाल करते हैं, यह Developer Mode को खुद बढ़ा देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kali Nino dibuka, Developer Mode diperpanjang untuk Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kali Nino dibuka, Developer Mode dilanjutkan untuk anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telkens als je Nino opent, verlengt het Developer Mode voor je."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกครั้งที่เปิด Nino แอปจะต่ออายุ Developer Mode ให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'yu her açışınızda geliştirici modunun süresi kendiliğinden yenilenir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کھلتے ہی Developer Mode کا وقت اپنے آپ آگے بڑھ جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần bạn mở Nino, Developer Mode sẽ được gia hạn tự động."
          }
        }
      }
    },
    "setup.tvApp.lg.hoursLeft %lld": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بقيت %lld ساعة من Developer Mode. يجدّد Nino هذه المدة تلقائيًا كلما فتحته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode-এর মেয়াদ ফুরোতে %lld ঘণ্টা বাকি। যতবার Nino খোলেন, এটি নিজেই মেয়াদ বাড়িয়ে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hours of Developer Mode remain. Whenever you open Nino, it renews this for you."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld oras pa ang natitira sa Developer Mode. Tuwing bubuksan mo si Nino, siya na ang nagre-renew nito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode के %lld घंटे बचे हैं। जब भी आप Nino खोलते हैं, वह इसे खुद बढ़ा देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisa waktu Developer Mode: %lld jam. Setiap kali Nino dibuka, waktunya diperpanjang untuk Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode berbaki %lld jam. Setiap kali Nino dibuka, tempoh ini dilanjutkan untuk anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode blijft nog %lld uur actief. Telkens als je Nino opent, wordt dit voor je verlengd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode เหลือ %lld ชม. ทุกครั้งที่เปิด Nino แอปจะต่ออายุให้เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici modunun bitmesine %lld saat var. Nino'yu her açışınızda süre kendiliğinden yenilenir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode کے %lld گھنٹے باقی ہیں۔ Nino کھلتے ہی یہ وقت اپنے آپ آگے بڑھ جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn %lld giờ Developer Mode. Hễ bạn mở Nino, thời hạn sẽ được gia hạn tự động."
          }
        }
      }
    },
    "setup.tvApp.lg.install": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تثبيت على تلفازي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার TV-তে বসিয়ে দিন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install on My TV"
          }
        },
        "fil": {

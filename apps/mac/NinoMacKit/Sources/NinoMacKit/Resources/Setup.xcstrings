    "setup.tv.list.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد أي تلفاز Samsung أو LG. هل تلفازك مشغَّل ويشارك جهاز Mac الذي تستخدمه الشبكةَ ذاتها؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্কে Samsung বা LG-র কোনো TV মেলেনি। আপনারটি কি অন অবস্থায় এই Mac-এর নেটওয়ার্কেই আছে?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Samsung or LG TV turned up. Is yours switched on and connected to the network this Mac uses?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakitang Samsung o LG TV. Nakabukas ba ang sa iyo at konektado sa network na gamit din ng Mac mo?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई Samsung या LG टीवी नहीं मिला। क्या आपका टीवी ऑन है, साथ ही उसी नेटवर्क से कनेक्टेड है जो यह Mac इस्तेमाल करता है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum terdeteksi satu pun TV Samsung atau LG. TV Anda sudah hidup dan memakai jaringan yang sama seperti Mac ini?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada TV Samsung atau LG yang dijumpai. Adakah TV anda dihidupkan dan menggunakan rangkaian sama seperti Mac ini?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen Samsung of LG gevonden. Is jouw tv ingeschakeld en verbonden met het netwerk dat deze Mac ook gebruikt?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หาทีวี Samsung หรือ LG ไม่เจอเลย ทีวีของคุณเปิดอยู่และใช้วงเน็ตเดียวกับ Mac นี้หรือเปล่า?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung veya LG marka TV bulunamadı. TV'niz açık mı, bu Mac'in ağına bağlı mı, bakın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی Samsung یا LG ٹی وی سامنے نہیں آیا۔ کیا آپ کا ٹی وی چالو ہے، اور یہ Mac جس نیٹ ورک سے جڑا ہے، کیا ٹی وی بھی وہیں ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thấy TV Samsung hay LG nào. TV của bạn đã bật và dùng chung mạng với Mac này chưa?"
          }
        }
      }
    },

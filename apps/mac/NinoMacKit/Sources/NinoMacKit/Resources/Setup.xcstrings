          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لنک کی کاپی لیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép đường link"
          }
        }
      }
    },
    "setup.tvApp.samsung.signIn.noAccount": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تملك حسابًا بعد؟ أنشئه مجانًا من تلك الصفحة. وإن طلب المتصفح الوصول إلى أجهزة شبكتك المحلية فاسمح له."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো অ্যাকাউন্ট নেই? ওই পেজেই বিনামূল্যে খুলে নিন। ব্রাউজার লোকাল নেটওয়ার্কের ডিভাইসে পৌঁছানোর অনুমতি চাইলে সায় দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account yet? Create one for free on that page. If your browser asks to reach devices on your local network, allow it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala ka pang account? Gumawa nang libre sa page na iyon. Kapag humingi ang browser mo ng pahintulot na maabot ang mga device na nasa local network, payagan ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अकाउंट नहीं है? उस पेज पर मुफ़्त अकाउंट बनाया जा सकता है। अगर ब्राउज़र लोकल नेटवर्क के डिवाइसों तक पहुँचने की इजाज़त माँगे, तो दे दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum punya akun? Buat gratis di halaman itu. Jika browser minta izin menjangkau perangkat di jaringan lokal, izinkan saja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada akaun? Daftar secara percuma di halaman itu. Jika pelayar meminta izin untuk mencapai peranti dalam rangkaian setempat, benarkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen account? Maak er gratis een aan op die pagina. Vraagt je browser of hij apparaten op je lokale netwerk mag bereiken, sta dat dan toe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแอคเคานต์? สมัครฟรีได้บนหน้านั้นเลย หากเบราว์เซอร์ขอเข้าถึงอุปกรณ์ในวงเน็ตบ้าน ให้กดยอม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız yoksa o sayfada ücretsiz oluşturabilirsiniz. Tarayıcınız yerel ağınızdaki cihazlara erişim isterse onay verin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی اکاؤنٹ نہیں؟ وہ صفحہ مفت اکاؤنٹ بنانے کا موقع بھی دیتا ہے۔ اگر براؤزر گھر کے راؤٹر سے جڑی ڈیوائسز تک پہنچنے کی اجازت طلب کرے تو ہاں کر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa từng lập tài khoản? Cứ lập một cái free ở chính trang ấy. Trình duyệt mà hỏi có được kết nối tới các máy trong mạng nhà không, thì bấm cho phép."
          }
        }
      }
    },
    "setup.tvApp.samsung.signIn.popup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تظهر نافذة الدخول؟ ربما حجبها المتصفح ظنًّا أنها إعلان. استخدم الزر المجاور لعنوان الموقع للسماح لهذه الصفحة بفتح نوافذ جديدة، ثم اختر «فتح الصفحة مجددًا»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লগইন উইন্ডো আসেনি? ব্রাউজার হয়তো একে বিজ্ঞাপন ভেবে আটকে দিয়েছে। ওয়েব ঠিকানার পাশের বোতাম দিয়ে এই পেজকে নতুন উইন্ডো খোলার অনুমতি দিন, এরপর পেজ ফের খুলুন টিপুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No login window? Your browser might have stopped it, thinking it was an ad window. Use the button next to the web address to let this page open new windows, then choose Reopen the Page."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang lumabas na login window? Baka hinarang ito ng browser mo dahil inakala nitong ad. Gamitin ang button sa tabi ng web address para payagang magbukas ng bagong window ang page na ito, saka piliin ang Buksan Ulit ang Page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन विंडो नहीं खुली? मुमकिन है ब्राउज़र ने विज्ञापन समझकर उस विंडो को रोक लिया हो। वेब पते के बगल वाले बटन से इस पेज को नई विंडो खोलने की इजाज़त दें, और फिर पेज फिर खोलें चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela masuk tidak muncul? Mungkin browser memblokirnya karena dikira iklan. Pakai tombol di samping alamat web agar halaman ini boleh membuka jendela baru, lalu pilih Buka Halaman Lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetingkap masuk tidak muncul? Pelayar anda mungkin menyekatnya kerana menyangka ia iklan. Gunakan butang di sebelah alamat web supaya halaman ini dibenarkan membuka tetingkap baru, lalu pilih Buka Halaman Semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen aanmeldvenster? Misschien heeft je browser het tegengehouden omdat het op een advertentie leek. Sta deze pagina via de knop naast het webadres toe om nieuwe vensters te openen en kies daarna Pagina opnieuw openen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่างล็อกอินไม่ขึ้น? บางทีเบราว์เซอร์กันไว้เพราะเข้าใจว่าเป็นป๊อปอัปโฆษณา ใช้ปุ่มข้างแถบที่อยู่เว็บเพื่อยอมให้หน้านี้เปิดหน้าต่างใหม่ได้ แล้วแตะ เปิดหน้าเว็บอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum penceresi gelmiyorsa tarayıcınız onu reklam penceresi sanıp durdurmuş olabilir. Web adresinin yanındaki düğmeden bu sayfaya pop-up izni tanıyın, ardından Sayfayı Tekrar Aç'ı seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاگ ان کی ونڈو نہیں کھلی؟ ممکن ہے براؤزر نے اشتہار سمجھ کر اسے روک دیا ہو۔ ویب ایڈریس کے برابر والے بٹن سے اس صفحے کو نئی ونڈوز کھولنے دیں، پھر «صفحہ پھر سے کھولیں» دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thấy khung đăng nhập? Rất có thể nó bị trình duyệt chặn vì tưởng đó là quảng cáo. Dùng nút cạnh thanh địa chỉ để cho trang này mở cửa sổ mới, rồi chọn Mở trang lần nữa."
          }
        }
      }
    },

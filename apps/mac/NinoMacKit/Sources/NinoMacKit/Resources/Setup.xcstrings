    "setup.xboxList.signIn.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر لك Greenlight رمزًا. ادخل إلى microsoft.com/link وأدخله وأنت داخل بحساب Xbox، وبعدها ارجع إلى Greenlight واضغط OK للتأكيد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight একটি কোড দেখাবে। Xbox অ্যাকাউন্টে লগ ইন থাকা অবস্থায় কোডটি microsoft.com/link পাতায় বসান, এরপর Greenlight-এ ফিরে OK টিপে নিশ্চিত করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight shows you a code. Go to microsoft.com/link and enter it, logged in to your Xbox account, then confirm with OK back in Greenlight."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May code na ipapakita ang Greenlight. Pumunta sa address na microsoft.com/link at ilagay ito habang nakapasok sa Xbox account mo, saka kumpirmahin sa OK pagbalik sa Greenlight."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight आपको एक कोड देगा। अपने Xbox अकाउंट से लॉग इन रहते हुए microsoft.com/link खोलकर उसे डालें, और फिर Greenlight में वापस आकर OK दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight akan menampilkan sebuah kode. Kunjungi microsoft.com/link dan masukkan kode itu sambil login ke akun Xbox, lalu setujui dengan OK di Greenlight."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight akan memaparkan satu kod. Pergi ke microsoft.com/link dan isikan kod tersebut ketika masuk ke akaun Xbox anda, kemudian sahkan dengan OK di Greenlight."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight laat een code zien. Ga naar microsoft.com/link, vul hem daar in terwijl je met je Xbox-account bent aangemeld, en bevestig daarna in Greenlight met OK."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight จะแสดงรหัสให้ เข้า microsoft.com/link แล้วกรอกรหัสนั้นขณะล็อกอินแอคเคานต์ Xbox อยู่ จากนั้นกลับมากด OK ใน Greenlight"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight size bir kod verir. microsoft.com/link adresine gidip kodu Xbox hesabınızla girin; sonra Greenlight'a dönüp onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight آپ کو ایک کوڈ دے گا۔ Xbox اکاؤنٹ میں لاگ ان رہتے ہوئے وہ کوڈ microsoft.com/link والے صفحے پر لکھیں، پھر Greenlight میں لوٹ کر OK سے منظوری دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight sẽ đưa ra một mã. Vào microsoft.com/link, đăng nhập tài khoản Xbox và nhập mã đó, rồi quay lại Greenlight bấm OK để xác nhận."
          }
        }
      }
    },

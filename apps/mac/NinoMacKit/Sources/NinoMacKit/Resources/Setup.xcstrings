    "setup.tvApp.samsung.signIn.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّع Samsung تطبيق Nino لتلفازك تحديدًا من خلال حساب Samsung المجاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ফ্রি Samsung অ্যাকাউন্টের মাধ্যমে Samsung আপনার নিজের TV-র জন্য Nino-তে সই করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung signs Nino for your own TV through a Samsung account, which is free."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinipirmahan ng Samsung si Nino para sa sarili mong TV gamit ang Samsung account, na libre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung मुफ़्त Samsung अकाउंट के ज़रिए Nino को आपके अपने टीवी के लिए साइन करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewat akun Samsung yang gratis, Samsung menandatangani Nino untuk TV milik Anda sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung menandatangani Nino untuk TV anda melalui akaun Samsung, yang percuma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung ondertekent Nino voor jouw tv via een Samsung-account, en dat is gratis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung ใช้ Samsung account (ฟรี) ในการเซ็นรับรอง Nino ให้เข้ากับทีวีของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung, Nino'yu ücretsiz Samsung hesabınızla yalnız kendi TV'niz için imzalar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung مفت Samsung اکاؤنٹ کے ذریعے Nino پر آپ کے اپنے ٹی وی کے لیے دستخط کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung cần một tài khoản Samsung (không mất phí) để ký Nino dành riêng cho TV nhà bạn."
          }
        }
      }
    },

    "setup.tvApp.android.approve": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انظر إلى التلفاز: يسألك هل يُسمح لهذا الحاسوب باستخدام تصحيح الأخطاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-টি দেখুন: এই কম্পিউটার ডিবাগিং চালাতে পারবে কি না, সেটা জানতে চাইছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the TV: it's asking whether this computer may use debugging."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan ang TV: tinatanong nito kung puwedeng gumamit ng debugging ang computer mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी पर नज़र डालें: वहाँ सवाल है कि यह कंप्यूटर डीबगिंग इस्तेमाल करे या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat TV: ada pertanyaan apakah komputer ini boleh memakai debugging."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak TV: ia meminta kebenaran untuk komputer ini menggunakan penyahpepijatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk op de tv: hij vraagt of debuggen vanaf deze computer mag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูที่ทีวี: มีคำถามว่าจะให้คอมเครื่องนี้ใช้การดีบักไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV ekranına bakın: bu bilgisayarın hata ayıklama kullanıp kullanamayacağını soruyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کی اسکرین دیکھیں: وہاں سوال آیا ہے کہ یہ کمپیوٹر ڈی بگنگ استعمال کر سکے یا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem TV: TV đang hỏi có cho máy tính này dùng chế độ gỡ lỗi không."
          }
        }
      }
    },
    "setup.tvApp.android.approveHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع علامة بجانب «Always allow from this computer»، ثم أكّد بـ Allow. بعدها يبدأ التثبيت تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“Always allow from this computer”-এর পাশে টিক দিন, তারপর Allow দিয়ে নিশ্চিত করুন। এরপর ইনস্টল নিজে থেকেই চলবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a tick next to “Always allow from this computer”, then confirm with Allow. Installation then runs automatically."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagyan ng check ang kahong “Always allow from this computer”, saka kumpirmahin sa Allow. Kusa nang tatakbo ang pag-install."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Always allow from this computer” के आगे टिक लगाकर Allow से मंज़ूरी दें। इसके बाद इंस्टॉलेशन अपने-आप चलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tanda centang pada “Always allow from this computer”, lalu setujui dengan Allow. Instalasi akan berjalan otomatis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda kotak “Always allow from this computer”, kemudian sahkan dengan Allow. Pemasangan seterusnya berjalan secara automatik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vink de optie aan om deze computer altijd toe te laten en bevestig met Toestaan. Daarna loopt de installatie vanzelf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติ๊กช่อง “Always allow from this computer” แล้วกด Allow จากนั้นการติดตั้งจะเดินต่อเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bu bilgisayardan her zaman izin ver” seçeneğini işaretleyin ve izni onaylayın. Kurulum sonrasında kendiliğinden yapılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“Always allow from this computer” والے خانے پر نشان لگائیں، پھر Allow سے منظوری دیں۔ اس کے بعد انسٹالیشن اپنے آپ ہو جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu vào “Always allow from this computer”, rồi bấm Allow để xác nhận. Sau đó việc cài đặt sẽ tự chạy."
          }
        }
      }
    },
    "setup.tvApp.android.looking": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفتش في الشبكة عن التلفاز…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্কে TV-র খোঁজ চলছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching the network for the TV…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinahanap sa network ang TV…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क में टीवी की खोज चल रही है…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang mencari televisi di jaringan…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari TV dalam rangkaian…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv zoeken op het netwerk…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังค้นหาทีวีในเครือข่าย…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV için ağ taranıyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیٹ ورک میں ٹی وی کی تلاش…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang dò TV trên mạng…"
          }
        }
      }
    },
    "setup.tvApp.android.menuHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل علامة تجارية تسميات مختلفة قليلًا للقوائم. تطبيقنا موجود على تلفازك أصلًا؟ انتقل إلى التالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ব্র্যান্ডের মেনুতে শব্দগুলো খানিক অন্যরকম। TV-তে অ্যাপটি আগেই আছে? এই ধাপ পার হয়ে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each brand words its menus slightly differently. Already have the app on your TV? Skip ahead."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahagyang magkakaiba ang tawag sa mga menu sa bawat brand. Nasa TV mo na ang app? Lumaktaw na."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेन्यू के नाम हर ब्रांड में थोड़ा-बहुत बदलते हैं। ऐप पहले से टीवी पर है? यह चरण छोड़ दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiap merek menamai menunya sedikit berlainan. Aplikasinya sudah terpasang di TV? Lewati saja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap jenama menamakan menunya sedikit berlainan. Aplikasi sudah dipasang di TV? Teruskan ke langkah seterusnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk merk noemt de menu's net even anders. Staat Nino al op je tv? Sla dit dan over."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละยี่ห้อตั้งชื่อเมนูต่างกันนิดหน่อย ถ้าลงแอปบนทีวีไว้แล้ว ข้ามขั้นนี้ไปได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her marka menülerini biraz farklı adlandırır. Uygulama TV'nizde yüklüyse bu adımı geçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر کمپنی مینو کے نام تھوڑے الگ لکھتی ہے۔ ایپ ٹی وی میں پہلے ہی لگی ہوئی ہے؟ یہ حصہ چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hãng đặt tên mục trong menu hơi khác một chút. TV đã có app rồi? Cứ bỏ qua."
          }
        }
      }
    },
    "setup.tvApp.android.notInstalled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التلفاز لا يحتوي Nino حتى الآن. بمجرد تفعيل تصحيح الأخطاء يرسله Nino إليه عبر شبكتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে এখনো Nino নেই। ডিবাগিং চালু হলেই Nino নেটওয়ার্কের মাধ্যমে সেটি পাঠিয়ে দেবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino isn't on the TV yet. As soon as debugging is switched on, Nino sends it over your network."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pa si Nino sa TV. Pagka-on ng debugging, ipapadala ito ni Nino sa network mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी में अभी Nino मौजूद नहीं है। जैसे ही डीबगिंग ऑन हो, Nino नेटवर्क के रास्ते उसे भेज देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino belum ada di TV. Begitu debugging aktif, Nino mengirimnya lewat jaringan Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino belum ada pada TV. Sebaik penyahpepijatan dihidupkan, Nino menghantarnya melalui rangkaian anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino staat nog niet op je tv. Zodra foutopsporing aanstaat, stuurt Nino de app via je netwerk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวียังไม่มี Nino พอเปิดการดีบักแล้ว Nino จะส่งแอปไปทางวงเน็ตให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino henüz TV'de yok. Hata ayıklamayı açar açmaz Nino uygulamayı ağınız üzerinden yükler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی میں ابھی Nino نہیں ہے۔ جیسے ہی ڈی بگنگ آن ہو گی، Nino ایپ کو گھر کے نیٹ ورک سے ٹی وی تک پہنچا دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV chưa có Nino. Ngay khi bật gỡ lỗi, Nino sẽ gửi ứng dụng sang qua mạng."
          }
        }
      }
    },
    "setup.tvApp.android.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. افتح على التلفاز Settings › Device Preferences › About (أما في Google TV فالمسار Settings › System › About)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV-র Settings › Device Preferences › About পাতায় যান (Google TV মডেলে: Settings › System › About)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Go to Settings › Device Preferences › About on your TV (Google TV models: Settings › System › About)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Sa TV mo, magtungo sa Settings › Device Preferences › About (sa mga modelong Google TV, ang daan ay Settings › System › About)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. टीवी में यह रास्ता खोलें: Settings › Device Preferences › About। जिन मॉडलों में Google TV है, उनमें रास्ता है Settings › System › About।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Pada TV, masuk ke Settings › Device Preferences › About (untuk model Google TV, bukalah Settings › System › About)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Di TV, lawati menu Settings › Device Preferences › About (bagi model Google TV, menunya ialah Settings › System › About)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open op je tv Settings › Device Preferences › About (heb je Google TV, dan is het Settings › System › About)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1. บนทีวีเข้า Settings › Device Preferences › About (รุ่น Google TV ใช้เส้นทาง Settings › System › About)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'nizde şuraya gidin: Ayarlar › Cihaz Tercihleri › Hakkında (Google TV modellerinde: Ayarlar › Sistem › Hakkında)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ٹی وی میں یہ راستہ کھولیں: Settings › Device Preferences › About (اگر Google TV ہے تو: Settings › System › About)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Trên TV, vào Settings › Device Preferences › About (với Google TV thì vào Settings › System › About)."
          }
        }
      }
    },
    "setup.tvApp.android.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. حدّد Build واضغط OK سبع مرات، حتى تخبرك رسالة أن وضع المطوّر صار مفعّلًا لديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Build-এ গিয়ে সাতবার OK টিপুন, যতক্ষণ পর্যন্ত বার্তা আসে যে আপনি এখন ডেভেলপার।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Highlight Build and press OK seven times, until a message tells you you're a developer."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Piliin ang Build at pitong beses na pindutin ang OK, hanggang may mensaheng magsabing developer ka na."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Build पर जाकर OK सात बार दबाएँ, जब तक संदेश न आए कि आप डेवलपर बन गए हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Sorot Build lalu tekan OK tujuh kali, hingga tampil pesan yang menyatakan Anda sudah menjadi developer."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Pilih Build dan tekan OK tujuh kali, sehingga mesej memberitahu anda kini pembangun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Selecteer Build en druk zeven keer op OK, tot een melding zegt dat je nu ontwikkelaar bent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2. เลื่อนไปที่ Build แล้วกด OK เจ็ดครั้ง จนขึ้นข้อความว่าเปิดโหมดนักพัฒนาให้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Yapı satırını seçin ve geliştirici olduğunuzu bildiren mesaj belirene dek Tamam tuşuna yedi defa basın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Build کو منتخب رکھ کر OK سات دفعہ دبائیں، جب تک پیغام نہ آ جائے کہ اب آپ ڈویلپر ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Chọn Build và nhấn OK bảy lần, tới khi thấy dòng báo bạn đã trở thành developer."
          }
        }
      }
    },
    "setup.tvApp.android.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3. ارجع إلى Device Preferences (في Google TV: System)، وافتح Developer options وفعّل USB debugging. وفعّل Network debugging أيضًا إن كان موجودًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Device Preferences-এ ফিরে যান (Google TV-তে System), Developer options খুলে USB debugging অন করুন। তালিকায় Network debugging থাকলে সেটিও অন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Return to Device Preferences (on Google TV, System), open Developer options and switch on USB debugging. Switch on Network debugging as well if it's listed."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Balikan ang Device Preferences (sa Google TV, System), buksan ang Developer options at paganahin ang USB debugging. Kung nakalista, paganahin pa ang Network debugging."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. फिर से Device Preferences में जाएँ (Google TV पर System), Developer options खोलकर USB debugging ऑन करें। सूची में Network debugging भी दिखे, तो वह भी ऑन कर दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Balik lagi ke Device Preferences (di Google TV: System), buka Developer options, lalu aktifkan USB debugging. Bila tersedia, aktifkan pula Network debugging."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Pulang ke Device Preferences (di Google TV, System), masuk ke Developer options lalu aktifkan USB debugging. Kalau Network debugging tersenarai, aktifkannya sekali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Keer terug naar Device Preferences (bij Google TV: System), open Developer options en zet USB debugging aan. Staat Network debugging erbij, zet dat dan ook aan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "3. ย้อนกลับไป Device Preferences (ถ้าเป็น Google TV คือ System) เข้า Developer options และเปิด USB debugging ถ้ามี Network debugging ก็เปิดไว้ด้วยกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Cihaz Tercihleri'ne (Google TV modellerinde Sistem'e) geri dönün, Geliştirici seçenekleri içinde USB hata ayıklama ayarını açın. Listede Ağ hata ayıklama seçeneği de varsa onu da etkinleştirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "3. پچھلی اسکرین Device Preferences پر لوٹیں (Google TV والوں کے لیے System)، Developer options کھولیں اور USB debugging کا سوئچ چالو کریں۔ فہرست میں Network debugging بھی نظر آئے تو وہ بھی چالو کر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Quay về Device Preferences (trên Google TV là System), mở Developer options và bật USB debugging. Nếu có Network debugging thì bật luôn."
          }
        }
      }
    },
    "setup.tvApp.android.usb": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التثبيت من ذاكرة USB"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "USB স্টিক থেকে ইনস্টল করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install from a USB Stick"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-install mula sa USB Stick"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "USB स्टिक के ज़रिए इंस्टॉल"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal dengan USB Stick Saja"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang dari Pemacu USB"
          }
        },
        "nl": {

    "setup.gemini.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق مفتاحك في الأسفل، ثم اختر «حفظ واختبار»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিচে কী-টি পেস্ট করুন, তারপর সেভ করে পরীক্ষা করুন বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste your key below, then choose Save and Test."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idikit sa ibaba ang key mo, at i-click ang button na I-save at I-test."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कुंजी नीचे चिपकाएँ, फिर सहेजें और जाँचें चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel kunci di bawah, lalu pilih Simpan dan Uji."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampal kunci di bawah, kemudian pilih Simpan dan Uji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak de sleutel hieronder en kies Opslaan en testen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางคีย์ในช่องข้างล่าง จากนั้นกดปุ่ม บันทึกแล้วลองดู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaladığınız anahtarı aşağıya yapıştırıp “Kaydet ve Sına”ya tıklayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی key نیچے والے خانے میں ڈالیں، پھر «محفوظ کریں اور آزمائیں» پر کلک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán khóa vào ô bên dưới, sau đó chọn Lưu và thử."
          }
        }
      }

{
  "sourceLanguage": "en",
  "strings": {
    "setup.account.mainAccountHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تشغيل يد التحكم، اختر ملفك الشخصي الأساسي على PS5. الحساب الثاني مخصّص لـ Nino كي يقرأ الشاشة فقط؛ وإن لعبت به فلن تستجيب يد التحكم داخل اللعبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কন্ট্রোলার চালু করার পর PS5-এ আপনার প্রধান প্রোফাইলটি বেছে নিন। Nino-র দ্বিতীয় অ্যাকাউন্ট শুধু স্ক্রিন পড়ার কাজে লাগে; ওটাতে খেললে গেমে কন্ট্রোলার আর সাড়া দেবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you switch the controller on, choose your MAIN profile on your PS5. Nino's second account is only for reading the screen; if you play on it, your controller stops responding in the game."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagka-on ng controller, ang PANGUNAHIN mong profile ang piliin sa PS5. Para lang sa pagbasa ng screen ang pangalawang account ni Nino; kapag doon ka naglaro, titigil sa pagtugon ang controller mo sa laro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंट्रोलर चालू होते ही PS5 पर अपनी मुख्य (MAIN) प्रोफ़ाइल चुनें। Nino का दूसरा अकाउंट केवल स्क्रीन पढ़ने के लिए है; अगर आप उसी से खेलेंगे, तो गेम के दौरान कंट्रोलर रिस्पॉन्ड नहीं करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah stik dinyalakan, pilih profil UTAMA milik Anda di konsol PS5. Akun kedua Nino hanya dipakai untuk membaca layar; kalau Anda bermain dengan akun itu, stik tidak akan merespons di dalam game."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebaik sahaja kawalan permainan dihidupkan, pilih profil UTAMA pada PS5. Akaun kedua Nino cuma bertugas membaca skrin; kalau anda bermain menggunakannya, pengawal tidak lagi memberi respons dalam permainan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra je de controller aanzet, kies je op je PS5 je EIGEN hoofdprofiel. Het tweede account van Nino leest alleen het beeld mee; speel je daarmee, dan reageert je controller niet meer in het spel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดจอยแล้ว ให้เลือกโปรไฟล์หลักที่คุณใช้เล่นประจำบนเครื่อง PS5 ส่วนแอคเคานต์สำรองของ Nino มีไว้อ่านภาพบนจอเท่านั้น ถ้าเข้าเกมด้วยแอคเคานต์นี้ จอยจะสั่งการในเกมไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolu açtıktan sonra PS5'te ANA profilinizi seçin. Nino'nun ikinci hesabı yalnız ekranı okumak içindir; onunla oynarsanız kol oyunda tepki vermez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنٹرولر آن کرنے کے بعد PS5 پر اپنی اصل (MAIN) پروفائل منتخب کریں۔ Nino والا دوسرا اکاؤنٹ صرف اسکرین پڑھنے کے لیے ہے؛ اگر آپ اس پر کھیلیں گے تو گیم میں کنٹرولر کام کرنا بند کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở tay cầm xong, nhớ chọn hồ sơ CHÍNH trên máy PS5. Còn tài khoản phụ dành cho Nino chỉ để đọc hình; chơi bằng nó thì tay cầm sẽ mất tác dụng trong game."
          }
        }
      }
    },
    "setup.account.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتابع Nino اللعبة عبر Remote Play بهذا الحساب. لو استخدم حسابك الشخصي لقطع PS5 اتصال يد التحكم لديك، أما الحساب المنفصل فيتيح لك مواصلة اللعب. يُضبط هذا مرة واحدة فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play-এর মাধ্যমে গেমটি দেখতে Nino এই অ্যাকাউন্ট ব্যবহার করে। Nino আপনার নিজের অ্যাকাউন্ট নিলে PS5 আপনার কন্ট্রোলারকে বিচ্ছিন্ন করে দিত; আলাদা অ্যাকাউন্ট থাকলে আপনি নিশ্চিন্তে খেলে যেতে পারেন। এটা মাত্র একবারই করতে হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino uses this account to follow the game over Remote Play. If Nino used your personal account, your PS5 would disconnect your controller; a separate one leaves you free to keep playing. It's a one-time setup."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Umaasa si Nino sa account na iyan para masundan ang laro mo sa Remote Play. Kung personal na account mo ang gamit ni Nino, aalisin ng PS5 sa koneksyon ang controller mo; kapag hiwalay ang account, tuloy-tuloy ka lang maglaro. Minsanan lang ang setup na ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यही अकाउंट Nino के लिए Remote Play पर गेम देखने का ज़रिया है। आपका निजी अकाउंट इस्तेमाल होता, तो PS5 कंट्रोलर को डिस्कनेक्ट कर देता; अलग अकाउंट रहने से आप आराम से खेल जारी रख पाते हैं। इसे सिर्फ़ एक दफ़ा सेट करना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewat akun ini, Nino mengikuti jalannya permainan via Remote Play. Kalau Nino memakai akun pribadi Anda, PS5 akan memutus stik Anda; dengan akun terpisah, Anda tetap bisa bermain. Cukup diatur sekali saja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini digunakan oleh Nino untuk mengikuti permainan menerusi Remote Play, manakala anda terus bermain menggunakan akaun sendiri. Kalau akaun peribadi anda yang dipakai, PS5 akan memutuskan pengawal anda. Ia hanya perlu disediakan sekali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Via dit account kijkt Nino over Remote Play mee met het spel. Zou Nino je eigen account gebruiken, dan koppelt je PS5 je controller los; met een apart account speel je gewoon door. Dit regel je eenmalig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ใช้แอคเคานต์นี้ติดตามเกมทาง Remote Play ถ้าเป็นแอคเคานต์ส่วนตัวของคุณ PS5 จะตัดจอยของคุณออก การแยกแอคเคานต์ไว้อีกอันทำให้เล่นเกมได้ต่อไปตามปกติ ทำแค่หนเดียวพอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino oyunu bu hesapla Remote Play üzerinden izler; siz kendi hesabınızla rahatça oynamaya devam edersiniz. Kendi hesabınız kullanılsaydı PS5 kolunuzu kapatırdı. Bunu yalnızca bir defa ayarlarsınız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino یہ اکاؤنٹ اس لیے لیتا ہے کہ Remote Play سے گیم کو دیکھتا رہے۔ اگر Nino آپ کا ذاتی اکاؤنٹ لیتا تو PS5 آپ کے کنٹرولر کا رابطہ توڑ دیتا؛ الگ اکاؤنٹ ہو تو آپ بے فکر ہو کر کھیل جاری رکھتے ہیں۔ یہ سیٹنگ صرف ایک دفعہ کرنی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino nhờ vào tài khoản ấy để bám theo trò chơi qua Remote Play. Giả sử Nino dùng chính tài khoản cá nhân, PS5 sẽ cắt kết nối tay cầm; tách riêng một tài khoản thì bạn cứ thế chơi tiếp. Làm một lần là xong."
          }
        }
      }
    },
    "setup.account.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم بريدًا إلكترونيًا مختلفًا لفتح حساب مجاني على playstation.com."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "playstation.com সাইটে আলাদা কোনো ইমেইল দিয়ে একটি ফ্রি অ্যাকাউন্ট বানান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a free account on playstation.com using another email address."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbukas ng account nang libre sa playstation.com, at ibang email ang ilagay."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "playstation.com पर कोई दूसरा ईमेल पता डालकर मुफ़्त अकाउंट खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftarkan satu akun baru tanpa biaya di playstation.com memakai email yang berbeda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka akaun PSN percuma menerusi playstation.com, guna e-mel yang berlainan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak op playstation.com gratis een account aan, met een e-mailadres dat je nog niet voor PSN gebruikt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมัครแอคเคานต์ใหม่ที่ playstation.com ฟรี โดยใช้อีเมลคนละอันกับที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "playstation.com'da başka bir e-posta adresiyle ücretsiz bir PSN hesabı açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "playstation.com پر ایک مفت اکاؤنٹ بنائیں، اپنے موجودہ ای میل کی جگہ کوئی اور ای میل دے کر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lập một tài khoản không mất phí trên playstation.com với một email khác."
          }
        }
      }
    },
    "setup.account.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على PS5 اختر Add User، ثم ادخل مرة واحدة بالحساب الجديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর হোম থেকে Add User বাছাই করুন, এরপর নতুন অ্যাকাউন্টটি দিয়ে একবার লগ ইন সেরে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your PS5, pick Add User, then log in one time using the new account."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa iyong PS5, pindutin ang Add User, tapos pumasok nang minsan sa bago mong account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 में Add User चुनकर नए अकाउंट से केवल एक दफ़ा लॉग इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada PS5, buka Add User, kemudian login satu kali memakai akun yang baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada PS5, tekan Add User, lalu masuk sekali menggunakan akaun yang baru dibuat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies op je PS5 voor Gebruiker toevoegen en meld je één keer aan met dat nieuwe account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน PS5 เลือก Add User และล็อกอินแอคเคานต์ใหม่นั้นหนึ่งหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'in Kullanıcı Ekle bölümünden yeni hesapla bir kere oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 میں Add User کا انتخاب کریں، پھر تازہ بنائے گئے اکاؤنٹ کے ساتھ ایک مرتبہ لاگ ان کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên PS5, chọn Add User, rồi đăng nhập đúng một lần với tài khoản vừa tạo."
          }
        }
      }
    },
    "setup.account.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما دمت في الملف الجديد، افتح قائمة الإعدادات › النظام › Remote Play. فعّل خيار تمكين Remote Play، ثم فعّل في الأسفل إخفاء حالة الاتصال حتى لا يظهر شريط Remote Play فوق لعبتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওই নতুন প্রোফাইলে থেকেই Settings › System › Remote Play খুলুন। Enable Remote Play অপশনটি অন করুন, আর নিচের দিকে Hide Connection Status-ও অন করুন, যাতে গেমের উপর Remote Play-এর কোনো ব্যানার না ভাসে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still on that new profile, go into Settings › System › Remote Play. Switch on the Enable Remote Play option, and further down switch on Hide Connection Status so no Remote Play banner appears over your game."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang nasa bagong profile ka pa, buksan itong Settings › System › Remote Play. Paganahin ang opsiyong Enable Remote Play, tapos sa bandang ibaba ay paganahin din ang Hide Connection Status para walang banner ng Remote Play na lilitaw habang naglalaro ka."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी नई प्रोफ़ाइल में रहते हुए Settings › System › Remote Play खोलें। Enable Remote Play को चालू करें, और नीचे Hide Connection Status भी चालू कर दें, ताकि खेलते समय स्क्रीन पर Remote Play की पट्टी न आए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap di profil baru itu, masuk lewat menu Pengaturan › Sistem › Remote Play. Nyalakan opsi Aktifkan Remote Play; setelah itu, di bawahnya nyalakan Sembunyikan Status Koneksi agar spanduk Remote Play tidak muncul menutupi game."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambil masih dalam profil baru itu, lawati menu Settings › System › Remote Play. Tandakan pilihan Enable Remote Play sebagai aktif, dan di bahagian bawahnya aktifkan Hide Connection Status agar sepanduk Remote Play tidak timbul semasa anda bermain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf in dat nieuwe profiel en open Instellingen › Systeem › Remote Play. Activeer daar Remote Play inschakelen, en activeer wat lager ook Verbindingsstatus verbergen, zodat je spel niet bedekt wordt door een Remote Play-banner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะยังอยู่ในโปรไฟล์ใหม่ ไปที่ Settings › System › Remote Play เปิดตัวเลือก Enable Remote Play แล้วเลื่อนลงไปเปิด Hide Connection Status ด้วย แถบแจ้ง Remote Play จะได้ไม่โผล่ทับเกม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O yeni profildeyken Ayarlar › Sistem › Uzaktan Oynatma'yı açın. Uzaktan Oynatmayı Etkinleştir seçeneğini, aşağıdaki Bağlantı Durumunu Gizle seçeneğini de açık konuma getirin; oyunun üzerinde Uzaktan Oynatma bildirimi belirmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسی نئی پروفائل میں رہتے ہوئے Settings › System › Remote Play کھولیں۔ وہاں Enable Remote Play کو چالو کریں، اور ذرا نیچے Hide Connection Status بھی چالو کر دیں، تاکہ کھیلتے وقت اسکرین پر Remote Play والی پٹی ظاہر نہ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn ở hồ sơ mới đó, đi tới Cài đặt › Hệ thống › Remote Play. Gạt Bật Remote Play sang bật, sau đó kéo xuống bật Ẩn trạng thái kết nối để biểu ngữ của Remote Play không che trò chơi."
          }
        }
      }
    },
    "setup.account.step4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارجع إلى ملفك المعتاد، ثم أسكِت التنبيهات عبر قائمة الإعدادات › الإشعارات كي لا يظهر شيء فوق الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার নিজের ব্যবহারকারীতে ফিরে যান এবং Settings › Notifications-এ নোটিফিকেশন বন্ধ করুন, যাতে কোনো পপ-আপ সাবটাইটেল ঢেকে না দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to your usual profile and silence alerts in Settings › Notifications so nothing pops up over the subtitles."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumalik sa dati mong profile at patahimikin ang mga abiso sa Settings › Notifications para walang sumulpot sa harap ng subtitle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने यूज़र पर वापस जाएँ और Settings › Notifications में सूचनाएँ बंद करें, ताकि कोई पॉप-अप सबटाइटल को न ढके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke profil biasa Anda dan bisukan pemberitahuan di Pengaturan › Notifikasi supaya tidak ada yang muncul di atas subtitel."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulang ke profil biasa anda dan senyapkan makluman dalam Settings › Notifications agar sari kata tidak dihalang oleh apa-apa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga terug naar je vaste profiel en zet meldingen uit via Instellingen › Meldingen, zodat er niets over de ondertitels heen komt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับกลับไปที่ผู้ใช้ของคุณเอง แล้วปิดการแจ้งเตือนที่ Settings › Notifications เพื่อไม่ให้มีป๊อปอัปบังคำบรรยาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki profilinize geçin, Ayarlar › Bildirimler içinde uyarıları susturun; altyazıların üstüne hiçbir şey açılmasın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے صارف پر واپس جائیں اور Settings › Notifications میں اطلاعات بند کریں، تاکہ کوئی پاپ اپ سب ٹائٹل کو نہ ڈھانپے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay lại hồ sơ thường dùng và tắt thông báo trong Cài đặt › Thông báo để không có gì bật lên che phụ đề."
          }
        }
      }
    },

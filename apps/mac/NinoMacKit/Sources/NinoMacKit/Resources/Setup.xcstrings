    "setup.welcome.ps5.message.arabic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين تلعب على PS5، يلتقط Nino الترجمة الإنجليزية للعبة ويعرضها بالعربية فوق الصورة على تلفازك. وتبقى أنت على أريكتك تلعب بيد التحكم المعتادة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি PS5-এ গেম খেলার সময় Nino এর ইংরেজি সাবটাইটেল ধরে নিয়ে TV-র ছবির উপর আরবিতে দেখায়। ওদিকে আপনি সোফায় বসে চেনা কন্ট্রোলার হাতেই খেলে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you play a PS5 game, Nino catches its English subtitles and displays an Arabic version over the picture on your TV. Meanwhile you keep playing from your couch, holding your usual controller."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang naglalaro ka ng PS5, sinasalo ni Nino ang subtitle na English at ipinapakita ito sa Arabic sa ibabaw ng larawan sa TV mo. Samantala, tuloy ka sa paglalaro mula sa sofa, hawak ang karaniwan mong controller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 पर गेम खेलते समय Nino उसके अंग्रेज़ी सबटाइटल पकड़ता है और टीवी की तस्वीर पर उनका अरबी रूप दिखा देता है। इस बीच आप सोफ़े पर आराम से बैठकर अपने उसी पुराने कंट्रोलर से खेल जारी रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selagi Anda memainkan game PS5, Nino menangkap subtitel bahasa Inggrisnya dan menampilkan versi bahasa Arab di atas gambar TV. Anda tetap bermain santai dari sofa dengan stik yang biasa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa anda bermain di PS5, Nino menangkap sari kata Inggeris dan memaparkan versi Arab di atas gambar pada TV. Anda pula terus bermain dari sofa dengan alat kawalan biasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terwijl je een PS5-game speelt, pikt Nino de Engelse ondertitels op en zet er een Arabische versie van over je tv-beeld. Jij speelt intussen gewoon door vanaf de bank, met je vertrouwde controller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะคุณเล่นเกม PS5 อยู่ Nino จะจับซับภาษาอังกฤษในเกม แล้วขึ้นฉบับภาษาอาหรับทับภาพบนทีวีให้ คุณก็นั่งเล่นบนโซฟาต่อไปด้วยจอยตัวเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino, PS5 oyunlarınızdaki İngilizce altyazıları alır ve Arapça hâlini TV'nizde görüntünün üzerine yerleştirir. Siz her zamanki kolunuzla TV başında oynamayı sürdürürsünüz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ PS5 پر گیم کھیلتے ہیں تو Nino گیم میں آنے والے انگریزی سب ٹائٹل پکڑ کر ان کا عربی روپ ٹی وی کی تصویر پر دکھا دیتا ہے۔ آپ صوفے پر بیٹھے، ہاتھ میں وہی پرانا کنٹرولر لیے کھیل جاری رکھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn chơi game PS5, Nino lấy phụ đề bằng tiếng Anh rồi hiện bản tiếng Ả Rập lên hình ảnh trên TV. Bạn vẫn ngồi sofa chơi tiếp với tay cầm quen thuộc."
          }
        }
      }
    },
    "setup.welcome.ps5.message.other": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين تلعب على PS5، يلتقط Nino الترجمة الإنجليزية للعبة ويعرضها بلغتك فوق الصورة على تلفازك. وتبقى أنت على أريكتك تلعب بيد التحكم المعتادة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি PS5-এ গেম খেলার সময় Nino এর ইংরেজি সাবটাইটেল ধরে নিয়ে TV-র ছবির উপর আপনার ভাষায় দেখায়। ওদিকে আপনি সোফায় বসে চেনা কন্ট্রোলার হাতেই খেলে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you play a PS5 game, Nino catches its English subtitles and displays a version in your language over the picture on your TV. Meanwhile you keep playing from your couch, holding your usual controller."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang naglalaro ka ng PS5, sinasalo ni Nino ang subtitle na English at ipinapakita ito sa wika mo sa ibabaw ng larawan sa TV mo. Samantala, tuloy ka sa paglalaro mula sa sofa, hawak ang karaniwan mong controller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 पर गेम खेलते समय Nino उसके अंग्रेज़ी सबटाइटल पकड़ता है और टीवी की तस्वीर पर उनका अनुवाद आपकी भाषा में दिखा देता है। इस बीच आप सोफ़े पर आराम से बैठकर अपने उसी पुराने कंट्रोलर से खेल जारी रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selagi Anda memainkan game PS5, Nino menangkap subtitel bahasa Inggrisnya dan menampilkan versi berbahasa Anda di atas gambar TV. Anda tetap bermain santai dari sofa dengan stik yang biasa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa anda bermain di PS5, Nino menangkap sari kata Inggeris dan memaparkan versi bahasa pilihan anda di atas gambar pada TV. Anda pula terus bermain dari sofa dengan alat kawalan biasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terwijl je een PS5-game speelt, pikt Nino de Engelse ondertitels op en zet er een versie in jouw taal van over je tv-beeld. Jij speelt intussen gewoon door vanaf de bank, met je vertrouwde controller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะคุณเล่นเกม PS5 อยู่ Nino จะจับซับภาษาอังกฤษในเกม แล้วขึ้นฉบับภาษาของคุณทับภาพบนทีวีให้ คุณก็นั่งเล่นบนโซฟาต่อไปด้วยจอยตัวเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino, PS5 oyunlarınızdaki İngilizce altyazıları alır ve sizin dilinizdeki hâlini TV'nizde görüntünün üzerine yerleştirir. Siz her zamanki kolunuzla TV başında oynamayı sürdürürsünüz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ PS5 پر گیم کھیلتے ہیں تو Nino گیم میں آنے والے انگریزی سب ٹائٹل پکڑ کر انہیں آپ کی اپنی بولی میں ٹی وی کی تصویر پر دکھا دیتا ہے۔ آپ صوفے پر بیٹھے، ہاتھ میں وہی پرانا کنٹرولر لیے کھیل جاری رکھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn chơi game PS5, Nino lấy phụ đề bằng tiếng Anh rồi hiện bản dịch theo ngôn ngữ bạn chọn lên hình ảnh trên TV. Bạn vẫn ngồi sofa chơi tiếp với tay cầm quen thuộc."
          }
        }
      }
    },

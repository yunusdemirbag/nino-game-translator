    "setup.samsung.dropped": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعدادات تبدو صحيحة، ومع ذلك قطع التلفاز الاتصال. افصل سلك الكهرباء عن التلفاز وانتظر دقيقة تقريبًا ثم أعده، وبعد أن يعمل امنحه دقيقة أخرى. سيعيد Nino المحاولة تلقائيًا فور عودة التلفاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস ঠিকঠাক মনে হচ্ছে, তবু TV সংযোগটি ছিন্ন করেছে। TV-র পাওয়ার প্লাগ খুলে ফেলুন, মিনিটখানেক অপেক্ষা করে আবার লাগান, আর চালু হলে আরও এক মিনিট সময় দিন। TV ফিরে এলেই Nino নিজে থেকে আবার চেষ্টা করবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its settings look correct, yet the TV cut the connection. Pull the TV's power cord, wait about a minute and reconnect it, then give it another minute once it's on. Nino will retry on its own as soon as the TV returns."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang tama ang settings, pero pinutol pa rin ng TV ang pagkakakonekta. Hugutin sa saksakan ang power cord ng TV, maghintay nang mga isang minuto at isaksak ulit, tapos bigyan pa ito ng isang minuto pagka-on. Kusang susubok ulit si Nino kapag bumalik na ang TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स ठीक दिखती हैं, फिर भी टीवी ने कनेक्शन तोड़ दिया। टीवी का पावर प्लग निकालें, करीब एक मिनट रुककर फिर लगाएँ, और ऑन होने पर एक मिनट और रुकें। टीवी के लौटते ही Nino अपने-आप फिर कोशिश करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturannya tampak benar, tetapi TV memutus sambungan. Cabut kabel daya TV, tunggu kira-kira semenit, lalu colokkan lagi, dan beri waktu semenit lagi setelah menyala. Nino otomatis mencoba lagi begitu TV kembali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan TV nampak betul, tetapi sambungan diputuskan oleh TV. Cabut kord kuasa TV, tunggu lebih kurang seminit dan pasang semula, kemudian beri seminit lagi selepas ia hidup. Nino akan mencuba sendiri sebaik TV kembali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De instellingen lijken goed, maar de tv verbrak toch de verbinding. Trek de stroomkabel van de tv los, wacht zo'n minuut, sluit hem weer aan en gun de tv na het opstarten nog een minuut. Nino doet zelf een nieuwe poging zodra de tv weer bereikbaar is."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าต่าง ๆ ดูถูกหมด แต่ทีวีกลับตัดสายสัญญาณทิ้ง ให้ถอดปลั๊กทีวี รอสักหนึ่งนาทีค่อยเสียบคืน พอทีวีติดแล้วรออีกราวหนึ่งนาที ทันทีที่ทีวีกลับมา Nino จะลองใหม่เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları doğru göründüğü hâlde TV bağlantıyı kopardı. TV'yi prizden çekin, yaklaşık bir dakika sonra geri takın; açıldıktan sonra da bir dakika daha tanıyın. TV döndüğünde Nino kendisi yeniden bağlanmayı dener."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیٹنگز ٹھیک دکھتی ہیں، پھر بھی ٹی وی نے رابطہ کاٹ دیا۔ ٹی وی کی بجلی کی تار نکالیں، لگ بھگ ایک منٹ رک کر دوبارہ لگائیں، اور چالو ہونے کے بعد اسے ایک منٹ اور دیں۔ ٹی وی واپس آتے ہی Nino خود کوشش کرے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt có vẻ đúng nhưng TV lại cắt kết nối. Rút dây nguồn TV, chờ khoảng một phút rồi cắm lại, sau khi TV lên thì đợi thêm một phút. Nino sẽ tự kết nối lại ngay khi TV chạy lại."
          }
        }
      }
    },
    "setup.samsung.leadingZeros %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كُتب العنوان على التلفاز بأصفار بادئة (%1$@)، لذا لن يقبل هذا الكمبيوتر. اكتبه مرة أخرى بدونها: %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র ঠিকানার শুরুতে বাড়তি শূন্য বসানো হয়েছে (%1$@), সেজন্য TV কম্পিউটারটিকে ঢুকতে দিচ্ছে না। শূন্যগুলো বাদ দিয়ে আবার লিখুন: %2$@।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra zeros were entered at the start of your TV's address (%1$@), which makes it reject this computer. Enter it once more without them: %2$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May sobrang zero sa unahan ng address na inilagay sa TV mo (%1$@), kaya ayaw nitong tanggapin ang computer mo. Ilagay itong muli nang walang ganoong zero: %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी के पते (%1$@) की शुरुआत में फ़ालतू शून्य लिखे गए हैं, इसी कारण टीवी इस कंप्यूटर को मना कर रहा है। शून्य हटाकर इसे दोबारा लिखें: %2$@।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat di TV Anda diawali angka nol yang berlebih (%1$@), sehingga komputer ini ditolak. Ketik ulang tanpa nol tersebut: %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat TV anda (%1$@) mengandungi sifar lebih di hadapan, maka TV menolak komputer ini. Isikan semula tanpa sifar tersebut: %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan het begin van het adres op je tv (%1$@) staan extra nullen, en daardoor weigert je tv deze computer. Vul het nog eens in zonder die nullen: %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่บนทีวี (%1$@) มีเลขศูนย์เกินมาข้างหน้า ทีวีเลยไม่ยอมรับคอมเครื่องนี้ ลองกรอกใหม่โดยตัดศูนย์ออก: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'ye girilen adresin önünde fazladan sıfırlar var (%1$@); TV bu yüzden bu bilgisayarı reddediyor. Sıfırları atıp tekrar girin: %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کے ایڈریس (%1$@) میں شروع میں فالتو صفر لکھے گئے ہیں، اس وجہ سے ٹی وی یہ کمپیوٹر رد کر دیتا ہے۔ صفر ہٹا کر یوں دوبارہ لکھیں: %2$@۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ ghi trong TV bị dư số 0 phía trước (%1$@), vì thế TV từ chối chiếc máy này. Gõ lại một lần nữa, bỏ những số 0 đó: %2$@."
          }
        }
      }
    },
    "setup.samsung.loopback %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُظهر التلفاز Host PC IP بالقيمة 127.0.0.1، وهذه تناسب برامج التثبيت العاملة داخل التلفاز وحدها. لكن Nino يجري التثبيت انطلاقًا من هذا الحاسوب، فاجعل القيمة %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার TV-র Host PC IP এখন 127.0.0.1, যা কেবল TV-র ভেতরে চলা ইনস্টলারের জন্য খাটে। Nino এই কম্পিউটার থেকেই ইনস্টল করে, তাই এটি %@ করে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV lists Host PC IP as 127.0.0.1, which only suits installers running inside the TV. Nino does its installing from this computer, so set it to %@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakatakda sa 127.0.0.1 itong value ng Host PC IP na nasa TV mo, na bagay lang kapag sa loob mismo ng TV gumagana ang installer. Sa computer mo nag-i-install si Nino, kaya gawin itong %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP के तौर पर टीवी में 127.0.0.1 दर्ज है; यह सिर्फ़ उन इंस्टॉलरों के लिए ठीक है जो टीवी के भीतर ही चलते हैं। Nino तो इस कंप्यूटर से इंस्टॉलेशन करता है, इसलिए इसकी जगह %@ लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di TV Anda, kolom Host PC IP terisi 127.0.0.1. Nilai itu hanya cocok untuk penginstal yang berjalan di dalam TV, sedangkan Nino menginstal dari komputer ini, jadi ubah menjadi %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV anda menyenaraikan Host PC IP sebagai 127.0.0.1, iaitu nilai untuk pemasang yang dijalankan dalam TV sendiri. Pemasangan Nino dilakukan daripada komputer ini, jadi gantikannya dengan %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij Host PC IP staat op je tv 127.0.0.1. Dat werkt alleen voor installers die binnen de tv zelf lopen. Nino installeert juist vanaf deze computer, dus vul %@ in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP บนทีวีเป็น 127.0.0.1 ซึ่งใช้ได้กับโปรแกรมลงแอปที่ทำงานภายในทีวีเท่านั้น แต่ Nino ลงแอปจากคอมเครื่องนี้ จึงต้องแก้เป็น %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nizdeki Host PC IP değeri 127.0.0.1. Bu değer yalnız TV'nin içinde çalışan kurucular için geçerlidir; Nino ise kurulumu bu bilgisayardan yapar. Değeri %@ olarak değiştirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کی سیٹنگ کے مطابق Host PC IP کی قیمت 127.0.0.1 درج ہے، اور یہ پتہ بس اُن انسٹالرز کا ہے جو ٹی وی پر ہی چلتے ہوں۔ Nino انسٹال اسی کمپیوٹر سے کرتا ہے، لہٰذا یہاں %@ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV đang để Host PC IP bằng 127.0.0.1, giá trị này chỉ hợp với trình cài nằm sẵn trong TV. Nino lại cài đặt từ chiếc máy này, nên hãy đặt thành %@."
          }
        }
      }
    },
    "setup.samsung.macAddress %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيمة Host PC IP لهذا الحاسوب: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কম্পিউটারের Host PC IP: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP for this computer: %@"
          }
        },
        "fil": {

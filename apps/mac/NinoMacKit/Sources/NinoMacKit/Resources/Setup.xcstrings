            "state": "translated",
            "value": "Gunakan remote TV untuk menekan 1 2 3 4 5"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toets 1 2 3 4 5 in met je afstandsbediening"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้รีโมตทีวีป้อน 1 2 3 4 5 ลงไป"
          }
        },
        "tr": {

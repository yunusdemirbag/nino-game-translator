        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP के तौर पर टीवी में %1$@ दर्ज है; यहाँ %2$@ होना चाहिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP yang tercatat pada TV: %1$@. Yang benar: %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV anda menyenaraikan Host PC IP sebagai %1$@; nilai yang betul ialah %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij Host PC IP staat op je tv %1$@, terwijl %2$@ vereist is"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP บนทีวีเป็น %1$@ แต่ที่ถูกคือ %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nizdeki Host PC IP değeri %1$@; doğrusu %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کی سیٹنگ کے مطابق Host PC IP کی قیمت %1$@ درج ہے؛ درست قیمت %2$@ ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV đang để Host PC IP bằng %1$@; cần đổi thành %2$@"
          }
        }
      }
    },

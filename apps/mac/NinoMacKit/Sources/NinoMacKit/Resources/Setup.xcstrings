    "setup.tv.android.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلفزيونات بنظام Android من علامات مثل Arçelik وBeko وGrundig وiFFALCON وPhilips وSony وTCL وVestel."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Arçelik, Beko, Grundig, iFFALCON, Philips, Sony, TCL ও Vestel-এর মতো ব্র্যান্ডের Android-চালিত TV।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-based TVs from brands like Arçelik, Beko, Grundig, iFFALCON, Philips, Sony, TCL and Vestel."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga TV na Android ang gamit, mula sa mga brand tulad ng Arçelik, Beko, Grundig, iFFALCON, Philips, Sony, TCL at Vestel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arçelik, Beko, Grundig, iFFALCON, Philips, Sony, TCL और Vestel जैसी कंपनियों के Android वाले टीवी।"
          }

    "setup.test.message.tv": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيضع Nino بعد لحظة ترجمة للتجربة على التلفاز. انظر إلى أسفل الصورة، فوق لعبتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino এখন TV স্ক্রিনে একটি পরীক্ষার সাবটাইটেল দেখাবে। গেমের উপরে, নিচের দিকে খেয়াল করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino is about to put a test subtitle on your TV screen. Look for it along the bottom, over your game."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maglalagay si Nino ng test subtitle sa TV mo. Hanapin ito sa ibaba, nakapatong sa laro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino अब टीवी पर एक टेस्ट सबटाइटल भेजेगा। उसे नीचे की तरफ़, गेम की तस्वीर पर ढूँढें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino akan menampilkan subtitel uji di layar TV. Cari di bagian bawah, menimpa tampilan game."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino akan meletakkan sari kata percubaan pada skrin TV. Cari di bahagian bawah, di atas permainan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino zet zo een proefondertitel op je tv. Kijk onderaan het beeld, boven je spel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino กำลังจะส่งซับทดลองไปขึ้นบนจอทีวี ลองมองหาตรงขอบล่าง ทับอยู่บนเกม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino TV'nize bir deneme altyazısı yollayacak. Altyazı ekranın alt kısmında, oyunun üzerinde çıkmalı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ابھی ٹی وی پر آزمائش کے لیے ایک سطر بھیجنے والا ہے۔ اسے نیچے کی طرف، گیم کے اوپر تلاش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino sắp hiện một dòng phụ đề thử trên TV. Hãy nhìn phía dưới màn hình, đè lên trò chơi."
          }
        }
      }

    "setup.welcome.ps5.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا، هذا Nino"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino আপনাকে স্বাগত জানায়"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino Welcomes You"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumusta, ito si Nino"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino आपका स्वागत करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino Menyambut Anda"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino Mengalu-alukan Anda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijn dat je er bent"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวัสดี นี่คือ Nino"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba, burası Nino Game Translator"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خوش آمدید، یہ Nino ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino xin chào bạn"
          }
        }
      }
    },
    "setup.welcome.thisComputer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألعب على هذا الكمبيوتر باستخدام PS Remote Play"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি PS Remote Play চালিয়ে এই Mac-এই খেলি"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I use PS Remote Play to play here on my Mac"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "PS Remote Play ang gamit ko para maglaro dito sa Mac"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं यहीं Mac पर खेलता हूँ, PS Remote Play चलाकर"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya main langsung di Mac ini memakai PS Remote Play"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya guna PS Remote Play untuk bermain terus di Mac"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik speel hier op mijn Mac, via PS Remote Play"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันใช้ PS Remote Play เล่นอยู่บน Mac ตัวนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS Remote Play ile bu Mac'te oynuyorum"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں PS Remote Play چلا کر یہیں اپنے Mac پر کھیلتا ہوں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi chơi ngay trên Mac qua PS Remote Play"
          }
        }
      }
    },
    "setup.welcome.thisComputer.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يلزمك تلفاز ولا حساب ثانٍ. يراقب Nino ما يعرضه Remote Play ويضع الترجمة فوق لعبتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV লাগে না, দ্বিতীয় অ্যাকাউন্টও না। Remote Play যা দেখায় Nino তা দেখে আর আপনার গেমের উপর অনুবাদ বসিয়ে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither a TV nor a second account is required. Nino watches what Remote Play shows and lays the translation over your game."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mo kakailanganin ang TV, o ang pangalawang account. Binabantayan ni Nino ang ipinapakita sa Remote Play at ipinapatong ang salin sa laro mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न टीवी चाहिए, न दूसरा अकाउंट। Nino देखता है कि Remote Play में क्या दिख रहा है और अनुवाद गेम के ऊपर दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak perlu TV maupun akun kedua. Nino memantau tampilan Remote Play dan menaruh terjemahan menimpa tampilan game."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak perlukan TV ataupun akaun kedua. Nino memerhati apa yang dipaparkan Remote Play lalu menindih terjemahan pada permainan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt geen tv nodig, en ook geen tweede account. Nino houdt in de gaten wat Remote Play toont en legt de vertaling over je spel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีทีวีหรือแอคเคานต์สำรอง Nino คอยดูภาพที่ Remote Play แสดง แล้ววางคำแปลซ้อนบนเกมให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'ye de ikinci hesaba da gerek yok. Nino, Remote Play penceresinde olanı izler ve çeviriyi oyunun üzerine yerleştirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نہ ٹی وی درکار ہے نہ دوسرا اکاؤنٹ۔ Remote Play جو دکھاتا ہے Nino اسے دیکھتا ہے اور ترجمہ گیم پر بچھا دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần TV, cũng chẳng cần thêm tài khoản. Nino xem những gì Remote Play hiển thị và đặt bản dịch lên trò chơi."
          }
        }
      }
    },
    "setup.xbox.browser": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أو جرّبه من المتصفح دون أن تثبّت شيئًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অথবা ব্রাউজারেই চালিয়ে দেখুন, কিছু ইনস্টল করতে হবে না"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or try it in your browser, nothing to install"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "O subukan sa browser mo, walang kailangang i-install"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "या ब्राउज़र में आज़माएँ, कुछ इंस्टॉल नहीं करना"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atau coba lewat browser, tanpa perlu memasang apa pun"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atau cuba terus di pelayar, tiada apa-apa perlu dipasang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of probeer het in je browser, zonder iets te installeren"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หรือลองเล่นในเบราว์เซอร์ ไม่ต้องลงอะไรเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklemeden tarayıcıda dene"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یا براؤزر میں آزما لیں، کچھ انسٹال کیے بغیر"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử trong trình duyệt mà không cần cài đặt"
          }
        }
      }
    },
    "setup.xbox.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص Nino الخطوات واحدة تلو الأخرى وحده ثم يكمل. وكل هذا لمرة واحدة فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino প্রতিটি ধাপ নিজেই মিলিয়ে দেখে, তারপর সামনে যায়। এটা মাত্র একবারই করতে হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino verifies each step on its own and continues. It's a one-time setup."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusang sinusuri ni Nino ang bawat isang hakbang bago magpatuloy. Minsanan lang ang setup na ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino हर चरण को खुद परखकर आगे जाता है। यह सेटअप एक ही बार का काम है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino memeriksa tiap langkah sendiri lalu melanjutkan. Cukup diatur sekali saja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap langkah disemak sendiri oleh Nino sebelum ia diteruskan. Ia hanya perlu disediakan sekali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino checkt zelf elke stap en gaat dan door. Dit regel je eenmalig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ตรวจสอบทุกขั้นตอนเองแล้วไปต่อ คุณทำเพียงครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino adımları tek tek kendisi doğrular ve ilerler. Bu ayarı yalnızca bir defa yaparsınız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر قدم کو Nino خود جانچتا ہے اور پھر اگلے پر جاتا ہے۔ یہ کام صرف ایک دفعہ کا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tự xem xét từng bước rồi làm tiếp. Làm một lần là xong."
          }
        }
      }
    },

    "setup.samsung.typeCode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الأرقام 1 2 3 4 5 من ريموت التلفاز"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র রিমোট দিয়ে 1 2 3 4 5 টিপুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key in 1 2 3 4 5 using your TV remote"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamit ang TV remote, isa-isang pindutin: 1 2 3 4 5"
          }
        },
        "hi": {
          "stringUnit": {

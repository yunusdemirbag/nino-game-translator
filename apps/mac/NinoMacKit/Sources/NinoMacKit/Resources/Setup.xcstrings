    "setup.tv.lgSamsung.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلفزيونات بنظام LG webOS أو Samsung Tizen. يكتشفها Nino على شبكتك تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "LG webOS বা Samsung Tizen চলা TV। Nino নেটওয়ার্কে এগুলোকে নিজে থেকেই খুঁজে পায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TVs running LG webOS or Samsung Tizen. Nino spots them on your network automatically."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga TV na may LG webOS o Samsung Tizen. Kusang natutukoy ni Nino ang ganitong TV sa network mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LG webOS या Samsung Tizen वाले टीवी। Nino इन्हें नेटवर्क पर खुद पहचान लेता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV dengan LG webOS atau Samsung Tizen. Nino otomatis mendeteksinya di jaringan Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV dengan LG webOS atau Samsung Tizen. Nino mengesannya pada rangkaian anda secara automatik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tv's met LG webOS of Samsung Tizen. Nino vindt ze vanzelf op je netwerk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีระบบ LG webOS หรือ Samsung Tizen Nino จะหาเจอเองในวงเน็ตของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LG webOS ya da Samsung Tizen çalıştıran TV'ler. Nino bu TV'leri ağınızda kendiliğinden görür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "LG webOS یا Samsung Tizen والے ٹی وی۔ Nino ایسے ٹی وی آپ کے راؤٹر سے جڑے آلات میں خود پہچان لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV chạy LG webOS hoặc Samsung Tizen. Nino tự phát hiện chúng trong mạng của bạn."
          }
        }
      }
    },

    "setup.card.check.working": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء جاهز، والصورة تصل من PS5."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ড কাজ করছে। PS5-এর ছবি আসছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All set. Video from your PS5 is arriving."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayos na. Pumapasok na ang video galing sa PS5 mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब ठीक है। PS5 की वीडियो आ रही है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu berfungsi. Gambar PS5 sudah masuk."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad berfungsi. Gambar PS5 sedang diterima."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaart werkt. Het PS5-beeld komt binnen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดทำงานแล้ว ภาพจาก PS5 กำลังเข้ามา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Card hazır. PS5 görüntüsü alınıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب ٹھیک ہے۔ PS5 کی ویڈیو آ رہی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong rồi. Đã nhận được hình từ PS5."
          }
        }
      }
    },
    "setup.card.connect.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلتقط البطاقة صورة HDMI الصادرة من PS5 وتمرّرها عبر USB إلى جهاز Mac الذي تستخدمه. لا يلزمك حساب PSN إضافي، ولا دور لـ Remote Play هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "capture card PS5-এর HDMI ছবি ধরে USB-র মাধ্যমে Mac পর্যন্ত পৌঁছে দেয়। বাড়তি PSN অ্যাকাউন্ট লাগবে না, Remote Play-ও ব্যবহার হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A capture card grabs your PS5's HDMI video and passes it through USB to this Mac. You won't need an extra PSN account, and Remote Play isn't used."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinasalo ng isang capture card ang HDMI video ng PS5 at ipinapasa ito sa Mac mo sa pamamagitan ng USB. Hindi mo kailangan ng dagdag na PSN account, at hindi gagamitin ang Remote Play."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture card, PS5 से HDMI वीडियो लेकर उसे USB के रास्ते इस Mac तक भेजता है। अलग PSN अकाउंट नहीं बनाना पड़ता और Remote Play भी काम में नहीं आता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu capture mengambil video HDMI dari PS5 dan meneruskannya lewat USB ke Mac ini. Akun PSN tambahan tidak diperlukan, dan Remote Play tidak dipakai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tangkap merakam video HDMI daripada PS5 lalu menyalurkannya menerusi USB ke Mac ini. Akaun PSN tambahan tidak perlu, dan Remote Play tidak dipakai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een opnamekaart vangt het HDMI-beeld van je PS5 op en stuurt het via USB naar deze Mac. Een extra PSN-account is dan niet nodig, en Remote Play doet niet mee."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดจับภาพจะรับสัญญาณ HDMI จาก PS5 แล้วส่งต่อเข้า Mac เครื่องนี้ทาง USB แบบนี้ไม่จำเป็นต้องใช้แอคเคานต์ PSN เพิ่ม และไม่ต้องพึ่ง Remote Play"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Card, PS5'in HDMI görüntüsünü alıp USB üzerinden bu Mac'e aktarır. Ek bir PSN hesabına veya Remote Play'e ihtiyaç kalmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کی HDMI ویڈیو کیپچر کارڈ پکڑ لیتا ہے، پھر USB تار کے راستے اس Mac تک پہنچاتا ہے۔ اس صورت میں نہ اضافی PSN اکاؤنٹ چاہیے، نہ Remote Play۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Card ghi hình lấy tín hiệu HDMI của PS5 và đưa qua USB vào Mac này. Bạn không cần thêm tài khoản PSN, cũng không dùng đến Remote Play."
          }
        }
      }
    },
    "setup.card.connect.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف يتصل PS5 لديك؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার PS5 কীভাবে যুক্ত?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Does Your PS5 Connect?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paano nakakonekta ang PS5 mo?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका PS5 किस तरह जुड़ता है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 Anda Tersambung Lewat Apa?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana PS5 Anda Disambungkan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",

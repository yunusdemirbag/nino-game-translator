          }
        }
      }
    },
    "setup.card.check.permission": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى جهاز Mac بطاقة الالتقاط ككاميرا، لذا يلزم Nino إذن الكاميرا: إعدادات النظام › الخصوصية والأمن › الكاميرا. بعدها أغلق Nino وافتحه من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac capture card-কে ক্যামেরা হিসেবেই দেখে। তাই Nino-কে ক্যামেরা ব্যবহারের অনুমতি দিন: System Settings › Privacy & Security › Camera। এরপর Nino বন্ধ করে আবার খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac treats a capture card like a camera. Nino needs Camera access: System Settings › Privacy & Security › Camera. Afterwards, quit and reopen Nino."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa Mac mo, parang camera ang capture card. Kailangan ni Nino ng access sa Camera: System Settings › Privacy & Security › Camera. Pagkatapos, isara at buksan muli si Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac capture card को कैमरे की तरह देखता है। इसलिए Nino को कैमरा इस्तेमाल करने की इजाज़त चाहिए: System Settings › Privacy & Security › Camera। उसके बाद Nino बंद करके दोबारा खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac memperlakukan kartu capture seperti kamera, jadi Nino butuh izin Kamera: Pengaturan Sistem › Privasi & Keamanan › Kamera. Setelah itu, tutup Nino lalu buka lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac menganggap kad tangkap sebagai kamera, jadi Nino perlukan akses Kamera: Tetapan Sistem › Privasi & Keselamatan › Kamera. Selepas itu, tutup Nino dan bukanya semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac ziet een opnamekaart als camera, dus Nino heeft cameratoegang nodig: Systeeminstellingen › Privacy en beveiliging › Camera. Sluit Nino daarna af en open het opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac มองการ์ดจับภาพว่าเป็นกล้องตัวหนึ่ง Nino จึงต้องได้รับอนุญาตใช้กล้อง: การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › กล้อง จากนั้นปิด Nino แล้วเปิดขึ้นมาใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac, Capture Card'ı kamera gibi görür. Nino'ya kamera izni verin: Sistem Ayarları › Gizlilik ve Güvenlik › Kamera. Sonra Nino'yu kapatıp yeniden açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac کیپچر کارڈ کو کیمرے کی طرح دیکھتا ہے، اس لیے Nino کو کیمرے تک رسائی دیں: System Settings › Privacy & Security › Camera۔ اس کے بعد Nino بند کر کے دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac xem card ghi hình như một camera, nên Nino cần quyền dùng Camera: Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Camera. Xong thì thoát Nino và mở lại."
          }
        }
      }
    },
    "setup.card.check.plugIn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِل البطاقة مباشرةً بأحد منافذ USB 3 في جهاز Mac هذا. إن كنت تستعمل موزّعًا فاستخدم بدلًا منه منفذًا مدمجًا في الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ডটি সোজাসুজি এই Mac-এর একটা USB 3 পোর্টে গুঁজে দিন। মাঝখানে হাব থাকলে সেটি সরিয়ে কম্পিউটারের গায়ের পোর্টেই লাগান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug the card straight into one of this Mac's USB 3 ports. If you're using a hub, use one of the Mac's built-in ports instead."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Diretsong ikabit ang card sa isang USB 3 port na nasa mismong Mac. Kung naka-hub ka, ilipat ito sa port ng Mac mismo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड को किसी हब के बिना सीधे इसी Mac में, उसके किसी USB 3 पोर्ट पर लगाएँ। हब इस्तेमाल हो रहा हो, तो उसे छोड़कर Mac का अपना पोर्ट लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokkan kartu langsung ke salah satu port USB 3 milik Mac. Kalau memakai hub, ganti dengan port bawaan Mac."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang kad terus pada port USB 3 milik Mac ini. Kalau anda memakai hab, gunakan port terbina dalam Mac sebagai ganti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prik de kaart rechtstreeks in een van de USB 3-aansluitingen van deze Mac. Zit er een hub tussen? Neem dan liever een ingebouwde aansluiting van de Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบการ์ดเข้าพอร์ต USB 3 ของ Mac โดยตรง หากผ่านฮับอยู่ ให้ย้ายมาเสียบพอร์ตที่ติดมากับตัวเครื่องแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartı bu Mac'teki USB 3 yuvalarından birine doğrudan takın. Arada bir çoklayıcı kullanıyorsanız Mac'in üstündeki bir yuvayı deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ کو سیدھا اس Mac کے کسی USB 3 ساکٹ سے جوڑیں۔ ہب لگا ہو تو اسے ہٹا کر Mac کی اپنی پورٹ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm card thẳng vào một cổng USB 3 của Mac. Nếu đang dùng hub, hãy chuyển sang cổng có sẵn trên máy."
          }
        }
      }
    },

        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de gelen isteği kabul edin…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی پر آنے والا سوال منظور کریں…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận thông báo trên TV…"
          }
        }
      }
    },
    "setup.tv.connecting.samsung": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقبل مربع الإذن على التلفاز بجهاز التحكم («السماح»). ينتظر Nino ‏60 ثانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র বার্তায় রিমোট ব্যবহার করে Allow বেছে নিন। Nino এক মিনিট (৬০ সেকেন্ড) অবধি অপেক্ষায় থাকবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your TV, pick Allow in the prompt using the remote. Nino keeps waiting for 60 seconds."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa TV mo, gamitin ang remote para pindutin ang Allow sa lumabas na tanong. Animnapung segundo (60) maghihintay si Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी पर आए संदेश में रिमोट से Allow चुनें। Nino 60 सेकंड तक रुकेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di TV, pilih Allow pada permintaan yang muncul dengan remote. Nino akan menunggu hingga 60 detik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di TV, gunakan remote untuk memilih Allow dalam gesaan. Nino akan menunggu 60 saat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Toestaan in de melding die je tv toont, met je afstandsbediening. Nino wacht hier 60 seconden op."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้รีโมตกด Allow ในกล่องที่ขึ้นบนทีวี Nino จะรอไว้ 60 วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nizde çıkan soruda kumandayla izin verme seçeneğini onaylayın. Nino 60 saniye boyunca bekler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی پر کھلنے والے خانے میں ریموٹ سے Allow چن لیں۔ Nino پورے 60 سیکنڈ رکا رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên TV, dùng điều khiển chọn Allow trong hộp thoại. Nino sẽ chờ trong 60 giây."
          }
        }
      }
    },
    "setup.tv.error.noResponse": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التلفاز لا يرد. هل هو مشغَّل ويشارك جهاز Mac الذي تستخدمه الشبكةَ ذاتها؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV থেকে কোনো সাড়া নেই। TV কি অন অবস্থায় এই Mac-এর নেটওয়ার্কেই আছে?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer from your TV. Is it switched on and connected to the network this Mac uses?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang sagot mula sa TV mo. Nakabukas ba ito at konektado sa network na gamit din ng Mac mo?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी से कोई जवाब नहीं आया। क्या टीवी ऑन है, साथ ही उसी नेटवर्क से कनेक्टेड है जो यह Mac इस्तेमाल करता है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV tidak menjawab. TV sudah hidup dan memakai jaringan yang sama seperti Mac ini?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV anda tidak memberi respons. Adakah TV menyala dan menggunakan rangkaian sama seperti Mac ini?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen reactie van je tv. Is hij ingeschakeld en verbonden met het netwerk dat deze Mac ook gebruikt?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีไม่ตอบกลับ ทีวีเปิดอยู่และใช้วงเน็ตเดียวกับ Mac นี้หรือเปล่า?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV cevap vermedi. Açık olduğunu ve aynı ağa bağlı olduğunu denetleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کوئی جواب نہیں دے رہا۔ کیا وہ چالو ہے، اور یہ Mac جس نیٹ ورک سے جڑا ہے، کیا ٹی وی بھی وہیں ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV không trả lời. TV có đang mở, có dùng chung mạng với Mac này không?"
          }
        }
      }
    },
    "setup.tv.error.samsungNotAccepted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يوافق أحد على طلب التلفاز في المهلة (60 ثانية). إن لم يظهر لك الطلب فارجع إلى الشاشة الرئيسية للتلفاز واختر «اتصال» مجددًا. وإن كنت رفضت Nino سابقًا فاسمح له من Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়মতো (৬০ সেকেন্ড) কেউ TV-র বার্তাটি নিশ্চিত করেনি। বার্তাটি একেবারেই না দেখে থাকলে TV-র শুরুর স্ক্রিনে ফিরে আবার Connect বেছে নিন। আগে Nino-কে না বলে থাকলে অনুমতিটি দিন এই পথে: Settings › General › External Device Manager › Device Connection Manager › Device List।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody confirmed the TV's prompt in time (60 seconds). If you never saw it, return to the TV's start screen and choose Connect once more. If you turned Nino down earlier, give it permission under Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang kumumpirma sa tanong ng TV bago maubos ang oras (60 segundo). Kung hindi mo nakita ang tanong, bumalik sa start screen ng TV mo at piliin ulit ang Connect. Kung tinanggihan mo si Nino dati, bigyan ito ng pahintulot dito: Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी पर आया संदेश समय पर (60 सेकंड में) मंज़ूर नहीं हुआ। अगर संदेश दिखा ही नहीं, तो टीवी की होम स्क्रीन पर लौटें और फिर से Connect चुनें। अगर आपने पिछली बार Nino को अनुमति नहीं दी थी, तो Settings › General › External Device Manager › Device Connection Manager › Device List के अंदर उसे इजाज़त दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan di TV tidak disetujui tepat waktu (60 detik). Jika permintaan itu tidak pernah muncul, kembali ke layar awal TV dan pilih Hubungkan lagi. Jika sebelumnya Anda menolak Nino, beri izin di Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesaan di TV tidak disahkan tepat pada masanya (60 saat). Kalau gesaan itu tidak pernah kelihatan, pulang ke skrin mula TV dan pilih Sambung semula. Kalau Nino telah anda tolak sebelum ini, berikan kebenaran di Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand heeft de melding op tijd bevestigd (60 seconden). Niets gezien? Ga terug naar het startscherm op je tv en kies nog eens Verbinden. Heb je Nino eerder afgewezen, geef dan toestemming via Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีใครกดยืนยันกล่องบนทีวีทันเวลา (60 วินาที) ถ้าไม่เห็นกล่องเลย ให้กลับไปหน้าแรกของทีวีแล้วกด Connect อีกรอบ ถ้าเคยปฏิเสธ Nino ไปก่อนหน้านี้ ให้เปิดสิทธิ์ที่ Settings › General › External Device Manager › Device Connection Manager › Device List"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'deki soru 60 saniyelik süre içinde onaylanmadı. Soru hiç belirmediyse TV'nin ana ekranına gidip Bağlan'a bir kez daha basın. Nino'yu önceden geri çevirdiyseniz izni şuradan verin: Ayarlar › Genel › Harici Aygıt Yöneticisi › Cihaz Bağlantı Yöneticisi › Cihaz Listesi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقررہ وقت (60 سیکنڈ) میں کسی نے ٹی وی کا سوال منظور نہیں کیا۔ وہ خانہ دکھا ہی نہیں تو ٹی وی کی ابتدائی اسکرین پر لوٹ کر Connect ایک بار اور چنیں۔ اگر پہلے آپ Nino کو منع کر چکے ہیں تو یہ راستہ کھولیں اور اجازت دیں: Settings › General › External Device Manager › Device Connection Manager › Device List۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai xác nhận thông báo trên TV kịp lúc (60 giây). Nếu bạn không thấy thông báo, hãy quay ra màn hình đầu tiên của TV rồi chọn Kết nối lần nữa. Nếu trước đó bạn đã từ chối Nino, hãy cấp quyền trong Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        }
      }
    },
    "setup.tv.error.samsungRefused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل التلفاز الاتصال. من التلفاز امنح Nino الإذن في Settings › General › External Device Manager › Device Connection Manager › Device List، ثم اختر «اتصال» مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV সংযোগটি নাকচ করেছে। অনুমতি দেওয়ার পথ: Settings › General › External Device Manager › Device Connection Manager › Device List; সেখানে Nino-কে মঞ্জুর করে ফের Connect বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV turned the connection down. On the TV, give Nino permission under Settings › General › External Device Manager › Device Connection Manager › Device List, and choose Connect once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinanggihan ng TV mo ang pagkonekta. Sa TV, bigyan si Nino ng pahintulot dito: Settings › General › External Device Manager › Device Connection Manager › Device List, at piliin ulit ang Connect."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी ने कनेक्शन नामंज़ूर कर दिया। Settings › General › External Device Manager › Device Connection Manager › Device List खोलकर Nino को इजाज़त दें, फिर एक बार और Connect चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV menolak sambungan. Di TV, beri izin untuk Nino di Settings › General › External Device Manager › Device Connection Manager › Device List, lalu pilih Hubungkan lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV menolak sambungan. Pada TV, benarkan Nino di Settings › General › External Device Manager › Device Connection Manager › Device List, kemudian tekan Sambung sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tv heeft de verbinding geweigerd. Geef Nino toestemming op je tv via Settings › General › External Device Manager › Device Connection Manager › Device List en kies daarna nog eens Verbinden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีปฏิเสธการเชื่อม บนทีวีให้เปิดสิทธิ์แก่ Nino ที่ Settings › General › External Device Manager › Device Connection Manager › Device List แล้วกด Connect อีกรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV bağlantıyı geri çevirdi. TV'de şu bölümden Nino'yu onaylayın: Ayarlar › Genel › Harici Aygıt Yöneticisi › Cihaz Bağlantı Yöneticisi › Cihaz Listesi. Sonra Bağlan'a bir kez daha basın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی نے رابطہ ٹھکرا دیا۔ ٹی وی میں Settings › General › External Device Manager › Device Connection Manager › Device List کھولیں، وہاں Nino کو منظوری دے کر Connect ایک بار اور چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV không đồng ý kết nối. Trên TV, cấp quyền cho Nino trong Settings › General › External Device Manager › Device Connection Manager › Device List, rồi chọn Kết nối lần nữa."
          }
        }
      }
    },
    "setup.tv.guide.open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح الدليل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গাইড খুলুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Guide"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Gabay"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गाइड खोलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Panduan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Panduan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de handleiding"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูคู่มือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehberi Aç"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گائیڈ دیکھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem hướng dẫn"
          }
        }
      }
    },
    "setup.tv.guide.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتبع الدليل لتثبيت تطبيق Nino للتلفاز هنا، ثم افتحه. سيجد التطبيق هذا الحاسوب تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্দেশিকা মেনে এখানে Nino-র TV অ্যাপটি বসিয়ে নিন, তারপর সেটি খুলুন। অ্যাপটি নিজেই এই কম্পিউটারকে খুঁজে নেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the guide to install Nino's TV app here, then open it. The app locates this computer automatically."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sundan ang gabay para mai-install dito ang TV app ni Nino, saka ito buksan. Kusang mahahanap ng app ang computer mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गाइड देखकर Nino का टीवी ऐप यहाँ इंस्टॉल करें, फिर उसे खोलें। ऐप इस कंप्यूटर को खुद ढूँढ लेता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti panduannya agar aplikasi TV milik Nino terpasang di sini, lalu jalankan. Aplikasinya akan mendeteksi komputer ini secara otomatis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikut panduan ini bagi memasang aplikasi TV Nino, kemudian lancarkannya. Aplikasi tersebut akan menjumpai komputer ini secara automatik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer de tv-app van Nino hier met de handleiding en open hem daarna. De app spoort deze computer zelf op."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำตามคู่มือเพื่อลงแอปทีวีของ Nino บนทีวีเครื่องนี้ แล้วเปิดแอปขึ้นมา แอปจะหาคอมเครื่องนี้เจอเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehberi izleyerek TV'deki Nino'yu bu televizyona yükleyin ve başlatın. Uygulama bu bilgisayarı kendiliğinden bulur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گائیڈ کے مطابق Nino کی ٹی وی ایپ اس ٹی وی میں ڈالیں اور پھر کھولیں۔ ایپ یہ کمپیوٹر اپنے آپ ڈھونڈ لیتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm theo hướng dẫn để cài app Nino cho TV tại đây, rồi mở app lên. App sẽ tự động tìm ra máy tính này."
          }
        }
      }
    },
    "setup.tv.lgSamsung": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "LG أو Samsung (تلفاز)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "LG কিংবা Samsung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An LG or a Samsung"
          }

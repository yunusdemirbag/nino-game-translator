          "stringUnit": {
            "state": "translated",
            "value": "Satu-satunya maklumat yang Nino simpan ialah ID akaun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het enige wat Nino bewaart, is het account-ID."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino เก็บไว้แค่ ID บัญชีเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun sakladığı tek bilgi hesap kimliğidir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کے پاس محفوظ صرف اکاؤنٹ ID رہتی ہے، بس۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino chỉ lưu đúng ID tài khoản."
          }
        }
      }
    },
    "setup.psn.assure.once": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكفي الدخول مرة، ولن يسألك Nino عنه ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার সাইন ইন করলেই হবে, আর জিজ্ঞাসা করা হবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in a single time; Nino won't ask again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Minsanan lang ang pag-login; hindi na ito hihingin ulit ni Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ एक बार लॉग इन करना है; Nino फिर नहीं पूछेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cukup masuk sekali; Nino tidak akan meminta lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda daftar masuk sekali dan tidak akan ditanya lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je meldt je één keer aan; daarna vraagt Nino er niet meer om."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าแค่ครั้งเดียว Nino จะไม่ขอซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir giriş yeterli, Nino bunu tekrar istemez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بس ایک مرتبہ لاگ ان کریں؛ Nino پھر نہیں پوچھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chỉ đăng nhập một lượt, Nino sẽ không hỏi lại."
          }
        }
      }
    },
    "setup.psn.assure.password": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُدخل كلمة مرورك إلا في صفحة دخول PlayStation، وليس لـ Nino أي وصول إليها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ড আপনি শুধু Sony-র নিজের পেজে লেখেন; Nino কখনো এটি দেখে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password goes only into the PlayStation sign-in page. Nino has no access to it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa sign-in page lang ng PlayStation mo ilalagay ang password. Wala itong access kay Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पासवर्ड केवल PlayStation के साइन-इन पेज में जाता है। Nino तक वह कभी नहीं पहुँचता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi hanya diketik di halaman masuk PlayStation. Nino tidak bisa melihatnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata laluan anda hanya ditaip di halaman log masuk PlayStation. Nino tidak dapat melihatnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wachtwoord typ je alleen op de aanmeldpagina van PlayStation. Nino kan er niet bij."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านจะกรอกในหน้าล็อกอินของ PlayStation เท่านั้น ซึ่ง Nino เข้าถึงไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreniz yalnızca PlayStation'ın oturum açma sayfasına girilir; Nino ona erişemez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس ورڈ صرف PlayStation کے لاگ ان پیج پر لکھا جاتا ہے۔ Nino اسے دیکھ ہی نہیں سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu chỉ được gõ vào trang đăng nhập PlayStation. Nino không thể xem được."
          }
        }
      }
    },
    "setup.psn.manual.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحة دخول PlayStation لا تُفتح؟ قد يحجبها مزوّد الإنترنت لديك. في هذه الحالة أدخل معرّف PSN الخاص بحسابك الثاني (12 رمزًا مرمّزة بـ base64)، على سبيل المثال AbCdEfGhIjk=."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation-এর লগইন পাতা আসছে না? কিছু ইন্টারনেট সংস্থা এটি আটকে দেয়। তার বদলে দ্বিতীয় অ্যাকাউন্টের PSN ID লিখুন (base64, ১২টি অক্ষর), উদাহরণ: AbCdEfGhIjk=।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is the PlayStation sign-in page not opening? Some ISPs block it. Instead, type the PSN ID of your second account (base64, 12 characters), for example AbCdEfGhIjk=."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw bumukas ng PlayStation sign-in page? Hinaharangan ito ng ilang ISP. Sa halip, i-type ang PSN ID ng pangalawa mong account (base64, 12 character), halimbawa AbCdEfGhIjk=."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation का लॉगिन पेज खुल नहीं रहा? कुछ इंटरनेट प्रदाता इस पेज को रोकते हैं। उसकी जगह अपने दूसरे अकाउंट वाली PSN ID (base64, 12 अक्षर) टाइप करें, जैसे AbCdEfGhIjk=।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman masuk PlayStation tidak terbuka? Beberapa penyedia internet memblokirnya. Sebagai gantinya, ketik PSN ID akun kedua Anda (base64, 12 karakter), misalnya AbCdEfGhIjk=."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman log masuk PlayStation tidak terbuka? Sesetengah ISP menyekatnya. Sebaliknya, taip ID PSN akaun kedua anda (base64, 12 aksara), contohnya AbCdEfGhIjk=."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat de aanmeldpagina van PlayStation niet open? Sommige providers blokkeren die. Typ dan de PSN-ID van je tweede account (base64, 12 tekens), bijvoorbeeld AbCdEfGhIjk=."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าล็อกอินของ PlayStation ไม่ขึ้นใช่ไหม ผู้ให้บริการเน็ตบางเจ้าบล็อกหน้านี้ ให้พิมพ์ PSN ID ของบัญชีที่สองแทน (base64 ยาว 12 ตัว) เช่น AbCdEfGhIjk="
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation oturum sayfası açılmıyor mu? Bazı internet şirketleri onu engelliyor. Bunun yerine ikinci hesabın PSN kimliğini base64 biçiminde yazın; 12 karakterdir, örneğin AbCdEfGhIjk=."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation کا لاگ ان پیج کھل نہیں رہا؟ کچھ انٹرنیٹ کمپنیاں اسے روک دیتی ہیں۔ ایسے میں دوسرے والے اکاؤنٹ کی PSN ID (base64، 12 حروف) خود لکھیں، جیسے AbCdEfGhIjk=۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang đăng nhập PlayStation không mở ra? Có nhà mạng chặn luôn trang ấy. Khi đó, hãy gõ PSN ID của tài khoản phụ (base64, dài 12 ký tự), như AbCdEfGhIjk=."
          }
        }
      }
    },
    "setup.psn.manual.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرّف الحساب هذا لا يبدو سليمًا. المطلوب 12 رمزًا مرمّزة بـ base64، على سبيل المثال AbCdEfGhIjk=."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি বৈধ অ্যাকাউন্ট আইডি নয়। এতে ১২টি base64 অক্ষর থাকে, যেমন AbCdEfGhIjk=।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account ID doesn't look right. It should be 12 base64 characters, for example AbCdEfGhIjk=."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang mali ang account ID na ito. Dapat 12 base64 character ito, halimbawa AbCdEfGhIjk=."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अकाउंट ID सही नहीं लगती। इसमें base64 के 12 अक्षर होने चाहिए, जैसे AbCdEfGhIjk=।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu bukan ID akun yang valid. ID terdiri dari 12 karakter base64, mis. AbCdEfGhIjk=."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "ID akaun ini nampaknya salah. Ia sepatutnya 12 aksara base64, contohnya AbCdEfGhIjk=."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account-ID klopt niet. Het moet uit 12 base64-tekens bestaan, bijvoorbeeld AbCdEfGhIjk=."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ID แอคเคานต์นี้ดูผิดรูปแบบ ต้องเป็นตัวอักษร base64 ทั้งหมด 12 ตัว เช่น AbCdEfGhIjk="
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap kimliği geçersiz. Kimlik 12 base64 karakterinden oluşur, ör. AbCdEfGhIjk=."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اکاؤنٹ ID درست معلوم نہیں ہوتی۔ اس میں base64 کے 12 حروف ہونے چاہییں، جیسے AbCdEfGhIjk=۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ID tài khoản này có vẻ chưa đúng. ID cần có đủ 12 ký tự dạng base64, như AbCdEfGhIjk=."
          }
        }
      }
    },
    "setup.psn.manual.open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تصل إلى صفحة الدخول؟ اكتب معرّف الحساب بنفسك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লগইন পেজে যাওয়া যাচ্ছে না? অ্যাকাউন্ট ID নিজেই লিখুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't get to the login page? Type the account ID yourself"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabuksan ang login page? I-type na lang ang account ID"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन पेज खुलता ही नहीं? ID हाथ से टाइप करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman masuk tidak bisa dibuka? Ketik ID akun sendiri"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuka laman log masuk? Taip sendiri ID akaun anda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom je niet op de aanmeldpagina? Vul het account-ID zelf in"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าหน้าล็อกอินไม่ได้? พิมพ์ ID บัญชีเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum sayfası gelmiyor mu? Kimliği kendiniz yazın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاگ ان صفحہ نہیں کھلتا؟ اکاؤنٹ ID ہاتھ سے لکھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở nổi trang đăng nhập? Tự gõ ID tài khoản"
          }
        }
      }
    },
    "setup.psn.manual.save": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষণ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-save"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydet"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu"
          }
        }
      }
    },
    "setup.psn.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادخل بالحساب الجديد المخصّص لـ Nino كي يتصل بـ PlayStation Network. عبره يتابع Nino الترجمة، ولا يحتفظ بغير معرّف الحساب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন দ্বিতীয় অ্যাকাউন্টে লগ ইন করুন; এতে Nino PlayStation Network-এ যুক্ত হয়। এর মাধ্যমেই Nino সাবটাইটেল দেখে, আর রাখে শুধু এর ID।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in with the new second account; this connects Nino to PlayStation Network. Nino follows the subtitles through it and stores nothing but its ID."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumasok gamit ang bagong pangalawang account; ito ang nagkokonekta kay Nino sa PlayStation Network. Dito dumadaan si Nino para sundan ang subtitle, at ID lang nito ang itinatabi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए दूसरे अकाउंट में लॉग इन करें; इससे Nino का PlayStation Network से नाता जुड़ता है। Nino इसी के ज़रिए सबटाइटल पर नज़र रखता है और सिर्फ़ इसकी ID सहेजता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Login memakai akun kedua yang barusan dibuat; dengan begitu Nino tersambung ke PlayStation Network. Nino mengikuti subtitel lewat akun itu dan hanya menyimpan ID-nya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk menggunakan akaun kedua yang anda baru cipta untuk menyambungkan Nino ke PlayStation Network. Nino mengikuti sari kata melaluinya dan cuma menyimpan ID akaun tersebut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan met het nieuwe tweede account; zo koppel je Nino aan PlayStation Network. Nino volgt de ondertitels via dit account en bewaart alleen het ID ervan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล็อกอินด้วยแอคเคานต์สำรองที่เพิ่งสมัคร Nino จะได้เชื่อมกับ PlayStation Network และใช้ติดตามซับผ่านบัญชีนั้น โดยเก็บไว้แค่ ID"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni açtığınız ek PSN hesabıyla oturum açın. Nino altyazıları bu hesapla izler, sakladığı tek şey hesabın kimliğidir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئے دوسرے اکاؤنٹ سے لاگ ان کریں؛ یوں Nino، PlayStation Network سے جڑ جاتا ہے۔ اسی کے ذریعے Nino سب ٹائٹل دیکھتا ہے، اور محفوظ صرف اس کی ID کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập vào tài khoản phụ mới lập để nối Nino với PlayStation Network. Qua đó Nino theo dõi phụ đề và chỉ lưu lại ID."
          }
        }
      }
    },

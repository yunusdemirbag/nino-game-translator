        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV berbasis Android dari merek seperti Arçelik, Beko, Grundig, iFFALCON, Philips, Sony, TCL, dan Vestel."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV berasaskan Android daripada jenama seperti Arçelik, Beko, Grundig, iFFALCON, Philips, Sony, TCL dan Vestel."

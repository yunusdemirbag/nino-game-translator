    "setup.samsung.address.mismatch %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيمة Host PC IP في التلفاز هي %1$@؛ ويجب أن تكون %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার TV-র Host PC IP এখন %1$@; এখানে বসাতে হবে %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV lists Host PC IP as %1$@; it needs to be %2$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakatakda sa %1$@ ang value ng Host PC IP na nasa TV mo; dapat ay %2$@"

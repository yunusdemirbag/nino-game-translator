          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "USB اسٹک کے ذریعے انسٹال"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài bằng USB"
          }
        }
      }
    },
    "setup.tvApp.android.waiting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار التلفاز…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র অপেক্ষায়…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting on the TV…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinihintay pa ang TV…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी का इंतज़ार है…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang menunggu TV…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang menunggu TV…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even wachten op je tv…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอทีวี…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'yi bekliyoruz…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کی راہ دیکھی جا رہی ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang đợi TV…"
          }
        }
      }
    },
    "setup.tvApp.installing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تثبيت Nino على التلفاز…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে Nino ইনস্টল হচ্ছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing Nino on your TV…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini-install si Nino sa TV mo…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी में Nino की इंस्टॉलिंग जारी है…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang Nino di TV…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang Nino pada TV…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tv-app installeren…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังติดตั้งแอปทีวี…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV uygulaması yükleniyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی میں Nino کی انسٹالیشن جاری ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang cài Nino lên TV…"
          }
        }
      }
    },
    "setup.tvApp.legacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد إصدار أقدم من تطبيق Nino للتلفاز مثبّت على التلفاز، وسيفتحه Nino. وهو لا يزال يعمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিভিতে Nino টিভি অ্যাপের একটি পুরোনো সংস্করণ ইনস্টল করা আছে, Nino সেটিই খুলবে। এটি এখনও কাজ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An older Nino TV app is installed on the TV, and Nino will open it. It still works."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May mas lumang Nino TV app na naka-install sa TV, at iyon ang bubuksan ng Nino. Gumagana pa rin ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी पर Nino टीवी ऐप का पुराना संस्करण इंस्टॉल है, Nino उसी को खोलेगा। यह अब भी काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi lama aplikasi TV Nino terpasang di TV, dan Nino akan membukanya. Versi ini masih berfungsi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi lama aplikasi TV Nino dipasang pada TV, dan Nino akan membukanya. Versi ini masih berfungsi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staat een oudere Nino-tv-app op de tv; Nino opent die. Die werkt nog steeds."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแอป Nino สำหรับทีวีรุ่นเก่าติดตั้งอยู่บนทีวี และ Nino จะเปิดแอปนั้น แอปนี้ยังใช้งานได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de Nino TV uygulamasının eski bir sürümü kurulu; Nino onu açacak. Bu sürüm de çalışır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی پر Nino ٹی وی ایپ کا پرانا ورژن انسٹال ہے، اور Nino اسی کو کھولے گا۔ یہ اب بھی کام کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV đang cài phiên bản cũ của ứng dụng Nino cho TV và Nino sẽ mở phiên bản đó. Phiên bản này vẫn hoạt động."
          }
        }
      }
    },
    "setup.tvApp.legacy.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تثبيت الإصدار الجديد متى شئت. يُثبَّت بجانب الإصدار القديم، ويبقى القديم إلى أن تحذفه بنفسك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যখন খুশি নতুন সংস্করণ ইনস্টল করতে পারেন। এটি পুরোনোটির পাশে ইনস্টল হয়; পুরোনোটি আপনি নিজে না সরানো পর্যন্ত থাকবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can install the new version whenever you like. It's installed next to the old one, and the old one stays until you remove it yourself."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede mong i-install ang bagong bersyon kahit kailan. Ini-install ito katabi ng luma, at mananatili ang luma hanggang ikaw mismo ang mag-alis nito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जब चाहें नया संस्करण इंस्टॉल कर सकते हैं। यह पुराने के साथ इंस्टॉल होता है; पुराना तब तक रहेगा जब तक आप उसे खुद न हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda bisa memasang versi baru kapan saja. Versi baru dipasang di samping versi lama, dan versi lama tetap ada sampai Anda menghapusnya sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh memasang versi baharu bila-bila masa. Ia dipasang di sebelah versi lama, dan versi lama kekal sehingga anda sendiri membuangnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de nieuwe versie installeren wanneer je wilt. Die komt naast de oude; de oude blijft staan tot je hem zelf verwijdert."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณติดตั้งเวอร์ชันใหม่ได้ทุกเมื่อ เวอร์ชันใหม่จะติดตั้งคู่กับเวอร์ชันเก่า และเวอร์ชันเก่าจะยังอยู่จนกว่าคุณจะลบเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğin zaman yeni sürümü kurabilirsin. Yenisi eskisinin yanına kurulur; eskisini sen kaldırana kadar TV'de kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ جب چاہیں نیا ورژن انسٹال کر سکتے ہیں۔ یہ پرانے کے ساتھ انسٹال ہوتا ہے، اور پرانا تب تک رہتا ہے جب تک آپ خود اسے نہ ہٹائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể cài phiên bản mới bất cứ lúc nào. Phiên bản mới được cài bên cạnh phiên bản cũ, và phiên bản cũ vẫn còn cho đến khi bạn tự gỡ."
          }
        }
      }
    },
    "setup.tvApp.legacy.update": {
      "extractionState": "manual",
      "localizations": {

    "setup.key.ownDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini أو DeepL أو OpenAI أو Claude أو نموذج على هذا الحاسوب: أكثر النتائج طبيعية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, DeepL, OpenAI, Claude অথবা এই কম্পিউটারের কোনো মডেল: সবচেয়ে স্বাভাবিক ফল।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, Claude, DeepL, OpenAI or a model running here: the most natural result."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, DeepL, OpenAI, Claude o modelo sa computer na ito: pinakanatural na resulta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, DeepL, OpenAI, Claude या इस कंप्यूटर पर कोई मॉडल: सबसे स्वाभाविक नतीजा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, DeepL, OpenAI, Claude, atau model di komputer ini: hasil paling alami."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, DeepL, OpenAI, Claude atau model pada komputer ini: hasil paling semula jadi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, DeepL, OpenAI, Claude of een model op deze computer: het natuurlijkste resultaat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, DeepL, OpenAI, Claude หรือโมเดลบนคอมพิวเตอร์เครื่องนี้ ให้ผลที่เป็นธรรมชาติที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, Claude, DeepL, OpenAI veya bu bilgisayarda çalışan bir model: en doğal sonuç."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini، DeepL، OpenAI، Claude یا اس کمپیوٹر پر کوئی ماڈل: سب سے فطری نتیجہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini, DeepL, OpenAI, Claude hoặc một mô hình trên máy này: kết quả tự nhiên nhất."
          }
        }
      }
    },
    "setup.key.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للحصول على أفضل جودة في الألعاب الأخرى، أدخل مفتاح API. لا يُحفظ مفتاحك على أي خادم لـ Nino ولا يُرسل إلى أي مكان آخر: يبقى في سلسلة مفاتيح هذا الـ Mac ويُستخدم فقط للاتصال بالخدمة التي اخترتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য গেমে সেরা মানের জন্য একটি API কি দিন। আপনার কি Nino-র কোনো সার্ভারে রাখা হয় না, অন্য কোথাও পাঠানো হয় না: এটি এই Mac-এর কিচেইনে থাকে এবং শুধু আপনার বেছে নেওয়া পরিষেবায় যুক্ত হতে ব্যবহার হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the best quality in other games, enter an API key. Your key is never stored on a Nino server and goes nowhere else: it stays in this Mac's Keychain and is used only to reach the service you picked."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa pinakamahusay na kalidad sa ibang laro, maglagay ng API key. Hindi ito iniimbak sa server ng Nino at hindi ipinapadala kahit saan: nananatili ito sa Keychain ng Mac na ito at ginagamit lang para kumonekta sa serbisyong pinili mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे गेम में सबसे अच्छी गुणवत्ता के लिए API की डालें। आपकी की Nino के किसी सर्वर पर नहीं रखी जाती और कहीं और नहीं भेजी जाती: वह इसी Mac के कीचेन में रहती है और सिर्फ़ आपकी चुनी सेवा से जुड़ने में काम आती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk kualitas terbaik di game lain, masukkan kunci API. Kunci Anda tidak disimpan di server Nino dan tidak dikirim ke mana pun: kunci tetap di Keychain Mac ini dan hanya dipakai untuk terhubung ke layanan pilihan Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk kualiti terbaik dalam permainan lain, masukkan kunci API. Kunci anda tidak disimpan di pelayan Nino dan tidak dihantar ke mana-mana: ia kekal dalam Rantai Kunci Mac ini dan hanya digunakan untuk menyambung ke perkhidmatan pilihan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer voor de beste kwaliteit in andere games een API-sleutel in. Je sleutel wordt niet op een server van Nino bewaard en gaat nergens anders heen: hij blijft in de sleutelhanger van deze Mac en wordt alleen gebruikt voor de dienst die je kiest."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่คีย์ API เพื่อให้เกมอื่นได้คุณภาพดีที่สุด คีย์ของคุณไม่ถูกเก็บบนเซิร์ฟเวอร์ของ Nino และไม่ถูกส่งไปที่อื่น: คีย์อยู่ในพวงกุญแจของ Mac เครื่องนี้ และใช้เพียงเพื่อเชื่อมต่อบริการที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer oyunlarda en iyi kalite için API anahtarınızı girin. Anahtarınız Nino sunucusunda saklanmaz, başka hiçbir yere gönderilmez: bu Mac'in Anahtar Zinciri'nde kalır, yalnız seçtiğiniz hizmete bağlanırken kullanılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسری گیمز میں بہترین معیار کے لیے API کلید درج کریں۔ آپ کی کلید Nino کے کسی سرور پر محفوظ نہیں ہوتی اور کہیں اور نہیں بھیجی جاتی: یہ اسی Mac کے کی چین میں رہتی ہے اور صرف آپ کی چنی ہوئی سروس سے جڑنے میں استعمال ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để có chất lượng tốt nhất ở các trò chơi khác, hãy nhập khóa API. Khóa không được lưu trên máy chủ của Nino và không gửi đi đâu khác: nó nằm trong Chuỗi khóa của máy Mac này và chỉ dùng để kết nối tới dịch vụ bạn chọn."
          }
        }
      }
    },
    "setup.key.otherEngines": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم بدلًا منه DeepL أو OpenAI أو Claude أو نموذجًا محليًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর বদলে DeepL, OpenAI, Claude বা লোকাল মডেল ব্যবহার করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to Claude, DeepL, OpenAI, or your own local model"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin na lang ang DeepL, OpenAI, Claude o lokal na modelo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी जगह DeepL, OpenAI, Claude या लोकल मॉडल इस्तेमाल करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai DeepL, OpenAI, Claude, atau model lokal sebagai gantinya"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna DeepL, OpenAI, Claude atau model setempat sebagai ganti"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik in plaats daarvan DeepL, OpenAI, Claude of een lokaal model"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ DeepL, OpenAI, Claude หรือโมเดลในเครื่องแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, DeepL, OpenAI veya kendi yerel modelinize geçin"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے بجائے DeepL، OpenAI، Claude یا مقامی ماڈل استعمال کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng DeepL, OpenAI, Claude hoặc mô hình cục bộ thay thế"
          }
        }
      }
    },
    "setup.key.note.private": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يصل إلى Google إلا نص الترجمة. لا يحتفظ Nino بنسخة من مفتاحك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google শুধু সাবটাইটেলের লেখা পায়। Nino আপনার কি-র কোনো কপি রাখে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google receives only the subtitle text. Nino keeps no copy of your key."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksto lang ng subtitle ang natatanggap ng Google. Walang kopya ng key mo ang Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google तक सिर्फ़ सबटाइटल का टेक्स्ट पहुँचता है। Nino आपकी की की कोई कॉपी नहीं रखता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hanya menerima teks subtitel. Nino tidak menyimpan salinan kunci Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hanya menerima teks sari kata. Nino tidak menyimpan salinan kunci anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google krijgt alleen de ondertiteltekst. Nino bewaart geen kopie van je sleutel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ได้รับเพียงข้อความคำบรรยาย Nino ไม่เก็บสำเนาคีย์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'a yalnız altyazı metni gider. Nino anahtarınızın kopyasını tutmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google کو صرف سب ٹائٹل کا متن جاتا ہے۔ Nino آپ کی کلید کی کوئی نقل نہیں رکھتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google chỉ nhận văn bản phụ đề. Nino không giữ bản sao khóa của bạn."
          }
        }
      }
    },
    "setup.key.skipInfo": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك التخطي: بدون مفتاح تُترجم الألعاب الأخرى عبر مجمّع Nino والمترجم المدمج في هذا الـ Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এড়িয়ে যেতে পারেন: কি ছাড়া অন্য গেমগুলো Nino পুল আর এই Mac-এর নিজের অনুবাদক দিয়ে অনুবাদ হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipping is fine: without a key, other games are translated by the Nino pool and this Mac's own translator."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede mong laktawan: kung walang key, isasalin ang ibang laro ng Nino pool at ng sariling tagasalin ng Mac na ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोड़ सकते हैं: की के बिना दूसरे गेम Nino पूल और इस Mac के अपने अनुवादक से अनुवादित होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Boleh dilewati: tanpa kunci, game lain diterjemahkan oleh pool Nino dan penerjemah bawaan Mac ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Boleh langkau: tanpa kunci, permainan lain diterjemah oleh kolam Nino dan penterjemah Mac ini sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overslaan mag: zonder sleutel worden andere games vertaald door de Nino-pool en de eigen vertaler van deze Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้ามได้: หากไม่มีคีย์ เกมอื่นจะแปลด้วยคลังกลางของ Nino และตัวแปลของ Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçebilirsiniz: anahtar olmadan diğer oyunlar Nino havuzu ve bu Mac'in kendi çevirisiyle çevrilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چھوڑ سکتے ہیں: کلید کے بغیر دوسری گیمز کا ترجمہ Nino پول اور اس Mac کے اپنے مترجم سے ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể bỏ qua: không có khóa, các trò chơi khác sẽ được dịch bằng kho chung Nino và trình dịch sẵn có của máy Mac này."
          }
        }
      }
    },
    "setup.key.ready %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {

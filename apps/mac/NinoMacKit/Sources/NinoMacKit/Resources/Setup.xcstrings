    "setup.key.library.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُترجم GTA 6 والألعاب ذات الحزم الجاهزة من مكتبة Nino المجانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 আর তৈরি প্যাকওয়ালা গেমগুলো বিনামূল্যের Nino লাইব্রেরি থেকে অনুবাদ হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 and every title that has a ready pack are translated from the free Nino library."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinasalin ang GTA 6 at ang mga larong may handang pack mula sa libreng Nino library."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 और तैयार पैक वाले गेम मुफ़्त Nino लाइब्रेरी से अनुवादित होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 dan game dengan paket siap pakai diterjemahkan dari perpustakaan Nino yang gratis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 dan permainan yang ada pek sedia diterjemah daripada pustaka Nino yang percuma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 en games met een kant-en-klaar pakket worden vertaald vanuit de gratis Nino-bibliotheek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 และเกมที่มีแพ็กพร้อมใช้จะแปลจากคลัง Nino ซึ่งใช้ฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 ve hazır paketli oyunlar ücretsiz Nino kütüphanesinden çevrilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 اور تیار پیک والی گیمز کا ترجمہ مفت Nino لائبریری سے ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA 6 và các trò chơi có gói sẵn được dịch từ thư viện Nino miễn phí."
          }
        }
      }
    },

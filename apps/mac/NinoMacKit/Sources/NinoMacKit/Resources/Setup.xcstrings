    "setup.gemini.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر «مفتاح مجاني من هنا»، وادخل بحسابك في Google."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ফ্রি কী নিন”-এ চাপ দিন, তারপর Google-এ লগ ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Get a Key for Free, then log in to Google."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindutin ang Libreng Key, Kunin Dito, tapos pumasok sa Google account mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“मुफ़्त key पाएँ” दबाकर Google में लॉग इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik Dapatkan Kunci Gratis, lalu login ke Google."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik Dapatkan Kunci Percuma, kemudian masuk ke akaun Google."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Gratis sleutel ophalen en meld je aan bij Google."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่ม ขอคีย์ฟรี และเข้าสู่ระบบ Google"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ücretsiz Anahtar Oluştur”a tıklayıp Google'a giriş yapın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«مفت کلید حاصل کریں» دبائیں، پھر Google میں لاگ ان کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm Nhận khóa miễn phí, sau đó đăng nhập Google."
          }
        }
      }
    },
    "setup.gemini.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر Create API key ثم انسخ المفتاح الجديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Create API key বেছে নিন, তারপর সদ্য তৈরি কী-টি কপি করে রাখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Create API key, then copy the new key."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin itong Create API key, saka kopyahin ang bagong key."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Create API key चुनें और बनी हुई नई कुंजी कॉपी करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Create API key, lalu salin kunci barunya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Create API key, lalu salin kunci baharu itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Create API key, kopieer daarna die verse sleutel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก Create API key จากนั้นก๊อปปี้คีย์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Create API key” düğmesine tıklayın, çıkan anahtarı kopyalayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",

    "setup.key.freeDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجمّع Nino مع المترجم المدمج في هذا الـ Mac. لا حاجة إلى مفتاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino পুল আর এই Mac-এর নিজের অনুবাদক। কোনো কি লাগবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Nino pool plus this Mac's own translator. No key required."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Nino pool at ang sariling tagasalin ng Mac na ito. Hindi kailangan ng key."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino पूल और इस Mac का अपना अनुवादक। कोई की नहीं चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pool Nino ditambah penerjemah bawaan Mac ini. Tidak perlu kunci."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolam Nino serta penterjemah Mac ini sendiri. Tiada kunci diperlukan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Nino-pool plus de eigen vertaler van deze Mac. Geen sleutel nodig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังกลางของ Nino ร่วมกับตัวแปลของ Mac เครื่องนี้ ไม่ต้องใช้คีย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino havuzu ve bu Mac'in kendi çevirisi. Anahtar gerekmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino پول اور اس Mac کا اپنا مترجم۔ کسی کلید کی ضرورت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho chung Nino cùng trình dịch sẵn có của máy Mac này. Không cần khóa."
          }
        }
      }
    },

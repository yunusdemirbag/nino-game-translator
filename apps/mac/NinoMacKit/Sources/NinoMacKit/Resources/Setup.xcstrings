    "setup.card.check.black": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقة موصولة غير أن الصورة لا تصل. افتح PS5 ثم عطّل HDCP (آخر خطوة)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ড ঠিকমতো যুক্ত, অথচ পর্দায় ছবি পৌঁছাচ্ছে না। PS5 অন করে HDCP অফ করে দিন (একেবারে শেষ ধাপ)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your card is connected, yet no image arrives. Power up the PS5 and switch HDCP off (the final step)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakakabit ang card mo pero walang dumarating na larawan. Buksan ang PS5 at patayin ang HDCP (ang huling hakbang)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड लगा हुआ है, लेकिन तस्वीर नहीं आ रही। PS5 को ऑन करके HDCP बंद कर दें (अंतिम चरण)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu sudah tersambung, tetapi gambarnya belum masuk. Hidupkan konsol PS5, lalu nonaktifkan HDCP (ada di langkah terakhir)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad sudah disambung, namun belum ada gambar. Hidupkan PS5 dan nyahaktifkan HDCP (langkah akhir)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaart zit erin, toch blijft het beeld zwart. Schakel je PS5 in en schakel HDCP uit (de laatste stap)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดเสียบไว้แล้ว แต่ภาพยังไม่มา ลองเปิด PS5 แล้วปิดตัวเลือก HDCP (ดูขั้นสุดท้าย)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Card takılı ama görüntü yok. PS5'i açıp HDCP'yi kapatın (bir önceki adım)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ جڑ گیا ہے مگر تصویر نہیں آ رہی۔ PS5 چلائیں، پھر HDCP کو بند کر دیں (یہ آخری مرحلہ ہے)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Card đã được cắm nhưng chưa thấy hình. Hãy mở PS5 lên rồi tắt HDCP (đây là bước cuối)."
          }
        }
      }
    },

    "setup.xboxList.install.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو 220 ميغابايت. ينزّله Nino ويضعه في التطبيقات ويفتحه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আকার মোটামুটি 220 MB। Nino নিজেই নামিয়ে Applications-এ রেখে চালু করে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roughly 220 MB. Nino fetches it, places it inside Applications and launches it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga 220 MB. Si Nino ang magda-download nito, ilalagay sa Applications at bubuksan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "करीब 220 MB। इसे Nino खुद डाउनलोड करके Applications फ़ोल्डर में डालता है और चला देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Besarnya sekitar 220 MB. Semuanya diurus Nino: diunduh, dipindahkan ke Applications, lalu dijalankan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiznya lebih kurang 220 MB. Nino akan memuat turun, memasukkannya ke Applications, dan melancarkannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo'n 220 MB. Nino haalt het binnen, zet het in je map Apps en start het."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดราว 220 MB Nino จะโหลดมาให้ ย้ายเข้า Applications แล้วเปิดขึ้นมาเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutu yaklaşık 220 MB. Uygulamayı Nino indirir, Uygulamalar klasörüne koyar ve başlatır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائز تقریباً 220 MB ہے۔ Nino خود اسے لاتا ہے، Applications فولڈر میں ڈالتا ہے، پھر کھول دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chừng 220 MB. Nino sẽ tải về, chép vào Applications rồi mở lên."
          }
        }
      }
    },
    "setup.xboxList.installing %lld": {
      "extractionState": "manual",
      "localizations": {
        "ar": {

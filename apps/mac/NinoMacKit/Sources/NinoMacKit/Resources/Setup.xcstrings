          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งเวอร์ชันใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Sürümü Kur"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیا ورژن انسٹال کریں"
          }
        },
        "vi": {

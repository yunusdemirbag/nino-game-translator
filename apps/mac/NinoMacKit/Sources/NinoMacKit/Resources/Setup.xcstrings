    "setup.gemini.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المترجم المدمج في Nino يعمل دون إنترنت، لكن أسلوبه قد يبدو جامدًا. Gemini من Google يكتب بلغة أكثر طبيعية بكثير، ويكفيك مفتاحه المجاني. ولك أن تتخطى هذه الخطوة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino-র নিজস্ব অনুবাদক ইন্টারনেট ছাড়াই চলে, তবে লেখা একটু আড়ষ্ট লাগতে পারে। Google-এর তৈরি Gemini শুনতে ঢের বেশি স্বাভাবিক, আর এর জন্য শুধু একটি ফ্রি কী-ই যথেষ্ট। চাইলে এটা এড়িয়েও যেতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino's built-in translator runs without internet, though it can feel wooden. Gemini from Google reads far more naturally, and its free key is all you need. Feel free to skip this."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagana nang offline ang built-in na tagasalin ni Nino, pero minsan matigas ang dating. Mas natural ang salin ng Gemini mula sa Google, at libreng key lang ang kailangan. Puwede mo itong laktawan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino का बिल्ट-इन अनुवादक इंटरनेट के बिना चलता है, मगर कभी-कभी उसकी भाषा मशीनी लगती है। Google के Gemini का अनुवाद ज़्यादा सहज पढ़ने में आता है, और इसके लिए उसकी मुफ़्त कुंजी ही काफ़ी है। चाहें तो यह चरण छोड़ सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerjemah bawaan Nino bekerja tanpa internet, tetapi hasilnya kadang kaku. Gemini buatan Google terdengar jauh lebih wajar, dan Anda cukup butuh kunci gratisnya. Boleh dilewati."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penterjemah terbina dalam Nino boleh digunakan tanpa internet, namun hasilnya agak kaku. Gemini keluaran Google jauh lebih lancar, dan anda hanya memerlukan kunci percumanya. Bahagian ini tidak wajib."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ingebouwde vertaler van Nino heeft geen internet nodig, al klinkt hij soms houterig. Google Gemini klinkt een stuk natuurlijker, en alleen een gratis sleutel volstaat. Overslaan mag ook."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวแปลในตัวของ Nino ทำงานได้แม้ไม่มีเน็ต แต่สำนวนอาจแข็ง ๆ ส่วน Gemini จาก Google ให้คำแปลที่อ่านลื่นกว่าเยอะ แค่มีคีย์ฟรีก็ใช้ได้แล้ว ข้ามขั้นนี้ไปก่อนก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun yerleşik çevirmeni internet olmadan da çalışır, fakat cümleleri sık sık kaskatı kalır. Google Gemini çok daha akıcı çeviri yapar; bunun için bedava bir anahtar yeterli. Dilerseniz bu adımı atlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کا اپنا مترجم انٹرنیٹ کے بغیر چلتا ہے، لیکن اس کی زبان کچھ روکھی لگ سکتی ہے۔ Google والا Gemini اس سے کافی زیادہ رواں عبارت لکھتا ہے، اور اسے چلانے کو صرف ایک مفت key درکار ہے۔ یہ مرحلہ اختیاری ہے، چاہیں تو آگے بڑھ جائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình dịch có sẵn của Nino chạy không cần mạng, nhưng câu chữ đôi khi hơi cứng. Gemini do Google làm cho câu văn mượt và tự nhiên hơn hẳn, mà bạn chỉ cần có khóa free. Không muốn thì cứ bỏ qua."
          }
        }
      }
    },
    "setup.gemini.note.limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين تنفد الحصة المجانية يتولى المترجم المجاني المهمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রি সীমা ফুরিয়ে গেলে বিনামূল্যের অনুবাদকটি কাজ চালিয়ে নেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the free quota is used up, the free translator steps in."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naubos ang libreng quota, ang libreng tagasalin ang papalit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त सीमा पूरी होते ही मुफ़्त अनुवादक काम संभाल लेता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kuota gratis habis, penerjemah gratis akan mengambil alih."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila kuota percuma habis, penterjemah percuma mengambil alih."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is het gratis tegoed op, dan neemt de gratis vertaler het over."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อโควตาฟรีหมด ตัวแปลฟรีจะทำงานแทนให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz kullanım biterse Nino'nun kendi ücretsiz çevirisi kullanılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت حد ختم ہونے پر مفت مترجم خود بخود اس کی جگہ لے لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hết lượt dùng free thì trình dịch không mất phí sẽ thay vào."
          }
        }
      }
    },
    "setup.gemini.note.others": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تريد خدمة غير هذه؟ من الإعدادات، في قسم الترجمة، يمكنك متى شئت التبديل إلى Claude، وكذلك DeepL وOpenAI، أو إلى نموذج يعمل على حاسوبك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য কোনো সেবা পছন্দ? সেটিংস › অনুবাদ অংশে যেকোনো সময় Claude, DeepL, OpenAI বা নিজের কম্পিউটারে চলা কোনো মডেল বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer another service? Choose Claude, DeepL, OpenAI or a model on your own computer any time in Settings, under Translation."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas gusto mo ng ibang serbisyo? Kahit kailan, mapipili mo sa Settings › Pagsasalin ang Claude, DeepL, OpenAI o modelong nasa sarili mong computer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई और सेवा पसंद है? सेटिंग › अनुवाद में कभी भी Claude, DeepL, OpenAI या अपने कंप्यूटर पर चलने वाला मॉडल चुन लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih suka layanan lain? Pilih Claude, DeepL, OpenAI, atau model di komputer Anda sendiri kapan saja lewat Pengaturan, bagian Terjemahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahu perkhidmatan lain? Pilih Claude, DeepL, OpenAI atau model pada komputer sendiri bila-bila masa dalam Tetapan › Terjemahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liever een andere dienst? Kies wanneer je wilt Claude, DeepL, OpenAI of een model op je eigen computer bij Instellingen, onder Vertaling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากใช้บริการอื่น? เลือก Claude, DeepL, OpenAI หรือโมเดลบนคอมพิวเตอร์ของคุณเองได้ทุกเมื่อในหัวข้อการแปลของการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir hizmet mi istiyorsunuz? Claude, DeepL, OpenAI ya da kendi bilgisayarınızdaki bir model, Ayarlar'ın Çeviri bölümünden her zaman seçilebilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی اور سروس پسند ہے؟ ترتیبات › ترجمہ میں کبھی بھی Claude، DeepL، OpenAI یا اپنے کمپیوٹر کا ماڈل چن لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muốn dùng dịch vụ khác? Lúc nào cũng có thể chọn Claude, DeepL, OpenAI hay một mô hình chạy trên máy bạn trong mục Dịch của phần Cài đặt."
          }
        }
      }
    },
    "setup.gemini.note.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُرسل إلى Google إلا ترجمات اللعبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google শুধু সাবটাইটেলের লেখাটুকুই পায়, আর কিছু না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google is sent nothing but subtitle text."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksto lang ng subtitle ang napupunta sa Google."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google तक सबटाइटल के शब्दों के सिवा कुछ नहीं जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hanya menerima teks subtitel, tidak lebih."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hanya menerima teks sari kata, tiada yang lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google krijgt alleen de tekst van de ondertitels te zien."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลที่ส่งให้ Google มีเพียงข้อความซับเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'a oyunun altyazılarından başka bir şey gitmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google کو سب ٹائٹل کے متن کے سوا کچھ نہیں بھیجا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google chỉ nhận được chữ phụ đề, ngoài ra không gì cả."
          }
        }
      }
    },

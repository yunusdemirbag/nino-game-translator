    "setup.samsung.typeCode.sent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم. لم يظهر شيء على التلفاز؟ استعمل طريقة غيرها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হয়ে গেছে। TV-তে কিছু না খুললে অন্য কোনো উপায় দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. If nothing opened on your TV, try another method."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapos na. Kung walang bumukas sa TV mo, subukan ang ibang paraan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो गया। अगर टीवी पर कुछ नहीं खुला, तो कोई दूसरा तरीका आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai. Kalau di TV tidak ada yang terbuka, coba cara lain."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai. Jika tiada apa-apa terbuka pada TV, cuba cara lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelukt. Is er niets geopend op je tv? Kies dan een andere manier."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งไปแล้ว ถ้าทีวีไม่มีอะไรขึ้น ลองอีกทางหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderildi. Pencere TV'de açılmadıysa başka bir yolu deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہو گیا۔ ٹی وی پر کچھ نہیں کھلا تو کوئی دوسرا طریقہ آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi. Nếu TV không mở gì, hãy thử cách khác."
          }
        }
      }
    },
    "setup.samsung.typeCode.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Nino بلوغ التلفاز. هل هو مشغَّل؟ إن كان كذلك فأعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino TV-র নাগাল পায়নি। TV কি চালু আছে? তাহলে আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino couldn't get through to your TV. Is it switched on? Then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maabot ni Nino ang TV mo. Nakabukas ba ito? Kung oo, subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino का टीवी से संपर्क नहीं हुआ। क्या टीवी ऑन है? फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak bisa menjangkau TV. Apakah TV sudah hidup? Setelah itu, ulangi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghubungi TV. Pastikan ia hidup dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino kreeg geen contact met je tv. Staat hij aan? Probeer het dan nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ติดต่อทีวีไม่ติด ทีวีเปิดอยู่หรือเปล่า? ถ้าเปิดแล้วลองอีกที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'ye erişilemedi. TV açık mı, bakıp tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ٹی وی تک نہیں پہنچ پایا۔ کیا ٹی وی چالو ہے؟ اگر ہاں تو ایک بار اور آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino không liên lạc được với TV. TV đang mở chứ? Vậy thì thử thêm lần nữa."
          }
        }
      }
    },
    "setup.samsung.window.notOpening": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النافذة لا تظهر؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উইন্ডোটি খুলছে না?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window doesn't open?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nagbubukas ang window?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विंडो खुल नहीं रही?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela tidak terbuka?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetingkap tidak muncul?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat het venster niet open?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่างไม่ขึ้นมาใช่ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere gelmiyor mu?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ونڈو نہیں کھلتی؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ không hiện ra?"
          }
        }
      }
    },
    "setup.samsung.window.step1.new": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. افتح Apps على التلفاز، ومرّر حتى الأسفل تمامًا، ثم اختر App Settings."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV-তে Apps-এ যান, একদম নিচ পর্যন্ত নামুন, আর App Settings খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Go to Apps on your TV, scroll all the way down, and choose App Settings."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Buksan ang Apps sa TV mo, mag-scroll pababa hanggang dulo, at App Settings ang piliin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. टीवी पर Apps में जाएँ, एकदम आख़िर तक स्क्रॉल करके App Settings खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Buka Apps di TV, gulir sampai paling bawah, kemudian masuk ke App Settings."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Di TV, pergi ke Apps, skrol hingga paling bawah, kemudian pilih App Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ga op je tv naar Apps, scrol door tot onderaan en selecteer App Settings."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1. เปิด Apps บนทีวี เลื่อนจนสุดด้านล่าง จากนั้นเข้า App Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'nizde Uygulamalar ekranına gidin, en aşağıya inip Uygulama Ayarları'na girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ٹی وی میں Apps والا حصہ کھولیں، فہرست کے بالکل آخر تک جائیں اور وہاں App Settings کو چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Vào Apps trên TV, cuộn xuống tận cùng, chọn App Settings."
          }
        }
      }
    },
    "setup.samsung.window.step1.old": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. افتح Apps على التلفاز. إذا ظهر App Settings في آخر القائمة فاختره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV-তে Apps-এ যান। একেবারে শেষে App Settings দেখা গেলে ওটাই খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Go to Apps on your TV. If App Settings appears at the very end, choose it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Buksan ang Apps sa TV mo. Kapag nasa pinakadulo ang App Settings, piliin iyon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. टीवी में Apps खोलिए। App Settings सबसे अंत में दिखे, तो उसे चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Buka Apps di TV. Jika App Settings ada di paling ujung, pilih itu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Di TV, pergi ke Apps. Kalau App Settings muncul di penghujung, pilihlah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ga op je tv naar Apps. Staat App Settings helemaal aan het eind, kies het dan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1. บนทีวี เปิด แอป หากมี การตั้งค่าแอป อยู่ล่างสุดของหน้า ให้เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'nizde Uygulamalar ekranına gidin. En aşağıda Uygulama Ayarları görüyorsanız oraya girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ٹی وی میں Apps والا حصہ کھولیں۔ فہرست کے آخر میں App Settings موجود ہو تو اسی کو منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Vào Apps trên TV. Nếu cuối danh sách có App Settings thì mở mục ấy."
          }
        }
      }
    },
    "setup.samsung.window.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. أدخل 1 2 3 4 5. الريموت بلا أزرار أرقام؟ اضغط 123 وانتقِ الأرقام المعروضة على الشاشة. عند الرقم الخامس يظهر مربع Developer Mode."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "2. রিমোট দিয়ে টিপুন 1 2 3 4 5। রিমোটে সংখ্যার বোতাম নেই? 123 চেপে স্ক্রিন থেকে অঙ্কগুলো বেছে নিন। পঞ্চম অঙ্কের পর Developer Mode-এর একটি বাক্স ভেসে ওঠে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Key in 1 2 3 4 5. No number keys on your remote? Press 123 and choose the digits on screen. After the fifth digit, a Developer Mode box appears."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Isa-isang pindutin: 1 2 3 4 5. Walang number key ang remote mo? Pindutin ang 123 at pumili ng numero sa screen. Pagkalagay ng ikalima, lalabas ang kahon ng Developer Mode."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. अब 1 2 3 4 5 डालें। अगर रिमोट पर अंकों वाले बटन न हों, तो 123 दबाकर स्क्रीन पर अंक चुनें। पाँचवाँ अंक डालते ही Developer Mode का बॉक्स खुल जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Masukkan 1 2 3 4 5. Remote Anda tidak ada tombol nomornya? Pencet 123 dan pilih angkanya di layar. Setelah angka kelima, kotak Developer Mode akan muncul."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Masukkan 1 2 3 4 5. Remote tidak mempunyai butang nombor? Tekan 123 dan pilih digit di skrin. Selepas digit kelima, kotak Developer Mode akan terpapar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Toets 1 2 3 4 5 in. Zitten er geen cijfertoetsen op je afstandsbediening? Druk op 123 en selecteer de cijfers in beeld. Zodra je het vijfde cijfer invoert, opent er een Developer Mode-venster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ป้อน 1 2 3 4 5 ลงไป ถ้ารีโมตไร้แป้นตัวเลข ให้กด 123 แล้วเลือกเลขบนจอ เมื่อครบหลักที่ห้า กล่อง Developer Mode จะเด้งขึ้นมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Şu kodu girin: 1 2 3 4 5. Kumandanızda rakam tuşları yoksa 123 tuşunu kullanın, rakamlar ekranda belirir. Beşinci rakamı girince Developer Mode kutusu açılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ہندسے 1 2 3 4 5 ٹائپ کریں۔ ریموٹ پر نمبر والے بٹن نہیں؟ 123 دبائیں اور ہندسے اسکرین پر چن لیں۔ پانچواں ہندسہ دباتے ہی Developer Mode کا خانہ کھل جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Gõ 1 2 3 4 5. Remote thiếu phím số? Nhấn 123 rồi chọn từng số hiện ra. Gõ xong số thứ năm, hộp Developer Mode sẽ hiện ra."
          }
        }
      }
    },
    "setup.samsung.window.step3 %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3. اجعل Developer mode على On. ضمن Developer Mode أدخل %@ (هذا الحاسوب) في خانة Host PC IP، واكتب كل قسم منه حرفيًا دون أي أصفار في أوله (اكتب 1 لا 001)، ثم انقر OK. إن كان العنوان لا يقبل التعديل فاضغط 123 قبل ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Developer mode-কে On অবস্থায় আনুন। Developer Mode-এ Host PC IP ঘরে %@ (এই কম্পিউটার) বসান, প্রতিটি অংশ হুবহু লিখে, সামনে কিছু না জুড়ে (যেমন 001-এর জায়গায় শুধু 1), শেষে OK টিপুন। ঠিকানার ঘরে লেখা না গেলে প্রথমে 123 টিপে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Switch Developer mode On. In Developer Mode, put %@ (this computer) into Host PC IP, entering every part exactly, with nothing added in front (1 rather than 001), and choose OK. If you can't edit the address, press 123 first."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Gawing On itong Developer mode. Sa screen ng Developer Mode, isulat ang %@ (itong computer) bilang value ng Host PC IP, eksakto bawat bahagi at walang dagdag sa harap (1, hindi 001), at kumpirmahin sa OK. Kung ayaw ma-edit ng address, unahing pindutin ang 123."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. अब Developer mode का स्विच On करें। Developer Mode की स्क्रीन के Host PC IP वाले खाने में %@ (यही कंप्यूटर) भरें — हर हिस्सा बिल्कुल वैसा, शुरू में कुछ जोड़े बगैर (1 लिखें, 001 नहीं) — और OK दबाएँ। पता न बदले, तो शुरुआत में 123 दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Nyalakan Developer mode (On). Di Developer Mode, isi Host PC IP dengan %@ (komputer ini) persis apa adanya, tanpa angka nol tambahan di awal (tulis 1, jangan 001), kemudian tekan OK. Kalau alamatnya terkunci dan tak bisa diedit, pencet 123 dulu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Tukar Developer mode kepada On. Dalam Developer Mode, isi Host PC IP dengan %@ (komputer ini) setiap bahagian dengan tepat, tanpa tambahan di hadapan (1, bukannya 001), lalu tekan OK. Sekiranya alamat tidak dapat disunting, tekan 123 terlebih dahulu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Schakel Developer mode naar On. Typ in Developer Mode bij Host PC IP %@ (deze computer) in, elk deel precies zo, zonder iets ervoor (dus 1 in plaats van 001), en bevestig met OK. Lukt het niet om het adres te wijzigen? Druk eerst op 123."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "3. สลับ Developer mode ไปที่ On ใน Developer Mode กรอก %@ (คอมเครื่องนี้) ลงใน Host PC IP ให้ตรงทุกส่วน ห้ามมีอะไรนำหน้า (พิมพ์ 1 ห้ามพิมพ์ 001) แล้วกด OK ถ้าแก้ตัวเลขไม่ได้ ให้กด 123 ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Developer mode ayarını On yapın; ardından Host PC IP kutusuna şu adresi girin: %@. Her bölümü önüne sıfır eklemeden aynen yazın (001 yerine 1), sonra OK düğmesine basın. Adres düzenlenemiyorsa ilk önce 123 tuşunu kullanın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Developer mode کا سوئچ On پر لائیں۔ Developer Mode کے اندر Host PC IP والے خانے میں %@ (یہ کمپیوٹر) لکھیں، ہر حصہ ہوبہو، آگے کچھ جوڑے بغیر (001 نہیں بلکہ 1)، اور OK چنیں۔ ایڈریس بدل نہ سکیں تو پہلے 123 دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Chuyển Developer mode thành On. Trong Developer Mode, điền %@ (chiếc máy này) vào ô Host PC IP, gõ đúng từng phần, không thêm gì phía trước (1 chứ không phải 001), xong bấm OK. Nếu ô địa chỉ không cho sửa, nhấn 123 trước đã."
          }
        }
      }
    },
    "setup.samsung.window.step4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "4. أعد إقلاع التلفاز: أبقِ إصبعك على زر الطاقة بالريموت إلى حين ظهور شعار Samsung، أو انزع القابس وانتظر قرابة دقيقة. وسيتقدم Nino في هذه الشاشة وحده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "4. TV-টি রিস্টার্ট দিন: স্ক্রিনে Samsung লোগো ভেসে ওঠা অবধি রিমোটের পাওয়ার কী টিপে রাখুন, বা প্লাগ খুলে মিনিটখানেক অপেক্ষা করুন। এই পাতায় Nino আপনা থেকেই পরের ধাপে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Restart your TV: keep the remote's power button held down until you see the Samsung logo, or pull the power cord and wait about a minute. Nino moves ahead on this screen automatically."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "4. I-restart nang buo ang TV: diinan ang power button na nasa remote hanggang lumitaw ang Samsung logo, o hugutin ang saksakan at maghintay nang mga isang minuto. Kusang uusad si Nino sa screen na ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "4. टीवी रीस्टार्ट करें: Samsung लोगो आने तक रिमोट के पावर बटन को दबाकर रखें, या प्लग निकालकर करीब एक मिनट रुकें। Nino इस स्क्रीन पर अगला चरण खुद खोल देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Restart TV: tekan terus tombol power di remote hingga logo Samsung tampil, atau lepas steker dan tunggu kira-kira semenit. Nino akan lanjut di layar ini dengan sendirinya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Mula semula TV anda: tekan lama butang kuasa remote hingga logo Samsung kelihatan, ataupun cabut kord kuasa dan tunggu kira-kira seminit. Nino akan memajukan skrin ini dengan sendirinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Herstart je tv: druk de powerknop op de afstandsbediening in tot je het Samsung-logo ziet, of trek de stroomkabel los en wacht zo'n minuut. Nino gaat op dit scherm uit zichzelf verder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "4. รีสตาร์ตทีวี: กดปุ่มเปิดปิดบนรีโมตค้างจนโลโก้ Samsung ขึ้น หรือถอดปลั๊กรอราวหนึ่งนาที หน้านี้ของ Nino จะไปต่อเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. TV'yi kapatıp açın: Samsung logosunu görene dek kumandadaki güç tuşunu bırakmayın ya da TV'yi prizden çekip yaklaşık bir dakika bekleyin. Bu ekran kendiliğinden ilerler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "4. ٹی وی کو دوبارہ چلائیں: ریموٹ پر پاور والا بٹن Samsung لوگو آنے تک دبا کر رکھیں، یا پلگ نکال کر تقریباً ایک منٹ رکیں۔ Nino اس اسکرین پر خود آگے بڑھ جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Tắt hẳn TV rồi mở lại: giữ chặt phím nguồn của remote tới lúc logo Samsung hiện lên, hoặc rút dây nguồn và chờ khoảng một phút. Nino sẽ tự chuyển tiếp trên màn hình này."
          }
        }
      }
    },
    "setup.samsung.window.tip1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• أدخل الأرقام وأنت داخل App Settings في نهاية Apps. فالتلفزيونات من طراز 2022 فما فوق لا تتفاعل معها في شاشة Apps الأولى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "• অঙ্কগুলো Apps-এর শেষে থাকা App Settings-এর ভেতরে টিপুন। ২০২২ সাল ও তার পরের মডেলে Apps-এর প্রথম পাতা এগুলো ধরে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Type the digits inside App Settings, found at the end of Apps. On TVs from 2022 onward, the first Apps screen ignores them."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "• Isulat ang mga digit sa App Settings, na nasa dulo ng Apps. Kapag 2022 o mas bago ang TV, hindi pinapansin ng unang screen ng Apps ang mga ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "• अंक App Settings के अंदर डालें, जो Apps की सूची के आख़िर में मिलता है। 2022 या उसके बाद बने टीवी में Apps की पहली स्क्रीन इन्हें अनदेखा करती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "• Ketik angkanya di dalam App Settings, yang ada di ujung Apps. Pada TV keluaran 2022 ke atas, layar Apps pertama mengabaikan angka tersebut."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "• Taip digit tersebut di App Settings, yang terletak di hujung Apps. Bagi TV keluaran 2022 ke atas, skrin Apps yang pertama mengabaikannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "• Voer de cijfers in binnen App Settings, onderaan bij Apps. Tv's uit 2022 en later negeren ze in het eerste Apps-scherm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "• ให้พิมพ์ตัวเลขในหน้า App Settings ซึ่งอยู่ท้าย Apps ทีวีรุ่นปี 2022 ขึ้นไปจะไม่รับเลขที่กดในหน้า Apps แรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Rakamları, Uygulamalar ekranının sonundaki Uygulama Ayarları içinde girin. 2022 ve daha yeni TV'lerde Uygulamalar'ın ilk ekranı rakamları dikkate almaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "• ہندسے Apps کے آخر میں موجود App Settings کے اندر لکھیں۔ 2022 اور بعد کے ٹی وی پر Apps کی پہلی اسکرین انہیں نظر انداز کر دیتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "• Gõ các số bên trong App Settings, nằm ở cuối mục Apps. Trên TV từ đời 2022 trở đi, màn hình Apps đầu tiên không nhận các số này."
          }
        }
      }
    },
    "setup.samsung.window.tip2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• أعد إقلاع التلفاز كليًا (أبقِ زر الطاقة مضغوطًا إلى أن يظهر شعار Samsung) ثم كرّر المحاولة. فبعض الأجهزة لا تعرض النافذة إلا بعد محاولتين أو ثلاث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "• TV-টিকে সম্পূর্ণ রিস্টার্ট দিন (Samsung লোগো ভেসে ওঠা অবধি পাওয়ার টিপে রাখুন), এরপর ফের চেষ্টা করুন। কিছু মডেলে দুই-তিনবার চেষ্টার পরেই উইন্ডোটি দেখা যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Give the TV a full restart (hold power until you see the Samsung logo) and retry. Certain TVs only show the window after two or three attempts."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "• Bigyan ng buong restart ang TV (diinan ang power hanggang lumitaw ang Samsung logo) at subukan ulit. May mga TV na lumalabas lang ang window pagkatapos ng dalawa o tatlong subok."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "• टीवी का पूरा रीस्टार्ट करें (Samsung लोगो तक पावर दबाकर रखें) और दोबारा आज़माएँ। कुछ टीवी पर विंडो दो-तीन प्रयासों के बाद ही आती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "• Restart TV secara penuh (tekan terus tombol power hingga logo Samsung tampil), kemudian ulangi. Beberapa TV baru memunculkan jendelanya setelah dua atau tiga kali percobaan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "• Mula semula TV sepenuhnya (tekan lama butang kuasa hingga logo Samsung kelihatan) dan ulang. Sesetengah TV hanya memaparkan tetingkap itu selepas dua atau tiga percubaan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "• Start de tv helemaal opnieuw op (druk de powerknop in tot je het Samsung-logo ziet) en doe nog een poging. Bij sommige tv's komt het venster pas na twee of drie keer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "• รีสตาร์ตทีวีแบบเต็ม (กดปุ่มเปิดปิดค้างจนโลโก้ Samsung ขึ้น) แล้วลองอีกรอบ ทีวีบางรุ่นต้องลองสองสามหนหน้าต่างถึงจะโผล่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• TV'yi baştan başlatın (Samsung logosu belirene dek güç tuşunu bırakmayın) ve tekrar deneyin; bazı TV'ler pencereyi ancak iki üç denemeden sonra gösterir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "• ٹی وی کو مکمل ری اسٹارٹ کریں (Samsung لوگو آنے تک پاور دبائے رکھیں) اور پھر آزمائیں۔ بعض ٹی وی یہ ونڈو دو تین کوششوں کے بعد ہی دکھاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "• Tắt hẳn TV rồi mở lại (giữ phím nguồn tới lúc thấy logo Samsung) và thử lại. Một số TV phải thử hai, ba lần mới hiện cửa sổ."
          }
        }
      }
    },
    "setup.samsung.window.tip3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• اربط بالتلفاز لوحة مفاتيح عبر USB، واكتب منها 12345. وفي بعض الطرازات يمكن كذلك استعمال لوحة الأرقام في SmartThings على الهاتف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "• TV-র সঙ্গে USB কিবোর্ড জুড়ে তা দিয়ে 12345 লিখুন। কিছু TV ফোনের SmartThings-এর সংখ্যা বোতামও মেনে নেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Connect a USB keyboard to the TV and use it to type 12345. Certain TVs also accept the number keys in SmartThings on your phone."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "• Magkabit ng isang USB keyboard sa iyong TV at gamitin iyon sa pag-type ng 12345. May mga TV ring tumatanggap ng number key mula sa SmartThings sa phone mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "• टीवी से USB कीबोर्ड जोड़ें और उससे 12345 लिखें। कुछ टीवी फ़ोन पर SmartThings के नंबर बटन भी स्वीकार करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "• Pasang keyboard USB ke televisi, lalu ketik 12345 dengan keyboard itu. Beberapa TV juga menerima tombol angka di SmartThings pada ponsel Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "• Sambungkan papan kekunci USB kepada TV, kemudian taip 12345 dengannya. Sesetengah TV juga menerima butang nombor dalam SmartThings di telefon anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "• Prik een USB-toetsenbord in de tv en tik daarmee 12345. Sommige tv's pakken ook de cijfertoetsen van SmartThings op je telefoon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "• ต่อแป้นพิมพ์ USB กับทีวี แล้วใช้มันป้อน 12345 ทีวีบางรุ่นยังรับปุ่มตัวเลขจาก SmartThings บนโทรศัพท์ได้อีกด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• TV'nize bir USB klavye takın ve 12345'i onunla yazın. Bazı TV'ler telefonunuzdaki SmartThings'in rakam tuşlarını da kabul eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "• ٹی وی سے کوئی USB کی بورڈ جوڑیں اور 12345 اسی پر ٹائپ کریں۔ بعض ٹی وی فون پر SmartThings کے نمبر والے بٹن بھی قبول کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "• Cắm một bàn phím USB cho TV rồi gõ 12345 bằng bàn phím ấy. Một số TV cũng nhận phím số trong app SmartThings của điện thoại."
          }
        }
      }
    },
    "setup.samsung.window.tip4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• أو دع Nino يدخلها عنك: افتح App Settings في التلفاز، ثم انقر الزر الموجود في الأسفل. ربما يطلب منك التلفاز أولًا أن توافق على Nino. ليست كل الأجهزة تدعم ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "• চাইলে Nino-কে দিয়েও লেখাতে পারেন: TV-র App Settings পাতা খুলে রাখুন আর নিচের বোতামে ক্লিক করুন। TV প্রথমে Nino-কে অনুমতি দেবেন কিনা জানতে চাইতে পারে। সব TV এটা সমর্থন করে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• You can also let Nino enter it: go to App Settings on your TV and click the button underneath. Your TV might first ask whether to allow Nino. Not every TV supports this."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "• Puwede ring si Nino ang maglagay nito: sa TV mo, magtungo sa App Settings at i-click ang button na nasa ibaba. Baka itanong muna ng TV kung papayagan si Nino. Hindi lahat ng TV ay may ganitong suporta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "• Nino से भी यह डलवा सकते हैं: टीवी में App Settings खोलकर नीचे दिए बटन पर क्लिक करें। टीवी पहले पूछ सकता है कि Nino को इजाज़त देनी है या नहीं। हर टीवी में यह सुविधा नहीं होती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "• Nino juga bisa mengetikkannya: masuk ke App Settings di televisi, lalu klik tombol yang ada di bawah. Bisa jadi TV bertanya dulu apakah Nino diizinkan. Tidak semua TV mendukung cara ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "• Anda juga boleh biar Nino yang memasukkannya: masuk ke App Settings pada skrin TV, kemudian klik butang di bawah ini. TV anda mungkin akan bertanya dahulu sama ada Nino dibenarkan. Tidak semua TV menyokong cara ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "• Je kunt Nino het ook laten invullen: ga op je tv naar App Settings en klik hieronder op de knop. Mogelijk vraagt je tv eerst of Nino mag. Niet elke tv kan dit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "• หรือให้ Nino ป้อนแทนก็ได้: ไปที่ App Settings บนทีวี แล้วคลิกปุ่มข้างล่าง ทีวีอาจถามก่อนว่าจะให้ Nino เข้าถึงไหม บางรุ่นใช้วิธีนี้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Kodu Nino da girebilir: TV'nizde Uygulama Ayarları'na girin, ardından aşağıdaki düğmeye tıklayın. TV ilk olarak Nino'ya izin verip vermeyeceğinizi sorabilir. Her TV bunu desteklemez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "• یہ کام Nino سے بھی کروا سکتے ہیں: ٹی وی میں App Settings والا حصہ کھولیں اور نیچے والا بٹن کلک کریں۔ ہو سکتا ہے ٹی وی پہلے پوچھے کہ Nino کو اجازت دی جائے یا نہیں۔ یہ ہر ٹی وی پر نہیں چلتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "• Hoặc để Nino gõ hộ: mở App Settings ở TV, sau đó nhấn nút phía dưới đây. Có thể TV sẽ hỏi trước là có cho phép Nino không. Không phải TV nào cũng hỗ trợ cách này."
          }
        }
      }
    },
    "setup.samsung.wrongAddress %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُظهر التلفاز Host PC IP بعنوان آخر (%1$@)، وهذا سبب رفضه لهذا الحاسوب. اجعل القيمة %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার TV-র Host PC IP ঘরে ভিন্ন একটা ঠিকানা (%1$@) সেট করা, সেজন্য TV কম্পিউটারটিকে ঢুকতে দিচ্ছে না। ওখানে %2$@ বসান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV lists Host PC IP as a different address (%1$@), which makes it reject this computer. Set it to %2$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibang address (%1$@) ang nakatakdang value ng Host PC IP na nasa TV mo, kaya ayaw nitong tanggapin ang computer mo. Gawin itong %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP के तौर पर टीवी में कोई और पता (%1$@) दर्ज है, इस वजह से यह कंप्यूटर ठुकराया जा रहा है। इसे %2$@ पर सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP yang tercatat pada TV adalah alamat lain (%1$@), sehingga komputer ini ditolak. Ubah menjadi %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV anda menetapkan Host PC IP kepada alamat lain (%1$@), maka komputer ini ditolak. Gantikannya dengan %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij Host PC IP staat op je tv een ander adres (%1$@), en daardoor weigert je tv deze computer. Vul %2$@ in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP บนทีวีเป็นเลขอื่น (%1$@) ทีวีจึงปฏิเสธคอมเครื่องนี้ ให้แก้เป็น %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nizdeki Host PC IP farklı bir adrese ayarlı (%1$@); TV bu yüzden bu bilgisayarı reddediyor. Değeri %2$@ olarak değiştirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کی سیٹنگ کے مطابق Host PC IP کوئی اور ایڈریس (%1$@) ہے، اس وجہ سے ٹی وی یہ کمپیوٹر رد کر دیتا ہے۔ اسے %2$@ کر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV đang để Host PC IP bằng địa chỉ khác hẳn (%1$@), vì thế TV từ chối chiếc máy này. Hãy đặt thành %2$@."
          }
        }
      }
    },
    "setup.sendLog %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تكرر ذلك، أرسل إلينا هذا الملف: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বারবার এমন হলে এই ফাইলটি আমাদের পাঠান: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still not working? Share this file with us: %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw pa rin? Ibahagi mo sa amin itong file: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब भी नहीं चल रहा? यह फ़ाइल हमें भेजें: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih belum berhasil? Kirimkan berkas ini kepada kami: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih bermasalah? Kongsikan fail ini dengan kami: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukt het nog steeds niet? Stuur ons dit bestand: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังใช้ไม่ได้อีก? แชร์ไฟล์นี้ให้ทีมเรา: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun sürerse bize bu dosyayı gönderin: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب بھی ٹھیک نہیں ہوا؟ یہ فائل ہمیں بھیج دیں: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn chưa được? Gửi tệp sau đây để chúng tôi xem giúp: %@"
          }
        }
      }
    },

    "setup.card.plug.tv": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع كابل HDMI القادم من PS5 في مدخل البطاقة، وصِل مخرج HDMI فيها بالتلفاز، وكابل USB منها بهذا الـ Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর HDMI তার কার্ডের ইনপুটে, কার্ডের HDMI আউটপুট TV-তে, আর কার্ডের USB তার এই Mac-এ লাগান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the PS5's HDMI cable into the card's input, its HDMI output into your TV, and its USB cable into this Mac."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isaksak ang HDMI cable ng PS5 sa input ng card, ang HDMI output ng card sa TV mo, at ang USB cable nito sa Mac mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 की HDMI केबल कार्ड के इनपुट में, कार्ड का HDMI आउटपुट टीवी में, और कार्ड की USB केबल इस Mac में लगाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokkan kabel HDMI PS5 ke input kartu, output HDMI kartu ke TV, dan kabel USB kartu ke Mac ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabel HDMI PS5 masuk ke input kad, output HDMI kad ke TV, dan kabel USB kad ke Mac ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HDMI-kabel van je PS5 in de kaartingang, de HDMI-out van de kaart door naar je tv, en tot slot de USB-kabel van de kaart in deze Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบสาย HDMI จาก PS5 เข้าช่องอินพุตของการ์ด ต่อช่องเอาต์พุต HDMI ของการ์ดเข้าทีวี และต่อสาย USB ของการ์ดเข้า Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'in kablosunu kartın HDMI girişine, kartın HDMI çıkışını TV'ye, USB kablosunu bu Mac'e takın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کی HDMI تار کارڈ کے ان پٹ میں، کارڈ کا HDMI آؤٹ پٹ ٹی وی میں، اور اس کی USB تار اس Mac میں لگائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm dây HDMI của PS5 vào cổng vào của card, cổng ra HDMI của card vào TV, và dây USB của card vào Mac này."
          }
        }
      }
    },
    "setup.card.tv": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلفاز ذكي مع تطبيق Nino"
          }
        },
        "bn": {

    "setup.card.hdcp.headset": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا وصلت سماعات بيد التحكم فسيذهب الصوت كله إليها ولن يصل أي صوت إلى البطاقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কন্ট্রোলারে হেডফোন লাগানো থাকলে সব শব্দ সেখানেই চলে যায়, কার্ড কোনো আওয়াজ পায় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With headphones connected to the controller, all audio goes to them and the card receives no sound."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag may headphones na nakakabit sa controller, doon napupunta ang lahat ng tunog at walang audio na natatanggap ang card."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर कंट्रोलर में हेडफ़ोन लगे हैं, तो पूरी आवाज़ वहीं जाती है और कार्ड तक कोई आवाज़ नहीं पहुँचती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika headphone tercolok ke stik, semua suara masuk ke headphone dan kartu tidak menerima audio."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika fon kepala disambung ke alat kawalan, semua bunyi pergi ke situ dan kad tidak menerima audio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangt er een koptelefoon aan de controller, dan gaat alle audio daarnaartoe en hoort de kaart niets."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากหูฟังต่ออยู่กับจอย เสียงทุกอย่างจะไปออกที่หูฟังหมด การ์ดเลยไม่ได้ยินเสียงอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kola kulaklık bağlıysa PS5 sesi kulaklığa verir; Capture Card ses almaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر ہیڈفون کنٹرولر سے لگے ہوں تو ساری آواز انہی میں جاتی ہے اور کارڈ تک کوئی آواز نہیں پہنچتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi cắm tai nghe vào tay cầm, mọi âm thanh sẽ chạy vào tai nghe, card sẽ chẳng nhận được tiếng nào."
          }
        }
      }
    },
    "setup.card.hdcp.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حماية النسخ HDCP في PS5 تمنع بطاقات الالتقاط من العمل. لا يؤثر إيقافها في ألعابك، ويكفي أن تغيّرها مرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর HDCP কপি সুরক্ষা capture card-কে কাজ করতে দেয় না। এতে গেমে কোনো পরিবর্তন আসে না, আর বদলাতে হয় মাত্র একবার।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HDCP copy protection on the PS5 stops capture cards from working. It doesn't change your games, and you only need to switch it once."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinipigilan ng HDCP copy protection ng PS5 ang paggana ng mga capture card. Walang epekto ito sa mga laro mo, at minsanan lang ang pagbabagong ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 की HDCP कॉपी-सुरक्षा के चलते capture card काम नहीं कर पाते। गेम इससे बिल्कुल नहीं बदलते, और यह बदलाव एक ही बार करना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteksi salin HDCP di PS5 membuat kartu capture tidak berfungsi. Game Anda tidak terpengaruh, dan pengaturan ini cukup diubah sekali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlindungan salinan HDCP pada PS5 menghalang kad tangkap daripada berfungsi. Permainan anda tidak terjejas, dan ia cuma perlu ditukar sekali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door de HDCP-kopieerbeveiliging van je PS5 werken opnamekaarten niet. Je games merken er niets van, en het is een eenmalige instelling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบป้องกันการคัดลอก HDCP ของ PS5 ทำให้การ์ดจับภาพใช้งานไม่ได้ การปิดไม่กระทบเกมของคุณ และทำแค่ครั้งเดียวพอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, HDCP kopya koruması yüzünden Capture Card'lara görüntü vermez. Oyunlara etkisi yok; yalnızca bir kere ayarlarsınız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کا HDCP (کاپی سے تحفظ) کیپچر کارڈ کو چلنے نہیں دیتا۔ آپ کی گیمز اس سے بالکل نہیں بدلتیں، اور اسے بس ایک بار بند کرنا ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ chống sao chép HDCP của PS5 khiến card ghi hình không hoạt động. Các game vẫn y nguyên, và chỉ cần tắt một lần."
          }
        }
      }
    },
    "setup.card.hdcp.netflix": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقاف HDCP لن تعمل Netflix وتطبيقات البث الأخرى على PS5. أعد تفعيله حين تريد المشاهدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "HDCP বন্ধ থাকলে PS5-এ Netflix আর অন্যান্য স্ট্রিমিং অ্যাপ চলবে না। দেখতে চাইলে আবার চালু করে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With HDCP switched off, Netflix and other streaming apps won't run on your PS5. Switch it on again when you want to watch."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang patay ang HDCP, hindi gagana sa PS5 ang Netflix at iba pang streaming app. Buhayin ulit ito kapag manonood ka."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HDCP बंद रहने पर PS5 पर Netflix जैसे स्ट्रीमिंग ऐप नहीं खुलेंगे। कुछ देखना हो तो उसे फिर से चालू कर लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama HDCP mati, Netflix dan aplikasi streaming lain tidak bisa jalan di PS5. Aktifkan kembali saat ingin menonton."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selagi HDCP dimatikan, Netflix dan aplikasi penstriman lain tidak berjalan di PS5. Hidupkannya semula apabila mahu menonton."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met HDCP uitgeschakeld doen Netflix en andere streamingapps het niet op je PS5. Wil je iets kijken, schakel het dan weer in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างที่ปิด HDCP ไว้ Netflix และแอปสตรีมมิงอื่น ๆ บน PS5 จะเปิดไม่ได้ อยากดูเมื่อไรก็เปิดกลับคืนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HDCP kapalıyken Netflix ve benzeri yayın uygulamaları PS5'te çalışmaz. İzlemek istediğinizde HDCP'yi tekrar açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "HDCP بند ہو تو PS5 پر Netflix جیسی اسٹریمنگ ایپس نہیں چلیں گی۔ کچھ دیکھنا ہو تو اسے پھر سے آن کر لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi HDCP đang tắt, Netflix cùng các app xem phim khác sẽ không chạy trên PS5. Lúc muốn xem thì bật lại."
          }
        }
      }
    },
    "setup.card.hdcp.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط PS5 مؤقتًا بشاشة أو تلفاز دون وسيط، لأن هذا الخيار لا يظهر عبر البطاقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুক্ষণের জন্য কনসোলটিকে সোজা কোনো TV বা মনিটরে লাগান, কারণ কার্ডের ভেতর দিয়ে এই অপশনে পৌঁছানো যায় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefly hook the PS5 up directly to a television or monitor, since this option can't be reached through the card."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pansamantalang ikabit ang PS5 nang diretso sa isang TV o monitor, dahil hindi maaabot ang setting na ito habang dumadaan sa card."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 को कुछ देर सीधे किसी टीवी या मॉनिटर में लगाएँ, क्योंकि कार्ड से होकर यह विकल्प नहीं मिलता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk sementara, colok PS5 secara langsung pada televisi atau monitor, karena opsi ini tidak bisa dibuka lewat kartu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat sementara, pasang PS5 secara terus pada televisyen atau monitor, kerana pilihan ini tidak dapat dicapai melalui kad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind je PS5 tijdelijk direct met een televisie of beeldscherm; via de kaart kom je niet bij deze optie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อ PS5 เข้าทีวีหรือจอภาพตรง ๆ ชั่วคราว เพราะเมนูนี้เข้าผ่านการ์ดไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir süreliğine PS5'i kart olmadan, doğrudan bir ekrana bağlayın; bu seçeneğe kart üzerinden ulaşılamıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ سے گزر کر یہ آپشن دکھائی نہیں دیتا، لہٰذا کچھ لمحوں کے لیے PS5 براہ راست کسی ٹی وی یا اسکرین سے لگا دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm tạm PS5 thẳng vào một chiếc TV hoặc một màn hình, vì qua card thì không vào được mục này."
          }
        }
      }
    },
    "setup.card.hdcp.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح على جهاز PS5 قائمة الإعدادات › النظام › HDMI."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনসোলে যান: Settings › System › HDMI।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go into Settings › System › HDMI on your PS5."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa iyong PS5, magtungo sa Settings › System › HDMI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने PS5 की Settings › System › HDMI खोलिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di PS5, masuk ke Pengaturan › Sistem › HDMI."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada PS5, lawati menu Settings › System › HDMI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen › Systeem › HDMI op je PS5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน PS5 เข้าไปที่ Settings › System › HDMI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'in Ayarlar › Sistem › HDMI bölümünü açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › System › HDMI میں جائیں (یہ PS5 کی سیٹنگ ہے)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên PS5, đi tới Cài đặt › Hệ thống › HDMI."
          }
        }
      }
    },
    "setup.card.hdcp.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عطّل تمكين HDCP، ثم ضع كابل HDMI القادم من PS5 في مدخل البطاقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable HDCP অফ করে দিন, এরপর PS5-এর HDMI তারটি কার্ডের ইনপুটে গুঁজুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch Enable HDCP off, then run the PS5's HDMI cable into the card's input."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Patayin ang Enable HDCP, saka isaksak ang HDMI cable ng PS5 sa input ng card."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable HDCP को ऑफ़ करें, उसके बाद PS5 की HDMI केबल कार्ड के इनपुट से जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan opsi Aktifkan HDCP, lalu colokkan kabel HDMI PS5 ke input kartu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyahaktifkan Enable HDCP, lalu masukkan kabel HDMI PS5 ke input kad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel HDCP inschakelen uit en verbind daarna de HDMI-kabel van je PS5 met de kaartingang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิด Enable HDCP จากนั้นเสียบสาย HDMI จาก PS5 เข้าช่องรับสัญญาณของการ์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HDCP'yi Etkinleştir seçeneğini kapatın; sonra PS5'in kablosunu kartın HDMI girişine bağlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable HDCP کو آف کر دیں، اس کے بعد PS5 کی HDMI تار کارڈ کے ان پٹ میں لگائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt mục Bật HDCP, rồi cắm dây HDMI của PS5 vào cổng vào của card."
          }
        }
      }
    },
    "setup.card.hdcp.title": {
      "extractionState": "manual",
      "localizations": {

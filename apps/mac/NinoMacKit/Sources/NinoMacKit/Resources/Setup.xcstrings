    "setup.ps5.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الأرقام الثمانية التي تظهر على شاشة PS5."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার PS5 স্ক্রিনে যে ৮ অঙ্কের কোড দেখায় সেটি লিখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the eight-digit code that your PS5 displays."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang walong-numerong code na lumalabas sa PS5 mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके PS5 पर जो आठ अंकों वाला कोड दिख रहा है, उसे लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kode delapan angka yang tampil di PS5."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kod lapan digit yang dipaparkan oleh PS5."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ de achtcijferige code over die je PS5 laat zien."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกรหัสแปดหลักที่ขึ้นบนจอ PS5"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'in ekranındaki sekiz haneli kodu girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو آٹھ ہندسوں والا کوڈ PS5 دکھا رہا ہے، وہ یہاں درج کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",

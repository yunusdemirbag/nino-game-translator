    },
    "setup.tv.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التلفاز. بعد النقر على «اتصال» سيطلب منك التلفاز الموافقة لمرة واحدة؛ وافق من الريموت. وإن لم يكن Nino على التلفاز بعد فستدلّك هذه الشاشة على طريقة تثبيته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে TV অন করুন। Connect টিপলে TV মাত্র একবার অনুমতি চাইবে; রিমোটে সায় দিন। TV-তে এখনো Nino না থাকলে এই স্ক্রিনই আপনাকে ইনস্টলের পথ দেখাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch your TV on. Pressing Connect makes the TV ask for permission a single time; confirm with your remote. If Nino isn't on the TV yet, this screen walks you through installing it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang TV mo. Pagpindot mo ng Connect, minsan lang manghihingi ng pahintulot itong TV; kumpirmahin ito sa remote. Kung wala pa si Nino sa TV, gagabayan ka sa pag-install ng screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी चालू करें। Connect दबाने पर टीवी एक ही बार अनुमति माँगेगा; रिमोट से हाँ कर दें। अगर Nino अभी टीवी पर नहीं है, तो यही स्क्रीन इंस्टॉल करने में आपकी मदद करेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan TV. Begitu tombol Hubungkan ditekan, TV akan meminta izin satu kali; setujui dengan remote. Jika Nino belum ada di TV, layar ini akan memandu pemasangannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan TV anda. Tekan Sambung dan TV akan memohon izin sekali sahaja; sahkan menggunakan remote. Kalau Nino belum dipasang pada TV, skrin ini akan menunjukkan cara memasangnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je tv aan. Na een druk op Verbinden vraagt je tv eenmalig om toestemming; bevestig met je afstandsbediening. Staat Nino nog niet op je tv, dan begeleidt dit scherm je bij de installatie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดทีวีก่อน เมื่อกด Connect ทีวีจะขอสิทธิ์แค่หนเดียว กดยืนยันด้วยรีโมต ถ้าทีวียังไม่มี Nino หน้านี้จะพาคุณลงแอปทีละขั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nizi açın. Bağlan'a basınca TV bir kereliğine izin sorar; kumandayla onaylayın. TV'de Nino yüklü değilse bu ekran kurulumda size yol gösterir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی چالو کریں۔ Connect دبانے پر ٹی وی صرف ایک دفعہ اجازت طلب کرے گا؛ ریموٹ کے ذریعے منظور کر دیں۔ ٹی وی میں Nino ابھی نہیں ہے تو یہ اسکرین قدم بہ قدم اسے انسٹال کروا دے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở TV lên. Bấm Kết nối thì TV sẽ hỏi quyền đúng một lần; xác nhận bằng remote. Nếu TV chưa có Nino, trang này sẽ hướng dẫn bạn cài."
          }
        }
      }
    },
    "setup.tv.noTV": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تملك تلفازًا؟ اعرض اللعبة على شاشة Mac"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV নেই? গেমটি এই Mac-এই দেখান"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't have a TV? Show the game on this Mac"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang TV? Ipakita ang laro sa Mac mo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी नहीं है? गेम इसी Mac पर दिखाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak punya TV? Mainkan game di Mac ini saja"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada TV? Papar permainan pada Mac ini"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen tv? Speel het spel op deze Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีทีวีใช่ไหม? เล่นเกมบนจอ Mac แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Televizyon yoksa bu Mac'in ekranını kullan"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی نہیں ہے؟ گیم اسی Mac پر دکھائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có TV? Chơi ngay trên Mac này"
          }
        }
      }
    },
    "setup.tv.noTV.ps5": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستلعب هنا على Mac عبر Remote Play، والترجمة تظهر داخل نافذته. يمكنك إضافة تلفاز متى أردت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play দিয়ে আপনি এখানে Mac-এই খেলবেন, সাবটাইটেল দেখা যাবে তার উইন্ডোর ভেতরে। TV যখন খুশি যোগ করা যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll play here on the Mac through Remote Play, with subtitles shown inside its window. A TV can be added whenever you like."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito ka sa Mac maglalaro gamit itong Remote Play, at lalabas ang subtitle sa loob ng window nito. Puwede kang magdagdag ng TV kahit kailan mo gusto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप Remote Play से यहीं Mac पर खेलेंगे, और सबटाइटल उसी की विंडो में आएँगे। टीवी जब चाहें बाद में जोड़ लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda main langsung di Mac ini lewat Remote Play, dan subtitel tampil di dalam jendelanya. TV bisa ditambahkan kapan pun Anda mau."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan bermain terus di Mac menerusi Remote Play, dan sari kata terpapar di dalam tetingkapnya. TV boleh ditambah bila-bila masa anda mahu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je speelt hier op de Mac via Remote Play, met de ondertitels in dat venster zelf. Een tv kun je later altijd nog toevoegen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะเล่นบน Mac โดยใช้ Remote Play และซับจะขึ้นในหน้าต่างนั้นเลย จะเพิ่มทีวีตอนไหนก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunu Remote Play ile doğrudan bu Mac'te oynarsınız; altyazılar Remote Play penceresinde belirir. Dilediğiniz zaman TV ekleyebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ Remote Play سے یہیں Mac پر کھیلیں گے، اور سب ٹائٹل اسی ونڈو کے اندر آئیں گے۔ ٹی وی بعد میں جب دل چاہے جوڑ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ chơi trên Mac qua Remote Play, chữ dịch hiện ngay trong cửa sổ đó. Muốn thêm TV lúc nào cũng được."
          }
        }
      }
    },
    "setup.tv.noTV.xbox": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستلعب هنا على Mac داخل نافذة Xbox نفسها، والترجمة تظهر فيها. يمكنك إضافة تلفاز متى أردت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox-এর নিজস্ব উইন্ডোতে আপনি এখানে Mac-এই খেলবেন, সাবটাইটেলও সেখানেই দেখা যাবে। TV যখন খুশি যোগ করা যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll play here on the Mac in Xbox's own window, with subtitles shown right there. A TV can be added whenever you like."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito ka sa Mac maglalaro sa sariling window ng Xbox, at doon mismo lalabas ang subtitle. Puwede kang magdagdag ng TV kahit kailan mo gusto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप यहीं Mac पर Xbox की अपनी विंडो में खेलेंगे, और सबटाइटल वहीं दिखेंगे। टीवी जब चाहें बाद में जोड़ लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda main langsung di Mac ini dalam jendela Xbox sendiri, dan subtitel tampil di situ juga. TV bisa ditambahkan kapan pun Anda mau."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan bermain terus di Mac dalam tetingkap Xbox sendiri, lengkap dengan sari kata di situ. TV boleh ditambah bila-bila masa anda mahu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je speelt hier op de Mac in het eigen venster van Xbox, met de ondertitels daar meteen in beeld. Een tv kun je later altijd nog toevoegen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะเล่นบน Mac ในหน้าต่างของ Xbox เอง และซับจะขึ้นตรงนั้นเลย จะเพิ่มทีวีตอนไหนก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'teki Xbox penceresinde oynarsınız; altyazılar da orada belirir. Dilediğiniz zaman TV ekleyebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ Xbox کی اپنی ونڈو میں یہیں Mac پر کھیلیں گے، اور سب ٹائٹل وہیں آئیں گے۔ ٹی وی بعد میں جب دل چاہے جوڑ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ chơi trên Mac trong cửa sổ riêng của Xbox, chữ dịch hiện ngay tại đó. Muốn thêm TV lúc nào cũng được."
          }
        }
      }
    },

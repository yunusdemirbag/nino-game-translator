          }
        }
      }
    },
    "setup.card.monitor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاشة عرض، أو تلفاز لا يشغّل تطبيقات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি মনিটর, কিংবা অ্যাপবিহীন কোনো TV"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A monitor, or a television with no apps"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang monitor, o kaya TV na hindi nagpapatakbo ng app"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉनिटर, या बिना ऐप वाला टीवी"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor, atau televisi yang tidak punya aplikasi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor, atau televisyen yang tiada aplikasi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor of tv zonder apps"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จอภาพ หรือทีวีธรรมดาที่ลงแอปไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitör veya uygulama çalıştıramayan bir TV"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مانیٹر، یا ایسا ٹی وی جس میں ایپس نہ ہوں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình rời, hoặc TV không cài app"
          }
        }
      }
    },
    "setup.card.monitor.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تملأ اللعبة شاشة Mac مع الصوت، والترجمة معروضة فوقها. صِل Mac بشاشتك بكابل HDMI."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গেম আর তার শব্দ Mac-এর স্ক্রিন জুড়ে চলে, অনুবাদ থাকে তার উপরে। একটি HDMI তার দিয়ে Mac-কে আপনার স্ক্রিনের সঙ্গে জুড়ুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game fills the Mac's display, sound included, with the translation laid over it. Use an HDMI cable to link the Mac with your screen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakop ng laro ang buong display ng Mac, kasama ang tunog, at nakapatong dito ang salin. Gumamit ng HDMI cable para ikabit ang Mac mo sa iyong screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम आवाज़ समेत Mac की पूरी स्क्रीन पर दिखता है और अनुवाद उसके ऊपर आता है। Mac और स्क्रीन को HDMI केबल से जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Game tampil penuh di layar Mac lengkap dengan suaranya, dan terjemahannya muncul di atasnya. Pakai kabel HDMI untuk menyambungkan Mac dengan layar Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permainan memenuhi skrin Mac lengkap dengan bunyi, dan terjemahan dipaparkan di atasnya. Gunakan kabel HDMI untuk menyambung Mac pada skrin anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het spel vult het Mac-scherm, inclusief geluid, terwijl de vertaling eroverheen ligt. Een HDMI-kabel tussen de Mac en je beeldscherm maakt het af."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกมพร้อมเสียงจะเต็มจอ Mac โดยมีคำแปลซ้อนอยู่ด้านบน ใช้สาย HDMI ต่อ Mac เข้ากับจอของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun bu Mac'te sesiyle birlikte tüm ekranı kaplar, çeviri üzerine yerleşir. Mac'ten ekranınıza bir HDMI kablosu takın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گیم آواز سمیت پوری Mac اسکرین پر چلتی ہے اور ترجمہ اس کے اوپر دکھتا ہے۔ ایک HDMI تار سے Mac اور آپ کی اسکرین کو ملا دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chơi chiếm trọn màn hình Mac, có cả tiếng, phần dịch nằm đè lên trên. Dùng một dây HDMI nối Mac sang màn hình."
          }
        }
      }
    },
    "setup.card.plug.monitor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كابل HDMI من PS5 في مدخل البطاقة، ثم صِل كابل USB من البطاقة بجهاز Mac هذا. أخيرًا صِل Mac بشاشتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর HDMI তার কার্ডের ইনপুটে দিন, আর কার্ডের USB তার এই Mac-এ লাগান। সবশেষে Mac থেকে আপনার ডিসপ্লেতে সংযোগ দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the PS5's HDMI cable into the card's input and plug the USB cable from the card into this Mac. Finally, link this Mac up to your display."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isaksak ang HDMI cable ng PS5 sa input ng card, tapos ang USB cable ng card sa Mac mo. Panghuli, ikabit ang Mac sa iyong display."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 की HDMI केबल कार्ड के इनपुट में और कार्ड की USB केबल इस Mac में लगाएँ। अंत में इस Mac और स्क्रीन को आपस में जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokkan kabel HDMI PS5 ke input kartu, lalu kabel USB kartu ke Mac ini. Terakhir, sambungkan Mac dengan layar yang Anda pakai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kabel HDMI PS5 ke input kad, dan pasang kabel USB kad pada Mac ini. Akhir sekali, sambungkan Mac ini pada paparan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HDMI-kabel van je PS5 in de kaartingang, USB-kabel van de kaart in deze Mac. Verbind tot slot deze Mac met je beeldscherm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบสาย HDMI จาก PS5 เข้าช่องอินพุตของการ์ด และต่อสาย USB ของการ์ดเข้า Mac สุดท้ายต่อ Mac ตัวนี้เข้ากับจอแสดงผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'in kablosunu kartın HDMI girişine, kartın USB kablosunu bu Mac'e takın. En son Mac'ten ekranınıza bir kablo çekin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کی HDMI تار کارڈ کے ان پٹ میں اور کارڈ کی USB تار اس Mac میں لگائیں۔ آخر میں Mac اور ڈسپلے کو آپس میں جوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm dây HDMI của PS5 vào cổng vào của card, nối dây USB từ card vào Mac này, sau cùng nối Mac sang màn hình."
          }
        }
      }
    },
    "setup.card.plug.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توصيل البطاقة"
          }
        },
        "bn": {
          "stringUnit": {

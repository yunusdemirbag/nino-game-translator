    "setup.welcome.captureCard.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تحتاج حسابًا ثانيًا. يقرأ Nino الصورة التي تمرّ عبر البطاقة ويضع الترجمة فوقها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্বিতীয় অ্যাকাউন্ট লাগে না। কার্ড দিয়ে আসা ছবি Nino পড়ে নেয় আর তার উপর অনুবাদ বসিয়ে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no second account involved. Nino reads the picture coming through the card and lays the translation over it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang pangalawang account na kailangan. Binabasa ni Nino ang larawang dumadaan sa card at ipinapatong dito ang salin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें दूसरा अकाउंट नहीं लगता। कार्ड से आने वाली तस्वीर को Nino पढ़ता है और उसी पर अनुवाद दिखा देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun kedua tidak dibutuhkan. Nino membaca gambar yang masuk lewat kartu lalu menaruh terjemahan di atas gambar itu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada akaun kedua terlibat. Nino membaca gambar yang melalui kad dan meletakkan terjemahan di atasnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tweede account is niet nodig. Nino bekijkt het beeld dat via de kaart binnenkomt en legt de vertaling eroverheen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องใช้แอคเคานต์สำรอง Nino อ่านภาพที่ผ่านการ์ดเข้ามาแล้ววางคำแปลซ้อนไว้บนภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek hesaba gerek yok. Nino oyunu karttan alır, çeviriyi de üzerine yerleştirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں دوسرا اکاؤنٹ درکار نہیں۔ کارڈ سے آنے والی تصویر Nino دیکھتا ہے، پھر ترجمہ اسی کے اوپر بچھا دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chẳng cần thêm tài khoản nào. Nino đọc khung hình đi qua card và đặt bản dịch lên trên."
          }
        }
      }
    },
    "setup.welcome.choose.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم Nino كليهما، ويمكنك تغيير اختيارك من الإعدادات متى شئت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino দুটোই সমর্থন করে, আর সেটিংসে গিয়ে যেকোনো সময় পছন্দ বদলাতে পারবেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino supports either one, and you can change your choice in Settings any time."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaya ni Nino ang alinman sa dalawa, at mababago mo ang pinili mo sa Settings kahit kailan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino इन दोनों में से किसी के भी साथ चल जाता है, और सेटिंग में आप कभी भी चुनाव बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino bekerja dengan keduanya, dan Anda dapat beralih nanti di Pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino menyokong kedua-duanya, dan pilihan ini boleh ditukar dalam Tetapan bila-bila masa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ondersteunt ze allebei, en je kunt je keuze altijd wijzigen in Instellingen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino รองรับได้ทั้งสองแบบ และเปลี่ยนใจภายหลังในการตั้งค่าได้ตลอด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ikisini de destekler; seçiminizi Ayarlar'dan istediğiniz an değiştirebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ان میں سے ہر ایک پر چلتا ہے، اور یہ انتخاب ترتیبات میں کبھی بھی بدلا جا سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino hỗ trợ cả hai, và lúc nào cũng đổi lại được trong Cài đặt."
          }
        }
      }
    },
    "setup.welcome.choose.ps5": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play عبر Wi-Fi، باستخدام حساب PSN ثانٍ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi দিয়ে Remote Play, সঙ্গে একটি বাড়তি PSN অ্যাকাউন্ট"

    "setup.account.window.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تملك حسابًا ثانيًا؟ اقرأ الترجمة من نافذة Remote Play"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্বিতীয় অ্যাকাউন্ট ছাড়া? Remote Play উইন্ডো থেকে সাবটাইটেল পড়ুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a second account? Read subtitles from your Remote Play window"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang pangalawang account? Kunin ang subtitle mula mismo sa nakabukas na Remote Play"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे अकाउंट के बिना? सबटाइटल Remote Play विंडो से लें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun kedua? Baca subtitel dari jendela Remote Play"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akaun kedua? Ambil sari kata terus dari tetingkap Remote Play"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder tweede account? Haal ondertitels uit je Remote Play-venster"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่อยากใช้แอคเคานต์สำรอง? อ่านซับจากหน้าต่างของ Remote Play ได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci hesabınız yoksa Remote Play penceresini kullanın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسرا اکاؤنٹ نہیں ہے؟ سب ٹائٹل Remote Play ونڈو سے پڑھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không muốn lập thêm tài khoản? Lấy phụ đề ngay trong khung Remote Play"
          }
        }
      }
    },

    "setup.xboxList.start.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقِ جهازك في Greenlight واضغط Start. ما زالت الدائرة تدور؟ أوقف أي بث Xbox يعمل في مكان آخر، وامنح Greenlight الإذن في Privacy & Security › Local Network."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight-এ নিজের কনসোল বেছে Start চাপুন। এখনো ঘুরছে? Xbox-এর অন্য স্ট্রিমগুলো বন্ধ করুন, তারপর Privacy & Security › Local Network থেকে Greenlight-কে ঢুকতে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select your console inside Greenlight and press Start. Still spinning? Close any other Xbox streams, then let Greenlight through under Privacy & Security › Local Network."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin ang console mo sa loob ng Greenlight at i-click ang Start. Umiikot pa rin? Isara ang iba pang Xbox stream, tapos bigyan ng pahintulot ang Greenlight dito: Privacy & Security › Local Network."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight में अपना कंसोल चुनकर Start दबाएँ। फिर भी लोडिंग घूम रही है? Xbox की दूसरी स्ट्रीम रोक दें, और Privacy & Security › Local Network में Greenlight को इजाज़त दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih konsol di dalam Greenlight lalu tekan Start. Masih berputar terus? Tutup streaming Xbox lain, lalu izinkan Greenlight di Privacy & Security › Local Network."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih konsol anda di Greenlight dan tekan Start. Masih berputar? Tamatkan sebarang strim Xbox yang lain, kemudian berikan kebenaran kepada Greenlight di Privacy & Security › Local Network."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je console in Greenlight en tik op Start. Blijft het laden? Stop eventuele overige streams van Xbox, en geef Greenlight toegang via Privacy & Security › Local Network."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคอนโซลของคุณใน Greenlight แล้วกด Start ยังหมุนค้างอยู่? หยุดสตรีม Xbox ตัวอื่นที่ค้างอยู่ แล้วให้สิทธิ์ Greenlight ที่ Privacy & Security › Local Network"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight içinde konsolunuzu seçin ve Başlat düğmesine tıklayın. Yükleniyor simgesi durmuyorsa öteki Xbox yayınlarını sonlandırın; Gizlilik ve Güvenlik › Yerel Ağ bölümünde de Greenlight'ı açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight میں اپنا کنسول چن کر Start دبائیں۔ اب بھی گھوم رہا ہے؟ Xbox کی باقی اسٹریمز بند کریں، پھر Privacy & Security › Local Network کھول کر Greenlight کا سوئچ آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn máy của bạn trong Greenlight và bấm Start. Vẫn cứ xoay mãi? Tắt mọi phiên stream Xbox khác, rồi cấp quyền cho Greenlight ở Privacy & Security › Local Network."
          }
        }
      }
    },

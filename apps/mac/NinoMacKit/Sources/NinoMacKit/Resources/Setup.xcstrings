          }
        }
      }
    },
    "setup.card.tv.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج هنا بطاقة تمرّر إشارة HDMI. تبلغ اللعبة التلفاز دون أي تأخير زائد، ويتابع Nino ما في البطاقة ثم يبعث الترجمة إلى تطبيقه على التلفاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর জন্য এমন কার্ড লাগবে যা HDMI ছবি সামনে পাঠিয়ে দেয়। খেলা কোনোরকম বাড়তি বিলম্ব ছাড়াই TV-তে পৌঁছায়, আর Nino কার্ড থেকে দেখে অনুবাদ Nino-র TV অ্যাপে পাঠিয়ে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs a card that passes HDMI through. Your game reaches the TV without extra delay, while Nino watches the card and forwards translations to Nino's TV app."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan dito ng card na kayang mag-HDMI passthrough. Walang dagdag na antala ang laro papunta sa TV, habang binabantayan ni Nino itong card at ipinapasa ang bawat salin papunta sa TV app ni Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए ऐसा कार्ड चाहिए जो HDMI को आगे पास कर दे। गेम बिना ज़्यादा देरी के टीवी तक पहुँचता है, और Nino कार्ड से तस्वीर देखकर अनुवाद टीवी वाले Nino ऐप को भेजता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Butuh kartu yang meneruskan HDMI (passthrough). Game tiba di TV tanpa tambahan jeda, sementara Nino memantau kartu dan meneruskan hasil terjemahan pada aplikasi TV milik Nino."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memerlukan kad yang menyalurkan HDMI terus. Permainan tiba di TV tanpa lengah tambahan, manakala Nino memantau kad dan mengirim terjemahan kepada aplikasi TV Nino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiervoor heb je een kaart nodig die HDMI doorgeeft. Het spel komt zonder extra vertraging op je tv, terwijl Nino via de kaart meekijkt en de vertalingen doorstuurt naar Nino op je tv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบนี้ใช้การ์ดที่ส่งสัญญาณ HDMI ผ่านต่อได้ ภาพเกมจะไปถึงทีวีโดยไม่หน่วงเพิ่ม ส่วน Nino คอยดูภาพจากการ์ดแล้วส่งคำแปลไปที่แอปทีวีของ Nino"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüyü HDMI ile dışarı aktarabilen (passthrough) bir kart gerekiyor. Oyun gecikme eklenmeden TV'ye ulaşır; Nino da kartı izleyip çevirileri TV'deki Nino'ya yollar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے لیے ایسا کارڈ چاہیے جو HDMI آگے گزار دے (pass-through)۔ گیم بغیر کسی تاخیر کے ٹی وی تک پہنچتی ہے، اور Nino کارڈ سے دیکھ کر ترجمے ٹی وی والی Nino ایپ تک پہنچا دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách này cần card có khả năng chuyển tiếp HDMI. Hình ảnh lên TV không bị trễ thêm, còn Nino theo dõi card rồi chuyển phần dịch sang app TV của Nino."
          }
        }
      }
    },

    "setup.key.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف تريد أن يترجم Nino؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino কীভাবে অনুবাদ করবে?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Should Nino Translate?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paano Magsasalin si Nino?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino कैसे अनुवाद करे?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana Nino Menerjemahkan?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana Nino Patut Menterjemah?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe moet Nino vertalen?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ Nino แปลแบบไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino Nasıl Çevirsin?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کیسے ترجمہ کرے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino nên dịch theo cách nào?"
          }
        }
      }
    },
    "setup.key.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الألعاب التي لها حزمة جاهزة لا تحتاج إلى شيء إضافي. لبقية الألعاب اختر طريقة من الأسفل، ويمكنك تغييرها لاحقًا من الإعدادات › الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব গেমের তৈরি প্যাক আছে, সেগুলোর জন্য বাড়তি কিছু লাগবে না। বাকি গেমের জন্য নিচে থেকে একটি উপায় বেছে নিন। পরে সেটিংস › অনুবাদ থেকে বদলাতে পারবেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles that already have a pack need nothing more. For the rest, choose one option below; Settings › Translation lets you switch whenever you like."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang kailangang gawin para sa mga larong may handang pack. Para sa ibang laro, pumili ng paraan sa ibaba. Mababago mo ito mamaya sa Settings › Pagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन गेम का तैयार पैक है, उनके लिए कुछ और नहीं चाहिए। बाकी गेम के लिए नीचे से एक तरीका चुनें। इसे बाद में सेटिंग्स › अनुवाद में बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Game dengan paket siap pakai tidak perlu apa-apa lagi. Untuk game lain, pilih cara di bawah. Anda bisa mengubahnya nanti di Pengaturan › Terjemahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permainan yang ada pek sedia tidak memerlukan apa-apa lagi. Untuk permainan lain, pilih satu cara di bawah. Anda boleh mengubahnya kemudian di Tetapan › Terjemahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Games met een kant-en-klaar pakket hebben niets extra nodig. Kies hieronder een manier voor alle andere games. Je kunt dit later wijzigen via Instellingen › Vertaling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกมที่มีแพ็กพร้อมใช้ไม่ต้องทำอะไรเพิ่ม สำหรับเกมอื่น ให้เลือกวิธีด้านล่าง และเปลี่ยนได้ภายหลังที่ การตั้งค่า › การแปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketi hazır oyunlarda yapmanız gereken bir şey yok. Ötekiler için aşağıdan bir yol seçin; Ayarlar › Çeviri bölümünden dilediğiniz an değiştirirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جن گیمز کا تیار پیک موجود ہے ان کے لیے کچھ اور نہیں چاہیے۔ باقی گیمز کے لیے نیچے سے ایک طریقہ چنیں۔ اسے بعد میں سیٹنگز › ترجمہ سے بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chơi đã có gói sẵn không cần thêm gì. Với các trò chơi khác, hãy chọn một cách bên dưới. Bạn có thể đổi lại sau trong Cài đặt › Dịch."
          }
        }
      }
    },

          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang di TV Saya"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang pada TV Saya"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op mijn tv installeren"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งบนทีวี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'ye Kur"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میرے ٹی وی پر لگائیں"
          }
        },
        "vi": {
          "stringUnit": {

    "setup.ps5.connecting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتصل بـ PS5… ربما يأخذ الأمر قرابة 30 ثانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর সঙ্গে যোগাযোগ করা হচ্ছে… প্রায় ৩০ সেকেন্ড লাগতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaching your PS5… This may need about 30 seconds."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumokonekta sa PS5 mo… Puwedeng umabot ito nang mga 30 segundo."

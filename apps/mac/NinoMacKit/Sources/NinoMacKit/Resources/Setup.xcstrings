    "setup.tvApp.samsung.anynet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ينتقل التلفاز باستمرار إلى مدخل آخر مثل HDMI 1 أثناء عمل Nino؟ افتح على التلفاز Settings › All Settings › Connection › External Device Manager وأوقف Anynet+ (HDMI-CEC) وكذلك Auto Source Switching."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে Nino চলার সময় TV কি বারবার HDMI 1-এর মতো অন্য ইনপুটে চলে যায়? TV-তে Settings › All Settings › Connection › External Device Manager খুলে Anynet+ (HDMI-CEC) আর Auto Source Switching দুটোই বন্ধ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Nino runs on your TV, does the TV keep jumping to another input such as HDMI 1? Open Settings › All Settings › Connection › External Device Manager on your TV and disable Anynet+ (HDMI-CEC) as well as Auto Source Switching."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang tumatakbo si Nino sa TV, palipat-lipat ba ang TV sa ibang input tulad ng HDMI 1? Sa TV mo, magtungo sa Settings › All Settings › Connection › External Device Manager at patayin itong Anynet+ (HDMI-CEC) pati ang Auto Source Switching."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino के चलते समय क्या टीवी बार-बार किसी और इनपुट (जैसे HDMI 1) पर स्विच हो जाता है? टीवी में Settings › All Settings › Connection › External Device Manager खोलकर Anynet+ (HDMI-CEC) तथा Auto Source Switching, दोनों को ऑफ़ कर दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selagi Nino berjalan di TV, apakah TV terus pindah ke input lain seperti HDMI 1? Pada TV, masuk ke Settings › All Settings › Connection › External Device Manager, lalu nonaktifkan Anynet+ (HDMI-CEC) serta Auto Source Switching."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketika Nino berjalan di TV, TV sering beralih ke input lain seperti HDMI 1? Di TV, lawati menu Settings › All Settings › Connection › External Device Manager lalu nyahaktifkan Auto Source Switching serta Anynet+ (HDMI-CEC)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Springt je tv steeds naar een andere ingang, zoals HDMI 1, terwijl Nino erop draait? Ga op je tv naar Settings › All Settings › Connection › External Device Manager en schakel zowel Anynet+ (HDMI-CEC) als Auto Source Switching uit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างที่ Nino ทำงานบนทีวี ทีวีชอบเด้งไปช่องอื่นอย่าง HDMI 1 ใช่ไหม? บนทีวีไปที่ Settings › All Settings › Connection › External Device Manager แล้วปิด Auto Source Switching พร้อมกับ Anynet+ (HDMI-CEC)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de Nino açıkken TV kendiliğinden HDMI 1'e veya başka bir girişe atlıyor mu? TV'nin Ayarlar › Tüm Ayarlar › Bağlantı › Harici Cihaz Yöneticisi bölümüne gidip Anynet+ (HDMI-CEC) ile Otomatik Kaynak Değiştirme seçeneklerini kapatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino چلتے وقت ٹی وی بار بار کسی دوسرے ان پٹ، جیسے HDMI 1، پر چلا جاتا ہے؟ ٹی وی میں Settings › All Settings › Connection › External Device Manager کھولیں، پھر Anynet+ (HDMI-CEC) بند کریں، ساتھ میں Auto Source Switching بھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi Nino đang chạy, TV cứ tự nhảy sang nguồn khác như HDMI 1? Mở Settings › All Settings › Connection › External Device Manager trên TV rồi tắt cả Anynet+ (HDMI-CEC) lẫn Auto Source Switching."
          }
        }
      }
    },
    "setup.tvApp.samsung.signIn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض المتصفح الآن صفحة حساب Samsung؛ أكمل تسجيل الدخول فيها. لا تجدها؟ انتقل إلى المتصفح، أو اختر «فتح الصفحة مجددًا»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্রাউজারে Samsung-এর অ্যাকাউন্ট পেজ খোলা আছে; সেখানে লগইন শেষ করুন। খুঁজে পাচ্ছেন না? ব্রাউজারে চলে যান, কিংবা পেজ ফের খুলুন টিপুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your browser is showing Samsung's account page; complete the login there. Can't find it? Switch over to your browser, or choose Reopen the Page."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa browser mo ang account page ng Samsung; doon tapusin ang pagpasok sa account. Hindi mo makita? Lumipat sa browser mo, o piliin ang Buksan Ulit ang Page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र में Samsung का अकाउंट पेज खुला है; साइन इन वहीं पूरा करें। पेज नहीं मिल रहा? अपने ब्राउज़र पर स्विच करें, या पेज फिर खोलें बटन दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser Anda sedang menampilkan halaman akun Samsung; tuntaskan login di halaman itu. Tidak ketemu? Pindah ke browser, atau pilih Buka Halaman Lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayar anda kini memaparkan laman akaun Samsung; lengkapkan langkah masuk akaun di sana. Tidak nampak? Beralih ke pelayar, ataupun pilih Buka Halaman Semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In je browser staat de accountpagina van Samsung open; meld je daar aan. Kun je hem niet vinden? Ga naar je browser of kies Pagina opnieuw openen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เบราว์เซอร์เปิดหน้า Samsung account ไว้แล้ว ล็อกอินให้เสร็จตรงนั้น หาไม่เจอ? ลองย้ายไปดูหน้าต่างเบราว์เซอร์ หรือแตะ เปิดหน้าเว็บอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcınızda Samsung hesap sayfası açık; oturum açmayı orada tamamlayın. Sayfayı bulamıyorsanız tarayıcınıza geçin veya Sayfayı Tekrar Aç'ı seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "براؤزر میں Samsung اکاؤنٹ والا صفحہ کھلا ہے؛ لاگ ان وہیں مکمل کریں۔ صفحہ نظر نہیں آ رہا؟ براؤزر کی ونڈو سامنے لائیں، یا «صفحہ پھر سے کھولیں» دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình duyệt đang hiện trang đăng ký và đăng nhập Samsung; hãy đăng nhập xong ở đó. Không thấy trang? Mở cửa sổ trình duyệt ra, hoặc chọn Mở trang lần nữa."
          }
        }
      }
    },
    "setup.tvApp.samsung.signIn.copy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {

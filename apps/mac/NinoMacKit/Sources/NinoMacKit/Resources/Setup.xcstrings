    "setup.test.tip.computer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انظر قرب الحافة السفلية للشاشة؛ تبقى الترجمة بضع ثوانٍ. وبعدها أعد إرسالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি কয়েক সেকেন্ডের জন্য স্ক্রিনের নিচে দেখায়। আবার পাঠান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look near the lower edge of the display; it stays a few seconds. Then send it once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumingin malapit sa ibabang gilid ng display; ilang segundo lang itong nananatili. Pagkatapos, ipadala ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन के निचले किनारे के पास देखें; यह कुछ सेकंड रहता है। फिर इसे एक बार और भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat di dekat tepi bawah layar; subtitel tampil beberapa detik. Lalu kirim sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat berhampiran tepi bawah skrin; ia kekal beberapa saat. Kemudian hantar sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk vlak bij de onderrand van het scherm; hij blijft een paar seconden staan. Stuur hem daarna nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มองแถวขอบล่างของจอ ซับจะค้างอยู่ไม่กี่วินาที จากนั้นส่งใหม่อีกที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazı birkaç saniyeliğine ekranın alt kısmında belirir. Bir kez daha gönderin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین کے نچلے کنارے پر نظر رکھیں؛ یہ چند سیکنڈ ٹھہرتا ہے۔ پھر ایک دفعہ اور بھیج کر دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn gần mép dưới màn hình; dòng chữ chỉ hiện vài giây. Sau đó gửi lại lần nữa."
          }
        }
      }
    },
    "setup.test.tip.tv": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تشغيل التلفاز ومن أن Nino مفتوح فيه، وأعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV অন আছে আর তাতে Nino খোলা আছে কিনা দেখে নিন, এরপর ফের চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your TV is switched on and Nino is open on it, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiyaking nakabukas ang TV mo at bukas dito si Nino, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि टीवी चालू है और उस पर Nino खुला है, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cek apakah TV hidup dan Nino sudah terbuka di TV, kemudian ulangi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan TV hidup dan aplikasi TV Nino terbuka, kemudian hantarkannya semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk of je tv aanstaat en Nino daarop geopend is, en doe dan nog een poging."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช็กว่าทีวีเปิดอยู่และเปิด Nino ไว้บนทีวี แล้วลองอีกที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV açık mı, TV'deki Nino açık mı, kontrol edip tekrar gönderin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تسلی کر لیں کہ ٹی وی چالو ہو اور اس پر Nino کھلا ہو، پھر ایک بار اور آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem TV có đang mở, Nino có đang chạy trên TV chưa, rồi thử thêm lần nữa."
          }
        }
      }
    },

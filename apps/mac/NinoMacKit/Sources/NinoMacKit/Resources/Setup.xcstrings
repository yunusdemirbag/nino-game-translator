    "setup.gemini.sample1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابقَ قريبًا. هناك شيء يتحرك في الخارج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাছে থাকো। বাইরে কিছু একটা নড়ছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay close. Something is moving out there."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dumikit ka lang. May gumagalaw diyan sa labas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पास रहो। बाहर कुछ हिल रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap dekat. Ada sesuatu yang bergerak di luar sana."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Duduk dekat. Ada sesuatu bergerak di luar sana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf dichtbij. Er beweegt daar iets."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ใกล้ๆ ไว้ มีอะไรเคลื่อนไหวอยู่ข้างนอกนั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakın dur. Dışarıda bir şey kıpırdıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریب رہو۔ وہاں باہر کچھ حرکت کر رہا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đứng gần vào. Có thứ gì đó đang di chuyển ngoài kia."
          }
        }
      }
    },
    "setup.gemini.sample2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنغادر عند الفجر، معه أو من دونه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা ভোরে রওনা দেব, ও আসুক বা না আসুক।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We leave at dawn, with or without him."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalis tayo pagsikat ng araw, kasama man siya o hindi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम सुबह निकलेंगे, वह आए या न आए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kita berangkat saat fajar, dengan atau tanpa dia."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kita bertolak waktu subuh, dengan atau tanpa dia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We vertrekken bij zonsopgang, met of zonder hem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะออกเดินทางตอนรุ่งสาง ไม่ว่าเขาจะมาหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şafakta yola çıkıyoruz, o gelse de gelmese de."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم صبح سویرے نکلیں گے، وہ ساتھ ہو یا نہ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng ta đi lúc bình minh, dù có anh ta hay không."
          }
        }
      }
    },
    "setup.gemini.sample3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد عدت. كنت أعلم أنك ستعود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি ফিরে এসেছ। আমি জানতাম তুমি আসবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You came back. I knew you would."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumalik ka. Alam kong babalik ka."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम लौट आए। मुझे पता था तुम आओगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kau kembali. Aku tahu kau akan kembali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kau kembali. Aku tahu kau akan kembali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent teruggekomen. Ik wist het wel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นายกลับมาแล้ว ฉันรู้อยู่แล้วว่านายจะกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri döndün. Döneceğini biliyordum."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تم واپس آ گئے۔ مجھے پتہ تھا تم آؤ گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cậu đã quay lại. Tôi biết cậu sẽ quay lại mà."
          }
        }
      }
    },
    "setup.gemini.save": {
      "extractionState": "manual",
      "localizations": {

            "value": "Host PC IP para sa computer mo: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कंप्यूटर का पता (Host PC IP): %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP untuk komputer ini: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP untuk komputer ini: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP voor deze computer: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP ของคอมเครื่องนี้: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayarın Host PC IP değeri: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کمپیوٹر کا پتہ (Host PC IP): %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP dành cho máy này: %@"
          }
        }
      }
    },
    "setup.samsung.modeOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فور تفعيل Developer Mode يثبّت Nino التطبيق على تلفازك نيابةً عنك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode অন হওয়ামাত্র Nino নিজেই অ্যাপটি আপনার TV-তে বসিয়ে দেবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As soon as Developer Mode is switched on, Nino puts the app on your TV for you."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pag-on mo ng Developer Mode, si Nino na ang maglalagay ng app sa TV mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे ही Developer Mode ऑन होगा, Nino खुद आपके टीवी पर ऐप डाल देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Segera setelah Developer Mode menyala, Nino langsung memasang aplikasinya di TV untuk Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebaik Developer Mode dihidupkan, Nino akan memasang aplikasi pada TV untuk anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je Developer Mode aan, dan zet Nino de app meteen voor je op de tv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทันทีที่ Developer Mode ทำงาน Nino จะจัดการลงแอปบนทีวีให้เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici modu açıldığında Nino TV uygulamasını kendiliğinden kurar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode چالو ہوتے ہی Nino خود ایپ کو ٹی وی پر انسٹال کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay khi bật Developer Mode, Nino sẽ tự cài ứng dụng lên TV giúp bạn."
          }
        }
      }
    },
    "setup.samsung.modeOff.account": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد ذلك ادخل لمرة واحدة بحساب Samsung (وهو مجاني)؛ إذ تشترط Samsung هذا كي توقّع Nino لتلفازك بعينه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এরপর একবার একটি Samsung অ্যাকাউন্টে লগ ইন করুন (এটা ফ্রি)। আপনার নির্দিষ্ট TV-র জন্য Nino-তে সই করতে Samsung এটা চায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, log in a single time with a Samsung account (it's free). Samsung requires this to sign Nino for your particular TV."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Susunod, pumasok nang minsan gamit ang Samsung account (libre ito). Hinihingi iyon ng Samsung para mapirmahan si Nino para sa mismong TV mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बाद एक बार Samsung अकाउंट (मुफ़्त) में लॉग इन करें। Samsung इसी के ज़रिए Nino को खास आपके टीवी के लिए साइन करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikutnya, login satu kali memakai akun Samsung (tanpa biaya). Samsung mewajibkan ini untuk menandatangani Nino khusus bagi TV Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemudian, masuk sekali menggunakan akaun Samsung (tanpa bayaran). Samsung mewajibkan langkah ini supaya Nino ditandatangani khas untuk TV anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je daarna één keer aan met een Samsung-account (kost niets). Samsung eist dat, zodat Nino voor jouw tv ondertekend kan worden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อจากนั้นให้ล็อกอิน Samsung account หนึ่งหน (สมัครฟรี) Samsung กำหนดไว้แบบนี้เพื่อเซ็นรับรอง Nino ให้ใช้กับทีวีเครื่องของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından bir Samsung hesabıyla (ücretsizdir) tek bir kez oturum açın. Samsung, Nino'yu sizin TV'niz için imzalarken bu hesabı kullanır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلے قدم میں ایک بار Samsung اکاؤنٹ سے لاگ ان کریں (یہ مفت ہے)۔ Samsung اسی سے Nino پر خاص اسی ٹی وی کے لیے دستخط کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đó, đăng nhập một lượt vào tài khoản Samsung (không tốn phí). Samsung cần bước này để ký Nino riêng cho chiếc TV của bạn."
          }
        }
      }
    },
    "setup.samsung.noAnswer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار ردّ التلفاز…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র উত্তরের অপেক্ষা…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a reply from the TV…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinihintay sumagot ang TV…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी से जवाब आने का इंतज़ार…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu TV merespons…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu TV menjawab…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten tot de tv antwoordt…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอทีวีตอบกลับ…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nin yanıtı bekleniyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کی طرف سے جواب کا انتظار…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ TV trả lời…"
          }
        }
      }
    },
    "setup.samsung.noAnswer.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أن التلفاز مشغَّل ويشارك هذا الحاسوب الشبكةَ ذاتها. تتقدم هذه الشاشة وحدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খেয়াল করুন TV অন আছে কিনা আর এই কম্পিউটারের নেটওয়ার্কে যুক্ত কিনা। পরের ধাপে এই পাতা নিজে নিজেই চলে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your TV is switched on and connected to the network this computer uses. This screen moves ahead automatically."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiyaking nakabukas ang TV mo at konektado sa network na gamit din ng computer mo. Kusang uusad ang screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पक्का करें कि टीवी ऑन है, साथ ही उसी नेटवर्क से कनेक्टेड है जो यह कंप्यूटर इस्तेमाल करता है। यह स्क्रीन खुद-ब-खुद अगले चरण पर चली जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cek apakah TV hidup dan memakai jaringan yang sama seperti komputer ini. Halaman ini akan lanjut dengan sendirinya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak bahawa TV menyala dan menggunakan rangkaian sama seperti komputer ini. Paparan ini akan maju dengan sendirinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk of je tv aanstaat en met hetzelfde netwerk verbonden is als deze computer. Zodra dat zo is, gaat dit scherm uit zichzelf verder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูให้แน่ใจว่าทีวีเปิดอยู่และใช้วงเน็ตเดียวกับคอมเครื่องนี้ หน้านี้จะไปขั้นถัดไปเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV açık mı, bu bilgisayarın ağına bağlı mı, kontrol edin. Bu ekran kendiliğinden ilerler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تسلی کر لیں کہ ٹی وی چالو ہے اور یہ کمپیوٹر جس نیٹ ورک سے جڑا ہے، ٹی وی بھی اسی سے جڑا ہے۔ اگلا مرحلہ اپنے آپ کھل جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem TV có đang mở, có dùng chung mạng với chiếc máy này chưa. Trang này sẽ tự động đi tiếp."
          }
        }
      }
    },
    "setup.samsung.notAccepted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض التلفاز الاتصال بهذا الحاسوب. افتح شاشة Developer Mode في التلفاز وراجع قيمة Host PC IP لتكون عنوان هذا الحاسوب، ثم أطفئ التلفاز وأعد تشغيله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV এই কম্পিউটারকে ফিরিয়ে দিয়েছে। TV-র পর্দায় Developer Mode পাতায় Host PC IP যেন এই কম্পিউটারের ঠিকানাই হয় তা মিলিয়ে নিন, তারপর TV বন্ধ করে আবার চালু করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV rejected this computer. On its Developer Mode screen, confirm Host PC IP equals the address of this computer, then switch the TV off and on."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw tanggapin ng TV mo ang computer mo. Sa screen nitong Developer Mode, tingnan kung kapareho ng address ng computer mo ang value ng Host PC IP, tapos patayin at buksan ulit ang TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कंप्यूटर को टीवी ने स्वीकार नहीं किया। टीवी की Developer Mode स्क्रीन देखें: Host PC IP वाली जगह यही कंप्यूटर का पता लिखा होना चाहिए। फिर टीवी ऑफ़-ऑन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV menolak komputer ini. Pada layar Developer Mode milik TV, cek bahwa isi Host PC IP sama persis dengan alamat komputer ini; sesudah itu matikan dan nyalakan kembali TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer ini ditolak oleh TV. Buka skrin Developer Mode milik TV dan sahkan nilai Host PC IP sepadan dengan alamat komputer ini; selepas itu matikan TV dan hidupkannya semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tv weigerde deze computer. Controleer in het scherm Developer Mode dat Host PC IP overeenkomt met wat deze computer als adres heeft, en zet de tv daarna uit en weer aan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีไม่ยอมรับคอมเครื่องนี้ ในหน้า Developer Mode บนทีวี เช็กให้ Host PC IP ตรงกับเลขที่อยู่ของคอมนี้ จากนั้นปิดทีวีแล้วเปิดใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV bu bilgisayarı reddetti. TV'nin Developer Mode ekranında Host PC IP değerinin bu bilgisayarın adresiyle aynı olduğunu doğrulayın, sonra TV'yi kapatıp açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی نے یہ کمپیوٹر رد کر دیا۔ Developer Mode والی اسکرین کھول کر جانچیں: Host PC IP والے خانے میں جو ایڈریس ہے، وہ اسی کمپیوٹر والا ہونا چاہیے۔ پھر ٹی وی بند کر کے دوبارہ چلائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV từ chối chiếc máy này. Trên màn hình Developer Mode, xem Host PC IP đã trùng với IP máy này chưa, sau đó tắt TV và mở lại."
          }
        }
      }
    },
    "setup.samsung.notRestarted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode مفعّل، لكن على التلفاز أن يُعاد تشغيله كليًا قبل أن يقبل التثبيت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode চালু হয়েছে, কিন্তু ইনস্টল করতে দেওয়ার আগে TV-টিকে পুরোপুরি রিস্টার্ট করা দরকার।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode is switched on, yet the TV still needs a full restart before it allows installs."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktibo na itong Developer Mode, pero kailangan pa ng buong restart ng TV bago ito pumayag mag-install."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode ऑन हो चुका है, लेकिन इंस्टॉल शुरू करने से पहले टीवी का पूरा रीस्टार्ट ज़रूरी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode sudah aktif, tetapi TV masih harus dimulai ulang sepenuhnya sebelum mengizinkan instalasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode sudah hidup, tetapi TV perlu dimulakan semula sepenuhnya sebelum pemasangan dibenarkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode is ingeschakeld, maar pas na een volledige herstart laat de tv installaties toe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ Developer Mode ทำงานอยู่ แต่ทีวียังต้องรีสตาร์ตเต็มรูปแบบก่อนจึงจะยอมให้ลงแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode açık, fakat TV baştan başlatılmadan kuruluma izin vermiyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode چالو ہے، مگر انسٹال کی اجازت سے پہلے ٹی وی کو ایک مکمل ری اسٹارٹ چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode đã được bật, nhưng TV vẫn phải tắt hẳn rồi mở lại thì mới cho cài đặt."
          }
        }
      }
    },
    "setup.samsung.notRestarted.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ إصبعك على زر الطاقة بالريموت إلى حين ظهور شعار Samsung، أو انزع قابس التلفاز قرابة دقيقة. النقرة السريعة لا تفعل سوى إدخاله في الاستعداد. تتقدم هذه الشاشة وحدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনে Samsung লোগো ভেসে ওঠা অবধি রিমোটের পাওয়ার কী টিপে রাখুন, বা মিনিটখানেকের জন্য TV-র প্লাগ খুলে রাখুন। ছোট্ট একটা চাপে TV কেবল স্ট্যান্ডবাই মোডে চলে যায়। পরের ধাপে এই পাতা নিজে নিজেই চলে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the remote's power button held down until you see the Samsung logo, or pull the TV's power cord for about a minute. A quick press just sends it to standby. This screen moves ahead automatically."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Diinan ang power button na nasa remote hanggang lumitaw ang Samsung logo, o hugutin sa saksakan ang TV nang mga isang minuto. Standby lang ang mangyayari kapag mabilis na pinindot. Kusang uusad ang screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung लोगो दिखने तक रिमोट के पावर बटन को दबाकर रखें, या टीवी का प्लग निकालकर करीब एक मिनट इंतज़ार करें। बस हल्के से दबाने पर टीवी केवल स्टैंडबाय मोड में पहुँचता है। स्क्रीन खुद-ब-खुद अगले चरण पर पहुँच जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan terus tombol power di remote hingga logo Samsung tampil, atau lepas steker TV kira-kira semenit. Kalau hanya ditekan singkat, TV cuma masuk mode siaga. Layar ini akan lanjut dengan sendirinya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama butang kuasa pada remote TV hingga logo Samsung kelihatan, ataupun cabut kord kuasa TV kira-kira seminit. Tekan sekejap hanya membuatkan TV tidur (siap sedia). Skrin ini akan maju dengan sendirinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk de powerknop op de afstandsbediening in en laat pas los als het Samsung-logo te zien is, of trek de stroomkabel van de tv zo'n minuut los. Even kort drukken laat de tv alleen sluimeren. Dit scherm gaat uit zichzelf verder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่มเปิดปิดของรีโมตแช่ไว้ จนกว่าโลโก้ Samsung จะขึ้น หรือถอดปลั๊กทีวีราวหนึ่งนาที ถ้ากดแป๊บเดียวทีวีจะแค่เข้าโหมดสแตนด์บาย หน้านี้จะไปขั้นถัดไปเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung logosunu görene dek kumandadaki güç tuşunu bırakmayın ya da TV'yi prizden çekip yaklaşık bir dakika bekleyin. Kısa bir basış TV'yi sadece beklemeye geçirir. Bu ekran kendiliğinden ilerler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریموٹ پر پاور والا بٹن دبائے رہیں، Samsung لوگو دکھائی دے تو چھوڑیں؛ یا ٹی وی کا پلگ تقریباً ایک منٹ کو نکال دیں۔ فوراً چھوڑ دیں تو ٹی وی بس سو جاتا ہے (اسٹینڈ بائی)۔ اگلا مرحلہ اپنے آپ کھل جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ chặt phím nguồn của remote tới lúc logo Samsung hiện lên, hoặc rút dây nguồn TV khoảng một phút. Bấm thoáng qua thì TV chỉ chuyển sang standby. Trang này sẽ tự động đi tiếp."
          }
        }
      }
    },
    "setup.samsung.restart": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعدت تشغيل التلفاز كليًا بعد التغيير"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বদলানোর পর আমি TV পুরোপুরি রিস্টার্ট করেছি"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I restarted the TV completely after changing it"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-restart ko nang buo ang TV pagkatapos itong baguhin"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव करने के बाद मैंने टीवी पूरा रीस्टार्ट कर दिया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya sudah memulai ulang TV sepenuhnya setelah mengubahnya"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV sudah saya mula semula sepenuhnya selepas tetapan diubah"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de tv na de wijziging helemaal opnieuw opgestart"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีสตาร์ททีวีอย่างสมบูรณ์แล้วหลังการเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayardan sonra TV tamamen yeniden başlatıldı"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بدلنے کے بعد میں نے ٹی وی پوری طرح ری اسٹارٹ کیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã tắt hẳn rồi mở lại TV sau khi đổi"
          }
        }
      }
    },
    "setup.samsung.restart.ok": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمّت إعادة التشغيل، والتلفاز مهيّأ للتثبيت"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV রিস্টার্ট হয়েছে, ইনস্টলের জন্য তৈরি"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV restarted and is ready for installs"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buo nang nag-restart ang TV, handa nang mag-install"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी दोबारा चालू हो चुका है, इंस्टॉल शुरू किए जा सकते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV selesai di-restart dan siap menerima instalasi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV sudah bermula semula dan boleh menerima pemasangan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv is herstart en klaar om te installeren"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีรีสตาร์ทแล้วและยอมรับการติดตั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV yeniden açıldı, kurulum yapılabilir"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی ری اسٹارٹ ہو چکا، اب انسٹال ہو سکتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV đã mở lại xong, có thể cài"
          }
        }
      }
    },
    "setup.samsung.restartHold": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقرة السريعة لا تفعل سوى إدخال تلفاز Samsung في الاستعداد. للحصول على إعادة تشغيل كاملة أبقِ زر الطاقة في الريموت مضغوطًا ثانيتين تقريبًا إلى أن تختفي الصورة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হালকা চাপে Samsung TV কেবল স্ট্যান্ডবাইতে যায়। পুরো রিস্টার্টের জন্য ছবি নিভে না যাওয়া অবধি রিমোটের পাওয়ার কী মোটামুটি ২ সেকেন্ড টিপে রাখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick press just sends a Samsung TV to standby. For a full restart, keep the remote's power key pressed for around 2 seconds, till the picture goes off."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Standby lang ang Samsung TV kapag mabilis na pinindot. Para sa buong restart, diinan ang power key ng remote nang humigit-kumulang 2 segundo, hanggang mawala ang larawan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हल्के से दबाने पर Samsung टीवी केवल स्टैंडबाय मोड में पहुँचता है। पूरे रीस्टार्ट के लिए रिमोट की पावर की को करीब 2 सेकंड तक दबाकर रखें, जब तक तस्वीर गायब न हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau ditekan singkat, TV Samsung cuma masuk mode siaga. Untuk restart penuh, tekan terus tombol power di remote kira-kira 2 detik hingga gambar padam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan sekejap hanya membuatkan TV Samsung tidur (siap sedia). Untuk mula semula sepenuhnya, tekan lama kekunci kuasa remote TV lebih kurang dua saat, hingga gambar hilang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even kort drukken laat een Samsung-tv alleen sluimeren. Voor een echte herstart druk je de powerknop op de afstandsbediening zo'n 2 seconden in, tot het beeld uitgaat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดแป๊บเดียวทีวี Samsung จะแค่สแตนด์บาย ถ้าจะรีสตาร์ตจริง ให้กดปุ่มเปิดปิดบนรีโมตค้างประมาณ 2 วินาที จนจอดับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa bir basış Samsung TV'yi sadece beklemeye geçirir. Tam yeniden başlatma için ekran kararana dek kumandadaki güç tuşunu iki saniye kadar bırakmayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung ٹی وی کا بٹن فوراً چھوڑ دیں تو وہ بس سو جاتا ہے (اسٹینڈ بائی)۔ پوری طرح ری اسٹارٹ کرنے کو ریموٹ کی پاور key کو قریب 2 سیکنڈ تک دبائیں، تصویر بجھنے پر چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm thoáng qua thì TV Samsung chỉ chuyển sang standby. Muốn tắt hẳn rồi mở lại, hãy giữ phím nguồn của remote chừng 2 giây, tới khi màn hình tắt."
          }
        }
      }
    },
    "setup.samsung.reversed %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خزّن التلفاز العنوان مقلوبًا (%1$@). يقع هذا إذا كانت واجهة التلفاز بلغة تُقرأ من جهة اليمين. عطّل Developer mode وفعّله من جديد، وأدخل العنوان بترتيب عكسي حتى يخزّنه التلفاز على هيئة %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV ঠিকানাটি উল্টো ক্রমে রেখেছে (%1$@)। ডান দিক থেকে লেখা কোনো ভাষা TV-তে চালু থাকলে এমনটা ঘটে। Developer mode একবার Off, তারপর On করুন, আর ঠিকানাটা পেছন থেকে সাজিয়ে লিখুন, তাহলে TV শেষমেশ %2$@ রাখবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV stored the address in reverse order (%1$@). It occurs if your TV uses a right-to-left language. Switch Developer mode Off, then On, and type the address in reverse so the TV ends up storing %2$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Baligtad ang pagkakatabi ng TV mo sa address (%1$@). Ganito ang nangyayari kapag right-to-left na wika ang gamit ng TV. Patayin at buhayin muli itong Developer mode, tapos isulat mula dulo pasimula ang address para %2$@ ang maitabi ng TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी ने पता उलटे क्रम में सहेज लिया (%1$@)। जब टीवी की भाषा दाईं ओर से शुरू होकर लिखी जाती है, तब ऐसा होता है। Developer mode ऑफ़ करके फिर ऑन करें, और पता उलटा टाइप करें, ताकि अंत में टीवी में %2$@ सहेजा जाए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urutan alamat yang disimpan TV terbalik (%1$@). Hal ini muncul bila TV memakai bahasa yang ditulis dari arah kanan. Nonaktifkan Developer mode, aktifkan kembali, lalu masukkan alamat dengan urutan dibalik supaya yang akhirnya tersimpan di TV adalah %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV menyimpan alamat dengan susunan songsang (%1$@). Perkara ini berlaku apabila TV memakai bahasa yang ditulis dari kanan. Tukar Developer mode kepada Off, kemudian On, lalu isikan alamat secara songsang agar TV akhirnya menyimpan %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres staat op je tv omgekeerd opgeslagen (%1$@). Dit komt voor bij een tv-taal met rechts-naar-links-schrift. Zet Developer mode uit en weer aan, en voer het adres achterstevoren in, zodat de tv uiteindelijk %2$@ bewaart."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีเก็บที่อยู่สลับลำดับ (%1$@) เรื่องนี้เกิดได้ถ้าทีวีใช้ภาษาที่อ่านจากขวาไปซ้าย ให้สลับ Developer mode ไปที่ Off และกลับมาที่ On จากนั้นป้อนที่อยู่โดยเรียงย้อนหลัง ทีวีจะได้เก็บค่าเป็น %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV adresi tersine çevirip saklamış (%1$@). TV'nin arayüz dili Arapça gibi sağdan sola bir dilse bu olur. Önce Developer mode ayarını Off, sonra On yapın; adresi sondan başa doğru yazın ki TV %2$@ olarak saklasın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی میں ایڈریس الٹا محفوظ ہو گیا (%1$@)۔ یہ مسئلہ ان ٹی وی پر آتا ہے جن کی زبان عربی یا اردو جیسی، یعنی دائیں سے شروع ہونے والی ہو۔ Developer mode ایک بار Off کر کے پھر On کریں، اور ایڈریس الٹی ترتیب سے ٹائپ کریں، تاکہ آخر میں ٹی وی کے پاس %2$@ محفوظ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ trong TV bị lưu đảo ngược (%1$@). Lỗi này gặp khi TV đang dùng ngôn ngữ đọc từ bên phải qua. Tắt Developer mode, mở lại, rồi gõ địa chỉ theo chiều đảo lại để cuối cùng TV ghi đúng %2$@."
          }
        }
      }
    },

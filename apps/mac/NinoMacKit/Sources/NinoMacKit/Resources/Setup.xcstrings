    "setup.xboxList.remote.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features. ثم افتح تفضيلات تطبيق Xbox واسمح لأي جهاز بالاتصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features। এরপর Xbox অ্যাপের পছন্দ-তালিকা খুলে যেকোনো ডিভাইসকে যুক্ত হতে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features. Then open the Xbox app's preferences and let any device connect."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features. Pagkatapos, buksan ang preferences ng Xbox app at payagang kumonekta ang kahit anong device."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features। फिर Xbox ऐप की सेटिंग्स खोलें और किसी भी डिवाइस को जुड़ने दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features. Lalu buka preferensi aplikasi Xbox dan izinkan semua perangkat tersambung."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features. Dalam Xbox app preferences, benarkan sambungan daripada sebarang peranti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features. Ga daarna naar de voorkeuren van je Xbox-app en sta verbindingen van elk apparaat toe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features จากนั้นเข้าการตั้งค่าของแอป Xbox แล้วยอมให้อุปกรณ์ใดก็ได้ต่อเข้ามา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar › Cihazlar ve bağlantılar › Uzak özellikler bölümüne girin. Ardından Xbox uygulamasının tercihlerinde her cihazın bağlanmasına izin verin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features۔ پھر Xbox ایپ کی ترجیحات کھول کر ہر ڈیوائس کو جڑنے دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Devices & connections › Remote features. Sau đó mở phần tùy chọn của app Xbox và cho mọi thiết bị được kết nối."
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "Sample subtitle from Nino. Is it visible over your game?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Halimbawang subtitle mula kay Nino. Kita mo ba ito habang naglalaro?"

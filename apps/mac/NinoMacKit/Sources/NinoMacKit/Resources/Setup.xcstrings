            "value": "Cài trên TV"
          }
        }
      }
    },
    "setup.tvApp.lg.lastStep": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode جاهز. بقي أمر واحد فقط قبل أن يُثبَّت Nino على تلفازك:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode তৈরি। TV-তে Nino বসানোর আগে আর মাত্র একটি কাজ বাকি:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode is ready. Only one thing left before Nino goes onto your TV:"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Handa na itong Developer Mode. Isang bagay na lang bago mapunta si Nino sa TV mo:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode तैयार है। Nino को टीवी पर डालने से पहले बस एक काम बचा है:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode sudah siap. Tinggal satu hal lagi sebelum Nino masuk ke TV:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode sudah sedia. Tinggal satu perkara lagi sebelum Nino dipasang pada TV:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode is klaar. Nog één ding en dan zet Nino de app op je tv:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode พร้อมแล้ว เหลืออีกอย่างเดียวก่อน Nino จะลงบนทีวี:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici modu açıldı. TV uygulamasının kurulması için tek adım kaldı:"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode تیار ہو گیا۔ Nino کے ٹی وی پر جانے سے پہلے بس ایک کام رہ گیا ہے:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode đã sẵn sàng. Chỉ còn một bước nữa là Nino lên TV:"
          }
        }
      }
    },
    "setup.tvApp.lg.notInstalled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التلفاز لا يحتوي Nino حتى الآن. متى فعّلت Developer Mode أمكن لـ Nino أن يثبّته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে এখনো Nino নেই। Developer Mode অন থাকলে Nino সেটি সেখানে বসিয়ে দিতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino isn't on the TV yet. With Developer Mode switched on, Nino can put it there."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pa si Nino sa TV. Kapag aktibo ang Developer Mode, kaya na itong ilagay ni Nino doon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी में अभी Nino इंस्टॉल नहीं हुआ। Developer Mode ऑन हो, तो Nino उसे वहाँ डाल सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino belum ada di TV. Selama Developer Mode aktif, Nino bisa memasangnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino belum ada pada TV. Apabila Developer Mode hidup, Nino boleh memasangnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino staat nog niet op je tv. Zodra Developer Mode aanstaat, kan Nino hem installeren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวียังไม่มี Nino หาก Developer Mode ทำงานอยู่ Nino จะลงแอปให้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV uygulaması yüklü değil. Geliştirici modu açıldığında Nino onu yükleyebilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی میں ابھی Nino موجود نہیں۔ جب Developer Mode چالو ہو، Nino اسے وہاں پہنچا سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV chưa có Nino. Khi bật Developer Mode rồi, Nino cài được app lên đó."
          }
        }
      }
    },
    "setup.tvApp.lg.passphraseHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على التلفاز افتح Developer Mode، وفعّل منه Key Server، واترك تلك الشاشة ظاهرة. ثم أدخل في الأسفل عبارة المرور (Passphrase) الظاهرة هناك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র পর্দায় Developer Mode চালিয়ে Key Server অন করুন, আর ওই স্ক্রিনটি খোলা রাখুন। সেখানে দেখানো Passphrase নিচে লিখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your TV, launch Developer Mode, switch Key Server on, and leave that screen showing. Enter the Passphrase you see there below."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa TV mo, ilunsad ang Developer Mode, gawing On itong Key Server, at hayaang nakabukas ang screen na iyon. Ilagay sa ibaba ang Passphrase na makikita mo roon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी पर Developer Mode खोलें, Key Server को ऑन करें और वही स्क्रीन खुली छोड़ दें। वहाँ जो Passphrase दिखे, उसे नीचे भरें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di TV, jalankan Developer Mode, nyalakan Key Server, lalu jangan tutup layar itu. Ketik Passphrase yang tertera di sana pada kolom di bawah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di TV, lancarkan Developer Mode, tukar Key Server kepada aktif, dan jangan tutup skrin itu. Isikan Passphrase yang terpapar di situ pada ruangan di bawah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Developer Mode op je tv, schakel Key Server in en laat dat scherm openstaan. Vul hieronder de Passphrase in die je daar ziet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนทีวีให้รัน Developer Mode สลับ Key Server ไปที่เปิด และค้างหน้านั้นไว้ นำ Passphrase ที่ขึ้นตรงนั้นมากรอกในช่องข้างล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nizde Developer Mode uygulamasını başlatın, Key Server seçeneğini açın ve uygulama ekranda açık kalsın. Orada görünen Passphrase'i aşağıya girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی پر Developer Mode چلائیں، Key Server کا سوئچ چالو کر کے وہ اسکرین کھلی رہنے دیں۔ وہاں دکھنے والا Passphrase نیچے لکھ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên TV, mở Developer Mode, bật Key Server rồi để nguyên màn hình đó. Gõ Passphrase đang hiện trên TV vào ô bên dưới."
          }
        }
      }
    },
    "setup.tvApp.lg.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. سجّل في webostv.developer.lge.com حساب مطوّر، وهو بلا مقابل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "1. বিনামূল্যে একটি ডেভেলপার অ্যাকাউন্ট খুলুন, ঠিকানা: webostv.developer.lge.com"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Make a free developer account on webostv.developer.lge.com."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Magbukas ng developer account nang libre: webostv.developer.lge.com."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. मुफ़्त डेवलपर अकाउंट बनाने के लिए webostv.developer.lge.com खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Daftar akun developer tanpa biaya lewat webostv.developer.lge.com."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Buat akaun pembangun secara percuma menerusi webostv.developer.lge.com."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Maak gratis een ontwikkelaarsaccount via de site webostv.developer.lge.com."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1. สมัครบัญชีนักพัฒนาแบบฟรี (webostv.developer.lge.com)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ücretsiz bir hesap için webostv.developer.lge.com adresine kaydolun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ایک مفت ڈویلپر اکاؤنٹ بنائیں، اس ویب سائٹ پر: webostv.developer.lge.com"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Lập một tài khoản developer free ở trang webostv.developer.lge.com."
          }
        }
      }
    },
    "setup.tvApp.lg.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. نزّل على التلفاز تطبيق Developer Mode عبر LG Content Store، وادخل بحسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "2. LG Content Store খুলে Developer Mode অ্যাপটি TV-র জন্য নামান, তারপর লগ ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. On your TV, download Developer Mode from LG Content Store, then log in."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Sa TV mo, i-download itong Developer Mode mula LG Content Store, tapos pumasok sa account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. LG Content Store खोलकर Developer Mode ऐप टीवी पर डाउनलोड करें, फिर उसमें लॉग इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Di TV, ambil aplikasi Developer Mode lewat LG Content Store, lalu login."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Di TV, cari Developer Mode dalam LG Content Store lalu muat turun, kemudian masuk ke akaun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Installeer Developer Mode op je tv via LG Content Store; log daarna in die app in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2. เปิด LG Content Store บนทีวี โหลดแอป Developer Mode มาลง แล้วล็อกอิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. TV'nizde LG Content Store üzerinden Developer Mode'u yükleyin ve hesabınızla oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ٹی وی میں Developer Mode ایپ ڈاؤن لوڈ کریں (یہ LG Content Store میں ملتی ہے)، پھر لاگ ان ہو جائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Trên TV, vào LG Content Store tải Developer Mode, sau đó đăng nhập."
          }
        }
      }
    },
    "setup.tvApp.lg.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3. شغّل خيار Dev Mode Status. بعدها يُعيد التلفاز تشغيل نفسه، ويكمل Nino هنا تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "3. এবার Dev Mode Status অন করে দিন। এতে TV নতুন করে চালু হবে, আর Nino এখানে আপনা থেকেই পরের ধাপে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Switch Dev Mode Status on. Your TV restarts, and Nino continues here automatically."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Gawing On itong Dev Mode Status. Pagkatapos mag-restart ng TV mo, kusang magpapatuloy si Nino dito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. अब Dev Mode Status ऑन करें। टीवी दोबारा चालू होगा और Nino यहाँ अपने-आप आगे का काम करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Nyalakan Dev Mode Status. Setelah TV restart, Nino otomatis melanjutkan di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Tukar Dev Mode Status kepada aktif. TV anda bermula semula, dan Nino menyambung langkah di sini secara automatik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Schakel Dev Mode Status in. Je tv herstart en Nino gaat hier vanzelf verder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "3. สลับ Dev Mode Status ไปที่เปิด ทีวีจะรีสตาร์ต และ Nino จะทำต่อในหน้านี้เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Son olarak Dev Mode Status seçeneğini etkinleştirin. TV kapanıp açılır; Nino burada kendiliğinden ilerler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "3. اب Dev Mode Status کا سوئچ چالو کریں۔ ٹی وی ری اسٹارٹ ہو گا اور Nino یہاں اپنے آپ آگے چلے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Mở Dev Mode Status. Lúc đó TV sẽ tự khởi động lại, sau đó Nino tự làm tiếp ở đây."
          }
        }
      }
    },
    "setup.tvApp.ready %@": {

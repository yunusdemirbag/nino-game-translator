    "console.psn.error.incomplete": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول لم يتم. حاول مرة أخرى من فضلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লগ ইন পুরো হয়নি। দয়া করে আরেকবার করে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in didn't finish. Please try once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudlot ang pag-log in. Pakisubukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन अधूरा रह गया। एक दफ़ा और आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses login belum selesai. Silakan coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses log masuk belum selesai. Cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aanmelden is niet afgerond. Probeer het nog een keer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อไม่เสร็จสิ้น ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş tamamlanamadı. Lütfen bir kez daha deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن ان پورا نہ ہو سکا۔ ایک بار اور آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập chưa xong. Hãy thử thêm lần nữa."
          }
        }
      }
    },
    "console.psn.error.manualInvalid": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرف الحساب هذا لا يبدو صحيحا. يجب أن يتكون من 12 حرفا بترميز base64، مثل AbCdEfGhIjk=."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "account ID-টা ঠিক লাগছে না। এতে ১২টা base64 অক্ষর থাকার কথা, যেমন AbCdEfGhIjk=।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That account ID doesn't look right. It should be 12 base64 characters, like AbCdEfGhIjk=."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang mali ang account ID na iyan. Dapat 12 base64 na karakter ito, gaya ng AbCdEfGhIjk=."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह account ID सही नहीं लगती। इसमें 12 base64 अक्षर हों, मसलन AbCdEfGhIjk=।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak tampak seperti ID akun yang valid. ID terdiri dari 12 karakter base64 (misalnya AbCdEfGhIjk=)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "ID akaun itu nampaknya tidak betul. Ia sepatutnya 12 aksara base64, seperti AbCdEfGhIjk=."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die account-ID lijkt niet te kloppen. Hij hoort uit 12 base64-tekens te bestaan, zoals AbCdEfGhIjk=."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ID ของบัญชีดูผิดรูปแบบ ควรเป็นอักขระ base64 ยาว 12 ตัว เช่น AbCdEfGhIjk="
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kimlik geçerli görünmüyor. Hesap kimliği base64 ile yazılmış 12 karakterdir (örnek: AbCdEfGhIjk=)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اکاؤنٹ ID ٹھیک نہیں لگتی۔ اس میں base64 کے 12 حروف ہونے چاہییں، مثلاً AbCdEfGhIjk=۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ID tài khoản đó trông không đúng. Cần đúng 12 ký tự dạng base64, chẳng hạn AbCdEfGhIjk=."
          }
        }
      }
    },
    "console.psn.error.network": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Nino من بلوغ صفحة الدخول في PlayStation. تأكد أنك متصل بالإنترنت، ثم أعد تسجيل الدخول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino, PlayStation-এর লগ ইন পাতা অবধি যেতে পারল না। নেট কানেকশন মিলিয়ে দেখে ফের লগ ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino couldn't get through to the PlayStation sign-in page. Make sure you're online, then sign in once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makakonekta ang Nino sa login page ng PlayStation. Siguraduhing online ka, at mag-log in muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino, PlayStation वाला लॉगिन पन्ना खोल न सका। नेट चालू है, यह जाँचकर एक दफ़ा और लॉगिन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak bisa menjangkau halaman login PlayStation. Pastikan Anda online, lalu login sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak dapat mencapai halaman log masuk PlayStation. Pastikan anda dalam talian, kemudian log masuk sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino kreeg geen verbinding met de aanmeldpagina van PlayStation. Kijk of je online bent en meld je opnieuw aan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ติดต่อหน้าลงชื่อของ PlayStation ไม่ได้ ตรวจว่าออนไลน์อยู่ แล้วลงชื่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino, PlayStation giriş sayfasına bağlanamadı. Çevrimiçi olduğunuzdan emin olup bir kez daha oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino، PlayStation کے سائن ان صفحے سے رابطہ نہ کر سکا۔ انٹرنیٹ چلتا ہو تو ایک بار اور سائن ان ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino không kết nối tới trang đăng nhập PlayStation được. Kiểm tra mạng rồi thử đăng nhập lần nữa."
          }
        }
      }
    },
    "console.psn.error.pageFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر فتح صفحة الدخول في PlayStation. تأكد أنك متصل بالإنترنت، ثم أعد تسجيل الدخول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation-এর লগ ইন পাতা খুলল না। নেট কানেকশন মিলিয়ে দেখে ফের লগ ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PlayStation sign-in page didn't open. Make sure you're online, then sign in once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nagbukas ang login page ng PlayStation. Siguraduhing online ka, at mag-log in muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation वाला लॉगिन पन्ना खुल न सका। नेट चालू है, यह जाँचकर एक दफ़ा और लॉगिन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman login PlayStation gagal terbuka. Pastikan Anda online, lalu login sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman log masuk PlayStation tidak terbuka. Pastikan anda dalam talian, kemudian log masuk sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmeldpagina van PlayStation ging niet open. Kijk of je online bent en meld je opnieuw aan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าลงชื่อของ PlayStation ไม่เปิด ตรวจว่าออนไลน์อยู่ แล้วลงชื่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation giriş sayfası yüklenmedi. Çevrimiçi olduğunuzdan emin olup bir kez daha oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation کا لاگ ان صفحہ نہیں کھلا۔ انٹرنیٹ چلتا ہو تو ایک بار اور سائن ان ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang đăng nhập PlayStation không mở ra. Kiểm tra mạng rồi thử đăng nhập lần nữa."
          }
        }
      }
    },
    "console.psn.error.rejected": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف تسجيل الدخول إلى PlayStation في منتصفه. انتظر لحظة، ثم اضغط زر تسجيل الدخول مرة أخرى باستخدام حسابك الثاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation-এ লগ ইন মাঝপথে থেমে গেল। খানিক সবুর করে বাড়তি account-টি দিয়ে ফের Sign in টিপুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PlayStation sign-in stopped halfway. Wait a moment, then tap Sign in once more using your second account."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudlot sa gitna ang pag-log in sa PlayStation. Maghintay nang sandali, at i-tap muli ang Sign in, sa pangalawa mong account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation लॉगिन आधे में थम गया। ज़रा ठहरें, फिर दूसरे खाते के साथ Sign in एक दफ़ा और दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Login PlayStation terhenti di tengah jalan. Tunggu sebentar, lalu ketuk Masuk lagi memakai akun kedua Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony tidak menyelesaikan daftar masuk. Tunggu seminit, tekan Daftar masuk sekali lagi dan gunakan akaun kedua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aanmelden bij PlayStation is halverwege gestopt. Wacht even en tik dan nogmaals op Aanmelden, nu met het tweede PSN-account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อ PlayStation หยุดกลางทาง รอสักครู่ แล้วแตะ Sign in อีกรอบโดยใช้บัญชีที่สองของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony girişi bitirmedi. Bir dakika bekleyin, Giriş Yap'a yeniden basın ve ikinci hesabı kullanın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation سائن ان آدھے راستے میں رک گیا۔ ذرا ٹھہریں، پھر دوسرا اکاؤنٹ استعمال کرتے ہوئے ایک بار اور Sign in پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập PlayStation bị ngắt giữa chừng. Đợi một lát, rồi chạm Đăng nhập lần nữa với tài khoản phụ."
          }
        }
      }
    },
    "console.psn.error.server": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقع خطأ في صفحة الدخول إلى PlayStation. انتظر قليلا ثم أعد تسجيل الدخول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation-এর লগ ইন পাতায় কিছু একটা গড়বড় হয়েছে। খানিক পরে ফের লগ ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on the PlayStation sign-in page. Wait a little, then sign in once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagka-error sa login page ng PlayStation. Maghintay nang kaunti, at mag-log in muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation वाले लॉगिन पन्ने पर कुछ बिगड़ गया। ज़रा ठहरें, फिर एक दफ़ा और लॉगिन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada masalah di halaman login PlayStation. Tunggu sebentar, lalu login sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku masalah pada halaman log masuk PlayStation. Tunggu sebentar, kemudian log masuk sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de aanmeldpagina van PlayStation liep iets fout. Wacht even en meld je opnieuw aan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าลงชื่อของ PlayStation มีปัญหา รอสักพัก แล้วลงชื่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation giriş sayfasında bir hata oluştu. Biraz bekleyip bir kez daha oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation کے سائن ان صفحے پر کوئی خرابی ہوئی۔ تھوڑا انتظار کریں، پھر ایک بار اور سائن ان ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang đăng nhập PlayStation gặp sự cố. Đợi chút rồi thử đăng nhập lần nữa."
          }
        }
      }
    },
    "console.psn.error.tooManyAttempts": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوزت عدد محاولات الدخول المسموح. أعد المحاولة بعد نحو 15 دقيقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেকবার লগ ইন করতে গিয়ে আটকে গেছেন। মোটামুটি পনেরো মিনিট পেরোলে আরেকবার করে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts to sign in. Try once more after roughly 15 minutes."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrang dami ng pagtatangkang mag-log in. Subukang muli makalipas ang mga 15 minuto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन के प्रयास हद से पार हो गए। करीब पंद्रह मिनट ठहरकर एक दफ़ा और आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percobaan login. Coba lagi setelah kira-kira 15 menit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percubaan log masuk terlalu banyak. Cuba sekali lagi selepas lebih kurang 15 minit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel aanmeldpogingen. Probeer het over ongeveer 15 minuten nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยายามลงชื่อหลายครั้งเกินไป ลองใหม่ในอีกราว 15 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik çok fazla oturum açma denemesi yapıldı. Yaklaşık 15 dakika geçince yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن ان کی کوششیں حد سے بڑھ گئیں۔ لگ بھگ 15 منٹ ٹھہر کر پھر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã thử đăng nhập quá nhiều lần. Khoảng 15 phút nữa hãy thử lại."
          }
        }
      }
    },
    "console.psn.error.unreadable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يفهم Nino رد PlayStation. سجل الدخول مجددا، وإن تكرر الأمر فثبت أحدث إصدار من Nino."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation-এর জবাব Nino বুঝতে পারল না। ফের লগ ইন করুন, আর একই সমস্যা ফিরে এলে সবচেয়ে নতুন Nino নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino didn't understand the reply from PlayStation. Sign in once more; if it happens again, get the latest Nino."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naintindihan ng Nino ang sagot mula sa PlayStation. Mag-log in muli; kapag naulit, mag-update sa pinakahuling Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation का जवाब Nino समझ न सका। एक दफ़ा और लॉगिन करें; ऐसा फिर हुआ, तो Nino का ताज़ा संस्करण लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak memahami balasan dari PlayStation. Login sekali lagi; jika terulang, perbarui Nino ke versi terbaru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak memahami balasan daripada PlayStation. Log masuk sekali lagi; jika berulang, dapatkan Nino terkini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino begreep het antwoord van PlayStation niet. Meld je opnieuw aan; gebeurt het weer, installeer dan de nieuwste Nino."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ไม่เข้าใจคำตอบจาก PlayStation ลงชื่ออีกครั้ง ถ้ายังเป็นอีก ให้อัปเดต Nino เป็นรุ่นล่าสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino, Sony'nin cevabını anlayamadı. Yeniden giriş yapın; tekrarlarsa Nino'yu güncelleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کو PlayStation کا جواب سمجھ نہیں آیا۔ ایک بار اور سائن ان ہوں؛ دوبارہ ایسا ہو تو Nino کا تازہ ورژن لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino không hiểu phản hồi từ PlayStation. Thử đăng nhập lần nữa; nếu lỗi lặp lại, nâng Nino lên bản mới nhất."
          }
        }
      }
    },
    "console.psn.error.windowClosed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلقت النافذة قبل اكتمال تسجيل الدخول. اضغط «تسجيل الدخول» مرة أخرى وأكمل في النافذة التي تُفتح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লগ ইন সারার আগে উইন্ডোটা আপনি বন্ধ করে ফেলেছেন। Sign in টিপে গোড়া থেকে ধরুন, আর নতুন উইন্ডোয় কাজটা সেরে ফেলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You closed the window before signing in finished. Tap Sign in to start over, and complete it in the new window."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naisara mo ang window bago matapos mag-log in. I-tap ang Sign in para magsimula ulit, at tapusin ito sa bagong window."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन बीच में था, तभी आपने खिड़की बंद कर डाली। शुरू से करने को Sign in दबाएँ, और नई खिड़की में लॉगिन ख़त्म करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda menutup jendela sebelum login selesai. Ketuk Masuk untuk memulai dari awal, lalu selesaikan di jendela yang baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetingkap ditutup sebelum daftar masuk selesai. Tekan Daftar masuk sekali lagi dan selesaikannya dalam tetingkap yang dibuka."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sloot het venster voordat het aanmelden klaar was. Tik op Aanmelden om opnieuw te beginnen en rond het af in het nieuwe venster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณปิดหน้าต่างก่อนลงชื่อเสร็จ แตะ Sign in เพื่อเริ่มใหม่ และทำให้เสร็จในหน้าต่างใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş bitmeden pencere kapatıldı. Giriş Yap'a yeniden basıp girişi açılan pencerede bitirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن ان پورا ہونے سے قبل آپ نے ونڈو بند کر دی۔ نئے سرے سے آغاز کے لیے Sign in پر ٹیپ کریں اور نئی ونڈو میں عمل پورا کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đóng cửa sổ khi đăng nhập chưa xong. Chạm Đăng nhập để làm lại, rồi hoàn tất trong cửa sổ mới."
          }
        }
      }
    }
  },
  "version": "1.0"
}

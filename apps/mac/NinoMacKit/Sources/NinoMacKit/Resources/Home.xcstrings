    "home.window.screenRecordingDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على Nino أن يحصل على إذن تسجيل الشاشة. فعّله عبر: إعدادات النظام › الخصوصية والأمن › تسجيل الشاشة، وبعدها أغلق Nino وافتحه من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino-কে পর্দা রেকর্ড করতে দেওয়া চাই। পথটি: System Settings › Privacy & Security › Screen Recording; সেখানে অন করে নিন, এরপর Nino পুনরায় খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino needs screen recording access. Turn it on under System Settings › Privacy & Security › Screen Recording and reopen Nino."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ni Nino na mai-record ang screen. Payagan ito (System Settings › Privacy & Security › Screen Recording), at muling buksan si Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परदा देख पाने को Nino को इजाज़त दें: System Settings › Privacy & Security › Screen Recording में इसे ऑन करें और Nino को छोड़कर पुनः खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino memerlukan izin perekaman layar. Hidupkan izinnya lewat Pengaturan Sistem › Privasi & Keamanan › Perekaman Layar, kemudian jalankan ulang Nino."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Nino merakam skrin: Tetapan Sistem › Privasi & Keselamatan › Rakaman Skrin. Kemudian buka Nino semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino heeft toegang tot schermopname nodig. Zet die aan via Systeeminstellingen › Privacy en beveiliging › Schermopname. Open Nino vervolgens opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ต้องใช้สิทธิ์บันทึกหน้าจอ เปิดได้ที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › การบันทึกหน้าจอ จากนั้นออกจาก Nino และเปิดขึ้นมาอีกรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun ekran kaydı iznine ihtiyacı var. Sistem Ayarları › Gizlilik ve Güvenlik › Ekran Kaydı bölümünde Nino'yu açın, ardından uygulamayı kapatıp yeniden başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کو اسکرین ریکارڈ کرنے کی اجازت چاہیے۔ System Settings › Privacy & Security › Screen Recording کے اندر اسے آن کیجیے، پھر Nino بند کر کے دوبارہ کھولیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino cần quyền quay màn hình. Bật quyền đó (Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Ghi màn hình), xong mở lại Nino."
          }
        }
      }
    },
    "home.window.searching": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل chiaki-ng (ويصلح PS Remote Play كذلك) وابدأ اللعب"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "chiaki-ng চালু করে দিন (PS Remote Play হলেও চলবে), এরপর খেলায় নেমে পড়ুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch chiaki-ng (PS Remote Play works too) and begin playing"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Patakbuhin ang chiaki-ng (o kaya PS Remote Play), saka maglaro"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "chiaki-ng चलाएँ (PS Remote Play भी ठीक है), फिर खेल शुरू करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan chiaki-ng (PS Remote Play juga bisa), lalu mulailah bermain"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancarkan chiaki-ng (PS Remote Play pun boleh), kemudian mula bermain"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start chiaki-ng (PS Remote Play kan ook) en ga spelen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด chiaki-ng (แอป PS Remote Play ก็ใช้แทนได้) แล้วลงมือเล่นเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "chiaki-ng'yi veya PS Remote Play uygulamasını çalıştırıp oyuna girin"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "chiaki-ng کھولیے (PS Remote Play بھی چلے گا) اور کھیل شروع کیجیے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",

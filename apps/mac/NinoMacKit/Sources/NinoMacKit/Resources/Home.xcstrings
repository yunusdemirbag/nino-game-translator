    "home.drop.network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن بلوغ PS5. يُعاد الربط…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর নাগাল মিলছে না। ফের জুড়ছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 can't be reached. Reconnecting…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang sagot mula sa PS5. Muling kumokonekta…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 तक पहुँच नहीं बन रही। पुनः जुड़ने की कोशिश…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak dapat dijangkau. Menghubungkan ulang…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak dapat dihubungi. Menyambung semula…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verbinding met de PS5. Nino probeert het opnieuw…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึง PS5 ไม่สำเร็จ ระบบกำลังลองต่อใหม่…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 yanıt vermiyor. Bağlantı yeniden kuruluyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 تک رسائی ممکن نہیں۔ دوبارہ کنکشن بن رہا ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không liên lạc được với PS5. Đang nối lại…"
          }
        }
      }
    },
    "home.drop.noPicture": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تأتي صورة من PS5. ربما عُطّل Remote Play أو دخل الجهاز في السكون. ألقِ نظرة وابدأ من البداية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর দিক থেকে ছবি আসছে না। হয়তো Remote Play অফ, বা কনসোল ঘুমে আছে। একবার মিলিয়ে নিয়ে নতুন করে আরম্ভ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 isn't sending a picture. Remote Play could be switched off, or the console could be asleep. Have a look and start over."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang larawang ipinapadala ang PS5. Posibleng naka-disable ang Remote Play nito, o natutulog ang console. Silipin ito at umpisahan muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 से चित्र नहीं आ रहा। शायद Remote Play ऑफ़ है या कंसोल सो रहा है। जाँचकर नए सिरे से आरंभ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 belum mengirim gambar. Mungkin Remote Play mati, atau konsol sedang tidur. Coba cek, kemudian ulangi dari awal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak menghantar imej. Mungkin Remote Play telah ditutup, atau konsol sedang tidur. Periksa dahulu, kemudian mula dari awal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er komt geen beeld binnen van de PS5. Mogelijk is Remote Play uitgeschakeld of slaapt de console. Kijk het na en begin opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่ส่งภาพมา อาจเป็นเพราะ Remote Play ถูกปิด หรือคอนโซลหลับอยู่ ลองดูอีกทีแล้วเริ่มต้นใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'ten görüntü gelmiyor. Uzaktan Oynatma kapatılmış ya da konsol dinlenme modunda olabilir. Bir göz atıp baştan başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 سے تصویر نہیں آ رہی۔ ممکن ہے Remote Play بند ہو یا کنسول سو رہا ہو۔ ایک نظر ڈال کر از سرِ نو آغاز کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 chưa gửi hình về. Có thể Remote Play bị tắt hoặc máy đang ngủ. Hãy xem lại rồi làm lại từ đầu."
          }
        }
      }
    },
    "home.drop.notFound %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد PS5 عند %@. تأكّد أن الجهاز يعمل ومتصل بشبكة جهاز Mac ذاتها. نحاول مجددًا…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ PS5 মেলেনি। কনসোলটি অন আছে তো, আর এই Mac-এর নেটেই জুড়ে আছে তো? মিলিয়ে নিন। ফের খোঁজ চলছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find a PS5 at %@. Check that it's turned on and connected to the network this Mac uses. Trying again…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakitang PS5 sa %@. Tiyaking bukas ito at konektado sa network na gamit ng iyong Mac. Sinusubukan ulit…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर PS5 मिल न सका। जाँचें कि PS5 ऑन है, साथ ही उसी राउटर पर है जिस पर यह Mac है। प्रयास जारी है…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tak ditemukan di %@. Pastikan konsol hidup dan memakai jaringan yang juga dipakai Mac ini. Mencoba ulang…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak dijumpai pada %@. Periksa bahawa konsol hidup dan berada di rangkaian yang digunakan Mac ini. Mencuba sekali lagi…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op %@ is geen PS5 te vinden. Kijk of die aanstaat en hetzelfde netwerk gebruikt als deze Mac. Nieuwe poging…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หา PS5 ที่ %@ ไม่เจอ ดูว่าเครื่องเปิดอยู่และอยู่บนเน็ตวงเดียวกันกับ Mac ตัวนี้ ระบบกำลังลองซ้ำ…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresinde PS5 yok. Konsolun çalıştığını ve bu Mac'in ağına bağlı olduğunu kontrol edin. Tekrar bağlanmaya çalışılıyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ والے پتے پر PS5 نہ ملا۔ تسلی کیجیے کہ وہ آن ہو اور اس نیٹ ورک سے منسلک ہو جس پر یہ Mac ہے۔ Nino پھر کوشش میں ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm ra PS5 ở %@. Xem máy đã mở chưa và có chung mạng với chiếc Mac này không. Đang dò lại…"
          }
        }
      }
    },
    "home.drop.other": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعاد الربط…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফের জুড়ছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting again…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumokonekta ulit…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनः जुड़ रहे हैं…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyambung ulang…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba sambung lagi…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding herstellen…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อใหม่อีกรอบ…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden bağlanılıyor…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ کنکشن بن رہا ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang nối lại…"
          }
        }
      }
    },

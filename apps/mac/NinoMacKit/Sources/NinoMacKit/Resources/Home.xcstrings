    "home.packOffer.message %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج المترجم المدمج في هذا الـ Mac إلى حزمة %1$@ → %2$@. افتح إعدادات النظام › عام › اللغة والمنطقة › لغات الترجمة ونزّلها. وحتى ذلك الحين يواصل Nino الترجمة من مصادره الأخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এর নিজের অনুবাদকের জন্য %1$@ → %2$@ প্যাক লাগবে। সিস্টেম সেটিংস › সাধারণ › ভাষা ও অঞ্চল › অনুবাদের ভাষা খুলে ডাউনলোড করুন। ততক্ষণ Nino অন্য উৎস দিয়ে অনুবাদ চালিয়ে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To translate by itself, this Mac needs the %1$@ → %2$@ pack. Get it from System Settings › General › Language & Region › Translation Languages. Meanwhile Nino keeps translating from its other sources."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng sariling tagasalin ng Mac na ito ang %1$@ → %2$@ pack. Buksan ang System Settings › General › Language & Region › Translation Languages at i-download ito. Habang wala pa, patuloy na magsasalin si Nino gamit ang ibang pinagmumulan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac के अपने अनुवादक को %1$@ → %2$@ पैक चाहिए। सिस्टम सेटिंग्स › सामान्य › भाषा और क्षेत्र › अनुवाद भाषाएँ खोलकर उसे डाउनलोड करें। तब तक Nino दूसरे स्रोतों से अनुवाद करता रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerjemah bawaan Mac ini butuh paket %1$@ → %2$@. Buka Pengaturan Sistem › Umum › Bahasa & Wilayah › Bahasa Terjemahan lalu unduh. Sampai saat itu, Nino tetap menerjemahkan dari sumber lainnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penterjemah Mac ini sendiri memerlukan pek %1$@ → %2$@. Buka Tetapan Sistem › Umum › Bahasa & Rantau › Bahasa Terjemahan dan muat turun. Sementara itu, Nino terus menterjemah daripada sumber lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eigen vertaler van deze Mac heeft het pakket %1$@ → %2$@ nodig. Open Systeeminstellingen › Algemeen › Taal en regio › Vertaaltalen en download het. Tot dan blijft Nino vertalen via zijn andere bronnen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวแปลของ Mac เครื่องนี้ต้องใช้แพ็ก %1$@ → %2$@ เปิด การตั้งค่าระบบ › ทั่วไป › ภาษาและภูมิภาค › ภาษาสำหรับการแปล แล้วดาวน์โหลด ระหว่างนี้ Nino จะแปลต่อจากแหล่งอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in kendi başına çevirebilmesi için %1$@ → %2$@ paketi gerekiyor. Sistem Ayarları › Genel › Dil ve Bölge › Çeviri Dilleri bölümünden indirebilirsiniz. Bu arada Nino öteki kaynaklarıyla çevirmeyi sürdürür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac کے اپنے مترجم کو %1$@ → %2$@ پیک چاہیے۔ سسٹم سیٹنگز › عمومی › زبان اور علاقہ › ترجمے کی زبانیں کھول کر اسے ڈاؤن لوڈ کریں۔ تب تک Nino دوسرے ذرائع سے ترجمہ جاری رکھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình dịch sẵn có của máy Mac này cần gói %1$@ → %2$@. Mở Cài đặt hệ thống › Cài đặt chung › Ngôn ngữ & Vùng › Ngôn ngữ dịch rồi tải về. Trong lúc đó, Nino vẫn dịch bằng các nguồn khác."
          }
        }
      }
    },

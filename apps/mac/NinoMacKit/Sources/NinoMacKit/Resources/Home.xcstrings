    "home.status.paired %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقترن بـ %@. سيرتبط Nino فور انطلاق الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর সঙ্গে জোড়া হলো। ভাষান্তর আরম্ভ হলেই Nino জুড়ে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired with %@. Nino connects as soon as translation begins."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakapares sa %@. Kokonekta si Nino pagsimula ng pagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से जोड़ी बन गई। भाषांतर आरंभ करते ही Nino जुड़ेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah dipasangkan dengan %@. Nino tersambung begitu terjemahan dimulai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipasangkan dengan %@. Nino akan bersambung sebaik terjemahan bermula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppeld met %@. Nino maakt verbinding zodra je gaat vertalen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino จับคู่ %@ ไว้แล้ว และจะต่อทันทีที่เริ่มแปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile eşleşti. Çeviriyi başlatınca bağlanır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سے جوڑی بن گئی۔ ترجمے کے آغاز پر Nino فوراً جڑ جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ghép với %@. Nino sẽ kết nối ngay khi bạn bật dịch."
          }
        }
      }
    },

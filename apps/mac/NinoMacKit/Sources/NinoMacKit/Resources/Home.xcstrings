    "home.keySuggestion.detail %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد لدى Nino حزمة جاهزة لـ %@. مع مفتاح تصبح الترجمة أكثر طبيعية بكثير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর জন্য Nino-তে তৈরি প্যাক নেই। একটি কি দিলে অনুবাদ অনেক বেশি স্বাভাবিক হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino has no ready pack for %@. With a key, translation reads far more naturally."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang handang pack si Nino para sa %@. Kapag may key, mas natural ang pagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए Nino में तैयार पैक नहीं है। की के साथ अनुवाद कहीं ज़्यादा स्वाभाविक लगता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino belum punya paket siap untuk %@. Dengan kunci, terjemahan jauh lebih alami."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino belum ada pek sedia untuk %@. Dengan kunci, terjemahan jauh lebih semula jadi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino heeft geen kant-en-klaar pakket voor %@. Met een sleutel leest de vertaling veel natuurlijker."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ยังไม่มีแพ็กพร้อมใช้สำหรับ %@ ถ้ามีคีย์ คำแปลจะเป็นธรรมชาติขึ้นมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için Nino'da hazır paket yok. Bir anahtarla çeviri çok daha doğal olur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کے لیے Nino کے پاس تیار پیک نہیں۔ کلید کے ساتھ ترجمہ کہیں زیادہ فطری لگتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino chưa có gói sẵn cho %@. Có khóa, bản dịch sẽ tự nhiên hơn nhiều."
          }
        }
      }
    },

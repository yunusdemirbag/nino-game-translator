    "home.warning.freeMeanwhile": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وإلى ذلك الحين، تتولّى ترجمة Nino المدمجة العمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ততক্ষণ Nino নিজেই অনুবাদ চালিয়ে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meanwhile, Nino's built-in translation steps in."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang wala pa, ang sariling pagsasalin ng Nino muna ang gagamitin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बीच Nino का अपना अनुवाद संभालेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk sementara, terjemahan bawaan Nino yang mengambil alih."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat sementara, Nino menterjemah dengan enjinnya sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot die tijd springt de ingebouwde vertaling van Nino bij."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างนี้ การแปลในตัวของ Nino จะทำงานแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arada Nino'nun kendi çevirisi devreye girer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تب تک Nino کا اپنا ترجمہ سنبھال لے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm thời, Nino sẽ tự lo phần dịch."
          }
        }
      }
    },
    "home.warning.languagePack %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تنزيل حزمة اللغة %1$@–%2$@ بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@ ভাষার প্যাকটি এখনো নামানো হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %1$@–%2$@ language pack hasn't been downloaded yet."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa na-download ang language pack na %1$@–%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ और %2$@ की भाषा-फ़ाइलें अब तक डाउनलोड न हुईं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",

    "home.warning.restartMac": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تشغيل الـ Mac، ثم ابدأ الترجمة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac একবার রিবুট দিন, এরপর নতুন করে ভাষান্তর আরম্ভ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart your Mac, then start translating again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-restart muna ang Mac, saka magsalin muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac पुनः आरंभ करें; उसके पश्चात भाषांतर एक बार और चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai ulang Mac Anda, lalu mulai menerjemahkan lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan semula Mac anda, kemudian mula menterjemah semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstart je Mac en start het vertalen opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Mac ใหม่อีกรอบ จากนั้นกลับมาแปลต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizi yeniden başlatın, ardından çeviriyi baştan başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ری اسٹارٹ کیجیے، پھر ترجمہ نئے سرے سے شروع کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho Mac khởi động lại, rồi bật dịch lần nữa."
          }
        }
      }
    },
    "home.warning.unsupported %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الـ Mac الترجمة من %1$@ إلى %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac %1$@ থেকে %2$@-এ ভাষান্তরে অক্ষম।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac can't translate from %1$@ to %2$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kayang isalin ng iyong Mac mula %1$@ papuntang %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac %1$@ से %2$@ में भाषांतर नहीं कर सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini tidak dapat menerjemahkan dari %1$@ ke %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini tidak dapat menterjemah daripada %1$@ kepada %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac kan niet vertalen van %1$@ naar %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้แปลจาก %1$@ เป็น %2$@ ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te %1$@ dilinden %2$@ diline çeviri yapılamıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Mac %1$@ سے %2$@ میں ترجمہ نہیں کر سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiếc Mac này không dịch được từ %1$@ sang %2$@."
          }
        }
      }
    },
    "home.warning.unsupportedHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه اللغة غير متوفرة بعد في ترجمة Apple على الجهاز. من الإعدادات › الترجمة، اختر «مجمّع Nino Game Translator (مجاني)»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-এর ডিভাইসের ভেতরের অনুবাদে এই ভাষা এখনো নেই। সেটিংস › অনুবাদ-এ গিয়ে “Nino Game Translator পুল (ফ্রি)” বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's on-device translation doesn't offer this language yet. Under Settings › Translation, pick “Nino Game Translator Pool (free)”."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pa ang wikang ito sa on-device na pagsasalin ng Apple. Sa Settings › Pagsasalin, piliin ang “Nino Game Translator Pool (libre)”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple के डिवाइस पर होने वाले अनुवाद में यह भाषा अभी नहीं है। सेटिंग › अनुवाद में “Nino Game Translator पूल (मुफ़्त)” चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa ini belum tersedia di terjemahan Apple pada perangkat. Buka Pengaturan › Terjemahan, lalu pilih “Pool Nino Game Translator (gratis)”."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa ini belum ada dalam terjemahan Apple pada peranti. Pergi ke Tetapan › Terjemahan dan pilih “Kumpulan Nino Game Translator (percuma)”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op het apparaat zelf kan Apple deze taal voorlopig niet vertalen. Kies onder Instellingen › Vertaling voor ‘Nino Game Translator-pool (gratis)’."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาษานี้ยังไม่มีในการแปลบนอุปกรณ์ของ Apple เปิดการตั้งค่า › การแปล จากนั้นเลือก “คลัง Nino Game Translator (ฟรี)”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dil Apple'ın cihaz içi çevirisinde henüz yok. Ayarlar › Çeviri bölümünde “Nino Game Translator Havuzu (ücretsiz)” seçeneğini kullanın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ زبان ابھی Apple کے آلے پر ہونے والے ترجمے میں شامل نہیں۔ ترتیبات › ترجمہ میں جا کر ”Nino Game Translator پول (مفت)“ منتخب کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dịch trực tiếp trên thiết bị của Apple chưa có thứ tiếng này. Mở Cài đặt › Dịch rồi chọn “Kho Nino Game Translator (miễn phí)”."
          }
        }
      }
    },
    "home.window.appMissing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُثبَّت Remote Play على جهاز Mac بعد. ثبّت PS Remote Play أولًا، أو اختر مصدرًا آخر للصورة من الإعدادات › الاتصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play এখনো এই Mac-এ বসানো নেই। আগে PS Remote Play ইনস্টল করুন, নয়তো সেটিংস › সংযোগ থেকে ছবির অন্য উৎস বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac doesn't have Remote Play yet. Install PS Remote Play first, or pick another picture source in Settings › Connection."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang Remote Play sa iyong Mac. I-install muna itong PS Remote Play bago bumalik dito, o pumili ng ibang pinagmulan ng larawan sa Settings › Koneksyon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play अभी इस Mac में नहीं है। पहले PS Remote Play इंस्टॉल करें, या सेटिंग › कनेक्शन में दृश्य का कोई दूसरा स्रोत चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini belum memiliki Remote Play. Silakan pasang PS Remote Play dulu, atau pilih sumber gambar lain di Pengaturan › Koneksi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini belum dipasangi Remote Play. Sila pasang PS Remote Play dahulu, atau pilih sumber gambar lain dalam Tetapan › Sambungan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play ontbreekt nog op deze Mac. Installeer eerst PS Remote Play op deze Mac, of kies een andere beeldbron bij Instellingen › Verbinding."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ตัวนี้ยังไม่มี Remote Play ให้ลง PS Remote Play ก่อน หรือเลือกแหล่งภาพอื่นในส่วนการตั้งค่า › เชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play bu Mac'te yüklü değil. Önce PS Remote Play uygulamasını kurun ya da Ayarlar › Bağlantı bölümünden başka bir görüntü kaynağı seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac میں Remote Play ابھی نہیں ہے۔ پہلے PS Remote Play انسٹال کیجیے، یا ترتیبات › کنکشن میں تصویر کا کوئی اور ذریعہ چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac này chưa có Remote Play. Hãy cài đặt PS Remote Play cho Mac trước, hoặc chọn nguồn hình khác trong Cài đặt › Kết nối."
          }
        }
      }
    },

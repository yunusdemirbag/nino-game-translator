    "home.switch.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Nino الترجمات الإنجليزية على PS5 ويعرضها على التلفاز بالعربية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino PS5 থেকে ইংলিশ উপশিরোনাম তুলে আনে, আর TV-তে সেটাই ফোটে তুর্কি অক্ষরে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino takes the English subtitles from your PS5 and puts a Turkish version on your TV."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinukuha ni Nino ang Ingles na subtitle mula sa PS5 mo at inilalabas sa TV ang bersyong Turkish."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino आपके PS5 से English सबटाइटल उठाकर आपके टीवी पर उनका तुर्की अवतार रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino membaca subtitle Inggris dari PS5 Anda, lalu menampilkan versi Turkinya di TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino mengambil sari kata Inggeris daripada PS5 lalu menayangkan versi Turkinya pada TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino neemt de Engelstalige ondertitels over van je PS5 en zet er een Turkse versie van op je tv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ดึงคำบรรยายอังกฤษจาก PS5 แล้วนำฉบับภาษาตุรกีขึ้นจอทีวีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino, PS5'inizdeki İngilizce altyazıyı alır ve Türkçesini TV'nizde gösterir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino، PS5 سے انگریزی سب ٹائٹل اٹھا کر ٹی وی پر ان کا ترکی روپ دکھاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino lấy phần phụ đề bằng tiếng Anh từ PS5 rồi hiện câu đã dịch sang tiếng Thổ trên TV."
          }
        }
      }
    },

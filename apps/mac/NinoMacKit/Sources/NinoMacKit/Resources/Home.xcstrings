    "home.overlay.instructions": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحبها لتحريكها، واسحب حوافها لتغيير حجمها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টেনে জায়গা বদলান; ধার ধরে টেনে মাপ বাড়ান-কমান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move it; pull an edge to change its size."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilahin para ilipat; hatakin ang gilid para palakihin o paliitin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खींचकर खिसकाएँ; आकार बदलने को कोई किनारा खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk memindah; tarik salah satu tepi untuk mengatur ukurannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk mengalihkannya, seret pinggirnya untuk mengubah saiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te verschuiven; trek aan een rand voor een andere grootte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อย้าย ดึงขอบเพื่อปรับขนาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükleyerek taşıyın, kenarlarından çekerek boyutlandırın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہٹانے کے لیے گھسیٹیے؛ سائز بدلنے کو کنارہ کھینچیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để dời khung; kéo một cạnh để đổi cỡ."
          }
        }
      }
    },

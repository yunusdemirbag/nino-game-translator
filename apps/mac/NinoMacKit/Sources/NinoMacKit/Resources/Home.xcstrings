    "home.warning.cantRead": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعجز macOS عن قراءة نص الشاشة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS পর্দার লেখা চিনতে পারছে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is unable to read the screen text."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kayang basahin ng macOS ang teksto sa screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS परदे के अक्षर पढ़ नहीं पा रहा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gagal membaca tulisan di layar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gagal membaca tulisan pada skrin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS krijgt de schermtekst niet gelezen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS อ่านตัวหนังสือบนจอไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ekrandaki yazıları okuyamıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS اسکرین پر موجود متن نہیں پڑھ پا رہا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chưa thể đọc chữ ở màn hình."
          }
        }
      }
    },
    "home.warning.diskFull %.1f": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القرص يكاد يمتلئ (بقي %.1f غيغابايت). لكي يتعرّف macOS على النص فهو يحتاج مساحة فارغة — أفرغ عدة غيغابايت ثم ابدأ الترجمة ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিস্কে আর জায়গা প্রায় নেই (%.1f GB বাকি)। লেখা চিনতে macOS-এর ডিস্কে জায়গা চাই — কয়েক GB ফাঁকা করে ফের ভাষান্তর আরম্ভ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your disk is nearly full (%.1f GB left). macOS needs room on disk for text recognition — clear several GB and begin translating once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Malapit nang mapuno ang disk mo (%.1f GB ang natitira). Nangangailangan ang macOS ng puwang para makilala ang teksto — magbura ng ilang GB, saka magsalin muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac की स्टोरेज लगभग भरी है (बचे %.1f GB)। लेख पहचानने को macOS को स्टोरेज में ठीक-ठाक जगह लगती है — कई GB हटाएँ, फिर भाषांतर दोबारा आरंभ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang disk hampir habis (sisa %.1f GB). Agar macOS bisa mengenali teks, disk perlu cukup lega — bebaskan beberapa GB, lalu mulai terjemahan sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cakera anda hampir penuh (tinggal %.1f GB). macOS perlukan ruang cakera untuk mengecam teks — bebaskan beberapa GB, lalu mula terjemah semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je schijf raakt vol (nog %.1f GB). Voor tekstherkenning heeft macOS schijfruimte nodig — ruim enkele GB op en vertaal daarna opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดิสก์ใกล้จะเต็ม (เหลือ %.1f GB) การอ่านตัวหนังสือของ macOS ต้องใช้ที่ว่างบนดิสก์ ลบไฟล์ออกสักหลาย GB แล้วเริ่มแปลใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskte neredeyse hiç yer yok (%.1f GB kaldı). macOS'un metni tanıyabilmesi için diskte yer olmalı; birkaç GB boşaltıp çeviriyi baştan başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈسک تقریباً بھر چکی ہے (%.1f GB باقی)۔ متن کی پہچان کو macOS ڈسک پر جگہ مانگتا ہے — کئی GB خالی کر کے ترجمہ ایک بار پھر شروع کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa gần hết chỗ (còn %.1f GB). Để nhận dạng chữ, macOS phải có khoảng trống trên ổ — xóa bớt vài GB rồi dịch lại từ đầu."
          }
        }
      }
    },

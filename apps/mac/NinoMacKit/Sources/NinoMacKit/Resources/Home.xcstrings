          }
        }
      }
    },
    "home.window.searchingXbox": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بثّ Xbox داخل Greenlight. علِقت؟ استعمل زر «وصّل Xbox»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight খুলে Xbox সম্প্রচার আরম্ভ করুন। আটকে গেলে “Xbox জুড়ুন” টিপুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Greenlight, begin streaming your Xbox. Stuck? Use the Connect your Xbox button."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Greenlight, simulan ang pag-stream ng Xbox mo. Naipit? Gamitin ang button na Ikonekta ang Xbox mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight खोलकर Xbox से खेलना आरंभ करें। अटक गए? Xbox जोड़ें बटन दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Greenlight, mulailah streaming Xbox Anda. Macet? Pakai tombol Hubungkan Xbox."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam Greenlight, mula strim Xbox anda. Tersekat? Guna butang Sambungkan Xbox anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start in Greenlight een stream van je Xbox. Lukt het niet? Gebruik de knop Koppel je Xbox."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Greenlight ให้สตรีม Xbox ขึ้นมา ติดขัดหรือ? กดปุ่ม “เชื่อม Xbox ของคุณ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight'ta Xbox yayınını başlatın. Takılırsanız Xbox'ı bağla düğmesini kullanın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenlight میں Xbox کی اسٹریمنگ شروع کیجیے۔ اٹک گئے؟ «Xbox جوڑیے» بٹن دبائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Greenlight và stream Xbox của bạn. Bị kẹt? Bấm nút Nối Xbox."
          }
        }
      }
    },

    "home.keySuggestion.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح ترجمة لهذه اللعبة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই গেমের জন্য অনুবাদ কি যোগ করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a translation key for this game"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng translation key para sa larong ito"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस गेम के लिए अनुवाद की जोड़ें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kunci terjemahan untuk game ini"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah kunci terjemahan untuk permainan ini"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een vertaalsleutel toe voor deze game"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคีย์การแปลสำหรับเกมนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

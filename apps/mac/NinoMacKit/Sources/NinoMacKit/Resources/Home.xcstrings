    "home.tv.updateHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل التلفاز بإصدار أقدم من تطبيق Nino. انقر لتثبيت الإصدار الجديد بجانبه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিভিতে Nino টিভি অ্যাপের পুরনো সংস্করণ চলছে। পাশে নতুনটি বসাতে ক্লিক করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV runs an older Nino TV app. Click to install the new one next to it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumang Nino TV app ang tumatakbo sa TV. I-click para ikabit ang bago sa tabi nito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी पर Nino टीवी ऐप का पुराना संस्करण चल रहा है। नया साथ में लगाने के लिए क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV memakai aplikasi Nino TV versi lama. Klik untuk memasang versi baru di sampingnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV menggunakan aplikasi Nino TV versi lama. Klik untuk memasang versi baharu di sebelahnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv gebruikt een oudere Nino-tv-app. Klik om de nieuwe ernaast te zetten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีใช้แอป Nino เวอร์ชันเก่า คลิกเพื่อติดตั้งเวอร์ชันใหม่ไว้ข้างกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV eski bir Nino TV uygulaması kullanıyor. Yenisini yanına kurmak için tıklayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی پر Nino ٹی وی ایپ کا پرانا ورژن چل رہا ہے۔ نیا ساتھ لگانے کے لیے کلک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV đang dùng ứng dụng Nino TV cũ. Bấm để cài bản mới bên cạnh."
          }
        }
      }
    },

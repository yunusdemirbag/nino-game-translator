    "home.drop.pairingInvalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض PS5 هذا الإقران. في الإعدادات، أقرِن PS5 مرة أخرى باستخدام الحساب الثاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 এই জোড় মানেনি। সেটিংসে গিয়ে নতুন করে জুড়ুন, এবার আরেকটি PSN আইডি দিয়ে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 rejected this pairing. Open Settings and pair again, this time with the second PSN account."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw na ng PS5 sa pares na ito. Buksan ang Settings at magpares muli, gamit ngayon ang ikalawang PSN account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ने यह जोड़ी ठुकराई। सेटिंग में जाकर दूसरे PSN खाते से नई जोड़ी बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 menolak pemasangan ini. Di Pengaturan, pasangkan PS5 lagi menggunakan akun kedua."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 menolak pasangan ini. Dalam Tetapan, pasangkan PS5 semula menggunakan akaun kedua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze koppeling is door de PS5 geweigerd. Ga naar Instellingen en koppel nog een keer, nu met het tweede PSN-account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่รับการจับคู่นี้ ไปที่การตั้งค่าแล้วจับคู่ใหม่ คราวนี้ให้ใช้ PSN อีกบัญชีหนึ่ง (บัญชีสำรอง)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bu eşlemeyi geçersiz saydı. Ayarlar'ı açın ve ikinci PSN hesabınızla PS5'i bir kez daha eşleştirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 نے یہ جوڑی قبول نہیں کی۔ ترتیبات کھولیے اور اس بار دوسرا PSN اکاؤنٹ استعمال کر کے جوڑی دوبارہ بنائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 từ chối lần ghép đôi này. Mở Cài đặt rồi ghép lại, lần này chọn tài khoản PSN số hai."
          }
        }
      }
    },
    "home.drop.passcodeRequired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب هذا الحساب رمز دخول على الجهاز. اكتبه في إعدادات Nino، أو احذف ذلك الرمز من PS5."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনসোলে এই আইডিতে ঢুকতে পাসকোড লাগে। সেটি Nino সেটিংসে টাইপ করে দিন, নয়তো PS5 থেকে পাসকোডটি তুলে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account needs a sign-in passcode on the console. Type it in Nino's Settings, or remove that passcode from the PS5."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humihingi ang console ng sign-in passcode para sa account na iyan. I-type ito sa Settings ni Nino, o tanggalin ang passcode sa PS5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते में PS5 लॉग-इन हेतु एक पासकोड लगा है। उसे Nino की सेटिंग में लिखें, या PS5 से यह पासकोड हटवा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini dilindungi kode sandi login di konsol. Ketikkan kodenya di Pengaturan Nino, atau cabut kode tersebut dari PS5."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini perlu kod log masuk pada konsol. Isikan kod itu dalam Tetapan Nino, atau buang kod tersebut daripada PS5."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor dit account is op de console een aanmeldcode nodig. Vul die in bij de instellingen van Nino, of haal de code weg op de PS5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้ต้องกรอกรหัสผ่านเข้าใช้บนคอนโซล ใส่รหัสนั้นในการตั้งค่าของ Nino หรือเอารหัสออกจาก PS5"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın PS5'te oturum açma şifresi var. Şifreyi Nino Ayarları'na yazın ya da konsolda bu şifreyi kaldırın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنسول پر اس اکاؤنٹ میں داخلے کے لیے پاس کوڈ لازمی ہے۔ اسے Nino کی ترتیبات میں لکھیے، یا PS5 سے یہ پاس کوڈ ہٹا دیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Console đòi một mật mã khi tài khoản này đăng nhập. Gõ mật mã ấy vào Cài đặt của Nino, hoặc xóa nó trên PS5."
          }
        }
      }
    },
    "home.drop.passcodeWrong": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز الدخول المحفوظ في الإعدادات لم ينجح مع PS5. عدّله هناك، أو احذف رمز هذا الحساب من الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে লেখা পাসকোডটি PS5 মানেনি। হয় ওখানে শুধরে দিন, নয়তো কনসোলে এই আইডির পাসকোড তুলে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in passcode saved in Settings didn't work on the PS5. Fix it there, or remove the passcode for this account on the console."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tumalab sa PS5 ang sign-in passcode na nakatabi sa Settings. Itama ito roon, o alisin sa console ang passcode para sa account na iyan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग में सहेजा PS5 पासकोड काम न आया। उसे वहाँ सुधारें, या PS5 में इस खाते से यह पासकोड हटवा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode sandi masuk yang tersimpan di Pengaturan ditolak PS5. Perbaiki kodenya di sana, atau cabut kode untuk akun ini di konsol."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod log masuk yang tersimpan dalam Tetapan ditolak oleh PS5. Betulkan di situ, atau buang kod bagi akaun ini pada konsol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmeldcode die in Instellingen staat, werkt niet op de PS5. Pas hem daar aan, of verwijder de code voor dit account op de console."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านเข้าใช้ที่เก็บไว้ในการตั้งค่าใช้กับ PS5 ไม่ได้ แก้ไขที่นั่น หรือเอารหัสของบัญชีนี้ออกบนคอนโซล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'a kaydedilen oturum açma şifresi PS5'te işe yaramadı. Şifreyi orada düzeltin ya da konsolda bu hesabın şifresini kaldırın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیبات میں محفوظ پاس کوڈ PS5 نے قبول نہیں کیا۔ وہاں درست کیجیے، یا کنسول میں اس اکاؤنٹ والا پاس کوڈ ہٹا دیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật mã đăng nhập lưu ở Cài đặt không dùng được trên PS5. Sửa nó ở đó, hoặc trên console, gỡ mật mã khỏi tài khoản ấy."
          }
        }
      }
    },
    "home.drop.refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض PS5 الاتصال. يُرجى إعداد PS5 مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 এই লিংক ফিরিয়ে দিয়েছে। দয়া করে PS5 নতুন করে সাজিয়ে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 turned the connection down. Please set the PS5 up again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw ng PS5 sa koneksyon. Pakiulit ang setup ng PS5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ने जुड़ने से मना किया। कृपया PS5 का सेटअप दोबारा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 menolak koneksi. Silakan atur PS5 lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 menolak sambungan. Sila sediakan PS5 sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 wees de verbinding af. Doorloop het instellen van de PS5 nogmaals."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ปฏิเสธการต่อ กรุณาตั้ง PS5 ใหม่อีกรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bağlantıyı kabul etmedi. Lütfen PS5 kurulumunu baştan yapın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 نے کنکشن رد کر دیا۔ براہِ کرم PS5 کی ترتیب نئے سرے سے کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không nhận kết nối. Vui lòng cài đặt lại PS5 từ đầu."
          }
        }
      }
    },
    "home.drop.rejected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض PS5 بدء الجلسة. لعل PS Remote Play يعمل، أو أن الجهاز منشغل بجلسة غيرها. أغلق تطبيق PS Remote Play، وأطفئ PS5 وشغّله، ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 সেশন আরম্ভ করেনি। কারণ হতে পারে সচল PS Remote Play, কিংবা কনসোলে চলা আরেকটি সেশন। PS Remote Play-টি ছেড়ে বেরোন, PS5 একবার অফ ও অন করে নিন, এরপর আরেকবার চালিয়ে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 wouldn't begin the session. PS Remote Play might be running, or the console might be busy with another session. Quit PS Remote Play, turn the PS5 off and on, and try once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw simulan ng PS5 ang sesyon. Baka may bukas pang PS Remote Play app, o may ibang sesyong hawak ang console. Isara muna ang app na PS Remote Play, patayin at buhayin ang PS5, at subukang muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 सत्र खोलने को राज़ी नहीं। शायद PS Remote Play अभी खुला हो, या PS5 पहले से कोई अन्य सत्र चला रहा हो। तब PS Remote Play छोड़ें, PS5 बंद कर के ऑन करें, और एक बार और आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak mau memulai sesi. Bisa jadi PS Remote Play sedang terbuka, atau konsol tengah melayani sesi lain. Tutup aplikasi PS Remote Play, matikan lalu hidupkan PS5, kemudian coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 enggan memulakan sesi. Mungkin PS Remote Play sedang berjalan, atau konsol sibuk dengan sesi lain. Hentikan apl PS Remote Play, matikan PS5 dan hidupkannya semula, kemudian cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 wilde geen sessie beginnen. Misschien draait PS Remote Play al, of heeft de console al een sessie lopen. Stop PS Remote Play, zet de PS5 uit en weer aan, en probeer nog een keer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่ยอมเริ่มเซสชัน บางทีแอป PS Remote Play อาจทำงานอยู่ หรือคอนโซลอาจติดเซสชันอื่น ให้ออกจาก PS Remote Play ปิด PS5 แล้วเปิดอีกรอบ จากนั้นลองดูอีกที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 oturumu açmadı. Ya PS Remote Play çalışıyor ya da konsol başka bir oturumla meşgul. PS Remote Play'den çıkın, PS5'i kapatıp açın ve bir kez daha deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیشن شروع کرنے سے PS5 نے انکار کیا۔ شاید PS Remote Play کھلا ہے، یا کنسول کسی دوسرے سیشن سے مصروف ہے۔ PS Remote Play چھوڑیے، PS5 کو بند کر کے پھر آن کیجیے، اور دوبارہ آزمائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không chịu mở phiên. Có thể PS Remote Play vẫn còn chạy, hoặc console đang bận với một phiên chơi khác. Hãy thoát PS Remote Play, tắt PS5 rồi bật lên, sau đó thử lại một lần."
          }
        }
      }
    },
    "home.drop.rejectedCode %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض PS5 الربط (الرمز %@). لعل PS Remote Play يعمل، أو أن الجهاز منشغل بجلسة غيرها. أغلق تطبيق PS Remote Play، وأطفئ PS5 وشغّله، ثم جرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 লিংক নাকচ করল (কোড: %@)। কারণ হতে পারে সচল PS Remote Play, কিংবা কনসোলে চলা আরেকটি সেশন। PS Remote Play-টি ছেড়ে বেরোন, PS5 একবার অফ ও অন করে নিন, এরপর আরেকবার চালিয়ে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection was refused by the PS5 (code %@). PS Remote Play might be running, or the console might be busy with another session. Quit PS Remote Play, turn the PS5 off and on, and try once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw ng PS5 sa koneksyon (code %@). Posibleng may bukas pang PS Remote Play app, o may ibang sesyong hawak ang console. Isara muna ang app na PS Remote Play, patayin at buhayin ang PS5, at subukang muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ने जुड़ाव ठुकराया (कोड %@)। शायद PS Remote Play अभी खुला हो, या PS5 पहले से कोई अन्य सत्र चला रहा हो। तब PS Remote Play छोड़ें, PS5 बंद कर के ऑन करें, और एक बार और आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 menolak sambungan (kode %@). Bisa jadi PS Remote Play sedang terbuka, atau konsol tengah melayani sesi lain. Tutup aplikasi PS Remote Play, matikan lalu hidupkan PS5, kemudian coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 menolak sambungan ini (kod %@). Mungkin PS Remote Play sedang berjalan, atau konsol sibuk dengan sesi lain. Hentikan apl PS Remote Play, matikan PS5 dan hidupkannya semula, kemudian cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding is door de PS5 afgewezen (code %@). Misschien draait PS Remote Play al, of heeft de console al een sessie lopen. Stop PS Remote Play, zet de PS5 uit en weer aan, en probeer nog een keer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ปฏิเสธการต่อ (โค้ด %@) อาจมีแอป PS Remote Play ทำงานอยู่ หรือคอนโซลอาจติดเซสชันอื่น ให้ออกจาก PS Remote Play ปิด PS5 แล้วเปิดอีกรอบ จากนั้นลองดูอีกที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bağlantıya izin vermedi (kod %@). Ya PS Remote Play çalışıyor ya da konsol başka bir oturumla meşgul. PS Remote Play'den çıkın, PS5'i kapatıp açın ve bir kez daha deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 نے کنکشن ٹھکرا دیا (کوڈ %@)۔ غالباً PS Remote Play کھلا ہے، یا کنسول کسی دوسرے سیشن سے مصروف ہے۔ PS Remote Play چھوڑیے، PS5 کو بند کر کے پھر آن کیجیے، اور دوبارہ آزمائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 khước từ kết nối này (mã %@). Có thể PS Remote Play vẫn còn chạy, hoặc console đang bận với một phiên chơi khác. Hãy thoát PS Remote Play, tắt PS5 rồi bật lên, sau đó thử lại một lần."
          }
        }
      }
    },
    "home.drop.remotePlayDisabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاصية Remote Play مطفأة في PS5. على الجهاز شغّل تمكين Remote Play (المسار: الإعدادات › النظام › Remote Play). بعدها ابدأ من البداية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই PS5 কনসোলে Remote Play অফ। কনসোলের Enable Remote Play অন করে নিন (পথ: Settings › System › Remote Play)। এরপর নতুন করে আরম্ভ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PS5 has Remote Play switched off. On the console, set Enable Remote Play to on (path: Settings › System › Remote Play). After that, start over."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pinapagana ng iyong PS5 ang Remote Play. Puntahan sa console: Settings › System › Remote Play, tapos buhayin doon: Enable Remote Play. Pagkatapos, umpisahan muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके PS5 में Remote Play ऑफ़ है। PS5 में Enable Remote Play ऑन करें (Settings › System › Remote Play), फिर नए सिरे से आरंभ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play di PS5 Anda sedang mati. Di konsol, nyalakan Aktifkan Remote Play (lokasinya: Pengaturan › Sistem › Remote Play). Sesudah itu, ulangi dari awal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play tidak aktif pada PS5 anda. Di konsol, tukar Enable Remote Play kepada hidup (laluan: Settings › System › Remote Play). Selepas itu, mula dari awal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play is uitgeschakeld op je PS5. Schakel op de console Remote Play inschakelen in; je vindt het onder Instellingen › Systeem › Remote Play. Begin daarna opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ของคุณยังไม่ได้เปิดใช้ Remote Play บนคอนโซล ให้สลับ Enable Remote Play เป็นเปิด (ที่ Settings › System › Remote Play) เสร็จแล้วเริ่มต้นใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'inizde Uzaktan Oynatma kapalı. Konsolda Ayarlar › Sistem › Uzaktan Oynatma bölümüne girip Uzaktan Oynatmayı Etkinleştir seçeneğini açın, ardından baştan başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے PS5 کا Remote Play آف ہے۔ کنسول پر Enable Remote Play والا اختیار آن کیجیے (راستہ: Settings › System › Remote Play)۔ اس کے بعد از سرِ نو آغاز کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play trên PS5 của bạn đang tắt. Trên console, gạt Bật Remote Play sang bật (đi theo Cài đặt › Hệ thống › Remote Play). Sau đó chạy lại từ đầu."
          }
        }
      }
    },

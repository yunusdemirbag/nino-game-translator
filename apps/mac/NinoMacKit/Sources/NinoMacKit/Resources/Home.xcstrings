          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek bahasa %1$@–%2$@ belum dimuat turun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het taalpakket %1$@–%2$@ is nog niet binnengehaald."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้โหลดชุดภาษา %1$@–%2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@ dil paketi henüz yüklenmemiş."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@ زبان پیک ابھی موجود نہیں، اسے ڈاؤن لوڈ کرنا باقی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói ngôn ngữ %1$@–%2$@ hiện vẫn chưa tải về."
          }
        }
      }
    },
    "home.warning.languagePackHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزّل اللغتين كلتيهما من إعدادات النظام › عام › اللغة والمنطقة › لغات الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings › General › Language & Region › Translation Languages থেকে দুই ভাষাই নামিয়ে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download both languages from System Settings › General › Language & Region › Translation Languages."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunin ang parehong wika sa System Settings › General › Language & Region › Translation Languages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings › General › Language & Region › Translation Languages खोलकर दोनों पैक ले लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh kedua bahasa itu dari Pengaturan Sistem › Umum › Bahasa & Wilayah › Bahasa Terjemahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan dua-dua bahasa itu di Tetapan Sistem › Umum › Bahasa & Rantau › Bahasa Terjemahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download beide talen. Ga naar Systeeminstellingen › Algemeen › Taal en regio › Vertaaltalen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดทั้งสองภาษาได้จาก การตั้งค่าระบบ › ทั่วไป › ภาษาและภูมิภาค › ภาษาสำหรับการแปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki dili de Sistem Ayarları › Genel › Dil ve Bölge › Çeviri Dilleri bölümünden indirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دونوں زبانیں System Settings › General › Language & Region › Translation Languages سے ڈاؤن لوڈ کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tải cả hai thứ tiếng (Cài đặt hệ thống › Cài đặt chung › Ngôn ngữ & Vùng › Ngôn ngữ dịch)."
          }
        }
      }
    },
    "home.warning.localNetwork": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما لا يملك Nino إذن الشبكة المحلية. فعّله عبر: إعدادات النظام › الخصوصية والأمن › الشبكة المحلية، وبعدها أغلق Nino وافتحه من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় নেটে ঢোকার অনুমতি Nino হয়তো পায়নি। পথটি হলো System Settings › Privacy & Security › Local Network; সেটা অন করে Nino পুনরায় খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino may be missing local network access. Turn it on under System Settings › Privacy & Security › Local Network and reopen Nino."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Baka walang pahintulot si Nino sa lokal na network. Payagan ito (System Settings › Privacy & Security › Local Network), at muling buksan si Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शायद Nino को Local Network इजाज़त नहीं मिली। System Settings › Privacy & Security › Local Network में इसे ऑन करें और Nino को छोड़कर पुनः खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino barangkali belum punya izin jaringan lokal. Hidupkan izinnya lewat Pengaturan Sistem › Privasi & Keamanan › Jaringan Lokal, kemudian jalankan ulang Nino."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino mungkin tiada akses rangkaian setempat. Hidupkannya di Tetapan Sistem › Privasi & Keselamatan › Rangkaian Setempat, lalu buka Nino sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino heeft mogelijk geen toegang tot het lokale netwerk. Zet die aan via Systeeminstellingen › Privacy en beveiliging › Lokaal netwerk. Open Nino vervolgens opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino อาจยังไม่มีสิทธิ์ใช้เครือข่ายเฉพาะที่ เปิดได้ที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › เครือข่ายเฉพาะที่ จากนั้นออกจาก Nino และเปิดขึ้นมาอีกรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun yerel ağa erişimi kapalı olabilir. Bunu Sistem Ayarları › Gizlilik ve Güvenlik › Yerel Ağ bölümünde açın, ardından Nino'yu kapatıp yeniden başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شاید Nino کو لوکل نیٹ ورک تک رسائی حاصل نہیں۔ System Settings › Privacy & Security › Local Network کے اندر اسے آن کیجیے، پھر Nino بند کر کے دوبارہ کھولیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino có thể đang thiếu quyền truy cập mạng LAN. Bật quyền đó (Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Mạng cục bộ), xong mở lại Nino."
          }
        }
      }
    },
    "home.warning.needsMacOS26": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مترجم Apple المدمج يتطلّب macOS 26 فما فوق. لا يزال بإمكانك استخدام DeepL وترجمة AI وحزم الألعاب على جهاز Mac (انظر الإعدادات › الترجمة)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-এর বিল্ট-ইন অনুবাদক চালাতে লাগে macOS 26, কিংবা তারও নতুন। তবে এই Mac-এ DeepL, AI ভাষান্তর ও খেলাভিত্তিক প্যাক চলবে — দেখুন সেটিংস › অনুবাদ।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's built-in translator requires macOS 26 or newer. You can still use DeepL, AI translation and game packs on this Mac (see Settings › Translation)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagana lang ang built-in na tagasalin ng Apple sa macOS 26 pataas. Magagamit mo pa rin ang DeepL, AI na pagsasalin at mga game pack sa iyong Mac (nasa Settings › Pagsasalin)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple का बिल्ट-इन अनुवादक macOS 26 से नीचे नहीं चलता। DeepL, AI भाषांतर व Nino के गेम-संग्रह इस Mac पर तब भी चलेंगे (सेटिंग › अनुवाद देखें)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerjemah bawaan Apple baru bisa dipakai di macOS 26 ke atas. DeepL, terjemahan AI, dan paket game tetap bisa dipakai di Mac ini (lihat Pengaturan › Terjemahan)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penterjemah terbina dalam Apple hanya berfungsi pada macOS 26 ke atas. Anda masih boleh guna DeepL, terjemahan AI dan pek permainan pada Mac ini (lihat Tetapan › Terjemahan)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ingebouwde vertaler van Apple werkt pas vanaf macOS 26. DeepL, AI-vertaling en gamepakketten kun je op deze Mac wel gebruiken (zie Instellingen › Vertaling)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวแปลในตัวของ Apple ต้องการ macOS 26 หรือใหม่กว่า แต่ Mac ตัวนี้ยังใช้ DeepL การแปลด้วย AI และแพ็กเกมได้ (ดูในส่วนการตั้งค่า › การแปล)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple'ın yerleşik çevirmeni macOS 26 veya daha yenisini ister. Bu Mac'te oyun paketlerini, DeepL'i ve yapay zekâ çevirisini (Ayarlar › Çeviri) kullanmaya devam edebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple کے اندرونی مترجم کو macOS 26 یا اس سے نیا ورژن چاہیے۔ اس Mac پر DeepL، AI ترجمہ اور گیم پیک پھر بھی چل سکتے ہیں (ترتیبات › ترجمہ دیکھیے)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình dịch tích hợp của Apple chỉ có từ macOS 26 về sau. Trên Mac này bạn vẫn có DeepL, dịch AI và gói trò chơi (xem Cài đặt › Dịch)."
          }
        }
      }
    },

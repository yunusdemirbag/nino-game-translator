    "home.card.black": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشاشة سوداء. هل جهاز PS5 مُشغَّل؟ إن كان كذلك فافتح على الجهاز الإعدادات › النظام › HDMI وعطّل خيار تمكين HDCP."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্দা কালো। PS5 অন আছে তো? অন থাকলে কনসোলে Settings › System › HDMI-তে গিয়ে Enable HDCP অফ করে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Black screen. Is the PS5 switched on? If it is, look under Settings › System › HDMI on the console and switch off Enable HDCP."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Madilim ang screen. Nakabukas ba ang PS5? Kung oo, buksan sa console: Settings › System › HDMI, at patayin doon ang Enable HDCP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परदा काला है। क्या PS5 ऑन है? अगर हाँ, तो PS5 के भीतर Settings › System › HDMI में जाएँ और उधर Enable HDCP को ऑफ़ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layarnya gelap. Sudahkah PS5 dihidupkan? Jika sudah, di konsol masuk ke Pengaturan › Sistem › HDMI, lalu nonaktifkan Aktifkan HDCP."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin gelap. Sudahkah PS5 dihidupkan? Jika ya, buka menu Settings › System › HDMI pada konsol, lalu nyahaktifkan Enable HDCP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwart beeld. Is de PS5 ingeschakeld? Zo ja: open op de console Instellingen › Systeem › HDMI en schakel HDCP inschakelen uit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอมืด PS5 เปิดเครื่องแล้วหรือยัง ถ้าเปิดแล้ว ให้ไปที่ Settings › System › HDMI บนคอนโซล แล้วปิด Enable HDCP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kararmış. PS5 açık mı? Açıksa konsolda Ayarlar › Sistem › HDMI altındaki HDCP'yi Etkinleştir seçeneğini kapatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین کالی ہے۔ کیا PS5 چالو ہے؟ اگر ہاں، تو کنسول کی Settings › System › HDMI کھول کر Enable HDCP کو بند کر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình đen. PS5 đã mở chưa? Nếu máy đang chạy, trên console hãy tìm tới Cài đặt › Hệ thống › HDMI rồi tắt Bật HDCP."
          }
        }
      }
    },
    "home.card.cameraDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على Nino أن يصل إلى الكاميرا. فعّل الإذن عبر: إعدادات النظام › الخصوصية والأمن › الكاميرا، وبعدها أغلق Nino وافتحه من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera চালাতে Nino-কে সায় দিন। পথ: System Settings › Privacy & Security › Camera; সেখানে অন করে নিন, এরপর Nino পুনরায় খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino needs camera access. Turn it on under System Settings › Privacy & Security › Camera and reopen Nino."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ni Nino na magamit ang camera. Payagan ito (System Settings › Privacy & Security › Camera), at muling buksan si Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino को कैमरा उपयोग की इजाज़त दें: System Settings › Privacy & Security › Camera में इसे ऑन करें और Nino को छोड़कर पुनः खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino memerlukan izin kamera. Hidupkan izinnya lewat Pengaturan Sistem › Privasi & Keamanan › Kamera, kemudian jalankan ulang Nino."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Nino menggunakan kamera: Tetapan Sistem › Privasi & Keselamatan › Kamera. Kemudian buka Nino semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino heeft toegang tot de camera nodig. Zet die aan via Systeeminstellingen › Privacy en beveiliging › Camera. Open Nino vervolgens opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ต้องใช้กล้อง เปิดสิทธิ์นี้ได้ที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › กล้อง จากนั้นออกจาก Nino และเปิดขึ้นมาอีกรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun kameraya erişmesi gerekiyor. Sistem Ayarları › Gizlilik ve Güvenlik › Kamera bölümünde Nino'yu açın, ardından uygulamayı kapatıp yeniden başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کو کیمرے تک رسائی درکار ہے۔ System Settings › Privacy & Security › Camera کے اندر اسے آن کیجیے، پھر Nino بند کر کے دوبارہ کھولیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino cần được dùng camera. Bật quyền đó (Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Camera), xong mở lại Nino."
          }
        }
      }
    },

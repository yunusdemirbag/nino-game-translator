    "settings.obs.noLocalhost": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج البث لديك (TikTok LIVE Studio مثلا) يرفض localhost؟ استبدله بعنوان IP المحلي لكمبيوترك في هذا العنوان:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok LIVE Studio-র মতো streaming software localhost মানে না? তাহলে computer-এর local IP বসিয়ে এই address নিন:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming software that won't take localhost, like TikTok LIVE Studio? Swap in your computer's local IP with this address:"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw ng localhost ng streaming app mo (gaya ng TikTok LIVE Studio)? Ilagay ang lokal na IP ng computer mo gamit ang address sa ibaba:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका प्रसारण सॉफ़्टवेयर localhost नहीं लेता, मसलन TikTok LIVE Studio? तो इस पते में अपने computer का local IP भरें:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi siaran Anda menolak localhost, seperti TikTok LIVE Studio? Pakai IP lokal komputer Anda lewat alamat ini:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perisian penstriman tidak menerima localhost, seperti TikTok LIVE Studio? Gantikan dengan IP setempat komputer anda menggunakan alamat ini:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepteert je streamsoftware geen localhost, zoals TikTok LIVE Studio? Vervang het dan door het lokale IP-adres van je computer, met dit adres:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมสตรีมบางตัว (อย่าง TikTok LIVE Studio) ไม่ยอมรับ localhost ใช่ไหม? ใส่ที่อยู่นี้ซึ่งใช้ IP ภายในของคอมพิวเตอร์แทน:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın yazılımınız localhost adresini almıyor mu (örneğin TikTok LIVE Studio)? Şu adresi bilgisayarınızın yerel IP'siyle kullanın:"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسٹریمنگ سافٹ ویئر localhost نہیں لیتا، جیسے TikTok LIVE Studio؟ تو اس پتے میں کمپیوٹر کا مقامی IP ڈالیں:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần mềm stream không nhận localhost, như TikTok LIVE Studio? Thay bằng IP nội bộ của máy bạn trong địa chỉ sau:"
          }
        }
      }
    },

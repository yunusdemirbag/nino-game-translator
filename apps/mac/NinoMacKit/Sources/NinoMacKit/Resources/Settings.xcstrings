    "settings.connection.xboxHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: افتح تطبيق Greenlight، أو زر الموقع xbox.com/play › My consoles من متصفح ويب، ثم ادخل بحساب Microsoft. يراقب Nino تلك النافذة ويضع الترجمة فوقها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: Greenlight app চালান, নয়তো web browser দিয়ে xbox.com/play › My consoles দেখুন, আর Microsoft account দিয়ে লগ ইন সেরে নিন। Nino ওই উইন্ডোয় নজর রেখে তার ওপর তর্জমা বিছিয়ে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: launch the Greenlight app, or visit xbox.com/play › My consoles using a web browser, and log in with a Microsoft account. Nino watches that window and lays the translation over it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: paganahin ang Greenlight app, o sa isang web browser ay pumunta sa xbox.com/play › My consoles, at mag-log in sa iyong Microsoft account. Sinusubaybayan ng Nino ang naturang window at ipinapatong ang salin doon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: Greenlight ऐप चलाएँ, या web browser से xbox.com/play › My consoles पर जाकर Microsoft खाते से लॉगिन करें। Nino उस खिड़की पर नज़र रखता है और भाषांतर उस पर बिछाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: jalankan aplikasi Greenlight, atau kunjungi xbox.com/play › My consoles lewat peramban web, lalu login memakai akun Microsoft. Nino memantau jendela itu dan meletakkan terjemahan di atasnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: lancarkan aplikasi Greenlight, atau gunakan pelayar web untuk ke xbox.com/play › My consoles, lalu log masuk menggunakan akaun Microsoft. Nino memantau tetingkap itu dan meletakkan terjemahan di atasnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: start de app Greenlight of ga in een webbrowser naar xbox.com/play › My consoles, en meld je aan met een Microsoft-account. Nino volgt dat venster en legt de vertaling erover."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: เปิดแอป Greenlight หรือไปที่ xbox.com/play › My consoles ในเว็บเบราว์เซอร์ แล้วลงชื่อด้วยบัญชี Microsoft โดย Nino อ่านหน้าต่างนั้นและวางคำแปลทับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: Greenlight uygulamasını veya xbox.com/play › Konsollarım sayfasını tarayıcıda açın, Microsoft hesabınızla oturum açın. Nino bu pencereyi izler, çeviriyi üzerine yerleştirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: Greenlight ایپ کھولیں، یا ویب براؤزر کے ذریعے xbox.com/play › My consoles پر جائیں، اور Microsoft اکاؤنٹ کے ذریعے لاگ ان ہوں۔ Nino اس ونڈو کو دیکھتا ہے اور ترجمہ اس پر رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox: mở ứng dụng Greenlight, hoặc vào xbox.com/play › My consoles trên trình duyệt, rồi đăng nhập Microsoft. Nino canh cửa sổ ấy rồi phủ bản dịch lên trên."
          }
        }
      }
    },
    "settings.deepl.badKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تقبل DeepL المفتاح. انسخه من جديد من صفحة الحساب على موقع DeepL والصقه هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL key-টা মানেনি। DeepL-এর website-এ account পাতায় গিয়ে key নিয়ে ফের paste করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL rejected the key. Paste it once more from the account page on DeepL's site."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw itong tanggapin ng DeepL. Kopyahin ulit ang key mula sa account page sa site ng DeepL."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL ने key ठुकरा दी। DeepL साइट के खाता पन्ने से key उठाकर पुनः चिपकाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL menolak kunci ini. Tempel ulang kunci dari laman akun Anda di situs DeepL."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL menolak kunci ini. Tampal sekali lagi dari halaman akaun di laman DeepL."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL heeft de sleutel geweigerd. Kopieer hem nogmaals vanaf je accountpagina op de site van DeepL."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL ไม่รับคีย์นี้ คัดลอกมาวางใหม่จากหน้าบัญชีบนเว็บ DeepL"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL anahtarı reddetti. DeepL sitesindeki hesap sayfanızdan anahtarı bir kez daha kopyalayıp yapıştırın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL نے کلید قبول نہیں کی۔ DeepL کی سائٹ کے اکاؤنٹ صفحے سے کاپی کر کے پھر پیسٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL không nhận khoá này. Hãy dán lại khoá lấy ở trang tài khoản trên web DeepL."
          }
        }
      }
    },
    "settings.deepl.limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استنفدت حصتك الشهرية في DeepL. وإلى أن تتجدد، يتولى الترجمة النموذج المثبت على كمبيوترك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এ মাসে DeepL-এর বরাদ্দ শেষ। বরাদ্দ নতুন করে না আসা অবধি আপনার computer-এ বসানো model-ই তর্জমা করবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached DeepL's monthly allowance. Until it refreshes, the model installed here on your computer translates."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naubos mo na ang buwanang allowance ng DeepL. Hangga't hindi ito nare-refresh, ang model na nasa computer mo ang magsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL में इस माह की हद पार हो चुकी है। हद नई होने तक, आपके computer पर लगा मॉडल भाषांतर संभालेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatah bulanan DeepL sudah habis. Sampai jatahnya pulih, model lokal di komputer Anda yang menerjemahkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Had bulanan DeepL anda sudah habis. Sehingga had itu diperbaharui, model yang terpasang di komputer anda akan menterjemah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je maandtegoed bij DeepL is op. Tot het weer wordt aangevuld, vertaalt het model op je eigen computer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้โควตารายเดือนของ DeepL ครบแล้ว ระหว่างรอรอบใหม่ โมเดลที่ติดตั้งบนคอมพิวเตอร์นี้จะแปลแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın DeepL hakkı bitti. Hak yenilenene dek çeviriyi bilgisayarınızda çalışan model üstlenir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL کا ماہانہ کوٹہ ختم ہو چکا۔ نیا کوٹہ آنے تک ترجمہ اس کمپیوٹر میں موجود ماڈل کرتا رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã dùng hết hạn mức tháng của DeepL. Cho tới khi hạn mức làm mới, mô hình cài trên máy bạn sẽ dịch."
          }
        }
      }
    },
    "settings.deepl.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب DeepL. تأكد أنك متصل بالإنترنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL কোনো জবাব দিল না। নেট কানেকশন ঠিক আছে তো?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL didn't respond. Make sure you're online."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang tugon mula sa DeepL. Tiyaking online ka."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL ने उत्तर नहीं दिया। नेट चालू है, यह जाँच लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL tidak merespons. Pastikan internet Anda tersambung."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL tidak menjawab. Pastikan anda dalam talian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen antwoord van DeepL. Controleer je internetverbinding."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL ไม่ตอบสนอง ตรวจดูว่าออนไลน์อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL'e bağlanılamadı. İnternetinizi denetleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL سے جواب نہیں ملا۔ دیکھیں کہ انٹرنیٹ چل رہا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepL không trả lời. Bạn xem lại mạng nhé."
          }
        }
      }
    },
    "settings.deepl.usage %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الشهر: استُخدم %1$@ من %2$@ حرف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলতি মাসে %2$@ অক্ষরের মধ্যে %1$@ খরচ হয়ে গেছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month you've used %1$@ characters out of %2$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngayong buwan, %1$@ na karakter ang nagamit mo sa %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस माह %2$@ में से आप %1$@ अक्षर ख़र्च कर चुके हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemakaian bulan ini: %1$@ karakter, dari jatah %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggunaan bulan ini: %1$@ aksara, daripada jumlah %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze maand gebruikt: %1$@ tekens, limiet %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดือนนี้: ใช้ไป %1$@ จาก %2$@ อักขระ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay %2$@ karakterin %1$@ tanesi kullanıldı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ماہ کا استعمال: %1$@ حروف، کل %2$@ میں سے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dùng %1$@ trên %2$@ ký tự trong tháng này."
          }
        }
      }
    },

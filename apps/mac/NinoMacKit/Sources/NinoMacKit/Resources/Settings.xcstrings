    "settings.translation.geminiPrivacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلقى Google الترجمات. مع مفتاح الفئة المجانية، يحق لـ Google استخدام ذلك النص لتدريب خدماتها وتحسينها، ويمكن لموظفيها الاطلاع عليه. لا يغادر Mac سوى ترجمات اللعبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "subtitle যায় Google-এর কাছে। ফ্রি plan-এর key-তে Google ওই text নিয়ে নিজেদের সেবা শেখাতে ও উন্নত করতে পারে, আর Google-এর কর্মীরাও সেটা দেখতে পান। Mac ছেড়ে কেবল খেলার subtitle-ই যায়, আর কিছু নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google receives the subtitles. On a free-tier key, Google is allowed to use that text to train and improve its services, and Google employees can see it. Nothing but subtitles from the game leaves your Mac."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Natatanggap ng Google ang subtitle. Kapag libreng key ang gamit, puwedeng gamitin ng Google ang tekstong iyon para sanayin at pagandahin ang mga serbisyo nito, at nakikita ito ng mga empleyado ng Google. Subtitle lang mula sa laro ang lumalabas sa Mac mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपशीर्षक Google तक पहुँचते हैं। key मुफ़्त स्तर की हो, तो Google उस लिखावट से अपनी सेवाओं को सिखा व निखार सकता है, और उसके कर्मचारी उसे पढ़ सकते हैं। खेल के उपशीर्षकों के सिवा आपके Mac से कुछ नहीं निकलता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Google menerima subtitel. Pada kunci versi gratis, Google boleh memakai teks itu untuk melatih dan meningkatkan layanannya, dan karyawan Google dapat melihatnya. Hanya subtitel game yang keluar dari Mac Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Google menerima sari kata. Dengan kunci peringkat percuma, Google dibenarkan memakai teks itu untuk melatih dan menambah baik perkhidmatannya, dan pekerja Google boleh melihatnya. Selain sari kata permainan, tiada apa-apa yang keluar dari Mac anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ontvangt de ondertitels. Bij een sleutel uit het gratis niveau mag Google die tekst gebruiken om zijn diensten te trainen en beter te maken, en kunnen Google-medewerkers hem lezen. Alleen ondertitels uit het spel verlaten je Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Google จะได้รับซับไตเติล หากเป็นคีย์ฟรี Google อาจใช้ข้อความนั้นฝึกและพัฒนาบริการ และพนักงาน Google อาจเห็นได้ ไม่มีอะไรออกจาก Mac นอกจากซับไตเติลของเกม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazılar Google'a iletilir. Ücretsiz anahtarla Google bu metinleri hizmetlerini geliştirmekte kullanabilir; Google'daki kişiler de bunları görebilir. Mac'inizden oyunun altyazıları dışında hiçbir şey çıkmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب ٹائٹل Google کو جاتے ہیں۔ مفت درجے کی کلید پر Google یہ متن اپنی سروسز کی تربیت اور بہتری میں لگا سکتا ہے، نیز Google کے ملازم اسے دیکھ سکتے ہیں۔ آپ کے Mac سے کھیل کے سب ٹائٹلوں کے سوا کچھ نہیں جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ đề sẽ đi tới Google. Với khoá miễn phí, Google được phép dùng nội dung đó để huấn luyện và cải tiến dịch vụ, nhân viên của Google cũng có thể đọc. Ngoài phụ đề game, không có gì khác rời khỏi Mac của bạn."
          }
        }
      }
    },

    "settings.area.noFrame": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر صورة اللعبة هنا فور بدء الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তর্জমা আরম্ভ হলে এই অংশে খেলার ছবি ফুটে উঠবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll see the game picture in this area after translation begins."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lilitaw sa bahaging ito ang eksena ng laro pagsimula ng salin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",

    "settings.api.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لترجمة ترجمات الألعاب الأخرى، أدخل مفتاح API (لا يحتفظ به أي خادم ولا يُشارَك مع أحد)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য গেমের subtitle অনুবাদ করতে API key দিন (কোনো সার্ভারে রাখা হয় না, কারও সঙ্গে শেয়ার হয় না)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To translate subtitles in other games, you need an API key (no server keeps it, and it is shared with no one)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para maisalin ang subtitle ng ibang laro, maglagay ng API key (walang server na nagtatago nito at hindi ito ibinabahagi kanino man)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे गेम के उपशीर्षक अनुवाद करने के लिए API key डालें (यह किसी सर्वर पर नहीं रहती, किसी को नहीं दी जाती)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menerjemahkan subtitel game lain, masukkan kunci API (tidak disimpan di server dan tidak dibagikan kepada siapa pun)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menterjemah sari kata permainan lain, masukkan kunci API (tidak disimpan di pelayan dan tidak dikongsi dengan sesiapa)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een API-sleutel in om ondertitels van andere games te vertalen (hij wordt niet op een server bewaard en nergens heen gestuurd)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าต้องการแปลซับไตเติลของเกมอื่น ให้ใส่ API key (ไม่มีเซิร์ฟเวอร์ใดเก็บไว้ และไม่แชร์ให้ใคร)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer oyunların altyazılarının çevrilmesi için API key girmeniz gerekir (sunucuda saklanmaz, hiçbir yere gönderilmez)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیگر گیمز میں سب ٹائٹل ترجمہ کروانے کو API کلید درج کریں (یہ کسی سرور پر نہیں رکھی جاتی، کسی کو نہیں دی جاتی)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để dịch phụ đề của các game khác, hãy nhập khoá API (không máy chủ nào giữ khoá, cũng không chia sẻ cho ai)."
          }
        }
      }
    },

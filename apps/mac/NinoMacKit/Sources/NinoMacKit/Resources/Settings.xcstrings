    "settings.translation.englishOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحركات عبر الإنترنت تترجم الألعاب الإنجليزية فقط. لغات الألعاب الأخرى تستخدم الترجمة المجانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "online engine কেবল ইংরেজি খেলার তর্জমা করে। খেলাটা ভিন্ন কোনো ভাষায় হলে ফ্রি তর্জমাই চলে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online engines only translate English games. Other game languages use the free translation."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingles na laro lamang ang kayang isalin ng online engines. Kapag ibang wika ang laro, libreng tagasalin ang gagana."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन वाले इंजन केवल इंग्लिश खेलों का भाषांतर करते हैं। बाकी भाषा वाले खेल मुफ़्त भाषांतर पर चलते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin daring cuma bisa menerjemahkan game yang berbahasa Inggris. Game dalam bahasa lain memakai terjemahan gratis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjin dalam talian cuma menterjemah permainan berbahasa Inggeris. Bahasa permainan lain memakai terjemahan percuma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Online diensten vertalen alleen Engelstalige spellen. Voor spellen in andere talen geldt de gratis vertaling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือออนไลน์แปลเฉพาะเกมภาษาอังกฤษ เกมภาษาอื่นจะใช้การแปลฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimiçi motorlar sadece İngilizce oyunlarda çalışır. Başka dildeki oyunlarda ücretsiz çeviri kullanılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آن لائن انجن فقط انگریزی گیمیں ترجمہ کرتے ہیں۔ باقی زبانوں والی گیموں میں مفت مترجم کام کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ máy online chỉ dịch được game bằng tiếng Anh. Game dùng ngôn ngữ khác sẽ qua trình dịch không mất phí."
          }
        }
      }
    },

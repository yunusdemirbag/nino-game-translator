    "settings.tv.overlayHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّله عندما يعرض Nino شاشة مظلمة بدل اللعبة؛ عندها تُرسم الترجمات فوق بث HDMI."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino-র ভেতরে PS5-এর ছবি কালো থাকলে এটি চালু করুন। তখন সাবটাইটেল টিভির নিজের HDMI পর্দার ওপরে দেখা যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch on when Nino shows a black screen instead of the game; translations are then drawn over the HDMI feed."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan kapag madilim na screen ang ipinapakita ng Nino sa halip na laro; ipapatong ang pagsasalin sa HDMI feed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर Nino के अंदर PS5 की तस्वीर काली रहती है तो इसे चालू करें। तब उपशीर्षक टीवी की अपनी HDMI स्क्रीन के ऊपर दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan bila Nino menampilkan layar gelap, bukan permainan; terjemahan lalu digambar di atas siaran HDMI."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan bila Nino memaparkan skrin gelap, bukan permainan; terjemahan dilukis di atas siaran HDMI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet dit aan als het PS5-beeld in Nino zwart blijft. De ondertitels verschijnen dan boven het eigen HDMI-scherm van de tv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไว้หากภาพ PS5 ใน Nino ยังดำอยู่ คำบรรยายจะแสดงทับหน้าจอ HDMI ของทีวีเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'da oyun yerine siyah ekran varsa açın; çeviriler TV'deki HDMI yayınının üzerine çizilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب Nino کھیل کے بجائے اندھیری اسکرین دکھائے تو آن کریں؛ ترجمے HDMI نشریات کے اوپر بنیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật khi Nino hiện màn đen thay vì trò chơi; bản dịch sẽ được vẽ đè lên luồng HDMI."
          }
        }
      }
    },

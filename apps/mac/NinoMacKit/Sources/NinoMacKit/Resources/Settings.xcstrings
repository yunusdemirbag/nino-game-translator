          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeren van het vertaalbestand is mislukt. Kijk of opmaak en tekencodering kloppen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถนำเข้าไฟล์คำแปล ตรวจว่ารูปแบบและการเข้ารหัสข้อความถูกต้อง"

    "settings.connection.computerHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الترجمات في نافذة مستقلة على هذا الكمبيوتر، طافية فوق اللعبة (PS Remote Play / chiaki-ng)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "subtitle এই computer-এই একটা নিজস্ব উইন্ডোয় ভাসতে থাকে খেলার মাথার ওপর (PS Remote Play / chiaki-ng)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitles appear in their own window here on this computer, floating above the game (PS Remote Play / chiaki-ng)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa sariling window dito sa computer lilitaw ang subtitle, nakalutang sa itaas ng laro (PS Remote Play / chiaki-ng)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS Remote Play / chiaki-ng के साथ: उपशीर्षक इसी computer पर अलग खिड़की में, खेल के ऊपर तैरते नज़र आते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitel tampil di jendelanya sendiri di komputer ini, mengambang di atas game (PS Remote Play / chiaki-ng)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sari kata dipaparkan dalam tetingkapnya sendiri pada komputer ini, terapung di atas permainan (PS Remote Play / chiaki-ng)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondertitels verschijnen hier op deze computer in een eigen venster dat boven het spel zweeft (PS Remote Play / chiaki-ng)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซับไตเติลจะขึ้นในหน้าต่างของตัวเองบนคอมพิวเตอร์เครื่องนี้ ลอยเหนือเกม (PS Remote Play / chiaki-ng)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazılar bu bilgisayarda ayrı bir pencerede belirir ve oyunun (PS Remote Play / chiaki-ng) üstünde durur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب ٹائٹل اسی کمپیوٹر پر ایک الگ ونڈو میں گیم کے اوپر تیرتے نظر آتے ہیں (PS Remote Play / chiaki-ng)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ đề nằm trong cửa sổ riêng ngay tại máy này, nổi phía trên game (PS Remote Play / chiaki-ng)."
          }
        }
      }
    },

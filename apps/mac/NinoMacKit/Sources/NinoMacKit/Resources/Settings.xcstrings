    "settings.packs.error.format": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر استيراد ملف الترجمة. تأكد من صحة تنسيقه وترميز نصه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তর্জমার ফাইলটা আনা গেল না। ফাইলের format আর text encoding দুটোই মিলিয়ে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't import the translation file. Make sure its format and text encoding are right."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigo ang pag-import ng file ng salin. Tiyaking tama ang format at text encoding nito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषांतर फ़ाइल लाई न जा सकी। फ़ाइल का ढाँचा और encoding ठीक हैं, यह परखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengimpor file terjemahan. Periksa format dan enkode teksnya."

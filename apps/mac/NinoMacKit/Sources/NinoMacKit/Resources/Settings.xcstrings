            "value": "แปลเฉพาะคำบรรยาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız altyazıyı çevir"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف ذیلی عنوان کا ترجمہ"
          }
        },
        "vi": {

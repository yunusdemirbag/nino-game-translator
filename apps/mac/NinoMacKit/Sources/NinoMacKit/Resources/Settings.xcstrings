    "settings.ask.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل Nino عن أي شيء يخص الاتصال أو الترجمة أو الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ, তর্জমা বা settings, যা জানতে চান Nino-কে প্রশ্ন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Nino anything about connecting, translation or settings."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magtanong kay Nino tungkol sa pagkonekta, pagsasalin o settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जुड़ने, भाषांतर, सेटिंग, किसी पर भी अपना सवाल Nino से करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan apa saja kepada Nino tentang koneksi, terjemahan, atau pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanya Nino apa sahaja tentang sambungan, terjemahan atau seting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag Nino alles over verbinden, vertalen of instellingen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาม Nino ได้ทุกเรื่องเกี่ยวกับการเชื่อมต่อ การแปล หรือการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı, çeviri ya da ayarlarla ilgili her şeyi Nino'ya sorabilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنکشن، ترجمہ یا ترتیبات کے بارے میں Nino سے کچھ بھی پوچھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi Nino bất cứ điều gì về kết nối, bản dịch hay cài đặt."
          }
        }
      }
    },

    "settings.card.permission": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى Mac بطاقة الالتقاط ككاميرا. توجه إلى إعدادات النظام › الخصوصية والأمن › الكاميرا وفعل Nino، ثم أغلق Nino وافتحه من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac একটি capture card-কে camera বলেই ধরে। System Settings › Privacy & Security › Camera খুলে Nino অন করে দিন, এরপর Nino একেবারে quit করে ফের চালান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac treats a capture card like a camera. Go to System Settings › Privacy & Security › Camera, switch Nino on, then quit and reopen Nino."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinuturing ng Mac na camera ang capture card. Pumunta rito: System Settings › Privacy & Security › Camera, payagan ang Nino, pagkatapos ay umalis at muling paganahin ang Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac किसी capture card को कैमरा समझता है। System Settings › Privacy & Security › Camera में Nino को ऑन कर दें; इसके बाद Nino से बाहर निकलकर उसे नए सिरे से चलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac menganggap kartu capture sebagai kamera. Buka Pengaturan Sistem › Privasi & Keamanan › Kamera, aktifkan Nino, lalu tutup dan buka lagi Nino."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac menganggap kad tangkap sebagai kamera. Buka Tetapan Sistem › Privasi & Keselamatan › Kamera, hidupkan Nino, kemudian tutup dan buka semula Nino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Mac ziet een opnamekaart als camera. Ga naar Systeeminstellingen › Privacy en beveiliging › Camera, schakel Nino in, sluit Nino af en open het weer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac มองการ์ดจับภาพเป็นกล้องตัวหนึ่ง ไปที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › กล้อง เปิดสวิตช์ Nino แล้วปิดและเปิด Nino ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac, capture card'ı bir kamera gibi tanır. Sistem Ayarları › Gizlilik ve Güvenlik › Kamera bölümünde Nino'yu açın, ardından Nino'yu kapatıp yeniden başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac کیپچر کارڈ کو کیمرا سمجھتا ہے۔ System Settings › Privacy & Security › Camera کھولیں، Nino کا سوئچ چالو کریں، پھر Nino بند کر کے دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac coi card ghi hình như một camera. Tại Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Camera, bật Nino, sau đó thoát và mở lại Nino."
          }
        }
      }
    },

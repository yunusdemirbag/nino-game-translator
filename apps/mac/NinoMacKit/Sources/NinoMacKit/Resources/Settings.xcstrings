    "settings.packs.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمات تركية جاهزة مسبقا لبعض الألعاب. السطور التي تغطيها الحزمة تظهر فورا دون المرور بمحرك الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাছাই কয়েকটা খেলায় আগেভাগে বানানো তুর্কি তর্জমা। pack-এ যে লাইন আছে তা তক্ষুনি ভেসে ওঠে, translation engine অবধি যায় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turkish translations prepared ahead of time for certain games. Lines that a pack covers show up instantly and skip the translation engine."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga Turkish na salin na inihanda na nang maaga para sa piling laro. Agad lumilitaw ang linyang sakop ng pack at hindi na dumadaan sa translation engine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनिंदा खेलों हेतु पहले से बनाए गए तुर्की उपशीर्षक। पैक की हर पंक्ति फ़ौरन दिखती है, भाषांतर वाले इंजन तक नहीं जाती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan Turki yang sudah disiapkan sebelumnya untuk game tertentu. Baris yang tercakup paket langsung tampil tanpa melalui mesin terjemahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan Turki yang disediakan lebih awal untuk permainan tertentu. Baris yang diliputi pek terus dipaparkan tanpa melalui enjin terjemahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vooraf gemaakte Turkse vertalingen voor bepaalde spellen. Regels uit een pakket verschijnen direct, zonder vertaalmachine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแปลภาษาตุรกีที่เตรียมไว้ล่วงหน้าสำหรับบางเกม บรรทัดที่แพ็กครอบคลุมจะขึ้นทันทีโดยไม่ผ่านเอนจินแปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belli oyunlar için önceden hazırlanmış Türkçe çeviriler. Paketin kapsadığı satırlar çeviri motoruna uğramadan anında ekrana gelir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ گیموں کے لیے پہلے سے تیار ترکی ترجمے۔ جو سطریں کسی پیک میں ہوں وہ فوراً دکھتی ہیں اور ترجمہ انجن تک نہیں جاتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản tiếng Thổ dịch trước cho vài game. Câu nào gói đã có thì hiện lập tức, không phải qua bộ máy dịch."
          }
        }
      }
    },

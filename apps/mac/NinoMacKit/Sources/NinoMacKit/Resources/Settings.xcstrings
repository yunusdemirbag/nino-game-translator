    "settings.updates.auto": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر Nino على الإصدارات الجديدة بنفسه ويثبتها بهدوء، فتجد الإصدار الجديد عند فتحه في المرة القادمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino নিজেই নতুন release খুঁজে নিঃশব্দে বসিয়ে রাখে; পরে যখন খুলবেন, নতুন release হাজির।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino finds new releases by itself and sets them up quietly; you get the new release on your next launch."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusang naghahanap ng bagong release ang Nino at tahimik itong ini-install; makukuha mo ang bago sa susunod mong pagbukas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino नई रिलीज़ ख़ुद खोजकर चुपचाप लगा देता है; अगली दफ़ा खोलते ही नई रिलीज़ आपके सामने होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino mencari rilis baru sendiri dan memasangnya diam-diam; rilis baru aktif saat Anda membukanya lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino mencari keluaran baharu dengan sendiri dan memasangnya secara senyap; anda mendapat keluaran baharu itu apabila dilancarkan seterusnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe versies vindt Nino zelf en installeert ze ongemerkt; bij de volgende start van Nino gebruik je de nieuwe versie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino หาเวอร์ชันใหม่และติดตั้งเงียบๆ เอง คุณจะได้เวอร์ชันใหม่เมื่อเปิดแอปครั้งหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino yeni sürümleri kendiliğinden bulur ve sessizce yükler; uygulamayı bir dahaki açışınızda yeni sürüm hazır olur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino نئے ورژن خود ڈھونڈ کر خاموشی سے انسٹال کر لیتا ہے؛ اگلی بار کھولنے پر نیا ورژن ملتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tự tìm bản mới và lặng lẽ cài đặt; lần mở tiếp theo bạn sẽ có bản mới."
          }
        }
      }
    },

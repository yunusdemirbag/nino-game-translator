    "settings.reset.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينسى Nino جهاز PS5 والحساب وربط التلفاز، ويبدأ الإعداد من الخطوة الأولى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino PS5, account আর TV link ভুলে যাবে, তারপর setup একেবারে প্রথম ধাপ থেকে চলবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino forgets the PS5, the account and the TV link, then setup begins from the first step."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buburahin ng Nino sa alaala ang PS5, ang account at ang link sa TV, at babalik ang setup sa unang hakbang."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino अपने पास से PS5, खाता और टीवी का जुड़ाव हटा देता है, और सेटअप एकदम पहले कदम से चलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino melupakan PS5, akun, dan sambungan TV, lalu penyiapan dimulai lagi dari langkah awal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino melupakan PS5, akaun dan pautan TV, lalu persediaan dimulakan semula dari langkah pertama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino vergeet de PS5, de koppeling met de tv en je account, en de configuratie start weer bij stap één."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino จะลบข้อมูล PS5 ข้อมูลบัญชี และลิงก์ทีวี แล้วเริ่มตั้งค่าจากขั้นแรกใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino; PS5'i, hesabı ve TV ile kurulan bağı unutur, ardından kurulum ilk adımdan başlar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino PS5، اکاؤنٹ اور ٹیلی وژن کا رابطہ بھول جائے گا اور سیٹ اپ پہلے قدم سے شروع ہو گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino sẽ quên PS5, tài khoản cùng liên kết TV, rồi cài đặt lại từ bước đầu."
          }
        }
      }
    },

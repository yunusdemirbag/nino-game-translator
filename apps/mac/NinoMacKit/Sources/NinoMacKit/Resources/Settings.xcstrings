    "settings.card.plugIn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اوصل البطاقة مباشرة بأحد منافذ USB 3 الموجودة في جهاز Mac هذا. وإن كانت موصولة عبر موزع، فاوصلها بجهاز Mac مباشرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "card-টি এই Mac-এ একটা USB 3 port-এ জুড়ুন। hub দিয়ে জুড়ে থাকলে বরং সোজা Mac-এ লাগিয়ে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the card to one of this Mac's USB 3 ports. If you're using a hub, plug straight into the Mac instead."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikabit ang card sa alinmang USB 3 port nitong Mac. Kung naka-hub ka, sa mismong Mac mo ito ikabit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्ड Mac के किसी USB 3 वाले पोर्ट से सीधे जोड़ें। हब लगा हो, तो हब हटाकर सीधे Mac में लगाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokkan kartu ke salah satu port USB 3 milik Mac. Kalau memakai hub, sambungkan langsung ke Mac saja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan kad ke salah satu port USB 3 Mac ini. Kalau memakai hab, cucuk kad terus ke Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de kaart rechtstreeks aan op een van de USB 3-poorten van deze Mac. Zit er een hub tussen, verbind hem dan direct met de Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบการ์ดเข้าพอร์ต USB 3 ที่ตัว Mac ถ้าต่อผ่านฮับอยู่ ให้เสียบตรงเข้า Mac แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartı bu Mac'in USB 3 bağlantı noktalarından birine takın. Araya hub giriyorsa kartı doğrudan Mac'e bağlamayı deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ سیدھا Mac کی کسی USB 3 ساکٹ سے جوڑیں۔ ہب لگا ہو تو اسے ہٹا کر براہ راست Mac سے جوڑیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm card vào một cổng USB 3 của Mac này. Nếu đang qua hub, hãy cắm thẳng vào Mac."
          }
        }
      }
    },

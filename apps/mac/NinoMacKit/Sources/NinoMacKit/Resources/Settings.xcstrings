          "stringUnit": {
            "state": "translated",
            "value": "Je tegoed bij %@ is op of de limiet van je account is bereikt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครดิตในบัญชี %@ ของคุณหมด หรือใช้ครบโควตาแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hesabınızın bakiyesi bitti veya kullanım sınırı doldu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ اکاؤنٹ کا کریڈٹ ختم یا حد مکمل ہو چکی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản %@ đã cạn tín dụng hay chạm giới hạn."
          }
        }
      }
    },
    "settings.engine.unreachable %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا استجابة من %@. تأكد أنك متصل بالإنترنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ কোনো জবাব দিল না। নেট কানেকশন ঠিক আছে তো?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't respond. Make sure you're online."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang tugon mula sa %@. Tiyaking online ka."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने उत्तर नहीं दिया। नेट चालू है, यह जाँच लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak merespons. Pastikan internet Anda tersambung."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak menjawab. Pastikan anda dalam talian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen antwoord van %@. Controleer je internetverbinding."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ตอบสนอง ตรวจดูว่าออนไลน์อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile bağlantı kurulamadı. İnternetinizi denetleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سے جواب نہیں ملا۔ دیکھیں کہ انٹرنیٹ چل رہا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không trả lời. Bạn xem lại mạng nhé."
          }
        }
      }
    },

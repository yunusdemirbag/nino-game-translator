          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดทำงานอยู่และภาพจาก PS5 ส่งมาแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart sorunsuz çalışıyor; PS5'in görüntüsü ulaşıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ ٹھیک چل رہا ہے اور PS5 کی تصویر آ رہی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Card chạy tốt, hình từ PS5 đang về."
          }
        }
      }

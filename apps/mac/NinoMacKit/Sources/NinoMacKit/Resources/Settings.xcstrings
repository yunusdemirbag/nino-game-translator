    "settings.style.autoSizeHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تشغيل الحجم التلقائي، يكبّر هذا الإعداد الحجم المأخوذ من اللعبة أو يصغّره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয় মাপ চালু থাকলে এই সেটিং গেম থেকে পাওয়া মাপ বড় বা ছোট করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With auto size on, this makes the size found from the game bigger or smaller."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naka-on ang awtomatikong laki, pinalalaki o pinaliliit nito ang laking nakuha mula sa laro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने-आप नाप चालू होने पर यह सेटिंग खेल से मिले नाप को बड़ा या छोटा करती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ukuran otomatis aktif, pengaturan ini memperbesar atau memperkecil ukuran dari game."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila saiz automatik dihidupkan, tetapan ini membesarkan atau mengecilkan saiz daripada permainan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met automatische grootte maakt deze instelling de grootte uit de game groter of kleiner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดขนาดอัตโนมัติ การตั้งค่านี้จะขยายหรือย่อขนาดที่ได้จากเกม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik boy açıkken bu ayar, oyuna göre bulunan boyu büyütür ya da küçültür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خودکار سائز آن ہونے پر یہ ترتیب کھیل سے ملا سائز بڑا یا چھوٹا کرتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {

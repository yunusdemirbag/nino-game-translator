    "settings.local.model.gemma12b": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة أفضل. يحتاج Mac إلى 16 GB من ذاكرة RAM على الأقل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তর্জমা আরও ভালো। Mac-এ 16 GB বা তার বেশি RAM থাকা চাই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Better translations. Your Mac should have 16 GB of RAM or more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas magandang salin. Dapat may 16 GB na RAM o higit pa ang Mac mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषांतर ज़्यादा उम्दा। Mac में कम से कम 16 GB RAM हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan lebih bagus. Mac Anda perlu RAM minimal 16 GB."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan lebih baik. Mac anda sepatutnya mempunyai sekurang-kurangnya 16 GB RAM."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betere vertalingen. Je Mac heeft minstens 16 GB RAM nodig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแปลดีกว่า Mac ควรมี RAM อย่างน้อย 16 GB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha iyi çevirir. En az 16 GB bellek ister."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہتر ترجمے۔ Mac میں کم از کم 16 GB RAM ہونی چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch tốt hơn. Mac nên có ít nhất 16 GB RAM."
          }
        }
      }
    },
    "settings.local.model.gemma4b": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذج ترجمة طورته Google. يناسب أغلب الحواسيب."
          }
        },
        "bn": {
          "stringUnit": {

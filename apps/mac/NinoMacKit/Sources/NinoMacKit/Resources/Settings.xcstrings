    "settings.updates.installHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجلب Nino التحديث ويثبته ثم يعيد تشغيل نفسه. تبقى كل إعداداتك محفوظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino update নামিয়ে বসিয়ে আপনা থেকেই restart নেয়। আপনার সব settings অটুট থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino fetches the update, sets it up and restarts itself. All your settings are kept."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusang kinukuha ng Nino ang bagong bersyon, inilalagay ito, saka nagre-restart. Hindi nawawala ang alinman sa mga setting mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino अपडेट लाकर लगाता है, फिर ख़ुद को बंद करके दोबारा चला लेता है। आपकी हर सेटिंग जस की तस रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino mengunduh pembaruan, memasangnya, lalu memulai ulang sendiri. Seluruh pengaturan Anda tidak akan hilang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino mengambil kemas kini, memasangnya, lalu memulakan semula dirinya. Semua tetapan anda dikekalkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino haalt de update op, installeert hem en herstart zichzelf. Al je instellingen blijven behouden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino โหลดตัวอัปเดตมา ลงให้ แล้วรีสตาร์ทตัวเอง การตั้งค่าทั้งหมดยังอยู่ครบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino güncellemeyi alır, yükler ve kendini yeniden başlatır. Ayarlarınızın hepsi korunur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino اپ ڈیٹ لا کر انسٹال کر لیتا ہے، پھر خود دوبارہ شروع ہوتا ہے۔ آپ کی ساری ترتیبات برقرار رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tải về bản mới, cài vào rồi tự khởi động lại. Mọi cài đặt đều được giữ."
          }
        }
      }
    },

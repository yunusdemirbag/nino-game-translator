    "settings.area.dragHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الإطار لتغيير موضعه، أو اسحب إحدى زواياه لتغيير حجمه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাক্স সরাতে ভেতরটা ধরে টানুন; মাপ বদলাতে কোণ ধরে টানুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag inside the box to reposition it, or pull a corner to resize."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilahin ang loob ng kahon upang ilipat, o ang isang sulok upang palakihin o paliitin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हिलाने हेतु डिब्बे के भीतर घसीटें, नाप बदलना हो तो कोना खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret bagian dalam kotak untuk memindahkannya, atau tarik salah satu sudut agar ukurannya berubah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret di dalam kotak untuk mengalihkannya, atau tarik salah satu bucunya untuk mengubah saiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versleep het kader zelf om het elders te zetten; trek aan een hoek voor een andere grootte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากภายในกรอบเพื่อย้ายตำแหน่ง หรือดึงมุมเพื่อปรับขนาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerini değiştirmek için çerçeveyi, boyutu için köşeyi sürükleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جگہ بدلنی ہو تو خانے کے اندر سے گھسیٹیں؛ سائز کے لیے کسی کونے کو کھینچیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo phần bên trong khung để dời chỗ, hoặc kéo một góc để thu phóng."
          }
        }
      }
    },

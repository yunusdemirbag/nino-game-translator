    "settings.style.speaker": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض اسم المتحدث"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কে বলছে, সেই নামও দেখান"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the speaker's name"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pangalan ng nagsasalita"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वक्ता का नाम भी दिखे"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertakan nama pembicara"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papar nama penutur"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon naam van spreker"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงชื่อคนที่พูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşanın adını göster"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بولنے والا دکھائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tên nhân vật đang nói"
          }
        }
      }
    },
    "settings.style.speakerHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر اسم المتحدث قبل الترجمة (ARTHUR: …). تبقى الأسماء بلا ترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তর্জমার আগে যিনি বলছেন, নামটা বসে তাঁর (ARTHUR: …)। নামগুলোর তর্জমা হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the speaker's name before the translation (ARTHUR: …). Names stay untranslated."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauuna sa salin ang pangalan ng taong nagsasalita (ARTHUR: …). Hindi isinasalin ang mga pangalan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषांतर से ठीक पहले वक्ता का नाम आता है, जैसे ARTHUR: …। नाम जस के तस रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan nama pembicara sebelum terjemahan (ARTHUR: …). Nama tidak diterjemahkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan nama penutur sebelum terjemahan (ARTHUR: …). Nama tidak diterjemah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de naam van wie er praat vóór de vertaling (ARTHUR: …). Namen worden niet vertaald."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงชื่อผู้พูดหน้าคำแปล (ARTHUR: …) โดยไม่แปลชื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşanın adı çevirinin önünde yer alır (ARTHUR: …). Adlar olduğu gibi kalır, çevrilmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمے سے پہلے کردار کا نام آتا ہے (ARTHUR: …)۔ نام ترجمہ نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tên người nói trước bản dịch (ARTHUR: …). Tên được giữ nguyên, không dịch."
          }
        }
      }
    },

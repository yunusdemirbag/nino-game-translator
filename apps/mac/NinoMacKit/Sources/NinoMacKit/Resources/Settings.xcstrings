    "settings.engine.badKey %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض %@ هذا المفتاح. انسخه مرة أخرى من صفحة حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ key-টা মানেনি। ওদের website-এ account পাতায় গিয়ে key নিয়ে ফের paste করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rejected the key. Paste it once more from the account page on its site."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinanggihan ng %@ ang key. Kopyahin ulit ito mula sa account page sa site nito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने key ठुकरा दी। उसकी साइट के खाता पन्ने से key उठाकर पुनः चिपकाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menolak kunci ini. Tempel ulang kunci dari laman akun Anda di situsnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menolak kunci ini. Tampal sekali lagi dari halaman akaun di lamannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft de sleutel geweigerd. Kopieer hem nogmaals vanaf je accountpagina op die site."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่รับคีย์นี้ คัดลอกมาวางใหม่จากหน้าบัญชีบนเว็บของผู้ให้บริการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ anahtarı reddetti. Hesap sayfanızdan anahtarı bir kez daha kopyalayıp yapıştırın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ نے کلید قبول نہیں کی۔ اس کی سائٹ کے اکاؤنٹ صفحے سے کاپی کر کے پھر پیسٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không nhận khoá này. Hãy dán lại khoá lấy ở trang tài khoản trên web của họ."
          }
        }
      }
    },
    "settings.engine.geminiQuota %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت حصة Gemini اليومية المجانية. المفتاح المجاني لا يُحاسَب أبدًا؛ تتجدد الحصة كل يوم (المرة القادمة في %@)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের ফ্রি Gemini বরাদ্দ শেষ। ফ্রি key-র কোনো দাম নেই, আর বরাদ্দ রোজ নতুন করে আসে (আবার আসবে: %@)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached today's free Gemini allowance. A free key costs nothing, and the allowance refreshes daily (next refresh: %@)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naubos mo na ang libreng allowance ng Gemini para ngayong araw. Libre ang key, at nare-refresh ang allowance araw-araw (susunod: %@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini की आज वाली मुफ़्त सीमा भर चुकी। key का कोई दाम नहीं लगता; यह सीमा रोज़ाना नई होगी, अगली बार: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatah gratis Gemini untuk hari ini telah terpakai semua. Kunci gratis tak dikenai biaya, dan jatahnya pulih setiap hari (berikutnya: %@)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Had Gemini percuma untuk hari ini sudah habis. Kunci percumanya tanpa kos, dan had diperbaharui saban hari (seterusnya: %@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gratis Gemini-tegoed voor vandaag is op. Een gratis sleutel kost niets en het tegoed wordt dagelijks aangevuld (volgende keer: %@)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้โควตาฟรีของ Gemini สำหรับวันนี้ครบแล้ว การใช้คีย์ฟรีไม่มีค่าใช้จ่าย และโควตาจะเติมใหม่ทุกวัน (รอบถัดไป: %@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü ücretsiz Gemini hakkı bitti. Ücretsiz anahtar hiçbir ücret doğurmaz; hak her gün tazelenir (bir sonraki: %@)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کا مفت Gemini کوٹہ ختم ہو چکا۔ مفت کلید کی کوئی قیمت نہیں اور کوٹہ روزانہ نیا ہوتا ہے (اگلی بار: %@)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt Gemini miễn phí của hôm nay đã hết. Khoá miễn phí không tốn tiền và lượt được cấp lại hằng ngày (lần cấp sau: %@)."
          }
        }
      }
    },
    "settings.engine.local.badKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم المحلي مفتاح API. راجعه، أو احذفه إن كان الخادم لا يستخدم مفاتيح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার local server API key-টা মানেনি। key-টা মিলিয়ে নিন, কিংবা server-টা key না চাইলে সেটা সরিয়ে ফেলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your local server rejected the API key. Double-check it, or delete it if that server doesn't use keys."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw tanggapin ng lokal mong server ang iyong API key. Suriin ito, o burahin kung walang key ang server na iyon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अपने सर्वर ने यह API key ठुकरा दी। उसे फिर परखें, या वह सर्वर key न माँगता हो तो उसे मिटा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server lokal Anda menolak kunci API. Periksa lagi, atau kosongkan saja bila server tersebut tidak memerlukan kunci."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan setempat anda menolak kunci API. Semak semula, atau padamkannya jika pelayan itu tidak memakai kunci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale server weigert de API-sleutel. Controleer hem, of haal hem weg als die server geen sleutels gebruikt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ในเครื่องไม่รับ API key ตรวจทานอีกครั้ง หรือลบทิ้งหากเซิร์ฟเวอร์นั้นไม่ใช้คีย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayardaki sunucu API anahtarını reddetti. Anahtarı gözden geçirin; sunucunuz anahtar kullanmıyorsa alanı boşaltın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی سرور نے API کلید رد کر دی۔ اسے جانچیں، یا اگر سرور کلید نہیں مانگتا تو مٹا دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Server trên máy bạn không nhận khoá API. Hãy xem lại, hoặc xoá khoá đi nếu server đó không cần khoá."
          }
        }
      }
    },
    "settings.engine.local.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخادم المحلي مشغول. انتظر لحظة وأعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার local server এখন কাজে আটকে আছে। খানিক সময় দিয়ে ফের করে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your local server is busy. Give it a moment and retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Abala ang local model server. Subukan ulit mamaya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका अपना सर्वर अभी काम में लगा है। ज़रा ठहरकर दोबारा आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server lokal Anda sedang sibuk. Tunggu sebentar, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan setempat anda sibuk. Tunggu seketika dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale server heeft het druk. Wacht even en probeer het nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ในเครื่องกำลังยุ่ง รอสักครู่แล้วลองอีกที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayardaki sunucu şu an dolu. Az sonra tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی سرور مصروف ہے۔ ذرا رک کر پھر کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Server trên máy bạn đang bận. Đợi chút rồi thử lại."
          }
        }
      }
    },
    "settings.engine.local.lmStudioDown %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستجيب LM Studio: لم يرد أحد على %@، أو كان النموذج بطيئا جدا. افتح LM Studio واختر النموذج ليحمل، ثم شغل الخادم فيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio জবাব দিচ্ছে না: %@-এ কেউ সাড়া দিল না, নয়তো model খুব ধীরে চলছিল। প্রথমে LM Studio চালু করে model বেছে load করে নিন, এরপর ওর server অন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio isn't responding: nothing answered at %@, or the model was too slow. Launch LM Studio, pick the model so it's loaded, then turn on its server."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tumutugon ang LM Studio: walang sumagot sa %@, o masyadong mabagal ang model. Paganahin ang LM Studio, piliin ang model upang ma-load, at buksan ang server nito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio उत्तर नहीं दे रहा: %@ से कोई जवाब नहीं आया, या मॉडल बहुत सुस्त रहा। LM Studio चलाएँ, उसमें मॉडल चुनकर लोड होने दें, फिर उसका सर्वर ऑन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio tidak merespons: tak ada jawaban dari %@, atau modelnya terlalu lambat. Buka LM Studio, pilih model agar termuat, lalu aktifkan servernya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio tidak menjawab: tiada balasan di %@, atau model terlalu perlahan. Lancarkan LM Studio, pilih model supaya ia dimuatkan, kemudian hidupkan pelayannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio reageert niet: er kwam geen antwoord van %@, of het model was te traag. Open LM Studio, kies het model zodat het geladen wordt en zet daarna de server aan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio ไม่ตอบสนอง: ไม่มีอะไรตอบที่ %@ หรือโมเดลช้าเกินไป เปิด LM Studio เลือกโมเดลให้โหลดอยู่ แล้วเปิดเซิร์ฟเวอร์ของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio yanıt vermiyor: %@ adresinden ses gelmedi veya model fazla geç kaldı. LM Studio'yu başlatın, modeli seçip belleğe alın, sonra sunucusunu açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio جواب نہیں دے رہا: %@ پر کوئی جواب نہیں آیا، یا ماڈل بہت سست تھا۔ LM Studio چلائیں، ماڈل چن کر لوڈ کریں، پھر اس کا سرور آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio không phản hồi: không có gì trả lời tại %@, hay mô hình chạy quá chậm. Mở LM Studio, chọn mô hình để nạp, rồi bật server của nó."
          }
        }
      }
    },
    "settings.engine.local.missing %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي الخادم المحلي على النموذج %1$@. لتنزيله: ollama pull %1$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ model এখনো আপনার local server-এ নেই। আনার command: ollama pull %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model %1$@ isn't on your local server yet. Get it with: ollama pull %1$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa nasa lokal mong server ang %1$@. Makukuha ito sa: ollama pull %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल %1$@ अभी आपके अपने सर्वर में नहीं। इस तरह लाएँ: ollama pull %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server lokal tidak memiliki model %1$@. Untuk mengunduhnya: ollama pull %1$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model %1$@ belum ada pada pelayan setempat anda. Untuk mendapatkannya, jalankan: ollama pull %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lokale server heeft het model %1$@ nog niet. Haal het op met: ollama pull %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ในเครื่องไม่มีโมเดล %1$@ หากต้องการดาวน์โหลด: ollama pull %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ modeli yerel sunucunuzda bulunmuyor. Almak için şu komutu çalıştırın: ollama pull %1$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی سرور میں ماڈل %1$@ نہیں ہے۔ ڈاؤن لوڈ کرنے کے لیے: ollama pull %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Server trên máy bạn chưa có mô hình %1$@. Tải về bằng lệnh: ollama pull %1$@"
          }
        }
      }
    },
    "settings.engine.local.missingLMStudio %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي LM Studio على نموذج باسم %@. نزله من داخل LM Studio وحمله، أو تحقق من كتابة الاسم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ নামে কোনো model LM Studio-তে মিলল না। LM Studio-র মধ্যেই সেটা নামিয়ে load করুন, অথবা নামের বানানটা মিলিয়ে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio has no model called %@. Get it inside LM Studio and load it, or make sure the name is spelled right."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang model na %@ sa LM Studio. Kunin ito sa loob ng LM Studio at i-load, o tiyaking tama ang baybay ng pangalan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio में %@ नाम का मॉडल नहीं मिला। LM Studio के भीतर ही उसे लाकर लोड कर लें, या नाम की वर्तनी परखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio tidak punya model bernama %@. Unduh lalu muat modelnya lewat LM Studio, atau cek apakah namanya ditulis dengan benar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio tiada model bernama %@. Ambil dan muatkan model tersebut melalui LM Studio, atau pastikan ejaan namanya betul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio heeft geen model dat %@ heet. Download het binnen LM Studio en laad het, of kijk of de naam juist gespeld is."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หาโมเดลชื่อ %@ ใน LM Studio ไม่เจอ ดาวน์โหลดและโหลดใน LM Studio หรือตรวจว่าสะกดชื่อถูก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio'da %@ adlı model bulunmuyor. Modeli LM Studio içinden indirip belleğe alın veya adının doğru yazıldığından emin olun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio میں %@ نام کا کوئی ماڈل نہیں۔ LM Studio کے اندر ہی اسے حاصل کر کے لوڈ کریں، یا نام کے ہجے دیکھ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong LM Studio chưa thấy mô hình nào tên %@. Tải rồi nạp mô hình ấy ngay trong ứng dụng, hoặc xem tên đã viết đúng chưa."
          }
        }
      }
    },
    "settings.engine.local.ollamaDown %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama لا يستجيب: لا رد على %1$@، أو أن النموذج بطيء جدا. شغل Ollama ثم اجلب النموذج بهذا الأمر: ollama pull %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama জবাব দিচ্ছে না: %1$@-এ কেউ সাড়া দিল না, নয়তো model খুব ধীরে চলছিল। Ollama খুলে model আনুন এভাবে: ollama pull %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama isn't responding: nothing answered at %1$@, or the model was too slow. Launch Ollama and fetch the model with: ollama pull %2$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tumutugon ang Ollama: walang sumagot sa %1$@, o masyadong mabagal ang model. Paganahin ang Ollama at kunin ang model sa: ollama pull %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama उत्तर नहीं दे रहा: %1$@ से कोई जवाब नहीं आया, या मॉडल बहुत सुस्त रहा। Ollama चलाएँ और मॉडल इस तरह लाएँ: ollama pull %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama tidak merespons: tak ada jawaban dari %1$@, atau modelnya terlalu lambat. Buka Ollama, lalu ambil modelnya dengan: ollama pull %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama tidak menjawab: tiada balasan di %1$@, atau model terlalu perlahan. Lancarkan Ollama dan ambil model dengan: ollama pull %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama reageert niet: er kwam geen antwoord van %1$@, of het model was te traag. Start Ollama en haal het model op met: ollama pull %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama ไม่ตอบสนอง: ไม่มีอะไรตอบที่ %1$@ หรือโมเดลช้าเกินไป เปิด Ollama แล้วดึงโมเดลด้วย: ollama pull %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama yanıt vermiyor: %1$@ adresinden ses gelmedi veya model fazla geç kaldı. Ollama'yı başlatın ve modeli şu komutla alın: ollama pull %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama جواب نہیں دے رہا: %1$@ پر کوئی جواب نہیں آیا، یا ماڈل بہت سست تھا۔ Ollama چلائیں، پھر ماڈل لانے کے لیے یہ کمانڈ دیں: ollama pull %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama không phản hồi: không có gì trả lời tại %1$@, hay mô hình chạy quá chậm. Mở Ollama rồi lấy mô hình về bằng lệnh: ollama pull %2$@"
          }
        }
      }
    },
    "settings.engine.local.otherDown %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يرد أحد على %@، أو كان النموذج بطيئا جدا. تحقق من صحة العنوان ومن تشغيل خادم النموذج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ কেউ সাড়া দিল না, নয়তো model খুব ধীরে চলছিল। address নির্ভুল কি না আর model server চালু কি না, দুটোই মিলিয়ে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing answered at %@, or the model was too slow. Make sure the address is right and your model server is up."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang sumagot sa %@, o masyadong mabagal ang model. Tiyaking tama ang address at gumagana ang server ng model mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से कोई जवाब नहीं आया, या मॉडल बहुत सुस्त रहा। पता सही है और मॉडल वाला सर्वर चालू है, यह परखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada jawaban dari %@, atau modelnya terlalu lambat. Pastikan alamatnya benar dan server model Anda sedang berjalan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada balasan di %@, atau model terlalu perlahan. Pastikan alamat betul dan pelayan model anda sedang berjalan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen antwoord van %@, of het model was te traag. Kijk of het adres klopt en je modelserver draait."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรตอบที่ %@ หรือโมเดลช้าเกินไป ตรวจว่าที่อยู่ถูกต้องและเซิร์ฟเวอร์โมเดลกำลังทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresinden ses gelmedi veya model fazla geç kaldı. Adresi gözden geçirin; model sunucunuz çalışıyor mu, bakın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ پر کوئی جواب نہیں آیا، یا ماڈل بہت سست تھا۔ پتا درست ہو اور ماڈل سرور چل رہا ہو، یہ دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì trả lời tại %@, hay mô hình chạy quá chậm. Hãy xem địa chỉ có đúng không và server mô hình đã chạy chưa."
          }
        }
      }
    },
    "settings.engine.model %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض %@ الطلب. جرب النموذج الآخر، أو أعد المحاولة بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ অনুরোধটা নাকচ করেছে। বরং অন্য model-টা নিন, কিংবা খানিক পরে ফের করে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ declined the request. Try the other model instead, or retry in a little while."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinanggihan ng %@ ang request. Pumili ng ibang model o subukan ulit mamaya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने माँग ठुकरा दी। अन्य मॉडल आज़माएँ, या ज़रा रुककर दोबारा आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menolak permintaan. Coba model yang lain, atau ulangi sebentar lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menolak permintaan ini. Gunakan model yang satu lagi, atau cuba semula sebentar nanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wees het verzoek af. Kies een ander model, of wacht even en doe dan nog een poging."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ปฏิเสธคำขอ เลือกอีกโมเดลหนึ่งหรือลองใหม่ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isteği reddetti. Öbür modele geçin veya biraz bekleyip tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ نے درخواست رد کر دی۔ دوسرا ماڈل آزمائیں، یا تھوڑی دیر بعد پھر کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã từ chối yêu cầu. Hãy dùng mô hình kia, hoặc lát nữa thử lại."
          }
        }
      }
    },
    "settings.engine.quota %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيد حساب %@ نفد أو وصل إلى حده الأقصى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার %@ account-এ credit ফুরিয়েছে, নয়তো limit ছুঁয়ে ফেলেছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ account is out of credit or has hit its limit."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubos na ang credit sa %@ account mo, o lampas na ito sa limit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके %@ खाते में पैसा बाक़ी नहीं, या उसकी सीमा भर चुकी है।"
          }
        },
        "id": {

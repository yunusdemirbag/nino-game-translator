    "settings.reset.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعادة من خطوة التلفاز: يحتفظ Nino بجهاز PS5 والحساب والاقتران، ويعيد ربط التلفاز فقط. إعادة ضبط الكل: ينسى Nino جهاز PS5 والحساب وربط التلفاز، وتعيد تسجيل دخولك إلى PSN من البداية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র ধাপ থেকে ফের: Nino PS5, account আর pairing রেখে দেয়, কেবল TV link আরেকবার বসায়। সব মুছে শুরু: Nino PS5, account আর TV link ভুলে যায়, আর আপনাকে PSN-এ গোড়া থেকে লগ ইন করতে হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo from the TV step: Nino keeps the PS5, account and pairing, and only sets up the TV link once more. Reset everything: Nino forgets the PS5, the account and the TV link, and you log in to PSN from scratch."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulitin mula sa hakbang ng TV: itatabi ng Nino ang PS5, account at pairing, at ang link sa TV lang ang muling ise-set up. I-reset lahat: buburahin ng Nino ang PS5, ang account at ang link sa TV, at magla-log in kang muli sa PSN mula umpisa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी कदम से दोहराना: Nino PS5, खाता और pairing बचाकर रखता है, केवल टीवी का जुड़ाव नए सिरे से बनता है। सब रीसेट: Nino PS5, खाता और टीवी का जुड़ाव हटा देता है, और PSN में आपको शुरुआत से लॉगिन करना पड़ेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi dari langkah TV: Nino menyimpan PS5, akun, dan pemasangan, lalu hanya menyiapkan ulang sambungan TV. Atur ulang semua: Nino melupakan PS5, akun, dan sambungan TV, lalu Anda login lagi ke PSN dari awal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulang dari langkah TV: Nino mengekalkan PS5, akaun dan gandingan, dan hanya menyediakan semula pautan TV. Tetap semula semua: Nino melupakan PS5, akaun dan pautan TV, lalu anda log masuk semula ke PSN dari awal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw vanaf de tv-stap: Nino bewaart de PS5, je account en de koppeling, en stelt enkel de tv-koppeling opnieuw in. Alles herstellen: Nino vergeet de PS5, de koppeling met de tv en je account, en je meldt je vanaf nul weer aan bij PSN."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำใหม่จากขั้นทีวี: Nino เก็บ PS5 บัญชี และการจับคู่ไว้ แล้วตั้งลิงก์ทีวีใหม่อย่างเดียว ล้างทั้งหมด: Nino ลบข้อมูล PS5 ข้อมูลบัญชี และลิงก์ทีวี และคุณต้องเข้า PSN ใหม่หมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV adımından yinele: PS5, hesap ve eşleşme yerinde kalır; yalnız TV ile bağ yeniden kurulur. Tümünü sıfırla: Nino; PS5'i, hesabı ve TV ile kurulan bağı unutur, PSN'e en baştan giriş yaparsınız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی قدم سے دہرائیں: Nino PS5، اکاؤنٹ اور جوڑی برقرار رکھتا ہے اور صرف ٹیلی وژن کا رابطہ پھر سے بناتا ہے۔ سب ری سیٹ: Nino PS5، اکاؤنٹ اور ٹیلی وژن کا رابطہ بھول جاتا ہے اور آپ PSN میں شروع سے سائن ان کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm lại từ bước TV: Nino giữ PS5, tài khoản cùng ghép nối, chỉ cài lại liên kết TV. Xoá hết: Nino quên PS5, tài khoản cùng liên kết TV, rồi bạn phải đăng nhập PSN lại từ đầu."
          }
        }
      }
    },

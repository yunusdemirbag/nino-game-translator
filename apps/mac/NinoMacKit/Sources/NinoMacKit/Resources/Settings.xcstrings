    "settings.local.getOllama": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزل Ollama (مجاني) وشغله، ثم عد إلى هذه الشاشة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama নামিয়ে নিন (এর কোনো দাম নেই), খুলে দিন, এরপর এই পাতায় ফেরত আসুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Ollama (it's free), launch it, and return to this screen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunin ang Ollama (libre), paganahin, at bumalik dito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama उतारें (कोई दाम नहीं), उसे चलाएँ, और यहाँ लौट आएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh Ollama (gratis), jalankan, lalu kembali ke layar ini."

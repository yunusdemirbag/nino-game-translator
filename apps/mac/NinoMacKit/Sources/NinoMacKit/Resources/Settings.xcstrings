            "state": "translated",
            "value": "Chỉ dịch phụ đề"
          }
        }
      }
    },
    "settings.packs.subtitlesOnlyHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، لا تُترجم تلميحات الأزرار والقوائم والنصوص على أطراف الشاشة، ويصل الحوار وحده إلى التلفاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু থাকলে বোতামের ইঙ্গিত, মেনু আর পর্দার কিনারার লেখা বাদ যায়; টিভিতে যায় কেবল কথোপকথন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, button prompts, menus and text at the edges of the screen are skipped, so the TV shows dialogue alone."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naka-on, nilalaktawan ang mga paalala sa button, menu at teksto sa gilid ng screen; usapan lang ang napupunta sa TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर बटन संकेत, मेनू और स्क्रीन के किनारों का लिखा छोड़ दिया जाता है; टीवी पर सिर्फ़ संवाद जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika aktif, petunjuk tombol, menu, dan tulisan di tepi layar dilewati; hanya percakapan yang dikirim ke TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila dihidupkan, gesaan butang, menu dan tulisan di tepi skrin dilangkau; hanya dialog dihantar ke TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat dit aan, dan worden knopaanwijzingen, menu's en tekst aan de randen van het scherm overgeslagen en toont de tv alleen dialoog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิด จะข้ามคำแนะนำปุ่ม เมนู และข้อความที่ขอบจอ ส่งไปทีวีเฉพาะบทพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken tuş ipuçları, menüler ve ekranın kenarındaki yazılar çevrilmez; yalnız konuşmalar TV'ye gider."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آن ہونے پر بٹن کے اشارے، مینو اور اسکرین کے کناروں کی تحریر چھوڑ دی جاتی ہے؛ ٹی وی پر صرف مکالمہ جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, gợi ý nút bấm, menu và chữ ở mép màn hình được bỏ qua; chỉ lời thoại được gửi lên TV."
          }
        }
      }
    },
    "settings.packs.turkishOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تعمل الحزم إلا عند الترجمة إلى التركية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "pack কাজ করে কেবল তর্জমা যখন তুর্কি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packs only apply when you translate into Turkish."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lamang sa pagsasalin sa Turkish ang mga pack."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैक केवल तुर्की वाले भाषांतर में चलते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",

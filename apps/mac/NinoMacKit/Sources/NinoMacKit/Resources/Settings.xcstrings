    "settings.connection.cardComputerHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكمبيوتر: تملأ اللعبة الشاشة كلها بصوتها، ويضع Nino الترجمة فوقها. اوصل هذا الكمبيوتر بتلفاز أو شاشة عرض."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "computer: Nino গোটা পর্দা জুড়ে শব্দসহ গেমটা চালায় আর তার ওপরে তর্জমা বিছিয়ে দেয়। এই computer-টিকে একটা টেলিভিশন বা monitor-এ জুড়ে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer: Nino fills the whole screen with the game, sound included, and lays the translation over it. Hook this computer up to a television or a monitor."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer: sakop ng laro ang buong screen, may tunog din, at nakapatong dito ang salin mula sa Nino. Ikonekta ang computer sa isang telebisyon o monitor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer: Nino पूरे परदे पर खेल आवाज़ समेत चलाता है और भाषांतर उसके ऊपर बिछाता है। इस computer पर एक टेलीविज़न अथवा मॉनिटर लगाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer: Nino memenuhi layar dengan game, berikut suaranya, dan terjemahannya ditumpangkan di atas gambar. Komputer ini perlu dihubungkan ke televisi atau monitor."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer: Nino memenuhi seluruh skrin dengan permainan, berserta bunyi, lalu meletakkan terjemahan di atasnya. Komputer ini perlu disambung kepada televisyen atau monitor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer: Nino vult het hele scherm met het spel, inclusief geluid, en legt de vertaling eroverheen. Sluit deze computer aan op een televisie of monitor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คอมพิวเตอร์: Nino แสดงเกมเต็มจอพร้อมเสียง และวางคำแปลทับไว้ ต่อคอมพิวเตอร์นี้เข้ากับทีวีหรือจอภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayar: Nino oyunu sesli ve tüm ekranı kaplayacak biçimde açar, çeviriyi de üzerine yerleştirir. Bilgisayarı bir televizyona veya monitöre takın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر: Nino پوری اسکرین پر گیم آواز سمیت دکھاتا ہے اور ترجمہ اس کے اوپر رکھتا ہے۔ یہ کمپیوٹر کسی ٹیلی وژن یا مانیٹر سے منسلک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính: Nino phát game kín màn hình, kèm cả tiếng, rồi phủ bản dịch lên trên. Cần cắm máy tính vào một chiếc TV hay monitor."
          }
        }
      }
    },
    "settings.connection.cardTVHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التلفاز: تنقل البطاقة صورة PS5 عبر منفذ HDMI الخارج منها نحو التلفاز. يراقب Nino ما تلتقطه البطاقة ويبعث بالترجمة إلى تطبيقه للتلفاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV: card তার HDMI output দিয়ে PS5 থেকে আসা ছবি TV অবধি পৌঁছে দেয়। Nino card-এর feed পড়ে আর তর্জমাটা Nino-র TV app-এ পাঠায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TV: the card passes the PS5 image on to the TV over its HDMI output. Nino watches the card's feed and delivers the translation to Nino's TV app."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "TV: ipinapasa ng card sa TV ang video ng PS5 gamit ang HDMI output nito. Binabantayan ng Nino ang feed nito at inihahatid ang salin papunta sa TV app ng Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी: कार्ड अपने HDMI आउटपुट से PS5 का दृश्य आगे टीवी तक भेजता है। इस कार्ड वाली फ़ीड पर Nino की नज़र रहती है, और भाषांतर Nino के टीवी ऐप तक पहुँचता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV: kartu meneruskan gambar PS5 ke TV lewat output HDMI-nya. Nino memantau sinyal dari kartu, lalu hasil terjemahannya dikirim menuju aplikasi Nino untuk TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV: kad menyalurkan imej PS5 ke TV melalui output HDMI kad itu. Nino memantau suapan kad, lalu terjemahan dikirim kepada aplikasi TV Nino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tv: via zijn HDMI-uitgang geeft de kaart wat de PS5 toont door aan de tv. Nino volgt wat de kaart binnenkrijgt en levert de vertaling af bij Nino's tv-app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวี: การ์ดส่งภาพ PS5 ต่อไปยังทีวีทางพอร์ต HDMI ขาออก Nino อ่านสัญญาณจากการ์ดและส่งคำแปลไปที่แอปทีวีของ Nino"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV: Kart, PS5 görüntüsünü HDMI çıkışı üzerinden televizyona aktarır. Nino kartın görüntüsünü izler, çeviriyi TV'deki Nino uygulamasına iletir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی: کارڈ اپنے HDMI آؤٹ پٹ سے PS5 کی تصویر آگے ٹی وی تک پہنچاتا ہے۔ Nino کارڈ کی فیڈ دیکھتا ہے اور ترجمہ Nino کی ٹی وی ایپ تک پہنچاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV: card đưa hình PS5 sang TV bằng ngõ HDMI ra. Nino đọc tín hiệu từ card rồi chuyển phần dịch đến app TV của Nino."
          }
        }
      }
    },
    "settings.connection.clickHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين يكون هذا مفعلا، تعبر النقرات نحو أي نافذة تقع تحته. أوقفه بـ ⌥⌘L أو من أيقونة Nino في شريط القوائم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি অন থাকলে আপনি যেখানে ক্লিক করবেন, তা নিচে থাকা উইন্ডোয় গিয়ে পড়ে। ⌥⌘L চেপে কিংবা menu bar-এ Nino-র icon থেকে অফ করা যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this on, clicks pass through to whatever window is below. Turn it off with ⌥⌘L or with Nino's menu bar icon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang naka-on ito, lumulusot ang click papunta sa nasa ilalim na window. Patayin gamit ang ⌥⌘L o ang icon ng Nino sa menu bar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऑन हो, तो माउस का हर दबाव सीधा उसके तले वाली खिड़की को मिलता है। ऑफ़ करना हो तो ⌥⌘L दबाएँ, अथवा मेन्यू पट्टी में Nino का आइकन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama aktif, klik tembus ke jendela yang ada di belakang. Matikan dengan ⌥⌘L atau lewat ikon Nino di bar menu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila ini aktif, klik melepasi ke tetingkap di bawahnya. Matikan dengan ⌥⌘L atau ikon Nino pada bar menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee ingeschakeld gaan klikken naar het onderliggende venster. Schakel het uit met ⌥⌘L of via het Nino-symbool in de menubalk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะเปิดตัวเลือกนี้ คลิกจะทะลุไปถึงหน้าต่างที่อยู่ข้างใต้ ปิดได้ด้วย ⌥⌘L หรือไอคอน Nino บนแถบเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu açıkken tıklamalar aşağıdaki pencereye geçer. Kapatmak isterseniz ⌥⌘L tuşlarını kullanın ya da menü çubuğundaki simgeye tıklayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آن ہو تو کلک نیچے موجود ونڈو کو ملتے ہیں۔ اسے ⌥⌘L سے یا مینو بار میں Nino کے آئیکن سے بند کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, cú nhấp sẽ xuyên qua tới cửa sổ nằm dưới. Tắt bằng ⌥⌘L hoặc biểu tượng Nino trên thanh menu."
          }
        }
      }
    },

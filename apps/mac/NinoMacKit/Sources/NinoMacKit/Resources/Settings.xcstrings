    "settings.passcode.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يلزمك هذا إلا إذا طلب PS5 رمز دخول للحساب الثاني. كلما طلبه الجهاز يدخله Nino نيابة عنك. يبقى الرمز محفوظا بأمان في سلسلة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাড়তি account-টি PS5-এ ঢুকতে passcode চাইলে তবেই এটা লাগবে। console যখনই চায়, Nino নিজেই সেটা বসিয়ে দেয়। passcode আপনার Keychain-এ নিরাপদে থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You only need this when the second account uses a sign-in passcode on its PS5. Whenever the console requests it, Nino enters it for you. The passcode stays safe in your Keychain."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan mo lang ito kung may sign-in passcode ang ikalawang account sa PS5 nito. Tuwing hihingin ito ng console, kusa itong ilalagay ng Nino. Ligtas na nakatago ang passcode sa Keychain mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह तभी चाहिए जब दूसरा खाता अपने PS5 में लॉगिन हेतु passcode रखता हो। कंसोल जब माँगे, Nino उसे ख़ुद भर देता है। passcode आपकी Keychain में महफ़ूज़ रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya diperlukan bila akun kedua memakai kode sandi login pada PS5-nya. Setiap kali konsol memintanya, Nino mengisinya untuk Anda. Kode sandi tersimpan aman di Rantai Kunci Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya perlu jika akaun kedua menggunakan kod laluan untuk log masuk ke PS5nya. Setiap kali konsol memintanya, Nino memasukkannya bagi pihak anda. Kod laluan disimpan dengan selamat dalam Rantai Kunci anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit heb je alleen nodig wanneer het tweede account op zijn PS5 een toegangscode heeft om in te loggen. Vraagt de console erom, dan vult Nino hem voor je in. De code blijft veilig in je Sleutelhanger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้เฉพาะเมื่อบัญชีที่สองตั้งรหัสผ่านเข้าสู่ระบบไว้บน PS5 เมื่อคอนโซลขอ Nino จะใส่ให้เอง รหัสนี้เก็บปลอดภัยใน Keychain"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnız ikinci hesap PS5'e girerken şifre istiyorsa gerekir. Konsol şifre sorduğunda Nino onu sizin yerinize yazar; şifre Anahtar Zinciri'nde tutulur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کی ضرورت صرف تب ہے جب دوسرا اکاؤنٹ PS5 پر سائن ان پاس کوڈ رکھتا ہو۔ کنسول جب بھی مانگے، Nino خود بھر دیتا ہے۔ پاس کوڈ آپ کی Keychain میں محفوظ رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần khi PS5 đòi mã đăng nhập cho tài khoản phụ. Mỗi lần máy hỏi, Nino sẽ tự nhập giúp bạn. Mã được cất an toàn trong Keychain."
          }
        }
      }
    },

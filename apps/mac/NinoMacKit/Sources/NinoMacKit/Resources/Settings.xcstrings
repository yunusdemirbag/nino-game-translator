    "settings.interface.toggleHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقلب المفتاح الزجاجي ليهبط تلفاز يعرض ترجمة مباشرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাচের টগলে আলতো ছোঁয়া দিলেই একটা TV ওপর থেকে নেমে এসে চলমান subtitle দেখাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flick the glass toggle and a TV lowers into view, showing a live subtitle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitikin ang salaming toggle at bababa ang isang TV na may live na subtitle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काँच का स्विच पलटें, और एक टीवी उतरकर सामने आता है जिस पर लाइव उपशीर्षक चल रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser tombol kaca, lalu sebuah TV turun ke layar dan menampilkan subtitel langsung."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petik suis kaca itu, lalu sebuah TV turun ke pandangan dengan sari kata langsung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de glazen schakelaar om en er zakt een tv naar beneden met een live ondertitel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดีดสวิตช์กระจก ทีวีจะเลื่อนลงมาพร้อมซับไตเติลสด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cam düğmeyi kaydırın; TV canlı altyazıyla yukarıdan iner."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شیشے کا سوئچ دبائیں تو اوپر سے ایک ٹی وی اترتا ہے جس پر لائیو سب ٹائٹل چلتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gạt công tắc kính, một chiếc TV hạ xuống và chiếu phụ đề ngay lúc đó."
          }
        }
      }
    },

    "settings.connection.guideHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شرح التوصيل خطوة بخطوة لـ PS5 وبطاقة الالتقاط والشاشة، مع طريقة تعطيل HDCP."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, capture card আর display কীভাবে তারে জুড়বেন তার ধাপে ধাপে বিবরণ, সাথে HDCP অফ করার উপায়ও।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step-by-step wiring for PS5, capture card and display, plus turning HDCP off."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunud-sunod na gabay sa pagkabit ng PS5, capture card at display, pati ang pag-off ng HDCP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, capture card और डिस्प्ले की तारें एक-एक कदम में, साथ ही HDCP ऑफ़ करने का तरीका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan kabel langkah demi langkah untuk PS5, kartu capture, dan layar, plus menonaktifkan HDCP."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendawaian langkah demi langkah bagi PS5, kad tangkap dan paparan, termasuk cara mematikan HDCP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stap voor stap de PS5, opnamekaart en het scherm aansluiten, en HDCP uitschakelen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นตอนต่อสายทีละขั้นสำหรับ PS5 การ์ดจับภาพ และจอ รวมถึงการปิด HDCP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, kart ve ekran arasındaki kabloların adım adım bağlanışı; HDCP'nin kapatılması."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5، کیپچر کارڈ اور ڈسپلے جوڑنے کا مرحلہ وار طریقہ، اور HDCP بند کرنا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn nối dây từng bước cho PS5, card ghi hình cùng màn hình, kèm cách tắt HDCP."
          }
        }
      }
    },

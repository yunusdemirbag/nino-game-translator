    "settings.card.black": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقة موصولة لكن صورتها سوداء. أدر جهاز PS5، ثم عطل HDCP."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "card ধরা পড়েছে, তবে ছবিটা পুরো অন্ধকার। আগে PS5 জাগিয়ে তুলুন, এরপর HDCP অফ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can see the card, yet its picture is black. Start up the PS5, then switch HDCP off."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakikita ang card, ngunit madilim na itim ang larawan. Paandarin ang PS5, pagkatapos ay patayin ang HDCP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड तो मिला, मगर दृश्य एकदम काला है। पहले PS5 को ऑन करें, फिर HDCP को ऑफ़ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu terdeteksi, tapi layarnya hitam. Hidupkan PS5, lalu nonaktifkan HDCP."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad dikesan, tetapi gambarnya hitam. Hidupkan PS5, kemudian matikan HDCP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaart is er, maar geeft een zwart beeld. Schakel de PS5 in en zet daarna HDCP uit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจพบการ์ดแล้ว แต่ภาพเป็นสีดำ เปิด PS5 จากนั้นปิด HDCP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart algılandı fakat görüntü kapkara. PS5'i çalıştırıp HDCP ayarını kapatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ مل گیا، لیکن اس کا منظر سیاہ ہے۔ PS5 چالو کریں، پھر HDCP بند کر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã nhận card nhưng hình toàn màu đen. Khởi động PS5 rồi tắt HDCP."
          }
        }
      }
    },

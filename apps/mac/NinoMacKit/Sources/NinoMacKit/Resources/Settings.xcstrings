    "settings.packs.replaceMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد حزمة مثبتة بهذا المعرف. إن استبدلتها فستكتب الجديدة مكان القديمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ID দিয়ে একটা pack আগেই বসানো আছে। বদলালে পুরনোটা মুছে নতুনটা বসবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's already an installed pack that uses this ID. If you replace it, the old one is overwritten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May naka-install nang pack na gumagamit ng ID na ito. Kapag pinalitan mo, mapapatungan ang luma."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसी ID से एक पैक पहले ही लगा हुआ है। बदलेंगे, तो पिछला वाला हट जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah ada paket terpasang dengan ID ini. Jika diganti, paket lama akan ditimpa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah ada pek terpasang yang memakai ID ini. Jika anda menggantikannya, pek lama akan ditulis ganti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is al een pakket met deze ID geïnstalleerd. Vervang je het, dan wordt het oude overschreven."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแพ็กที่ติดตั้งแล้วซึ่งใช้ ID นี้อยู่ หากแทนที่ แพ็กเดิมจะถูกเขียนทับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kimliği taşıyan bir paket zaten yüklü. Değiştirmeyi seçerseniz eskisinin yerine bu yazılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسی ID والا ایک پیک پہلے سے انسٹال ہے۔ بدلنے پر پرانا مٹ کر نیا آ جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một gói đã cài đang dùng ID này. Nếu thay, gói cũ sẽ bị ghi đè."
          }
        }
      }
    },
    "settings.packs.replaceTitle": {

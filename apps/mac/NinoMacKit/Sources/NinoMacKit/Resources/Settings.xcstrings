    "settings.connection.ps5Hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الترجمة على التلفاز، داخل تطبيق Nino للتلفاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "subtitle ওঠে আপনার টেলিভিশনে, Nino-র TV app-এর মধ্যে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitles show up on your television, within Nino's TV app."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa telebisyon mo lilitaw ang subtitle, sa TV app ng Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपशीर्षक आपके टेलीविज़न पर, Nino के टीवी ऐप के भीतर नज़र आते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitel tampil di televisi Anda, di dalam aplikasi TV Nino."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sari kata dipaparkan di televisyen anda, dalam aplikasi TV Nino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondertitels verschijnen op de televisie, binnen de tv-app van Nino."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำบรรยายจะปรากฏบนทีวีของคุณ ภายในแอปทีวี Nino"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazılar televizyonunuzda, Nino'nun TV uygulamasında belirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب ٹائٹل ٹیلی وژن پر، Nino کی ٹی وی ایپ میں نظر آتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ đề xuất hiện trên tivi, trong app TV của Nino."
          }
        }
      }
    },
    "settings.connection.remotePlayHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العب على هذا الجهاز بواسطة PS Remote Play / chiaki-ng. ويتابع Nino نافذتها ليضع الترجمة على اللعبة. الحساب الثاني غير مطلوب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানেই খেলতে PS Remote Play / chiaki-ng চালিয়ে নিন। Nino ওই উইন্ডোয় নজর রেখে খেলার ওপর তর্জমা বিছিয়ে রাখে। বাড়তি কোনো account দরকার পড়ে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use PS Remote Play / chiaki-ng to play here. Nino watches that window and lays the translation over the game. A second account isn't required."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito ka maglaro: PS Remote Play / chiaki-ng. Sinusubaybayan ng Nino ang naturang window at ipinapatong ang salin sa laro. Walang kailangang pangalawang account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ खेलना हो तो PS Remote Play / chiaki-ng चलाएँ। Nino उस खिड़की पर नज़र रखता है और भाषांतर खेल पर बिछाता है। अलग खाता ज़रूरी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Main di sini memakai PS Remote Play / chiaki-ng. Nino memantau jendela itu dan menumpangkan terjemahan pada gambar game. Akun kedua tidak diperlukan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Main di sini melalui PS Remote Play / chiaki-ng. Nino memantau tetingkap itu dan meletakkan terjemahan menindih permainan. Tak perlu akaun kedua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel hier via PS Remote Play / chiaki-ng. Nino volgt dat venster en legt de vertaling over het spel. Een tweede account is niet nodig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นที่นี่ผ่าน PS Remote Play / chiaki-ng โดย Nino อ่านหน้าต่างนั้นและวางคำแปลทับเกม ไม่จำเป็นต้องมีบัญชีที่สองแยก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS Remote Play / chiaki-ng ile bu bilgisayarda oynayın. Nino bu pencereyi izler ve çeviriyi oyunun üzerine yerleştirir. Ek bir hesaba gerek yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں کھیلنے کے لیے PS Remote Play / chiaki-ng استعمال کریں۔ Nino اس ونڈو کو دیکھتا ہے اور ترجمہ گیم پر رکھتا ہے۔ کوئی دوسرا اکاؤنٹ لازم نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi ngay tại đây qua PS Remote Play / chiaki-ng. Nino canh cửa sổ ấy rồi phủ bản dịch lên game. Bạn không phải có thêm tài khoản phụ."
          }
        }
      }
    },

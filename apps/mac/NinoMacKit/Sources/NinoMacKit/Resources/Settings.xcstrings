    "settings.card.whileTranslating": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف معاينة البطاقة مؤقتًا أثناء الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তর্জমা চলাকালে card-এর preview থামানো থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card preview is paused while translating."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-pause ang preview ng card habang nagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषांतर चलते समय इस capture card की झलक रुकी रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau kartu dijeda selama penerjemahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton kad dijeda semasa menterjemah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaartvoorvertoning is gepauzeerd tijdens het vertalen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพตัวอย่างจากการ์ดหยุดชั่วคราวระหว่างแปล"
          }
        },
        "tr": {
          "stringUnit": {

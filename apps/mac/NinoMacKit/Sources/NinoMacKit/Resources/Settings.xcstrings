    "settings.obs.streamHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألا يوفر برنامج البث مصدر متصفح شفافا (كما في TikTok LIVE Studio أو Streamlabs)؟ افتح نافذة البث، والتقطها بخاصية التقاط النافذة (ابحث عن Nino Stream)، ثم أزل الخلفية باستخدام Chroma key."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok LIVE Studio বা Streamlabs-এর মতো streaming software-এ স্বচ্ছ browser source নেই? তাহলে stream উইন্ডো সামনে এনে window capture-এ ধরুন (Nino Stream খুঁজে নিন), এরপর Chroma key দিয়ে পেছনের রংটা মুছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does your streaming software lack a see-through browser source (as with TikTok LIVE Studio or Streamlabs)? Bring up the stream window, then use window capture to grab it (look for Nino Stream) and key out the backdrop using Chroma key."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulang sa see-through na browser source ang streaming app mo (gaya ng TikTok LIVE Studio o Streamlabs)? Ilabas ang stream window, hulihin ito sa window capture (hanapin ang Nino Stream), at tanggalin ang likuran sa Chroma key."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके प्रसारण सॉफ़्टवेयर में पारदर्शी browser source नहीं (मसलन TikTok LIVE Studio या Streamlabs)? प्रसारण वाली खिड़की खोलें, window capture से उसे पकड़ें (Nino Stream चुनें), और Chroma key से पीछे का रंग हटा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi siaran Anda tidak punya browser source transparan (seperti halnya TikTok LIVE Studio atau Streamlabs)? Buka jendela siaran, tangkap dengan window capture (cari Nino Stream), lalu hilangkan latarnya memakai Chroma key."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perisian penstriman anda tiada sumber pelayar lutsinar (seperti TikTok LIVE Studio atau Streamlabs)? Paparkan tetingkap strim, kemudian tangkap tetingkap itu (carilah Nino Stream) lalu hilangkan latar menggunakan Chroma key."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft je streamsoftware geen doorzichtige browserbron (zoals TikTok LIVE Studio of Streamlabs)? Open het streamvenster, leg het vast met vensteropname (zoek naar Nino Stream) en haal de achtergrond weg via Chroma key."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมสตรีมไม่มี browser source แบบโปร่งใส (อย่าง TikTok LIVE Studio หรือ Streamlabs) หรือ? เรียกหน้าต่างสตรีมขึ้นมา แล้วใช้การจับภาพหน้าต่างดึงมันมา (มองหา Nino Stream) และลบพื้นหลังออกด้วย Chroma key"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın yazılımınızda arkası görünen bir tarayıcı kaynağı yok mu (TikTok LIVE Studio, Streamlabs vb.)? Yayın penceresini açıp yazılımda pencere olarak yakalayın (Nino Yayın adını arayın), arka planını da Chroma key filtresiyle temizleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسٹریمنگ سافٹ ویئر میں شفاف براؤزر سورس نہیں (جیسے TikTok LIVE Studio یا Streamlabs)؟ اسٹریم ونڈو کھولیں، window capture سے اسے پکڑیں (Nino Stream تلاش کریں) اور Chroma key سے پس منظر ہٹا دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần mềm stream không có browser source trong suốt (như TikTok LIVE Studio hay Streamlabs)? Mở cửa sổ stream, dùng tính năng bắt cửa sổ để lấy nó (tìm Nino Stream), rồi xoá nền bằng Chroma key."
          }
        }
      }
    },

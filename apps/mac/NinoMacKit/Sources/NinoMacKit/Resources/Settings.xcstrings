        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمے کی فائل درآمد نہ ہو سکی۔ فائل کا فارمیٹ اور ٹیکسٹ انکوڈنگ جانچیں۔"

    "settings.local.nameHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم LM Studio أو نموذجا آخر؟ اكتب اسمه تماما كما يظهر في قائمة الخادم. مع LM Studio، ابدأ بتحميل النموذج ثم فعل الخادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio কিংবা অন্য কোনো model নিয়ে চালাচ্ছেন? আপনার server-এর list-এ যেমন আছে, হুবহু সেই নামটাই লিখবেন। LM Studio হলে আগে model load করে নিন, এরপর ওর server অন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using LM Studio or a different model? Enter its name exactly the way your server lists it. With LM Studio, load that model first, then turn on its server."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May LM Studio ka o ibang model? Isulat ang pangalan nito nang eksakto sa nakalista sa server mo. Kung LM Studio, unahing i-load doon ang model, saka i-on ang server."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio चलाते हैं, या कोई और मॉडल? नाम हूबहू वही लिखें जो आपके सर्वर की सूची में है। LM Studio हो तो पहले उसमें वह मॉडल चढ़ जाने दें, उसके बाद उसका सर्वर ऑन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memakai LM Studio, atau jenis model berbeda? Tulis namanya persis seperti yang tercantum di server Anda. Untuk LM Studio, muat modelnya dulu, baru aktifkan servernya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memakai LM Studio, ataupun model lain? Taip namanya sama persis seperti yang disenaraikan oleh pelayan anda. Bagi LM Studio, muatkan dahulu model itu, kemudian hidupkan pelayannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk je met LM Studio of nog een ander model? Vul de naam exact in zoals jouw server hem noemt. In LM Studio laad je eerst dat model en zet je daarna de server aan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้โมเดลอื่นหรือ LM Studio อยู่ใช่ไหม? พิมพ์ชื่อให้ตรงตามรายการบนเซิร์ฟเวอร์ ถ้าเป็น LM Studio ให้โหลดโมเดลนั้นก่อน แล้วเปิดเซิร์ฟเวอร์ของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio veya farklı bir model mi kullanıyorsunuz? Adını sunucunuzun listesinde nasıl yazıyorsa tıpatıp öyle girin. LM Studio'da önce o modeli belleğe alın, sonra sunucusunu açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio یا کوئی اور ماڈل؟ نام بالکل اسی طرح لکھیں جس طرح سرور کی فہرست میں ہے۔ LM Studio ہو تو پہلے ماڈل لوڈ کریں، پھر سرور آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng LM Studio hay mô hình khác? Nhập tên đúng y như server của bạn liệt kê. Nếu là LM Studio, trước hết nạp mô hình, sau đó mới bật server."
          }
        }
      }
    },

    "settings.area.translateScreen": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة ما يظهر على الشاشة (⌥⌘T)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্দায় যা আছে তর্জমা করুন (⌥⌘T)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate what's on screen (⌥⌘T)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isalin ang nasa screen (⌥⌘T)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परदे पर जो है, उसका भाषांतर (⌥⌘T)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahkan isi layar (⌥⌘T)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah kandungan skrin (⌥⌘T)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles op het scherm vertalen (⌥⌘T)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลทุกอย่างบนจอ (⌥⌘T)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrandakini çevir (⌥⌘T)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین کا متن ترجمہ کریں (⌥⌘T)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch nội dung trên màn hình (⌥⌘T)"
          }
        }
      }
    },
    "settings.area.translateScreenHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء اللعب، اضغط ⌥⌘T لترجمة كل النصوص الظاهرة دفعة واحدة، فتوضع كل ترجمة على التلفاز في مكان نصها تماما. اضغط المفاتيح ذاتها لإزالتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খেলতে খেলতে ⌥⌘T টিপলে পর্দাজুড়ে যত লেখা, সব একসঙ্গে তর্জমা হয়ে যায়; একেকটি তর্জমা TV-তে আসল লেখাটির ঠিক ওপরেই বসে। সরাতে চাইলে ওই একই কী আবার টিপুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During play, press ⌥⌘T to translate everything visible at once; each translation is placed on the TV right where its text sits. Press the same keys to clear them."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa gitna ng laro, pindutin ang ⌥⌘T upang isalin nang sabay ang lahat ng nakikita; bawat salin ay ilalagay sa TV sa mismong puwesto ng teksto nito. Pindutin muli ang parehong key upang burahin ang mga iyon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खेलते वक़्त ⌥⌘T दबाते ही परदे पर नज़र आ रही हर लिखावट का एक साथ भाषांतर बनता है; हर भाषांतर टीवी पर ठीक उसी जगह आता है जहाँ उसकी मूल लिखावट है। इन्हें मिटाने को वही बटन फिर दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat bermain, tekan ⌥⌘T untuk menerjemahkan semua teks yang terlihat sekaligus; tiap terjemahan muncul di TV persis di posisi teks aslinya. Tekan tombol yang sama untuk menghapusnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa bermain, tekan ⌥⌘T untuk menterjemah semua yang kelihatan sekali gus; setiap terjemahan diletakkan di TV tepat pada kedudukan teksnya. Tekan kekunci yang sama untuk mengosongkannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ⌥⌘T vertaal je tijdens het gamen in één keer alle zichtbare tekst; elke vertaling staat op de tv precies waar de tekst zelf staat. Druk nogmaals op dezelfde toetsen om ze te wissen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างเล่น กด ⌥⌘T เพื่อแปลทุกข้อความที่มองเห็นในครั้งเดียว คำแปลแต่ละอันจะวางบนทีวีตรงจุดของข้อความนั้น กดปุ่มเดิมอีกครั้งเพื่อล้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun sırasında ⌥⌘T tuşlarına basınca görünen her yazı tek seferde Türkçeye döner ve TV'de tam yazının durduğu noktaya yerleşir. Temizlemek için aynı tuşlara bir kez daha basın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھیل کے دوران ⌥⌘T دبانے سے سامنے نظر آنے والا سارا متن ایک ساتھ ترجمہ ہو جاتا ہے؛ ہر ترجمہ ٹی وی پر اپنے متن کی جگہ ہی رکھا جاتا ہے۔ ہٹانے کے لیے یہی کلیدیں پھر دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong lúc chơi, bấm ⌥⌘T để dịch cùng lúc mọi chữ đang thấy; từng bản dịch nằm trên TV đúng vị trí của chữ gốc. Bấm lại tổ hợp đó để xoá."
          }
        }
      }
    },

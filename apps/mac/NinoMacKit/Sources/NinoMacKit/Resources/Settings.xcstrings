    "settings.obs.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبث مباشرة عبر بطاقة التقاط؟ أضف مصدر Browser في OBS يشير إلى هذا العنوان، بمقاس 1920 × 1080. عندها تظهر الترجمات فوق اللعبة لك ولمشاهديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "capture card দিয়ে live চালাচ্ছেন? OBS-এ একটা Browser source জুড়ুন, address হবে এটাই, মাপ 1920 × 1080। তাহলে subtitle খেলার ওপরে থাকবে, আপনি আর দর্শক দুজনেই দেখবেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going live through a capture card? Add an OBS Browser source pointed at this address, sized 1920 × 1080. Subtitles then sit over the game, for you and for your viewers."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagla-live sa pamamagitan ng capture card? Maglagay ng OBS Browser source na nakaturo sa address, 1920 × 1080 ang sukat. Lilitaw ang subtitle sa itaas ng laro, para sa iyo at sa mga manonood."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "capture card से लाइव जा रहे? OBS में इस पते वाला Browser source लगाएँ, नाप 1920 × 1080। तब आपको और दर्शकों दोनों को उपशीर्षक खेल पर दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran langsung lewat kartu capture? Tambahkan Browser source di OBS yang mengarah ke alamat ini, ukuran 1920 × 1080. Subtitel lalu tampil di atas game, untuk Anda dan penonton."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersiaran langsung melalui kad tangkap? Tambah sumber Browser OBS yang menghala ke alamat ini, bersaiz 1920 × 1080. Sari kata kemudian terletak di atas permainan, untuk anda dan penonton anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream je via een opnamekaart? Maak een browserbron aan in OBS die naar dit adres wijst, formaat 1920 × 1080. De ondertitels liggen dan over het spel, voor jou en voor je kijkers."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สตรีมผ่านการ์ดจับภาพหรือ? เพิ่ม Browser source ใน OBS ชี้มาที่ที่อยู่นี้ ขนาด 1920 × 1080 แล้วซับไตเติลจะอยู่บนเกม ทั้งสำหรับคุณและผู้ชม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Card'la mı yayın açıyorsunuz? OBS'e, bu adresi açan yeni bir Tarayıcı kaynağı koyun; boyutu 1920 × 1080 olsun. Altyazılar böylece oyunun üzerinde hem sizin ekranınızda hem izleyicilerde görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر کارڈ کے ساتھ لائیو جانا ہے؟ OBS میں Browser source شامل کر کے اسے اس پتے پر رکھیں، سائز 1920 × 1080۔ یوں سب ٹائٹل آپ اور ناظرین دونوں کو کھیل کے اوپر دکھیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát trực tiếp qua card ghi hình? Thêm một Browser source trong OBS trỏ tới địa chỉ này, cỡ 1920 × 1080. Phụ đề sẽ nằm trên game cho cả bạn lẫn người xem."
          }
        }
      }
    },
    "settings.obs.keepOpen": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك هذه النافذة مفتوحة وغير محجوبة طوال البث. تواصل الترجمات الظهور فيها ما دمت تترجم، حتى لو كان إعدادك يرسلها إلى التلفاز فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "stream চলাকালে এই উইন্ডো সবসময় খুলে রাখবেন, অন্য কিছুর আড়ালেও যেন না পড়ে। তর্জমা চললে subtitle এতে আসতেই থাকে, setup সেগুলো কেবল TV-তেই পাঠালেও।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this window open and unblocked during your stream. Subtitles keep appearing in it while you translate, even if your setup sends them only to the TV."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwag isara o takpan ang window na ito habang naka-stream ka. Tuloy-tuloy lilitaw dito ang subtitle habang may salin, kahit TV lamang ang padalhan ng setup mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव चलते समय यह खिड़की खुली रखें, उसे बेरोक छोड़ें। भाषांतर चलता रहे तो उपशीर्षक इसमें आते रहते हैं, भले आपका सेटअप उन्हें केवल टीवी को भेजता हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan jendela ini tetap terbuka tanpa terhalang apa pun selama siaran. Subtitel terus muncul di sini selama penerjemahan, walau pengaturan Anda hanya mengirimnya ke TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan tetingkap ini terbuka tanpa dilindungi apa-apa sepanjang siaran. Sari kata terus dipaparkan di situ semasa anda menterjemah, walaupun tetapan anda hanya menghantarnya ke TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd dit venster tijdens het streamen open en onbedekt. Zolang je vertaalt, verschijnen de ondertitels hierin, ook als ze volgens je instelling alleen naar de tv gaan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหน้าต่างนี้ค้างไว้ และอย่าให้ถูกบังขณะสตรีม ซับไตเติลจะขึ้นในนี้ตลอดที่แปล แม้ตั้งค่าให้ส่งไปแค่ทีวีก็ตาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın süresince bu pencereyi kapatmayın ve üstünü başka bir pencereyle örtmeyin. Çeviri sırasında altyazılar, kurulumunuz onları sadece TV'ye gönderse de burada da belirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسٹریم کے دوران یہ ونڈو کھلی رکھیں اور کسی چیز کے نیچے نہ چھپائیں۔ ترجمہ چلتے ہوئے سب ٹائٹل اس میں آتے رہتے ہیں، چاہے ترتیب انہیں صرف ٹی وی پر بھیجے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong khi stream, hãy để cửa sổ này mở, đừng che nó. Phụ đề vẫn hiện ở đây suốt lúc dịch, ngay cả khi bạn chỉ gửi chúng ra TV."
          }
        }
      }
    },

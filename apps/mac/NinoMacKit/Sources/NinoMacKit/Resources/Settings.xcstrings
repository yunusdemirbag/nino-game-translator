    "settings.interface.livingRoomHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الكابل في المقبس لتشغيل الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্লাগটা দেয়ালের সকেটে গুঁজে দিন, subtitle জ্বলে উঠবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push the plug into the wall socket and the subtitles come on."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isaksak sa pader ang plug at sisindi ang subtitle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लग को दीवार में घुसाएँ, और उपशीर्षक जल उठते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokkan kabel ke stopkontak untuk menyalakan subtitle."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucuk palam ke soket dinding, dan sari kata pun menyala."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steek de stekker in het stopcontact en de ondertitels gaan aan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบปลั๊กเข้าเต้าบนผนัง แล้วซับไตเติลจะติดขึ้นมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fişi prize sokun, altyazılar yansın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پلگ دیوار کے ساکٹ میں لگائیں اور سب ٹائٹل جل اٹھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm phích vào ổ điện trên tường là phụ đề bật lên."

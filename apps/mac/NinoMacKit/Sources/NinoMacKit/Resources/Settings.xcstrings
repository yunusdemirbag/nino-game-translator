    "settings.card.working": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقة تعمل وصورة PS5 تصل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "card ঠিকমতো কাজ করছে, PS5-এর ছবিও পৌঁছাচ্ছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card works fine and the PS5 image is arriving."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagana nang maayos ang card at dumarating na ang video ng PS5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड ठीक चल रहा है, PS5 का दृश्य पहुँच रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu berfungsi dan gambar PS5 sudah masuk."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad berfungsi dan gambar PS5 sedang diterima."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",

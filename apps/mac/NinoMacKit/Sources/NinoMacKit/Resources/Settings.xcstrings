    "settings.packs.share": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال الترجمات الإنجليزية المقروءة إلى المجمّع المشترك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino যা পড়ে, সেই ইংরেজি বাক্যগুলো সবার ভাণ্ডারে দিন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the English lines Nino reads with the common pool"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibahagi sa pangkalahatang pool ang mga Ingles na linyang binabasa ng Nino"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino जो इंग्लिश पंक्तियाँ पढ़ता है, वे साझा भंडार को दें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim baris Inggris yang dibaca Nino ke kumpulan bersama"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kongsi baris Inggeris yang dibaca Nino dengan kumpulan bersama"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Engelse regels die Nino leest delen met de gezamenlijke verzameling"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบ่งปันบรรทัดภาษาอังกฤษที่ Nino อ่านเข้าคลังกลาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunan altyazıları (İngilizce) ortak havuzla paylaş"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino جو انگریزی سطریں پڑھتا ہے، انہیں مشترکہ ذخیرے میں دیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Góp các câu tiếng Anh Nino đọc được vào kho chung"
          }
        }
      }
    },
    "settings.packs.shareHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل نص اللعبة الإنجليزي فقط، دون اسمك. يساعد ذلك على تحسين الترجمات التركية للجميع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খেলার যে বাক্যগুলো ইংরেজি ভাষায় আসে, Nino কেবল সেগুলোই পাঠায়, আপনার নাম কখনো নয়। এতে সকলে আরও উন্নত তুর্কি পান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino shares just the English lines from the game, never your name. That way everyone ends up with better Turkish."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingles na linya lang mula sa laro ang ibinabahagi ng Nino, hindi kailanman ang pangalan mo. Sa ganoon, gaganda ang Turkish para sa lahat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino केवल खेल की इंग्लिश पंक्तियाँ भेजता है, आपका नाम हरगिज़ नहीं। इससे हर किसी को उम्दा तुर्की पाठ मिलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino hanya membagikan baris Inggris dari game, tak pernah nama Anda. Dengan begitu, semua orang mendapat terjemahan Turki yang makin bagus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino hanya berkongsi baris Inggeris daripada permainan, bukan nama anda. Dengan itu, semua orang menikmati terjemahan Turki yang makin bagus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino deelt alleen de Engelse regels uit het spel, nooit je naam. Zo krijgt iedereen beter Turks."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino แบ่งปันเฉพาะบรรทัดภาษาอังกฤษจากเกม ไม่ส่งชื่อของคุณ ทุกคนจึงได้คำแปลภาษาตุรกีคุณภาพสูงขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilen yalnızca oyundaki İngilizce yazıdır, adınız eklenmez. Böylece Türkçe çeviriler herkes için iyileşir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino گیم کی صرف انگریزی سطریں بھیجتا ہے، آپ کا نام کبھی نہیں۔ اس طرح سب کو بہتر ترکی ملتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino chỉ chia sẻ các câu tiếng Anh lấy từ game, không bao giờ gửi tên bạn. Nhờ vậy ai cũng có bản tiếng Thổ hay hơn."
          }
        }
      }
    },

    "settings.local.downloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع التنزيل. تأكد أنك متصل بالإنترنت وأن Ollama قيد التشغيل، ثم حاول مجددا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাউনলোড মাঝপথে আটকে গেল। নেট আছে কি না আর Ollama চলছে কি না পরখ করে ফের করে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download stopped partway. Make sure you're online and Ollama is running, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naputol ang download. Tiyaking online ka at tumatakbo ang Ollama, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड अधूरा रुक गया। नेट और Ollama दोनों चालू हैं, यह जाँचकर दोबारा आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan terputus di tengah jalan. Pastikan Anda online dan Ollama berjalan, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun terhenti di tengah jalan. Pastikan anda dalam talian dan Ollama berjalan, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het downloaden is halverwege gestopt. Kijk of je online bent en Ollama draait, en doe dan nog een poging."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดหยุดกลางคัน ตรวจว่าออนไลน์อยู่และ Ollama กำลังทำงาน แล้วลองอีกที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme yarıda kaldı. Çevrimiçi olduğunuzdan ve Ollama'nın çalıştığından emin olup tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈاؤن لوڈ بیچ میں رک گیا۔ انٹرنیٹ اور Ollama دونوں چل رہے ہوں، پھر ایک بار اور آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống bị dừng giữa chừng. Hãy chắc rằng bạn có mạng và Ollama đang chạy, rồi thử lại."
          }
        }
      }
    },

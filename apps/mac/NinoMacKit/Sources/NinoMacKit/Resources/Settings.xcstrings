    "settings.obs.otherComputer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل OBS على كمبيوتر آخر؟ استبدل localhost بعنوان IP المحلي لهذا الـ Mac. لا تظهر الترجمات في الطبقة إلا أثناء الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS কি আলাদা computer-এ? localhost সরিয়ে এই Mac-এর local IP বসান। overlay-তে subtitle কেবল তর্জমা চলাকালেই আসে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is OBS on a separate computer? Swap localhost for the local IP of this Mac. Subtitles appear in the overlay only during translation."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa ibang computer ba ang OBS? Ipalit sa localhost ang lokal na IP nitong Mac. Sa overlay, lumalabas lang ang subtitle habang nagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS किसी अलग computer पर चलता है? localhost हटाकर इस Mac का local IP भरें। ओवरले पर उपशीर्षक केवल भाषांतर चलते समय आते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS ada di komputer lain? Ganti localhost dengan IP lokal Mac ini. Subtitel hanya tampil di overlay selama penerjemahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS berada pada komputer lain? Tukar localhost kepada IP setempat Mac ini. Sari kata hanya muncul dalam tindihan semasa terjemahan berjalan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat OBS op een tweede computer? Vervang localhost door het lokale IP-adres van deze Mac. Ondertitels staan alleen in de overlay terwijl er vertaald wordt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS อยู่บนคอมพิวเตอร์อีกเครื่องหรือ? เปลี่ยน localhost เป็น IP ภายในของ Mac เครื่องนี้ ซับไตเติลจะขึ้นในโอเวอร์เลย์เฉพาะตอนแปลเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS ayrı bir bilgisayarda mı? localhost'u silip bu Mac'in yerel IP adresini yazın. Altyazılar katmanda sadece çeviri devam ederken çıkar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS کسی الگ کمپیوٹر پر ہے؟ localhost کی جگہ اس Mac کا مقامی IP لکھیں۔ سب ٹائٹل اوورلے میں صرف ترجمے کے وقت آتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS nằm trên máy khác? Đổi localhost thành IP nội bộ của Mac này. Phụ đề chỉ hiện trong lớp phủ khi đang dịch."
          }
        }
      }
    },

            "state": "translated",
            "value": "không thoát"
          }
        }
      }
    },
    "tv.helper.endedWithoutResult": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف nino-tv-helper دون نتيجة (رمز الخروج %1$@): %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper কোনো ফল ছাড়াই থেমে গেছে (এক্সিট কোড %1$@): %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper stopped without a result (exit code %1$@): %2$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huminto ang nino-tv-helper nang walang resulta (exit code %1$@): %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper बिना नतीजे के रुक गया (एग्ज़िट कोड %1$@): %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper berhenti tanpa hasil (kode keluar %1$@): %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper berhenti tanpa hasil (kod keluar %1$@): %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper is gestopt zonder resultaat (afsluitcode %1$@): %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper หยุดทำงานโดยไม่มีผลลัพธ์ (รหัสออก %1$@): %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper sonuç vermeden durdu (çıkış kodu %1$@): %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper بغیر نتیجے کے رک گیا (ایگزٹ کوڈ %1$@): %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper đã dừng mà không có kết quả (mã thoát %1$@): %2$@"
          }
        }
      }
    },
    "tv.helper.missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا نجد ملف nino-tv-helper التابع لـ Nino. نزّل Nino مرة أخرى وثبّته من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino-র nino-tv-helper ফাইলটি পাওয়া যাচ্ছে না। Nino আবার নামিয়ে নতুন করে ইনস্টল করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino's nino-tv-helper file can't be found. Download Nino again and reinstall it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mahanap ang nino-tv-helper file ni Nino. I-download ulit si Nino at i-install muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में nino-tv-helper नहीं है। Nino को फिर से डाउनलोड करके इंस्टॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper tidak ada di dalam aplikasi. Unduh dan instal Nino lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail nino-tv-helper milik Nino tidak dijumpai. Dapatkan Nino sekali lagi dan pasang semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand nino-tv-helper van Nino ontbreekt. Download Nino opnieuw en installeer het nog een keer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบ nino-tv-helper ในแอป ดาวน์โหลดและติดตั้ง Nino ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "nino-tv-helper uygulamanın içinde yok. Nino'yu yeniden indirip kurun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ میں nino-tv-helper موجود نہیں۔ Nino کو دوبارہ ڈاؤن لوڈ اور انسٹال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng thiếu nino-tv-helper. Hãy tải về và cài lại Nino."
          }
        }
      }
    },

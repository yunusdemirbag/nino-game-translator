{
  "sourceLanguage": "en",
  "strings": {
    "tv.helper.didNotExit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنهِ عمله"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ হয়নি"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "did not exit"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "hindi nag-exit"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद नहीं हुआ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tidak keluar"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "tidak keluar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "niet afgesloten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ปิดตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kapanmadı"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند نہیں ہوا"
          }
        },
        "vi": {

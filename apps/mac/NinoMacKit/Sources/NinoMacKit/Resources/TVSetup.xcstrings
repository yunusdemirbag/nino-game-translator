    "tv.lg.versionNotVisible": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يظهر الإصدار %1$@ على التلفاز؛ ردّ التثبيت: %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংস্করণ %1$@ TV-তে দেখা যায়নি; ইনস্টলের উত্তর: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV doesn't list version %1$@; installer replied: %2$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi lumabas sa TV ang version %1$@; sagot ng install: %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्ज़न %1$@ टीवी पर नहीं दिखा; इंस्टॉल का जवाब: %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi %1$@ tidak muncul di TV; balasan instalasi: %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi %1$@ tidak muncul pada TV; balasan pemasangan: %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv toont versie %1$@ niet; antwoord van het installatieprogramma: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชัน %1$@ ไม่ปรากฏบนทีวี คำตอบจากการติดตั้ง: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de %1$@ sürümü görünmedi; kurulum yanıtı: %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ورژن %1$@ ٹی وی پر نظر نہیں آیا؛ انسٹال کا جواب: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV không có phiên bản %1$@ trong danh sách; trình cài đặt trả lời: %2$@"
          }
        }
      }
    },
    "tv.test.line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة للتجربة. هل تظهر لك فوق اللعبة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একটি পরীক্ষার সাবটাইটেল। গেমের উপর কি দেখা যাচ্ছে?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test subtitle here. Is it visible over your game?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Test subtitle ito. Kita mo ba habang naglalaro?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेस्ट सबटाइटल। क्या गेम पर यह नज़र आ रहा है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini subtitle uji. Apakah terlihat di atas game?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini sari kata ujian. Nampak di atas permainan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier een proefondertitel. Zie je deze tekst boven je spel?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซับทดสอบอยู่ตรงนี้ มองเห็นบนเกมไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir test altyazısı. Oyunun üzerinde görünüyor mu?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آزمائشی سطر ہے۔ کیا گیم کے اوپر صاف دکھ رہی ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một dòng phụ đề để thử. Nó có hiện trên trò chơi không?"
          }
        }
      }
    }
  },
  "version": "1.0"
}

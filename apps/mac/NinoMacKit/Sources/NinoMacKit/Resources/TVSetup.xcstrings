    "tv.install.sendLog": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تكرر ذلك، أرسل إلينا هذا الملف: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বারবার এমন হলে এই ফাইলটি আমাদের পাঠান: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still happening? Share this file with us: %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nangyayari pa rin? Ibahagi mo sa amin itong file: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब भी हो रहा है? यह फ़ाइल हमें भेजें: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih terjadi? Kirimkan berkas ini kepada kami: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih berlaku? Kongsikan fail ini dengan kami: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebeurt het nog steeds? Stuur ons dit bestand: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเป็นอยู่? แชร์ไฟล์นี้ให้ทีมเรา: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun sürerse bize bu dosyayı gönderin: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسئلہ اب بھی ہے؟ یہ فائل ہمیں بھیج دیں: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn bị lỗi? Gửi tệp sau đây để chúng tôi xem giúp: %@"
          }
        }
      }
    },

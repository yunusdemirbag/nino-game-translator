    "sheets.device.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرفق مع بلاغاتك كي نعرف إعدادك دون أن نسألك. لا تتضمن أبدًا أسماء ولا أرقامًا تسلسلية ولا عناوين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কিছু পাঠালে এগুলোও সাথে যায়, তাই প্রশ্ন না করেই আমরা আপনার সেটআপ জানি। এতে কারও নাম, ক্রমিক নং বা বাসার হদিস কখনো থাকে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Included with your reports, so we know your setup without having to ask. It never contains names, serials or addresses."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasama ito sa bawat ulat mo para alam namin ang setup mo nang hindi na nagtatanong. Hindi ito kailanman naglalaman ng pangalan, serial o address."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी शिकायतों के संग यह भी पहुँचता है, ताकि बगैर पूछे हमें आपका सेटअप समझ आ जाए। इसमें नाम, पते या मशीन नंबर कभी नहीं रहते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikut dikirim bersama laporan Anda, jadi kami paham susunan perangkat Anda tanpa perlu bertanya. Isinya tak pernah memuat nama, nomor seri, maupun alamat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disertakan bersama laporan anda agar persediaan anda dapat kami fahami tanpa bertanya. Ia tidak sesekali memuatkan nama, nombor siri ataupun alamat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat mee met je meldingen, zodat we je opstelling kennen zonder ernaar te vragen. Namen, serienummers en adressen staan er nooit in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนบไปกับรายงานของคุณ เราจะได้รู้ว่าคุณใช้อุปกรณ์อะไรโดยไม่ต้องถามเพิ่ม ในนี้ไม่มีทั้งชื่อ เลขซีเรียล และที่อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimlerinize eklenir; böylece kurulumunuzu size sormadan öğreniriz. İçinde ad, seri no veya adres bulunmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹوں میں خود شامل ہو جاتی ہے، تاکہ ہمیں آپ کا سیٹ اپ پوچھنا نہ پڑے۔ نام، سیریل یا پتے اس میں کبھی نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi kèm mỗi báo cáo, nhờ vậy chúng tôi nắm được cấu hình của bạn, khỏi phải hỏi. Tuyệt đối không có tên, số serial hay địa chỉ."
          }
        }
      }
    },

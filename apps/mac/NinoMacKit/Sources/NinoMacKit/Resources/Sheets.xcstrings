    "sheets.history.clearMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف كل سطر محفوظ من هذا الـ Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এর সব জমানো লাইন চিরতরে মোছা হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every saved line is deleted from this Mac."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabubura sa iyong Mac ang bawat nakatabing linya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सहेजी पंक्ति इस Mac से मिटा दी जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh baris tersimpan akan terhapus dari Mac ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap baris tersimpan akan dipadam daripada Mac ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle opgeslagen regels verdwijnen van deze Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกบรรทัดที่เก็บไว้จะถูกลบจาก Mac ตัวนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı bütün satırlar bu Mac'ten silinir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر محفوظ جملہ اس Mac سے حذف ہو جائے گا۔"

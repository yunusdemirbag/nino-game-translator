    "sheets.health.tvApp.approvalAdvice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر غالبًا نافذة على التلفاز: أشّر على «Always allow from this computer» ثم اختر Allow."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-তে একটি বার্তা দেখা দেবে: “Always allow from this computer” টিক চিহ্ন দিয়ে এরপর Allow চাপুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A prompt should be on the TV: check “Always allow from this computer”, then select Allow."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat may lumabas na tanong sa TV: lagyan ito ng check, “Always allow from this computer”, saka piliin ang Allow."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी पर अभी एक सवाल आएगा: “Always allow from this computer” को चुनकर Allow दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mestinya ada permintaan di TV: beri tanda pada “Selalu izinkan dari komputer ini”, lalu pilih Izinkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepatutnya ada gesaan pada TV: tanda “Always allow from this computer”, kemudian pilih Allow."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de tv hoort een melding te verschijnen. Kies daar Toestaan, met het vinkje bij “Altijd toestaan vanaf deze computer”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนทีวีควรมีหน้าต่างขึ้นมา: ติ๊ก “Always allow from this computer” แล้วเลือก Allow"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de bir onay penceresi açılmış olmalı. Önce “Bu bilgisayardan her zaman izin ver” seçeneğine tik koyun, ardından İzin ver'e basın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی پر ایک اجازت کا پیغام دکھنا چاہیے: “Always allow from this computer” کو منتخب کر کے Allow دبائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên TV sẽ có một hộp thoại: tích vào ô “Luôn cho phép từ máy tính này”, xong chọn Cho phép."
          }
        }
      }
    },
    "sheets.health.tvApp.developerModeAdvice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تشغيل وضع المطوّرين في التلفاز. إعدادات التلفاز في Nino ترشدك خطوة بخطوة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode চালু না থাকলে TV-তে কাজ হবে না। কীভাবে চালু করবেন, তা Nino-র TV সেটিংস ধাপে ধাপে বুঝিয়ে দেবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV needs developer mode turned on. Nino's TV settings walk you through it."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangang i-on sa TV ang developer mode. Gagabayan ka ng TV settings ni Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी में Developer mode ऑन किए बिना काम नहीं चलेगा। Nino की टीवी सेटिंग आपको इसका हर कदम बताती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV harus dalam mode pengembang. Pengaturan TV di Nino memandu Anda langkah demi langkah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV perlu mengaktifkan mod pembangun. Tetapan TV dalam Nino akan membimbing anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv moet in ontwikkelaarsmodus staan. De tv-instellingen van Nino helpen je daarbij."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีต้องเปิดโหมดนักพัฒนา การตั้งค่าทีวีใน Nino จะพาทำทีละขั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de geliştirici modunun açılması gerekiyor. Nino'nun TV ayarları bunu adım adım gösterir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی پر ڈویلپر موڈ آن کریں۔ Nino کی ٹی وی والی ترتیبات میں اس کا طریقہ قدم بہ قدم بتایا گیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV cần bật chế độ lập trình viên. Phần thiết lập TV của Nino sẽ chỉ bạn cách làm."
          }
        }
      }
    },

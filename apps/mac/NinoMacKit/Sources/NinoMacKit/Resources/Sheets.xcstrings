    "sheets.health.cause.slow.action %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة السطر الواحد تأخذ %@ ث. تأكّد أنك متصل بالشبكة؛ وإن بدا كل شيء سليمًا، فبدّل إلى مجمّع Nino Game Translator (مجاني)، تجده في الإعدادات › الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইনপিছু ভাষান্তরে %@ সে. লাগছে। আপনি অনলাইন তো? সবকিছু ঠিক মনে হলে সেটিংস › অনুবাদ-এ Nino Game Translator পুল (ফ্রি)-এ চলে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every line needs %@ s to translate. Make sure you're online; if everything looks fine, switch to Nino Game Translator Pool (free) under Settings › Translation."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s ang inaabot ng bawat linya bago maisalin. Tiyaking may internet ka; kung maayos ang lahat, lumipat sa Nino Game Translator Pool (libre) sa Settings › Pagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पंक्ति के भाषांतर में %@ s लगते हैं। इंटरनेट जुड़ा हो, यह पक्का करें; सब ठीक दिखे तो Nino Game Translator पूल (मुफ़्त) चुनें (सेटिंग › अनुवाद)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiap baris butuh %@ dtk untuk diterjemahkan. Pastikan Anda online; jika semua tampak normal, buka Pengaturan › Terjemahan lalu pilih Pool Nino Game Translator (gratis)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap baris perlu %@ s untuk diterjemah. Pastikan anda dalam talian; jika semuanya baik, tukar ke Kumpulan Nino Game Translator (percuma) di Tetapan › Terjemahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke regel duurt %@ s om te vertalen. Controleer je internet; is dat in orde, kies dan in Instellingen › Vertaling de Nino Game Translator-pool (gratis)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละบรรทัดใช้ %@ วินาทีในการแปล ดูว่าออนไลน์อยู่ ถ้าทุกอย่างปกติดี ให้เปลี่ยนไปใช้คลัง Nino Game Translator (ฟรี) ในส่วนการตั้งค่า › การแปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satırın çevrilmesi %@ sn alıyor. Çevrimiçi olduğunuzdan emin olun; her şey yolundaysa Ayarlar › Çeviri bölümünden Nino Game Translator Havuzu'na (ücretsiz) geçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر سطر کے ترجمے میں %@ s لگتے ہیں۔ دیکھیے کہ آپ آن لائن ہیں؛ سب ٹھیک لگے تو ترتیبات › ترجمہ میں Nino Game Translator پول (مفت) پر جائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi câu mất %@ giây để dịch. Xem lại kết nối Internet; nếu mọi thứ đều ổn, hãy đổi sang Kho Nino Game Translator (miễn phí) ở Cài đặt › Dịch."
          }
        }
      }
    },
    "sheets.health.cause.slow.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمة بطيئة: الإنترنت أو خدمة الترجمة بطيئة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাষান্তর ধীর: নেট বা অনুবাদক পিছিয়ে পড়ছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translations are slow: the internet or the translator is lagging"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabagal ang pagsasalin: mabagal ang internet mo o ang translation service"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषांतर धीमा है: इंटरनेट या अनुवादक पिछड़ रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan lambat: internet Anda atau layanan terjemahan lambat"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan perlahan: internet anda atau perkhidmatan terjemahan perlahan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vertalen gaat traag: je internet of de vertaaldienst is traag"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแปลช้า: อินเทอร์เน็ตหรือบริการแปลของคุณช้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviriler yavaş: internet veya çeviri hizmeti ağır kalıyor"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمہ سست ہے: آپ کا انٹرنیٹ یا ترجمہ سروس سست ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch chậm: internet hoặc dịch vụ dịch đang chậm"
          }
        }
      }
    },
    "sheets.health.cause.tvDropped.action %d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد التلفاز ربطه %d مرة. اترك Nino يعمل على التلفاز؛ ويجب أن يكون التلفاز وجهاز Mac على شبكة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র লিংক %d বার ছিঁড়েছে। TV-র পর্দায় Nino চলতে দিন; TV ও এই Mac একটাই নেটে থাকা চাই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV lost its link %d times. Leave Nino running on the TV; the TV and this Mac must be on one network."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%d beses naputol ang ugnayan ng TV. Hayaang bukas si Nino sa TV; dapat nasa iisang network ang TV at ang iyong Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी %d दफ़ा जुड़ाव खो बैठा। टीवी में Nino चलता छोड़ दें; टीवी और यह Mac एक ही राउटर पर हों।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TV kehilangan tautannya %d kali. Biarkan Nino tetap jalan di TV; TV dan Mac ini wajib berada di satu jaringan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TV terputus pautan %d kali. Biarkan Nino terus berjalan di TV; TV dan Mac ini perlu berada pada satu rangkaian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv verloor %d keer de link. Laat Nino draaien op de tv; tv en Mac moeten op één netwerk zitten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีวีหลุดลิงก์ไป %d ครั้ง เปิด Nino ทิ้งไว้บนทีวี โดยทีวีกับ Mac ตัวนี้ต้องอยู่เน็ตวงเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nin bağlantısı %d kez kesildi. TV'de Nino açık kalsın; TV ile bu Mac aynı ağı kullanmalı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کا رابطہ %d بار ٹوٹا۔ ٹی وی میں Nino کو چلتا رہنے دیجیے؛ ٹی وی اور یہ Mac، دونوں ایک نیٹ ورک پر ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV mất liên kết %d lần. Để Nino chạy trên TV; TV và Mac này phải chung một mạng."
          }
        }
      }
    },
    "sheets.health.cause.tvDropped.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد تطبيق التلفاز اتصاله بهذا الـ Mac"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino-র TV অ্যাপ আর এই Mac-এর মধ্যে লিংক ছিঁড়েছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino's TV app has lost its link to this Mac"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naputol ang ugnayan ng TV app ni Nino sa iyong Mac"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino का टीवी ऐप इस Mac से कट गया है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi TV kehilangan koneksi ke Mac ini"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi TV kehilangan sambungan ke Mac ini"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv-app verloor de verbinding met deze Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปทีวีของ Nino หลุดลิงก์กับ Mac ตัวนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun TV uygulaması bu Mac'ten koptu"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کی ٹی وی ایپ کا اس Mac سے رابطہ ٹوٹ گیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App TV của Nino đã mất liên kết với Mac này"
          }
        }
      }
    },
    "sheets.health.checks.lastSession": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه من آخر جلسة ترجمة. يقيس Nino مجددًا عند بدء الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই হিসাব আপনার শেষ ভাষান্তর সেশনের। ভাষান্তর আরম্ভ হলেই Nino ফের মাপবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These numbers come from your last translation session. Nino checks again once you start translating."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Galing sa huli mong session ng pagsasalin ang mga numerong ito. Susuriin ulit ni Nino pagsimula mo ng pagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये आँकड़े आपके पिछले भाषांतर सत्र के हैं। अगली दफ़ा भाषांतर आरंभ करते ही Nino इन्हें नए सिरे से परखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka-angka ini berasal dari sesi terjemahan terakhir. Nino memeriksa ulang begitu Anda mulai menerjemahkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka ini daripada sesi terjemahan terakhir anda. Nino menyemak semula sebaik terjemahan dimulakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze cijfers komen uit je vorige vertaalsessie. Nino meet opnieuw zodra je weer gaat vertalen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขเหล่านี้มาจากการแปลรอบล่าสุดของคุณ Nino จะเช็กใหม่ตอนที่เริ่มแปลรอบหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar son çeviri oturumundan. Çeviriyi başlatınca Nino yeniden ölçer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اعداد آپ کے پچھلے ترجمہ سیشن کے ہیں۔ ترجمے کا آغاز ہوتے ہی Nino پھر سے جانچتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số liệu dưới đây lấy từ lần dịch trước. Nino kiểm tra lại ngay khi bạn bật dịch."
          }
        }
      }
    },
    "sheets.health.checks.noData": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ الترجمة، ثم واصل اللعب بضع دقائق. يفحص Nino الاتصال بينما تلعب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাষান্তর আরম্ভ করে দু-চার মিনিট ধরে খেলুন। খেলা চলার মধ্যেই Nino লিংক মেপে দেখে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin translating, then keep playing a couple of minutes. Nino checks the connection as you play."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsimulang magsalin, saka maglaro nang mga dalawang minuto. Sinusuri ni Nino ang ugnayan habang ikaw ay naglalaro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषांतर आरंभ कर, कुछ देर खेलते रहें। जब तक खेल चलता है, Nino जुड़ाव परखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulailah menerjemahkan, kemudian main terus selama beberapa menit. Nino memeriksa sambungan sambil Anda bermain."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan terjemahan, kemudian terus bermain dua tiga minit. Nino menyemak sambungan sambil anda bermain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start het vertalen en speel nog een paar minuten door. Nino test de verbinding tijdens het spelen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มแปลแล้วเล่นต่อสักสองสามนาที Nino จะเช็กการเชื่อมขณะที่คุณเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviriye başlayın ve bir iki dakika oynayın. Nino oyun sırasında bağlantıyı denetler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمہ شروع کیجیے، پھر دو چار منٹ کھیلتے رہیے۔ کھیل کے دوران Nino کنکشن جانچتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật dịch rồi chơi thêm dăm phút. Nino theo dõi kết nối song song khi bạn chơi."
          }
        }
      }
    },
    "sheets.health.consoleAdvice.asleep": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز PS5 مطفأ أو يرتاح. شغّله، وإلا ففعّل «البقاء متصلاً بالإنترنت» ضمن خيارات وضع الراحة في PS5."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 অফ বা বিশ্রামে। এটি অন করে দিন; নয়তো PS5-এর বিশ্রাম মোডের বিকল্পে “Stay connected to the internet” অন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 is switched off or resting. Switch it on, or enable “Stay connected to the internet” under the PS5's rest mode options."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Patay o nagpapahinga ang PS5. Buksan ito, o buhayin ang opsyong “Stay connected to the internet” na nasa rest mode ng PS5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ऑफ़ है या आराम मोड पर है। उसे ऑन करें, या PS5 की Rest Mode सेटिंग के भीतर “Stay connected to the internet” को ऑन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 sedang mati atau beristirahat. Hidupkan, atau nyalakan “Tetap Terhubung ke Internet” pada opsi mode istirahat PS5."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 sedang tutup atau berehat. Hidupkannya, atau aktifkan “Stay connected to the internet”, iaitu di bawah pilihan mod rehat PS5."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 is uitgeschakeld of in rust. Schakel hem in, of schakel “Verbonden blijven met het internet” in bij de rustmodusopties van de PS5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ปิดเครื่องหรือพักเครื่องอยู่ ให้เปิดเครื่อง หรือเลือก “Stay connected to the internet” ในตัวเลือกโหมดพักของ PS5"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 kapalı veya dinlenmede. Konsolu açın; dilerseniz dinlenme modu seçeneklerinde şu ayarı da açın: “İnternete bağlı kal”."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 آف ہے یا آرام کی حالت میں۔ اسے آن کیجیے، یا PS5 کی rest mode ترتیبات کے اندر “Stay connected to the internet” فعال کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy PS5 hiện tắt hoặc đang nghỉ. Hãy mở máy lên, hoặc chọn “Duy trì kết nối Internet” ở phần thiết lập Chế độ nghỉ của PS5."
          }
        }
      }
    },
    "sheets.health.consoleAdvice.inUseElsewhere": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز آخر فتح Remote Play. أنهِه من ذلك الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play আরেকটি যন্ত্রে চলছে। ওই যন্ত্রে ইতি টানুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device has Remote Play open. End it on that device."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May ibang device na nakabukas ang Remote Play. Tapusin ito roon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play अभी दूसरे उपकरण में चालू है। उसे उसी उपकरण से समाप्त करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play sedang terbuka di perangkat lain. Akhiri di perangkat tersebut."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti lain sedang membuka Remote Play. Tamatkannya pada peranti itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play is open op een ander toestel. Beëindig het daar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์อื่นเปิด Remote Play อยู่ ให้ปิดบนอุปกรณ์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihaz Uzaktan Oynatma'yı kullanıyor. O cihazda sonlandırın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی اور آلے پر Remote Play کھلا ہے۔ اسے اسی آلے پر ختم کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thiết bị khác đang mở Remote Play. Hãy kết thúc nó trên thiết bị đó."
          }
        }
      }
    },
    "sheets.health.consoleAdvice.notFound": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 لا يجيب. هل هو مُشغَّل (وضع الراحة لا بأس به) وموصول بشبكة جهاز Mac ذاتها؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 জবাব দিচ্ছে না। কনসোল অন আছে তো (বিশ্রাম মোডেও চলবে), আর এই Mac-এর নেটে আছে তো?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 isn't answering. Is it powered on (rest mode is fine) and on the network this Mac uses?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sumasagot ang PS5. Bukas ba ito (puwede kahit naka-rest mode), konektado ba sa network ng iyong Mac?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 उत्तर नहीं दे रहा। वह ऑन तो है (आराम मोड भी चलेगा), और इस Mac के राउटर पर ही है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak menjawab. Sudahkah konsol hidup (mode istirahat juga boleh) dan memakai jaringan yang sama seperti Mac ini?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tidak memberi respons. Adakah ia hidup (mod rehat pun boleh) dan berada di rangkaian yang digunakan Mac ini?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 geeft geen antwoord. Is hij ingeschakeld (rustmodus mag ook), en zitten hij en deze Mac op hetzelfde netwerk?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่ตอบ เครื่องเปิดอยู่ไหม (โหมดพักก็ได้) และใช้เน็ตวงเดียวกับ Mac ตัวนี้หรือเปล่า?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ağdan yanıt vermiyor. Konsol açık mı (dinlenme modu da olur) ve bu Mac'in ağına bağlı mı, kontrol edin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 جواب نہیں دے رہا۔ کیا وہ چالو ہے (آرام کی حالت بھی ٹھیک ہے)، اور کیا وہ اور یہ Mac ایک ہی موڈیم سے جڑے ہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 không trả lời. Máy đã bật nguồn chưa (chế độ nghỉ cũng được) và có chung mạng với Mac này không?"
          }
        }
      }
    },
    "sheets.health.consoleAdvice.other": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربط PS5 يتقطّع مرارًا. مدّ كابلات Ethernet من المودم إلى PS5 وإلى جهاز Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 লিংক বারবার ছিঁড়ছে। PS5 আর এই Mac, দুটোকেই ইথারনেট কেবলে সরাসরি মডেমের সঙ্গে জুড়ুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 link keeps breaking. Run Ethernet cables from the modem to the PS5 and to this Mac."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paulit-ulit na napuputol ang ugnayan sa PS5. Magkabit ng Ethernet cable mula sa modem hanggang sa PS5 at sa iyong Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 जुड़ाव लगातार छूट रहा है। राउटर से PS5 तक और इस Mac तक Ethernet केबल लगाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan PS5 terus terputus. Tarik kabel Ethernet dari modem ke PS5 dan ke Mac ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan PS5 asyik terputus. Pasang kabel Ethernet dari modem ke PS5 dan juga ke Mac ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link met de PS5 breekt steeds af. Leg ethernetkabels van de modem naar de PS5 en naar deze Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ PS5 ขาดๆ หายๆ ลากสาย Ethernet จากโมเด็มไปที่ PS5 และ Mac ตัวนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bağlantısı sürekli kesiliyor. Modemden hem PS5'e hem bu Mac'e Ethernet kablosu çekin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 سے رابطہ رہ رہ کر ٹوٹتا ہے۔ موڈیم سے PS5 تک اور اس Mac تک Ethernet کیبلیں بچھائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết PS5 cứ đứt liên tục. Kéo cáp Ethernet từ modem tới PS5 và tới Mac này."
          }
        }
      }
    },
    "sheets.health.consoleAdvice.pairingInvalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض PS5 جهاز Mac. اقرن بينهما من جديد عبر الإعدادات › إعادة التعيين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-কে PS5 মানেনি; সেটিংস › রিসেট থেকে দুটিকে ফের জুড়ে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 rejected this Mac. Pair them once more using Settings › Reset."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw na ng PS5 sa iyong Mac. Ipares silang muli gamit ang Settings › I-reset."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac को PS5 ने ठुकराया। सेटिंग › रीसेट से दोनों की जोड़ी नए सिरे से बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 menolak Mac ini. Pasangkan keduanya sekali lagi melalui Pengaturan › Atur Ulang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 menolak Mac ini. Pasangkan semula keduanya melalui Tetapan › Tetap Semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac is door de PS5 afgewezen. Koppel ze nog een keer via Instellingen › Herstel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ไม่รับ Mac ตัวนี้ จับคู่ใหม่อีกรอบผ่านการตั้งค่า › รีเซ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 eşleştirmeyi kabul etmiyor. Ayarlar › Sıfırla bölümünden eşleştirmeyi baştan yapın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 نے یہ Mac مسترد کر دیا۔ ترتیبات › ری سیٹ سے دونوں کو پھر جوڑیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 từ chối Mac này. Ghép đôi lại bằng Cài đặt › Đặt lại."
          }
        }
      }
    },
    "sheets.health.consoleAdvice.passcode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسابك الثاني محميّ برمز دخول على PS5. عطّل ذلك الرمز من الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার আরেকটি আইডিতে ঢুকতে PS5 পাসকোড নেয়। কনসোলে সেই পাসকোড অফ করে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your second account is protected by a PS5 sign-in passcode. Switch that passcode off on the console."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May PS5 sign-in passcode ang pangalawa mong account. Patayin ang passcode na iyon sa console."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दूसरे खाते पर PS5 पासकोड लगा है। PS5 में जाकर वह पासकोड हटवा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun kedua Anda dilindungi kode sandi login PS5. Nonaktifkan kode itu di konsol."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun kedua anda dilindungi kod log masuk PS5. Matikan kod itu pada konsol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tweede account is beveiligd met een aanmeldcode voor de PS5. Schakel die code uit op de console."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีที่สองของคุณมีรหัสผ่านเข้าใช้ PS5 ล็อกไว้ ปิดรหัสนั้นบนคอนโซล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci hesap PS5'te açılış şifresiyle korunuyor. Bu şifreyi PS5'ten kaldırın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے دوسرے اکاؤنٹ پر PS5 میں ایک پاس کوڈ لگا ہوا ہے۔ کنسول پر وہ پاس کوڈ ہٹا دیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản phụ của bạn đang được khóa bằng mật mã khi đăng nhập vào PS5. Tắt mật mã ấy trên console."
          }
        }
      }
    },
    "sheets.health.consoleAdvice.remotePlayDisabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاصية Remote Play مطفأة في PS5. في الإعدادات › النظام › Remote Play: شغّل تمكين Remote Play. بعدها ابدأ ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 কনসোলে Remote Play অফ। Settings › System › Remote Play: Enable Remote Play অন করে নিন। এরপরে নতুন করে আরম্ভ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 has Remote Play switched off. Settings › System › Remote Play: switch Enable Remote Play to on. Then start once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pinapagana ng PS5 ang Remote Play. Puntahan sa console: Settings › System › Remote Play, tapos buhayin doon: Enable Remote Play. Pagkatapos, magsimula ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 में Remote Play ऑफ़ है। Enable Remote Play को ऑन करें (Settings › System › Remote Play), फिर एक बार और आरंभ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play di PS5 sedang mati. Pengaturan › Sistem › Remote Play: nyalakan Aktifkan Remote Play. Setelah itu, mulai sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play tidak aktif pada PS5. Settings › System › Remote Play: tukar Enable Remote Play kepada hidup. Lepas itu, mula sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play is uitgeschakeld op je console. Schakel Remote Play inschakelen in (te vinden onder Instellingen › Systeem › Remote Play). Begin daarna nog een keer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ยังไม่ได้เปิดใช้ Remote Play ที่ Settings › System › Remote Play ให้สลับ Enable Remote Play เป็นเปิด แล้วเริ่มอีกรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan Oynatma PS5'te kapalı. Ayarlar › Sistem › Uzaktan Oynatma bölümünde Uzaktan Oynatmayı Etkinleştir'i açın, ardından bir kez daha başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کا Remote Play آف ہے۔ Settings › System › Remote Play کے تحت Enable Remote Play والا اختیار فعال کیجیے، پھر دوبارہ شروع کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 đang tắt Remote Play. Cài đặt › Hệ thống › Remote Play: chuyển Bật Remote Play sang bật. Sau đó bắt đầu lại."
          }
        }
      }
    },

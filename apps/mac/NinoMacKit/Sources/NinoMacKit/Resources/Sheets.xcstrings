    "sheets.history.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء بعد. ستظهر هنا الأسطر المترجمة الآن وفي الجلسات الماضية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো ফাঁকা। এই সেশনে ও আগেরগুলোতে ভাষান্তর হওয়া লাইনগুলো এখানে ফুটে উঠবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. Lines translated now and in past sessions will appear here."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pa rito. Makikita rito ang bawat linyang isinalin ngayon at sa nakaraang mga sesyon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ नहीं। इस सत्र और पिछले सत्रों में भाषांतरित पंक्तियाँ इसी जगह आएँगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada isi. Baris yang diterjemahkan sekarang maupun di sesi sebelumnya akan tampil di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa-apa. Baris yang diterjemah sekarang dan pada sesi lepas akan dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets. Wat je nu of eerder vertaalt, komt hier te staan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังว่างอยู่ บรรทัดที่แปลตอนนี้และในรอบก่อนๆ จะมาแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz boş. Şimdi ve geçmiş oturumlarda çevrilenler burada listelenir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی خالی ہے۔ ابھی اور گزشتہ سیشنز کی ترجمہ کی گئی سطریں یہیں نظر آئیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì. Những câu dịch lúc này và ở các phiên cũ sẽ được liệt kê tại đây."
          }
        }
      }
    },
    "sheets.history.hint %lld": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ هذا الـ Mac بآخر الأسطر التي ترجمها Nino (حتى %lld)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino-র ভাষান্তর করা শেষ %lld লাইন এই Mac রেখে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac keeps the last %lld lines Nino translated."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinatabi ng iyong Mac ang huling %lld linyang isinalin ni Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac Nino की भाषांतरित अंतिम %lld पंक्तियाँ रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini menyimpan %lld baris terakhir hasil terjemahan Nino."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini menyimpan %lld baris terkini yang diterjemah oleh Nino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac bewaart de laatste regels die Nino heeft vertaald (maximaal %lld)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้เก็บบรรทัดล่าสุดที่ Nino แปลไว้ %lld บรรทัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun en son çevirdiği %lld satırı bu Mac saklar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Mac، Nino کے ترجمہ کیے گئے آخری جملے رکھتا ہے (تعداد: %lld)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này lưu %lld dòng gần nhất mà Nino đã dịch."
          }
        }
      }
    },

    "sheets.health.level.fair": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يكون أفضل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরও উন্নত হওয়া সম্ভব"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Room to improve"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May puwang pang umayos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",

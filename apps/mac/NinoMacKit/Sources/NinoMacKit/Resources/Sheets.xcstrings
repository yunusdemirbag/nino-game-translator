    "sheets.health.zipHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تواجه مشكلة؟ شارك ملف zip هذا مع من يساعدك. يضم الترجمات التي التقطها Nino، واسم جهاز اللعب وعنوان IP المحلي له. لا يضم كلمات السر ولا المفاتيح ولا بيانات الحساب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্যায় পড়েছেন? যে আপনার সমস্যা দেখছে, তাকে এই zip দিন। ভেতরে আছে Nino-র ধরা উপশিরোনাম, আর কনসোলের পরিচয় ও লোকাল IP। কোনো password, কী বা লগইন তথ্য নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Having trouble? Share this zip with the person helping you. Inside are the subtitles Nino picked up, plus the console's name and local IP. No passwords, keys or account details."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May problema? Ibahagi ang zip na ito sa taong tumutulong sa iyo. Laman nito ang mga subtitle na nakuha ni Nino, pati ang pangalan at lokal na IP ng console. Walang kasamang password, key o detalye ng account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परेशानी है? यह zip उस व्यक्ति को दें जो आपकी सहायता कर रहा है। इसमें Nino द्वारा पढ़े गए सबटाइटल, साथ में PS5 का नामकरण और लोकल IP है। कोई कुंजी, खाता-ब्योरा या पासवर्ड वगैरह नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada kendala? Bagikan zip ini kepada siapa pun yang sedang membantu Anda. Isinya subtitle yang ditangkap Nino, ditambah nama konsol dan IP lokalnya. Kata sandi, kunci, dan detail akun tidak disertakan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada masalah? Kongsi zip ini dengan sesiapa yang sedang menolong anda. Di dalamnya ada sari kata yang dikesan Nino, serta nama dan IP setempat konsol. Kata laluan, kunci dan butiran akaun tidak disertakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopt er iets mis? Deel deze zip met wie je helpt. Erin zitten de ondertitels die door Nino zijn opgepikt, plus de naam en het lokale IP van de console. Geen wachtwoorden, sleutels of accountgegevens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีปัญหาใช่ไหม? แชร์ไฟล์ zip นี้กับคนที่ช่วยคุณ ข้างในมีคำบรรยายที่ Nino จับได้ ชื่อคอนโซล และ IP ในบ้าน แต่จะไม่รวมรหัสผ่าน API key และรายละเอียดบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun mu var? Bu zip'i size yardımcı olan kişiyle paylaşın. Kayıtlarda Nino'nun gördüğü altyazılar, konsolun adı ve ev ağı adresi bulunur; parolalar, anahtarlar ve hesap bilgileri bulunmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی دقت؟ یہ zip اپنے مددگار کو بھیجیے۔ اس کے اندر Nino کے پکڑے سب ٹائٹل، کنسول کا نام اور لوکل IP ہیں۔ پاس ورڈ، کلیدیں یا اکاؤنٹ کی تفصیل نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gặp trục trặc? Gửi tệp zip này cho người đang hỗ trợ bạn. Trong đó có những dòng phụ đề Nino bắt được, kèm tên console và IP nội bộ của nó. Mật khẩu, khóa và dữ liệu tài khoản đều không có."
          }
        }
      }
    },

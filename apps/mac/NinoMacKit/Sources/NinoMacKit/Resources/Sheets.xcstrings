          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi پر PS5 کی تصویر ضائع ہو رہی ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi đang làm mất hình ảnh PS5"
          }
        }
      }
    },
    "sheets.health.cause.pictureLossWired.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصّل PS5 بالمودم بكابل أيضًا؛ وإذا كان موصولًا بالفعل، فأعد تشغيل المودم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-কেও মডেম অবধি একটি ইথারনেট কেবল দিন; কেবল আগেই থাকলে মডেম রিবুট দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the PS5 an Ethernet cable to the modem as well; if it already has one, restart the modem."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bigyan din ng Ethernet cable papunta sa modem ang PS5; kung meron na, i-restart ang modem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 को भी राउटर तक Ethernet केबल दें; केबल पहले से हो, तो राउटर को पुनः आरंभ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri juga PS5 kabel Ethernet ke modem; jika sudah ada, mulai ulang modemnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri PS5 kabel Ethernet ke modem juga; jika sudah ada, mulakan semula modem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de PS5 ook met een kabel aan op de modem; is dat al zo, herstart dan de modem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบสาย PS5 เข้ากับโมเด็มด้วย หากเสียบอยู่แล้ว ให้รีสตาร์ทโมเด็ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modemden PS5'e de Ethernet kablosu çekin; zaten takılıysa modemi kapatıp açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کو بھی موڈیم تک Ethernet کیبل دیجیے؛ اگر پہلے سے لگی ہو تو موڈیم ری اسٹارٹ کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 cũng nên có cáp Ethernet nối tới modem; nếu đã có rồi, tắt modem rồi bật lại."
          }
        }
      }
    },
    "sheets.health.cause.pictureLossWired.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجزاء من صورة PS5 تضيع عبر الشبكة"

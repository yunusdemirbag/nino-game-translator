    "sheets.health.tvApp.hostIPAdvice %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في التلفاز يحمل Host PC IP عنوانًا مختلفًا (%1$@)، لذا يُرفض هذا الحاسوب. اجعله %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-র Host PC IP ঘরে ভিন্ন একটি ঠিকানা (%1$@) রয়েছে, ফলে এই Mac-কে ফিরিয়ে দেওয়া হচ্ছে। সেটিকে %2$@ করে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the TV, Host PC IP holds a different address (%1$@), so this computer is turned away. Set it to %2$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa TV, ibang address (%1$@) ang laman ng Host PC IP, kaya tinatanggihan ang computer mo. Ilagay doon ang %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP अभी टीवी में दूसरा पता (%1$@) बता रहा है, अतः यह Mac लौटा दिया गया। इसे %2$@ कर दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di TV, Host PC IP berisi alamat lain (%1$@), jadi komputer ini ditolak. Ubah menjadi %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada TV, Host PC IP memegang alamat lain (%1$@), jadi komputer ini ditolak. Tukarkannya kepada %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij Host PC IP staat op de tv een ander adres (%1$@), dus deze computer wordt geweigerd. Verander het in %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนทีวี Host PC IP ตั้งเป็นอีกที่อยู่หนึ่ง (%1$@) คอมตัวนี้จึงถูกปฏิเสธ ให้แก้เป็น %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Host PC IP alanında farklı bir adres var (%1$@); TV bu nedenle bu bilgisayara izin vermiyor. Adresi %2$@ olarak değiştirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹی وی کی Host PC IP سیٹنگ میں کوئی اور پتہ (%1$@) لکھا ہے، لہٰذا یہ کمپیوٹر واپس کر دیا جاتا ہے۔ اسے %2$@ کر دیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên TV, mục Host PC IP đang giữ địa chỉ khác (%1$@), nên máy tính này bị chặn. Đổi nó sang %2$@."

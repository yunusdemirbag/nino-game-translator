    "sheets.about.license": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق بلا مقابل ومصدره مفتوح، يُوزَّع وفق GNU AGPL-3.0."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিখরচায় ও মুক্ত উৎসের; GNU AGPL-3.0 শর্তে বিতরণ।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free of charge and open source, licensed under GNU AGPL-3.0."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang bayad at bukas ang code. Lisensya: GNU AGPL-3.0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निःशुल्क और खुला-कोड; लाइसेंस: GNU AGPL-3.0।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis dan bersumber terbuka, berlisensi GNU AGPL-3.0."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percuma serta bersumber terbuka, berlesen GNU AGPL-3.0."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosteloos en opensource, uitgebracht onder GNU AGPL-3.0."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ฟรีและเปิดซอร์สโค้ด เผยแพร่ภายใต้ GNU AGPL-3.0"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz ve kaynak kodu açık; lisansı GNU AGPL-3.0."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا قیمت، اوپن سورس؛ لائسنس: GNU AGPL-3.0۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miễn phí, mã nguồn mở, cấp phép theo GNU AGPL-3.0."
          }
        }
      }
    },

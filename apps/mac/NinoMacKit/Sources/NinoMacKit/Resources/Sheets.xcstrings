    "sheets.health.advice.networkLoss": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزء من بيانات فيديو PS5 لا يصل. مدّ كابل Ethernet من المودم إلى جهاز Mac (ويصلح أيضًا مهايئ من USB-C لـ Ethernet). إن تعذّر ذلك، فاقترب من المودم واختر شبكة Wi-Fi ذات 5 GHz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর ভিডিও ডেটার কিছুটা পৌঁছাচ্ছে না। মডেম থেকে এই Mac অবধি একটি ইথারনেট কেবল টানুন (USB-C থেকে ইথারনেটের রূপান্তরকও চলবে)। তা না পারলে মডেমের পাশে বসুন, সাথে 5 GHz Wi-Fi নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of the PS5 video data isn't arriving. Run an Ethernet cable from the modem to this Mac (a USB-C to Ethernet adapter is fine too). If you can't, sit near the modem and pick 5 GHz Wi-Fi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May bahagi ng video ng PS5 na hindi dumarating. Magkabit ng Ethernet cable mula sa modem hanggang sa iyong Mac (puwede rin ang USB-C to Ethernet adapter). Kung di kaya, umupo malapit sa modem at piliin ang 5 GHz Wi-Fi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 वीडियो का कुछ डेटा रास्ते में खो रहा है। राउटर से इस Mac तक Ethernet केबल लगाएँ (USB-C से Ethernet अडैप्टर भी ठीक है)। यह न हो सके तो राउटर के नज़दीक बैठकर 5 GHz Wi-Fi चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian data video PS5 tidak sampai. Tarik kabel Ethernet dari modem ke Mac ini (adaptor USB-C ke Ethernet juga boleh). Kalau tak bisa, duduklah dekat modem dan gunakan 5 GHz Wi-Fi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebahagian data video PS5 tidak sampai. Pasang kabel Ethernet dari modem ke Mac ini (penyesuai USB-C ke Ethernet pun boleh). Jika tidak dapat, duduk dekat modem dan pilih 5 GHz Wi-Fi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel van de videogegevens van de PS5 komt niet aan. Leg een ethernetkabel van de modem naar deze Mac (een adapter van USB-C naar ethernet mag ook). Kan dat niet, zit dan vlak naast de modem en kies wifi op 5 GHz."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลวิดีโอจาก PS5 มาไม่ครบ ลากสาย Ethernet จากโมเด็มมาที่ Mac ตัวนี้ (จะใช้ตัวแปลง USB-C เป็น Ethernet ก็ได้) ถ้าทำไม่ได้ ให้นั่งใกล้โมเด็มแล้วเลือก 5 GHz Wi-Fi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 görüntüsünün bir kısmı yolda kayboluyor. Modemden bu Mac'e bir Ethernet kablosu çekin (USB-C'den Ethernet'e bir adaptör de yeter). Olmuyorsa modemin yanına geçip 5 GHz Wi-Fi seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کا کچھ ویڈیو ڈیٹا نہیں پہنچ رہا۔ موڈیم سے اس Mac تک Ethernet کیبل لگائیے (USB-C سے Ethernet اڈاپٹر بھی ٹھیک ہے)۔ اگر یہ نہ ہو سکے، تو موڈیم کے نزدیک بیٹھ کر 5 GHz Wi-Fi منتخب کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phần dữ liệu hình của PS5 bị thất lạc. Kéo cáp Ethernet từ modem tới Mac này (bộ đổi USB-C ra Ethernet cũng dùng tốt). Không làm được thì hãy ngồi gần modem và chọn Wi-Fi 5 GHz."
          }
        }
      }
    },
    "sheets.health.advice.noNetwork": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز Mac غير متصل. انضم إلى شبكة PS5."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac অফলাইন। PS5 যে নেটে আছে, সেখানে যুক্ত হন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is offline. Join the network the PS5 uses."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline ang iyong Mac. Sumali sa network na gamit ng PS5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac ऑफ़लाइन है। इसे उस राउटर पर लाएँ जिस पर PS5 है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini sedang offline. Gabung ke jaringan yang dipakai PS5."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini di luar talian. Sertai rangkaian yang digunakan PS5."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac is offline. Sluit hem aan op het netwerk van de PS5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ตัวนี้ออฟไลน์ ให้เข้าเน็ตวงที่ PS5 ใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac çevrimdışı. PS5'in bağlı olduğu ağa bağlanın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Mac آف لائن ہے۔ اسی نیٹ ورک میں شامل ہو جائیے جس پر PS5 ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac này đang ngoại tuyến. Hãy vào mạng mà PS5 đang dùng."
          }
        }
      }
    },
    "sheets.health.advice.speedEngine": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمات تستغرق وقتًا. جرّب التحويل إلى مجمّع Nino Game Translator (مجاني)، تجده في الإعدادات › الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাষান্তরে সময় লাগছে। সেটিংস › অনুবাদ-এ Nino Game Translator পুল (ফ্রি)-এ বদলে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translations are taking a while. Try switching to Nino Game Translator Pool (free) under Settings › Translation."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Matagal ang pagsasalin. Subukang lumipat sa Nino Game Translator Pool (libre) sa Settings › Pagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषांतर में देर लग रही है। Nino Game Translator पूल (मुफ़्त) आज़माएँ, यह सेटिंग › अनुवाद में मिलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan berjalan lambat. Coba buka Pengaturan › Terjemahan lalu pilih Pool Nino Game Translator (gratis)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan mengambil masa. Cuba tukar kepada Kumpulan Nino Game Translator (percuma) di Tetapan › Terjemahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertalingen duren lang. Probeer de Nino Game Translator-pool (gratis) onder Instellingen › Vertaling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแปลใช้เวลานาน ลองเปลี่ยนไปใช้คลัง Nino Game Translator (ฟรี) ในส่วนการตั้งค่า › การแปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviriler uzun sürüyor. Ayarlar › Çeviri bölümünden Nino Game Translator Havuzu'na (ücretsiz) geçmeyi deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمے سست ہیں۔ ترتیبات › ترجمہ کھول کر Nino Game Translator پول (مفت) آزمائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch đang chậm. Thử đổi sang Kho Nino Game Translator (miễn phí) ở Cài đặt › Dịch."
          }
        }
      }
    },
    "sheets.health.advice.speedMac": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمات تستغرق وقتًا. اخرج من التطبيقات الثقيلة العاملة هنا، ثم أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাষান্তরে সময় লাগছে। এখানে খোলা অন্য ভারী সফটওয়্যার বন্ধ রেখে ফের চালিয়ে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translations are taking a while. Quit other demanding apps running here, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Matagal ang pagsasalin. Isara muna ang iba pang mabigat na app dito, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषांतर में देर लग रही है। Mac में चल रहे बाकी भारी ऐप छोड़ें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan berjalan lambat. Keluar dari aplikasi lain yang memakan banyak daya di Mac ini, lalu ulangi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan mengambil masa. Tutup apl berat lain yang berjalan di sini, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertalingen duren lang. Stop andere zware apps die hier draaien en probeer het dan nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแปลใช้เวลานาน ปิดแอปหนักๆ ตัวอื่นบนเครื่องนี้ แล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviriler uzun sürüyor. Bu Mac'te yoğun çalışan diğer uygulamaları kapatıp bir daha deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمے میں دیر لگ رہی ہے۔ یہاں چل رہی بھاری ایپس سے باہر نکلیے، پھر دوبارہ آزمائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dịch đang ra chậm. Đóng bớt những app nặng khác trên Mac, rồi thử thêm lần nữa."
          }
        }
      }
    },
    "sheets.health.advice.tv": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق Nino في التلفاز بلا اتصال. اترك Nino يعمل على التلفاز؛ ويجب أن يكون التلفاز وجهاز Mac على شبكة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino-র TV অ্যাপে লিংক নেই। TV-র পর্দায় Nino চলতে দিন; TV ও এই Mac একটাই নেটে থাকা চাই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino's TV app has no connection. Leave Nino running on the TV; the TV and this Mac must be on one network."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang koneksyon ang TV app ni Nino. Hayaang bukas si Nino sa TV; dapat nasa iisang network ang TV at ang iyong Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino का टीवी ऐप जुड़ा हुआ नहीं। टीवी में Nino चलता छोड़ दें; टीवी और यह Mac एक ही राउटर पर हों।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi TV Nino tidak tersambung. Biarkan Nino tetap jalan di TV; TV dan Mac ini wajib berada di satu jaringan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi TV Nino tiada sambungan. Biarkan Nino terus berjalan di TV; TV dan Mac ini perlu berada pada satu rangkaian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tv-app van Nino heeft geen verbinding. Laat Nino draaien op de tv; tv en Mac moeten op één netwerk zitten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปทีวีของ Nino ไม่มีการเชื่อม เปิด Nino ทิ้งไว้บนทีวี โดยทีวีกับ Mac ตัวนี้ต้องอยู่เน็ตวงเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun TV uygulamasıyla bağlantı yok. TV'de Nino açık kalsın; TV ile bu Mac aynı ağı kullanmalı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کی ٹی وی ایپ سے کنکشن نہیں ہے۔ ٹی وی میں Nino کو چلتا رہنے دیجیے؛ ٹی وی اور یہ Mac، دونوں ایک نیٹ ورک پر ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App TV của Nino chưa có kết nối. Để Nino chạy trên TV; TV và Mac này phải chung một mạng."
          }
        }
      }
    },
    "sheets.health.advice.video": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما دامت الصورة متجمّدة فلن يرى Nino أي ترجمة. مدّ كابلات Ethernet من المودم إلى PS5 وإلى جهاز Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি আটকে থাকলে Nino কোনো উপশিরোনামই দেখে না। PS5 আর এই Mac, দুটোকেই ইথারনেট কেবলে সরাসরি মডেমের সঙ্গে জুড়ুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the picture is stuck, Nino can't see any subtitles. Run Ethernet cables from the modem to the PS5 and to this Mac."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang nakatigil ang larawan, walang subtitle na nakikita si Nino. Magkabit ng Ethernet cable mula sa modem hanggang sa PS5 at sa iyong Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र रुका रहे तो Nino को सबटाइटल नज़र नहीं आते। राउटर से PS5 तक और इस Mac तक Ethernet केबल लगाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama gambar macet, Nino tak bisa melihat subtitle. Tarik kabel Ethernet dari modem ke PS5 dan ke Mac ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selagi gambar tersangkut, Nino tidak nampak sebarang sari kata. Pasang kabel Ethernet dari modem ke PS5 dan juga ke Mac ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang het beeld vastloopt, ziet Nino geen ondertitels. Leg ethernetkabels van de modem naar de PS5 en naar deze Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะที่ภาพค้าง Nino มองไม่เห็นคำบรรยาย ลากสาย Ethernet จากโมเด็มไปที่ PS5 และ Mac ตัวนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü takıldığında Nino altyazıları göremez. Modemden hem PS5'e hem bu Mac'e Ethernet kablosu çekin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک تصویر رکی ہے، Nino کو کوئی سب ٹائٹل نظر نہیں آتا۔ موڈیم سے PS5 تک اور اس Mac تک Ethernet کیبلیں بچھائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc hình đứng, Nino không nhìn thấy phụ đề. Kéo cáp Ethernet từ modem tới PS5 và tới Mac này."
          }
        }
      }
    },
    "sheets.health.allGood": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبدو جيدًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব ঠিক আছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All looks good"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang maayos ang lahat"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब ठीक लग रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tampak baik"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya kelihatan baik"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles ziet er goed uit"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างดูปกติดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey yolunda"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب ٹھیک لگ رہا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ đều ổn"
          }
        }
      }
    },
    "sheets.health.autoOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإبلاغ التلقائي متوقف. يمكنك إرسال هذه من «الإبلاغ عن خلل»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাআপনি বিবরণী পাঠানো বন্ধ। “সমস্যার কথা জানান” থেকে এগুলো নিজেই পাঠিয়ে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic reports are turned off. Send these yourself from Report an Issue."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakapatay ang awtomatikong pag-uulat. Ikaw na ang magpadala nito mula sa Iulat ang Problema."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित शिकायतें बंद हैं। इन्हें “गड़बड़ी बताएँ” से खुद भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelaporan otomatis nonaktif. Anda dapat mengirimnya dari Laporkan Kendala."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelaporan automatik dimatikan. Anda boleh menghantarnya melalui Laporkan Isu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische meldingen zijn uitgeschakeld. Stuur ze zelf via Probleem melden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรายงานอัตโนมัติปิดอยู่ คุณส่งข้อมูลเหล่านี้ได้จาก รายงานปัญหา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik bildirim kapalı. İsterseniz bunları Hata Bildir bölümünden siz gönderebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خودکار رپورٹیں بند ہیں۔ انہیں مسئلہ بتائیں سے خود بھیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo tự động đang tắt. Bạn tự gửi chúng từ mục Báo lỗi."
          }
        }
      }
    },
    "sheets.health.autoOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبلغنا Nino بهذه الأمور من تلقاء نفسه (يرسل هذا الملخص وحده، بلا سجلات ولا ترجمات)، لذا لا حاجة لأن ترسلها أنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগুলো Nino আপনাআপনিই আমাদের কাছে পাঠায় (শুধু এই সারাংশ, লগ বা উপশিরোনাম কখনো নয়)। আপনার দিক থেকে কিছুই পাঠানোর নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino reports these to us automatically (only this summary, never logs or subtitles). There's nothing you need to send."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusang ipinapadala sa amin ni Nino ang mga ito (itong buod lang, hindi kailanman ang log o subtitle). Wala kang kailangang ipadala."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ये बातें हमें अपने-आप भेजता है (बस यह सार, लॉग या सबटाइटल कभी नहीं)। आपको कुछ भेजना नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino mengirimkannya kepada kami dengan sendirinya (hanya ringkasan ini, tanpa log atau subtitle), jadi tidak perlu melaporkannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino menghantar ini kepada kami dengan sendiri (hanya ringkasan ini, tanpa log atau sari kata), jadi anda tidak perlu melaporkannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino stuurt deze vanzelf naar ons (alleen deze samenvatting, geen logs of ondertitels), dus je hoeft ze niet te melden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ส่งข้อมูลเหล่านี้มาให้เราเอง (เฉพาะสรุปนี้ ไม่มีไฟล์บันทึกหรือคำบรรยาย) คุณจึงไม่ต้องรายงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino bunları bize otomatik olarak iletir (yalnız bu özet; günlükler ve altyazılar asla); sizin ayrıca bildirmenize gerek yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino یہ باتیں ہمیں خود ہی بھیج دیتا ہے (صرف یہ خلاصہ، لاگ یا سب ٹائٹل کبھی نہیں)۔ آپ کو کچھ بھیجنا نہیں پڑے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tự gửi các mục này cho chúng tôi (chỉ bản tóm tắt này, không có nhật ký hay phụ đề), nên bạn không cần báo cáo."
          }
        }
      }
    },
    "sheets.health.cause.afterNetworkLoss.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطعت Wi-Fi في جهاز Mac لحظة ولم يعد ربط PS5. مدّ كابل Ethernet من المودم إلى جهاز Mac، أو اقترب من المودم واختر شبكة Wi-Fi ذات 5 GHz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এর Wi-Fi খানিক সময় কেটে গিয়েছিল, PS5 লিংক আর ফেরেনি। মডেম থেকে এই Mac অবধি ইথারনেট কেবল টানুন, নয়তো মডেমের পাশে বসুন, সাথে 5 GHz Wi-Fi নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi on this Mac cut out briefly and the PS5 link didn't recover. Run an Ethernet cable from the modem to this Mac, or sit near the modem and pick 5 GHz Wi-Fi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Saglit na nawala ang Wi-Fi ng iyong Mac at hindi na nakabawi ang ugnayan sa PS5. Magkabit ng Ethernet cable mula sa modem hanggang sa Mac, o umupo malapit sa modem at piliin ang 5 GHz Wi-Fi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac का Wi-Fi पल भर को कटा और PS5 जुड़ाव वापस नहीं आया। राउटर से इस Mac तक Ethernet केबल लगाएँ, या राउटर के नज़दीक बैठकर 5 GHz Wi-Fi चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi di Mac ini sempat putus sebentar dan tautan PS5 tak pulih. Tarik kabel Ethernet dari modem ke Mac ini, atau duduklah dekat modem dan gunakan 5 GHz Wi-Fi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi pada Mac ini terputus seketika dan pautan PS5 tidak pulih. Pasang kabel Ethernet dari modem ke Mac ini, atau duduk dekat modem dan pilih 5 GHz Wi-Fi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wifi van deze Mac viel even weg en de link met de PS5 herstelde zich niet. Leg een ethernetkabel van de modem naar deze Mac, of zit vlak naast de modem en kies wifi op 5 GHz."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi บน Mac ตัวนี้หลุดไปชั่วครู่ และลิงก์ PS5 ไม่กลับมา ลากสาย Ethernet จากโมเด็มมาที่ Mac ตัวนี้ หรือนั่งใกล้โมเด็มแล้วเลือก 5 GHz Wi-Fi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'in kablosuz bağlantısı kısa bir an kesildi ve PS5 bağlantısı toparlanamadı. Modemden bu Mac'e bir Ethernet kablosu çekin ya da modemin yanına geçip 5 GHz Wi-Fi seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac کا Wi-Fi ایک لمحے کے لیے چلا گیا اور PS5 کنکشن برقرار نہ رہ سکا۔ Mac کو موڈیم سے جوڑیں، یا اسے 5 GHz Wi-Fi پر موڈیم کے قریب رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi trên Mac này mất sóng thoáng chốc và liên kết PS5 không hồi phục. Kéo cáp Ethernet từ modem tới Mac này, hoặc ngồi gần modem và chọn Wi-Fi 5 GHz."
          }
        }
      }
    },
    "sheets.health.cause.afterNetworkLoss.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع اتصال PS5 عندما فقد هذا الـ Mac الشبكة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac অফলাইন হতেই PS5 লিংক ছিঁড়ে গেল"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 link broke when this Mac went offline"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naputol ang ugnayan sa PS5 nang mawalan ng internet ang Mac"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ऑफ़लाइन होते ही PS5 जुड़ाव टूट गया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi PS5 terputus saat Mac ini kehilangan jaringan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan PS5 terputus apabila Mac ini kehilangan rangkaian"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5-verbinding viel weg toen deze Mac zijn netwerk kwijtraakte"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ PS5 ขาดตอนที่ Mac ตัวนี้หลุดออฟไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac ağdan düşünce PS5 bağlantısı da gitti"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Mac آف لائن ہوا تو PS5 سے رابطہ ٹوٹ گیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối PS5 bị ngắt khi máy Mac này mất mạng"
          }
        }
      }
    },
    "sheets.health.cause.asleep.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل PS5. ولكي يبلغه Nino أثناء الراحة، فعّل «البقاء متصلاً بالإنترنت» ضمن خيارات توفير الطاقة في PS5."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 অন করে দিন। বিশ্রামে থাকলেও Nino যেন PS5-এর নাগাল পায়, তাই এর পাওয়ার সেভিং বিকল্পে “Stay connected to the internet” অন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the PS5 on. So Nino can reach it while it rests, enable “Stay connected to the internet” under the PS5's power saving options."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang PS5. Para maabot ito ni Nino habang nagpapahinga, buhayin ang opsyong “Stay connected to the internet” na nasa power saving ng PS5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ऑन करें। आराम मोड में भी Nino उससे जुड़ सके, इसके वास्ते PS5 की पावर सेविंग सेटिंग के भीतर “Stay connected to the internet” को ऑन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan PS5. Supaya Nino bisa menjangkaunya saat konsol beristirahat, nyalakan “Tetap Terhubung ke Internet” pada opsi hemat daya PS5."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan PS5. Supaya Nino boleh mencapainya semasa ia berehat, aktifkan “Stay connected to the internet”, iaitu di bawah pilihan penjimatan kuasa PS5."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de PS5 in. Wil je dat Nino hem ook in rust bereikt, schakel dan “Verbonden blijven met het internet” in bij de energiebesparingsopties van de PS5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเครื่อง PS5 และเพื่อให้ Nino เข้าถึงได้ขณะพักเครื่อง ให้เปิด “Stay connected to the internet” ในตัวเลือกประหยัดพลังงานของ PS5"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'i açın. Nino'nun dinlenme modunda da konsola ulaşabilmesi için PS5'in güç tasarrufu seçeneklerinde şu ayarı etkinleştirin: “İnternete bağlı kal”."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 چالو کیجیے۔ آرام کی حالت میں بھی Nino اس تک پہنچ سکے، اس کے لیے PS5 کی بجلی بچت ترتیبات کے اندر “Stay connected to the internet” فعال کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở PS5. Muốn Nino tìm thấy máy khi đang nghỉ, hãy chọn “Duy trì kết nối Internet” ở mục tiết kiệm điện năng của PS5."
          }
        }
      }
    },
    "sheets.health.cause.asleep.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُطفئ جهاز PS5 أو صار في وضع الراحة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 বন্ধ ছিল বা বিশ্রামে আছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 was switched off or is resting"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Namatay o nag-rest mode ang PS5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ऑफ़ था या आराम मोड पर है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 mati atau masuk ke mode istirahat"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 dimatikan atau masuk mod rehat"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 stond uit of was in rust"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ปิดเครื่องหรือเข้าโหมดพัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 kapandı veya dinlenmeye geçti"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 بند ہو گیا یا ریسٹ موڈ میں چلا گیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 đã tắt hoặc chuyển sang chế độ nghỉ"
          }
        }
      }
    },
    "sheets.health.cause.couldNotConnect.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل PS5 مُشغَّل وموصول بشبكة جهاز Mac ذاتها؟ أصلح ذلك ثم ابدأ ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 অন আছে তো, আর এই Mac-এর নেটেই আছে তো? সেটুকু শুধরে নিয়ে নতুন করে আরম্ভ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is the PS5 switched on, and is it on the network this Mac uses? Fix that, then start once more."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukas ba ang PS5, at nasa network ba ito na gamit ng iyong Mac? Ayusin iyon, saka magsimula ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या PS5 ऑन है, साथ ही उसी राउटर पर है जिस पर यह Mac है? इसे ठीक करके एक बार और आरंभ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudahkah PS5 hidup, dan apakah ia memakai jaringan yang sama seperti Mac ini? Benahi itu, lalu mulai sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah PS5 hidup, dan berada di rangkaian yang digunakan Mac ini? Betulkan perkara itu, kemudian mula sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is de PS5 ingeschakeld, en zitten hij en deze Mac op hetzelfde netwerk? Los dat op en begin nog een keer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 เปิดอยู่และใช้เน็ตวงเดียวกับ Mac ตัวนี้ไหม? แก้ให้เรียบร้อยแล้วเริ่มอีกรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 açık mı ve bu Mac'in ağına bağlı mı, kontrol edin; ardından bir kez daha başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 چالو ہے؟ اور کیا PS5 اور یہ Mac ایک ہی موڈیم سے جڑے ہیں؟ یہ درست کر کے پھر شروع کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 đã mở chưa, và có chung mạng với Mac này không? Khắc phục xong thì bắt đầu lại."
          }
        }
      }
    },
    "sheets.health.cause.couldNotConnect.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Nino الاتصال بـ PS5"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino PS5-এর নাগাল পায়নি"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino didn't get through to the PS5"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naabot ni Nino ang PS5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino PS5 तक पहुँच नहीं पाया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino gagal menjangkau PS5"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak dapat bersambung ke PS5"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino kwam niet bij de PS5 terecht"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ติดต่อ PS5 ไม่ติด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino PS5'e ulaşamadı"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino، PS5 سے نہیں جڑ سکا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino chưa liên lạc được với PS5"
          }
        }
      }
    },
    "sheets.health.cause.dropped.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختفى PS5 من الشبكة. احرص أن يشترك هو وجهاز Mac في مودم واحد. إن تكرّر الأمر، فأطفئ المودم وشغّله أو امنح PS5 كابل Ethernet. يواصل Nino المحاولة تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটে PS5 চুপ মেরে গেছে। এটি আর এই Mac একই মডেমে জুড়ে আছে তো, মিলিয়ে নিন। ফের ঘটলে মডেম অফ ও অন করুন, বা PS5-কে একটা ইথারনেট কেবল দিন। Nino আপনাআপনি প্রয়াস জারি রেখেছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 has gone quiet on the network. Make sure it and this Mac share one modem. If this repeats, power-cycle the modem or give the PS5 an Ethernet cable. Nino keeps retrying by itself."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na sumasagot sa network ang PS5. Tiyaking iisang modem ang gamit nito at ng iyong Mac. Kapag naulit, patayin at buhayin ang modem o bigyan ng Ethernet cable ang PS5. Kusang sumusubok ulit si Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 राउटर पर चुप पड़ गया है। जाँचें कि PS5 और यह Mac एक ही राउटर पर हों। यह दोहराए तो राउटर का पावर निकालकर लगाएँ या PS5 में Ethernet केबल लगाएँ। Nino अपने-आप प्रयास जारी रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 tak lagi terdengar di jaringan. Pastikan konsol dan Mac ini memakai modem yang sama. Jika terulang, matikan-nyalakan modem atau beri PS5 kabel Ethernet. Nino akan terus mencoba sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 senyap di rangkaian. Pastikan ia dan Mac ini berkongsi satu modem. Jika berulang, matikan lalu hidupkan modem, atau beri PS5 kabel Ethernet. Nino terus mencuba dengan sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 is stil gevallen op het netwerk. Zorg dat hij en deze Mac één modem delen. Gebeurt het vaker, herstart dan de modem of geef de PS5 een ethernetkabel. Nino blijft het zelf proberen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 เงียบหายจากเน็ตวงนี้ ดูว่าเครื่องนั้นกับ Mac ตัวนี้ใช้โมเด็มตัวเดียวกัน ถ้ายังเกิดซ้ำ ให้ปิดเปิดโมเด็มใหม่ หรือต่อสาย Ethernet ให้ PS5 โดย Nino จะลองซ้ำเองไปเรื่อยๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ağda sessiz kaldı. Konsolun ve bu Mac'in tek bir modemi paylaştığından emin olun. Yine olursa modemi kapatıp açın veya konsola Ethernet kablosu takın. Nino kendi kendine denemeye devam eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیٹ ورک پر PS5 خاموش ہو گیا ہے۔ یقینی بنائیے کہ وہ اور یہ Mac ایک ہی موڈیم سے جڑے ہوں۔ اگر ایسا دوبارہ ہو تو موڈیم بند کر کے چالو کیجیے یا PS5 کو Ethernet کیبل دیجیے۔ Nino خود ہی کوشش کرتا رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 im lặng trên mạng. Kiểm tra xem PS5 và Mac này có dùng chung một modem. Nếu còn lặp lại, hãy tắt bật modem hoặc cắm cáp Ethernet cho PS5. Nino vẫn tự thử lại."
          }
        }
      }
    },
    "sheets.health.cause.dropped.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع اتصال PS5 ولم يعد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 লিংক ছিঁড়েছে, এখনো ফেরেনি"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 link broke and is still down"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naputol ang ugnayan sa PS5 at hindi pa bumabalik"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 जुड़ाव टूटा और अब तक वापस नहीं आया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi PS5 terputus dan belum pulih"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan PS5 terputus dan belum pulih"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5-verbinding is weggevallen en niet teruggekomen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ PS5 ขาดและยังไม่กลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bağlantısı kesildi ve bir daha kurulmadı"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کنکشن ٹوٹ گیا اور واپس نہیں آیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối PS5 bị ngắt và chưa khôi phục"
          }
        }
      }
    },
    "sheets.health.cause.elsewhere.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال Remote Play مفتوحًا على جهاز آخر مثل هاتف أو جهاز لوحي أو كمبيوتر؛ أنهِ الجلسة هناك. سيعود Nino للاتصال من تلقاء نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play এখনো অন্য যন্ত্রে চালু, যেমন ফোন, ট্যাবলেট বা পিসিতে; ওখানে ইতি টানুন। Nino আপনাআপনি ফের জুড়ে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play is still open on another device, like a phone, tablet or PC; end it there. Nino will reconnect by itself."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May ibang device pa na gumagamit ng Remote Play, gaya ng telepono, tablet o PC; tapusin ito roon. Kusang kokonekta ulit si Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play अभी किसी और उपकरण (फ़ोन, टैबलेट या PC) में खुला है; पहले उसे वहीं समाप्त करें। Nino अपने-आप फिर जुड़ेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup Remote Play di ponsel, tablet, atau komputer lain. Nino terhubung ulang dengan sendirinya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup Remote Play pada telefon, tablet atau komputer lain. Nino akan bersambung semula dengan sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Remote Play op de andere telefoon, tablet of computer. Nino maakt vanzelf weer verbinding."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play ยังเปิดค้างอยู่บนอุปกรณ์อื่น เช่น มือถือ แท็บเล็ต หรือพีซี ให้ปิดที่นั่น แล้ว Nino จะต่อกลับเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan Oynatma'yı açık tutan diğer telefon, tablet veya bilgisayarda oturumu sonlandırın. Nino bağlantıyı kendisi yeniden kurar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play ابھی کسی دوسرے آلے پر کھلا ہے، جیسے فون، ٹیبلیٹ یا PC؛ اسے وہیں ختم کیجیے۔ Nino خود ہی دوبارہ جڑ جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đóng Remote Play trên điện thoại, máy tính bảng hoặc máy tính kia. Nino sẽ tự kết nối lại."
          }
        }
      }
    },
    "sheets.health.cause.elsewhere.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ Remote Play على جهاز مختلف"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play আরেক যন্ত্রে শুরু হয়ে গেছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play started on a different device"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa ibang device nagsimula ang Remote Play"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play दूसरे उपकरण में आरंभ हुआ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play dibuka di perangkat lain"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play dibuka pada peranti lain"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play is op een ander toestel gestart"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการเปิด Remote Play บนอุปกรณ์อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan Oynatma farklı bir cihazda başlatıldı"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play ایک دوسرے آلے پر شروع ہوا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một máy khác đã mở Remote Play"
          }
        }
      }
    },
    "sheets.health.cause.frequentDrops.action %d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد مرات انقطاع الاتصال: %d. وصّل PS5 وهذا الـ Mac بالمودم بكابلات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ %d বার ভেঙেছে। মডেম থেকে PS5 আর এই Mac পর্যন্ত ইথারনেট কেবল টানুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link broke %d times. Run Ethernet cables from the modem to the PS5 and to this Mac."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%d beses naputol ang ugnayan. Magkabit ng Ethernet cable mula sa modem hanggang sa PS5 at sa iyong Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d दफ़ा कनेक्शन गया। राउटर से PS5 तक और इस Mac तक Ethernet केबल लगाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan terputus %d kali. Tarik kabel Ethernet dari modem ke PS5 dan ke Mac ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan terputus %d kali. Pasang kabel Ethernet dari modem ke PS5 dan juga ke Mac ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link brak %d keer af. Leg ethernetkabels van de modem naar de PS5 en naar deze Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ขาดไป %d ครั้ง ลากสาย Ethernet จากโมเด็มไปที่ PS5 และ Mac ตัวนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı %d kez kesildi. Modemden hem PS5'e hem bu Mac'e Ethernet kablosu çekin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رابطہ %d بار ٹوٹا۔ موڈیم سے PS5 تک اور اس Mac تک Ethernet کیبلیں بچھائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết bị đứt %d lần. Kéo cáp Ethernet từ modem tới PS5 và tới Mac này."
          }
        }
      }
    },
    "sheets.health.cause.frequentDrops.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال PS5 ينقطع كثيرًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এর লিংক বারবার ছিঁড়ছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 keeps losing its connection"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paulit-ulit na nawawalan ng koneksyon ang PS5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 का जुड़ाव लगातार छूट रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi PS5 sering terputus"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan PS5 kerap terputus"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5-verbinding valt vaak weg"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 หลุดการเชื่อมบ่อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bağlantısı sürekli kesiliyor"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 کنکشن اکثر ٹوٹتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối PS5 thường xuyên bị ngắt"
          }
        }
      }
    },
    "sheets.health.cause.networkDropped.action %d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد جهاز Mac الشبكة %d مرة. مدّ إليه كابل Ethernet من المودم، أو قرّبه من المودم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac %d বার অফলাইন হয়েছে। মডেম থেকে এতে একটি ইথারনেট কেবল টানুন, বা একে মডেমের আরও কাছে আনুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac went offline %d times. Run an Ethernet cable from the modem to it, or move it nearer the modem."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%d beses nag-offline ang iyong Mac. Magkabit ng Ethernet cable mula sa modem papunta rito, o ilapit ito sa modem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac %d दफ़ा ऑफ़लाइन हुआ। राउटर से इस तक Ethernet केबल लगाएँ, या इसे राउटर के क़रीब रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini %d kali kehilangan internet. Tarik kabel Ethernet dari modem ke Mac, atau dekatkan Mac ke modem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini terputus talian %d kali. Pasang kabel Ethernet dari modem kepadanya, atau alihkannya lebih dekat ke modem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac ging %d keer offline. Leg een ethernetkabel van de modem naar de Mac, of zet de Mac wat korter bij de modem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ตัวนี้หลุดออฟไลน์ %d ครั้ง ลากสาย Ethernet จากโมเด็มมาที่เครื่อง หรือย้ายเครื่องให้ใกล้โมเด็มขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac %d kez ağdan düştü. Mac'i modeme Ethernet kablosuyla takın ya da modemin yanına taşıyın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Mac %d بار آف لائن ہوا۔ موڈیم سے اس تک Ethernet کیبل لگائیے، یا اسے موڈیم کے قریب لے جائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac này mất mạng %d lần. Kéo cáp Ethernet từ modem tới máy, hoặc dời máy lại gần modem."
          }
        }
      }
    },
    "sheets.health.cause.networkDropped.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد جهاز Mac الشبكة أثناء اللعب"

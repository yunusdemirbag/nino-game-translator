    "sheets.about.telemetry": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل Nino إحصاءات مجهولة الهوية عن الأخطاء والسرعة كي يمكن إصلاحه وتسريعه. لا تُرسل أبدًا أي ترجمات أو لقطات شاشة أو أسماء أو عناوين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino নামহীনভাবে ত্রুটি আর গতির তথ্য পাঠায়, যাতে গলদ সারানো ও গতি বাড়ানো যায়। উপশিরোনাম, পর্দার ছবি, নাম, ঠিকানা — এসব কখনো যায় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino sends anonymous error and speed statistics so it can be fixed and made faster. No subtitles, screenshots, names or addresses are ever sent."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpapadala ang Nino ng anonymous na estadistika ng error at bilis para maayos ito at mapabilis. Hindi kailanman ipinapadala ang mga subtitle, screenshot, pangalan o address."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino बिना पहचान वाले त्रुटि व गति आँकड़े भेजता है जिससे गलतियाँ सुधरें और गति बढ़े। सबटाइटल, परदे की छवियाँ, नाम या पते कभी साझा नहीं होते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino mengirim statistik kesalahan dan kecepatan secara anonim agar dapat diperbaiki dan dibuat lebih cepat. Subtitle, tangkapan layar, nama, atau alamat tidak pernah dikirim."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino menghantar statistik ralat dan kelajuan tanpa nama supaya ia dapat dibaiki dan dipercepatkan. Tiada sari kata, tangkapan skrin, nama atau alamat yang pernah dihantar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino stuurt anonieme fout- en snelheidsstatistieken, zodat het verbeterd en sneller gemaakt kan worden. Er worden nooit ondertitels, schermafbeeldingen, namen of adressen verstuurd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ส่งสถิติข้อผิดพลาดและความเร็วโดยไม่ระบุว่าเป็นใคร เพื่อให้แก้ปัญหาและทำให้เร็วขึ้น โดยไม่ส่งคำบรรยาย ภาพหน้าจอ ชื่อ หรือที่อยู่ใดๆ เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'yu düzeltip hızlandırabilmemiz için anonim hata ve performans verileri gönderilir. Altyazılar, ekran görüntüleri, adlar ve adresler hiçbir zaman gönderilmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino گمنام خرابی اور رفتار کے اعداد بھیجتا ہے تاکہ اسے درست اور تیز بنایا جا سکے۔ سب ٹائٹلز، اسکرین شاٹس، نام یا پتے کبھی نہیں بھیجے جاتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino gửi thống kê ẩn danh về lỗi và tốc độ để được sửa và chạy nhanh hơn. Phụ đề, ảnh màn hình, tên hay địa chỉ thì tuyệt đối không gửi."
          }
        }
      }
    },
    "sheets.about.trademark": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرتبط Nino بشركة Sony Interactive Entertainment ولا تزكّيه. علامتا PlayStation وPS5 ملك Sony Interactive Entertainment Inc."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony Interactive Entertainment Nino-কে অনুমোদন দেয়নি, Nino তাদের অংশও নয়। PlayStation আর PS5 চিহ্নের মালিক Sony Interactive Entertainment Inc.।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino isn't affiliated with or endorsed by Sony Interactive Entertainment. The PlayStation and PS5 marks belong to Sony Interactive Entertainment Inc."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang kaugnayan si Nino sa Sony Interactive Entertainment at hindi ito inendorso nito. Ang Sony Interactive Entertainment Inc. ang may-ari ng mga markang PlayStation at PS5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony Interactive Entertainment ने Nino को न बनाया है, न उसका समर्थन करता है। PlayStation व PS5 चिह्नों की मालकिन: Sony Interactive Entertainment Inc."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino bukan bagian dari Sony Interactive Entertainment, dan tidak didukung olehnya. Merek PlayStation dan PS5 dimiliki Sony Interactive Entertainment Inc."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tiada kaitan, dan tidak disokong, oleh pihak Sony Interactive Entertainment. Tanda PlayStation dan PS5 dimiliki Sony Interactive Entertainment Inc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino heeft geen band met Sony Interactive Entertainment en wordt er niet door gesteund. Sony Interactive Entertainment Inc. is eigenaar van de merken PlayStation en PS5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ไม่ได้เกี่ยวข้องหรือได้รับการรับรองจาก Sony Interactive Entertainment เครื่องหมาย PlayStation กับ PS5 เป็นของ Sony Interactive Entertainment Inc."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun, Sony Interactive Entertainment'la bir ortaklığı yoktur ve onun onayını taşımaz. PlayStation ve PS5 markaları Sony Interactive Entertainment Inc.'e aittir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony Interactive Entertainment کا Nino سے کوئی واسطہ نہیں، اور نہ ہی Nino کو ان کی منظوری حاصل ہے۔ PlayStation اور PS5 نشانات Sony Interactive Entertainment Inc. کی ملکیت ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino là dự án độc lập, không thuộc và không được Sony Interactive Entertainment bảo trợ. Nhãn hiệu PlayStation cùng PS5 do Sony Interactive Entertainment Inc. sở hữu."
          }
        }
      }
    },

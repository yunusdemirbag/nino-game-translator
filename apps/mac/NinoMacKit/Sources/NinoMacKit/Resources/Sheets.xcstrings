            "state": "translated",
            "value": "Mac ตัวนี้หลุดออฟไลน์ระหว่างเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun sırasında bu Mac ağdan düştü"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھیل کے دوران یہ Mac آف لائن ہو گیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac này mất mạng lúc đang chơi"
          }
        }
      }
    },
    "sheets.health.cause.noNetwork.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع جهاز Mac على شبكة PS5. سيعيد Nino الربط تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-কে PS5-এর নেটে যোগ দিন। Nino আপনাআপনি ফের জুড়ে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put this Mac on the network the PS5 uses. Nino will reconnect by itself."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonekta ang iyong Mac sa network na gamit ng PS5. Kusang kokonekta ulit si Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac को PS5 वाले राउटर पर लाएँ। Nino अपने-आप फिर जुड़ेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gabungkan Mac ini dengan jaringan yang dipakai PS5. Nino akan tersambung kembali sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan Mac ini pada rangkaian yang digunakan PS5. Nino akan bersambung semula dengan sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet deze Mac op het netwerk van de PS5. Nino maakt vanzelf weer verbinding."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ Mac ตัวนี้เข้าเน็ตวงที่ PS5 ใช้ แล้ว Nino จะต่อกลับเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'i konsolun bağlı olduğu ağa bağlayın. Nino bağlantıyı kendisi yeniden kurar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac کو PS5 والے موڈیم سے جوڑیں۔ Nino خود دوبارہ جڑ جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho Mac này vào mạng mà PS5 đang dùng. Nino sẽ tự nối lại."
          }
        }
      }
    },
    "sheets.health.cause.noNetwork.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز Mac غير متصل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",

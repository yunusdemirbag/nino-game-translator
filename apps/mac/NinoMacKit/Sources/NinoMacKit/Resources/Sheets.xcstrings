    "sheets.photo.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Nino فتح هذا الملف كصورة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino এই ফাইলকে ছবি বলে খুলতে অক্ষম হলো।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino couldn't open this file as a picture."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabuksan ni Nino bilang larawan ang file na iyan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino इस फ़ाइल को छवि की तरह खोल नहीं पाया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak dapat membuka file ini sebagai gambar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak dapat membuka fail ini sebagai gambar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino kon dit bestand niet als afbeelding openen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino เปิดไฟล์นี้เป็นรูปภาพไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino bu dosyayı resim olarak açamadı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino یہ فائل بطور تصویر نہیں کھول سکا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino không thể mở tệp này thành ảnh."
          }
        }
      }
    },
    "sheets.report.error.dailyLimit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلاغات اليوم كثيرة. عاود غدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ অনেক বিবরণী এসে গেছে। কাল ফের পাঠিয়ে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a lot of reports for today. Try again tomorrow."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Marami ka nang ulat ngayong araw. Subukan ulit bukas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज बहुत शिकायतें आ चुकीं। कल फिर आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan hari ini sudah banyak sekali. Coba lagi besok."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari ini sudah banyak laporan. Cuba lagi esok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn veel meldingen voor vandaag. Morgen kan het weer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ส่งรายงานมาเยอะแล้ว พรุ่งนี้ค่อยลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünlük epey bildirim gönderdiniz. Yarın tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے لیے بہت رپورٹیں ہو گئیں۔ کل پھر کوشش کیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay đã có nhiều báo cáo rồi. Mai hãy thử lại."
          }
        }
      }
    },
    "sheets.report.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُرسَل البلاغ. تأكّد أنك متصل بالشبكة، ثم أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিবরণী পৌঁছায়নি। আপনি অনলাইন তো? মিলিয়ে নিয়ে আরেকবার পাঠিয়ে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report didn't go through. Make sure you're online, then retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naipadala ang ulat. Tiyaking may internet ka, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शिकायत हम तक न पहुँची। इंटरनेट जुड़ा हो, यह जाँचकर पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan gagal terkirim. Pastikan Anda online, lalu ulangi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan gagal sampai. Pastikan anda dalam talian, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je melding is niet aangekomen. Kijk of je online bent en probeer het dan nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานส่งไม่ถึง ดูว่าออนไลน์อยู่ แล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim gitmedi. İnternetinizin çalıştığından emin olup tekrar gönderin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹ نہیں پہنچی۔ دیکھیے کہ آپ آن لائن ہیں، پھر دوبارہ بھیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo chưa gửi được. Kiểm tra mạng, rồi thử lại."
          }
        }
      }
    },
    "sheets.report.error.server": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُرسَل البلاغ. انتظر قليلًا ثم أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিবরণী পৌঁছায়নি। খানিক পরে আরেকবার পাঠিয়ে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report didn't go through. Give it a little while and retry."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naipadala ang ulat. Maghintay nang kaunti at subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शिकायत हम तक न पहुँची। कुछ पल ठहरकर पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan gagal terkirim. Tunggu sebentar, lalu ulangi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan gagal sampai. Tunggu sebentar, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je melding is niet aangekomen. Wacht even en probeer het dan nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานส่งไม่ถึง รอสักพักแล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim gönderilemedi. Lütfen biraz sonra yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹ نہیں پہنچی۔ کچھ دیر رک کر دوبارہ بھیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo chưa gửi được. Đợi một lát rồi thử lại."
          }
        }
      }
    },
    "sheets.report.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البلاغ أكبر من المسموح. أزل ملفًا وأرسله مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোর্টের আকার বেশি বড়। একটা ফাইল সরিয়ে ফের পাঠান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report is too big. Take out one file and send it again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrang laki ng ulat. Tanggalin ang isang file at ipadala muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट का आकार ज़्यादा है। एक फ़ाइल हटाकर दोबारा भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan ini terlalu besar. Keluarkan satu file lalu kirim lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan ini terlalu besar. Keluarkan satu fail dan hantar semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze melding is groter dan toegestaan. Haal er een bestand uit en stuur hem opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานนี้มีขนาดใหญ่เกิน ลบไฟล์ออกหนึ่งไฟล์แล้วกดส่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim fazla büyük. Bir dosyayı çıkarıp yeniden gönderin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹ کا حجم زیادہ ہے۔ ایک فائل نکال کر دوبارہ بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo này quá lớn. Hãy bỏ bớt một tệp rồi gửi lại."
          }
        }
      }
    },
    "sheets.report.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل رسالتك وملفاتك وسجلات التطبيق إلى المطوّر. لا تُضاف المفاتيح ولا كلمات المرور أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লেখা, ফাইল আর অ্যাপের লগ নির্মাতার কাছে যায়। কী আর পাসওয়ার্ড কখনো যোগ হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message, your files and the app's logs go to the developer. Keys and passwords are never included."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapupunta sa developer ang mensahe mo, ang mga file mo at ang app log. Hindi kailanman kasama ang mga key at password."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका संदेश, आपकी फ़ाइलें और ऐप के लॉग डेवलपर तक जाते हैं। कुंजियाँ और पासवर्ड कभी शामिल नहीं होते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan Anda, file Anda, dan log aplikasi dikirim ke pengembang. Kunci dan kata sandi tidak pernah ikut."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesej anda, fail anda dan log aplikasi dihantar kepada pembangun. Kunci dan kata laluan tidak sekali-kali disertakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht, je bestanden en de logboeken van de app gaan naar de maker. Sleutels en wachtwoorden gaan nooit mee."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความ ไฟล์ และบันทึกของแอปจะส่งถึงผู้พัฒนา คีย์และรหัสผ่านจะไม่ถูกแนบไปด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdıklarınız, dosyalarınız ve uygulama kayıtları geliştiriciye gider. Anahtarlar ve parolalar eklenmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا پیغام، آپ کی فائلیں اور ایپ کے لاگ ڈویلپر تک جاتے ہیں۔ کلیدیں اور پاس ورڈ کبھی شامل نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn, tệp của bạn và nhật ký của ứng dụng được gửi tới người phát triển. Khóa và mật khẩu tuyệt đối không đi kèm."
          }
        }
      }
    },
    "sheets.report.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِف لنا الخلل: ما اللعبة، وماذا انتظرت أن ترى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোথায় গোলমাল, জানান: কোন খেলায়, আর আপনি কী দেখবেন ভেবেছিলেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what went wrong: the game, and what you expected to see."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabihin kung ano ang nangyari: ang laro, at ano ang inaasahan mong makita."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताइए क्या बिगड़ा: कौनसा गेम, और आप क्या देखना चाहते थे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan apa yang salah: game-nya, dan hal yang seharusnya Anda lihat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan apa yang tidak kena: permainannya, serta perkara yang anda harap akan lihat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat gebeurde er? Welke game, en wat verwachtte je?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่าให้ฟังว่าเกิดอะไรขึ้น: เกมไหน และคุณคาดว่าจะเห็นอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne oldu? Hangi oyundu, ne bekliyordunuz?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بتائیے کیا گڑبڑ ہوئی: کون سا گیم، اور آپ کیا دیکھنے کی توقع رکھتے تھے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kể cho chúng tôi lỗi gì: trò chơi nào, và bạn mong thấy điều gì."
          }
        }
      }
    },

    "sheets.health.localNetwork": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما لا يملك Nino إذن الشبكة المحلية. امنحه إياه هنا: إعدادات النظام › الخصوصية والأمن › الشبكة المحلية. بعد ذلك أغلق Nino وافتحه من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino হয়তো স্থানীয় নেটের অনুমতি পায়নি। অনুমতির পথ — System Settings › Privacy & Security › Local Network। এরপরে Nino বন্ধ করে পুনরায় খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino might not have local network access. Grant it here: System Settings › Privacy & Security › Local Network. Afterwards, quit and reopen Nino."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Baka walang pahintulot si Nino sa lokal na network. Ibigay ito rito: System Settings › Privacy & Security › Local Network. Pagkatapos, isara at buksan muli si Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शायद Nino को Local Network इजाज़त नहीं मिली। इसे यहाँ दें: System Settings › Privacy & Security › Local Network। उसके बाद Nino बंद करके पुनः खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino barangkali belum punya izin jaringan lokal. Berikan izinnya lewat Pengaturan Sistem › Privasi & Keamanan › Jaringan Lokal. Setelahnya, tutup lalu buka kembali Nino."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino mungkin tiada akses rangkaian setempat. Benarkan di sini: Tetapan Sistem › Privasi & Keselamatan › Rangkaian Setempat. Selepas itu, tutup dan buka Nino semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino heeft mogelijk geen toegang tot het lokale netwerk. Zet die hier aan: Systeeminstellingen › Privacy en beveiliging › Lokaal netwerk. Sluit Nino daarna af en open de app weer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino อาจไม่มีสิทธิ์ใช้เครือข่ายเฉพาะที่ ให้สิทธิ์ได้ที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › เครือข่ายเฉพาะที่ เสร็จแล้วออกจาก Nino และเปิดขึ้นมาอีกรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun yerel ağ erişimi kapalı olabilir. Şuradan Nino'yu açın: Sistem Ayarları › Gizlilik ve Güvenlik › Yerel Ağ. Ardından Nino'yu kapatıp yeniden başlatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شاید Nino کو لوکل نیٹ ورک تک رسائی نہیں۔ یہاں اجازت دیجیے: System Settings › Privacy & Security › Local Network۔ اس کے بعد Nino بند کر کے پھر سے کھولیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino có thể chưa được truy cập mạng LAN. Cấp quyền ở đây (Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Mạng cục bộ). Sau đó thoát Nino và mở lại."
          }
        }
      }
    },

          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac heeft geen netwerkverbinding"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ตัวนี้ออฟไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac hiçbir ağa bağlı değil"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac کا کوئی نیٹ ورک کنکشن نہیں"
          }
        },
        "vi": {

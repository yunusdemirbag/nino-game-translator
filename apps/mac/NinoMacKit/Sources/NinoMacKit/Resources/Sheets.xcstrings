    "sheets.health.path.engine %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بمفتاحك؛ وهذا الـ Mac ومجمّع Nino احتياطيان"

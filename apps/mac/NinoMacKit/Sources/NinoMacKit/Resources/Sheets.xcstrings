          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dengan kunci anda; Mac ini dan kolam Nino sebagai sandaran"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ met je sleutel; deze Mac en de Nino-pool als reserve"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ด้วยคีย์ของคุณ โดยมี Mac เครื่องนี้และคลังกลาง Nino สำรองไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarınızla %@; bu Mac ve Nino havuzu yedekte"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کلید سے %@؛ یہ Mac اور Nino پول بیک اپ میں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bằng khóa của bạn; máy Mac này và kho chung Nino dự phòng"
          }
        }
      }
    },
    "sheets.health.path.poolAndDevice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مفتاح: مجمّع Nino + ترجمة هذا الـ Mac"

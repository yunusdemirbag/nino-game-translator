    "sheets.ask.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصلني أسئلة كثيرة الآن. امنحني لحظة واسأل من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে প্রশ্নের ভিড়। একটু থেমে ফের জানতে চান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lots of questions coming in right now. Give me a moment and ask again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagsa ang tanong ngayon. Sandali lang, saka magtanong ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सवालों की भीड़ है। ज़रा रुककर फिर पूछें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang banyak sekali pertanyaan masuk. Beri saya waktu sebentar, lalu tanyakan lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Banyak soalan sedang masuk sekarang. Tunggu sebentar, kemudian tanya sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er komen nu heel veel vragen binnen. Geef me even en vraag het nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้มีคนถามเข้ามาเยอะ รอสักครู่แล้วถามใหม่นะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an çok soru geliyor. Bana bir dakika ver, sonra tekrar sor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت بہت سے سوال آ رہے ہیں۔ ذرا ٹھہر کر پھر پوچھیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc này có rất nhiều câu hỏi gửi tới. Chờ mình chút rồi hỏi lại nhé."
          }
        }
      }
    },
    "sheets.ask.error.dailyLimit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسئلة اليوم تكفي 🙂 نتابع حديثنا في الغد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ অনেক প্রশ্ন হলো 🙂 কাল ফের কথা হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's plenty of questions for today 🙂 We'll pick up again tomorrow."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Marami ka nang naitanong ngayong araw 🙂 Ituloy natin bukas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के लिए इतने सवाल काफ़ी हैं 🙂 कल फिर मिलते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan hari ini sudah cukup banyak 🙂 Kita sambung lagi besok."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cukup banyak soalan untuk hari ini 🙂 Kita teruskan esok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat waren genoeg vragen voor vandaag 🙂 Morgen pakken we het weer op."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ถามมาเยอะพอแล้ว 🙂 พรุ่งนี้มาคุยกันต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünlük epey soru oldu 🙂 Yarın kaldığımız yerden sürdürelim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے لیے سوال کافی ہو گئے 🙂 کل پھر بات کریں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay vậy là đủ câu hỏi rồi 🙂 Ngày mai mình tiếp tục nhé."
          }
        }
      }
    },
    "sheets.ask.error.disabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوشكت أن أجهز! إلى أن يتم ذلك، اكتب سؤالك في «الإبلاغ عن خلل» وسيجيبك أحد أفراد الفريق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিগগিরই তৈরি হয়ে যাব! আপাতত প্রশ্নগুলো “সমস্যার কথা জানান” অংশে টাইপ করুন, দলের কেউ জবাব পাঠাবেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm nearly ready! For now, use Report an Issue to ask, and someone from the team will reply."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Malapit na akong handa! Sa ngayon, gamitin ang Iulat ang Problema para magtanong; may sasagot mula sa team."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस ज़रा देर और! तब तक सवाल पूछना हो तो “गड़बड़ी बताएँ” का उपयोग करें, टीम का कोई सदस्य उत्तर देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebentar lagi saya siap! Untuk sekarang, ajukan pertanyaan melalui Laporkan Kendala, nanti anggota tim akan membalas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya hampir siap! Buat masa ini, tanya melalui Laporkan Isu, dan seseorang daripada pasukan akan membalas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben er bijna! Stel je vraag voorlopig via Probleem melden; iemand van het team reageert dan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใกล้เสร็จแล้ว! ระหว่างนี้ใช้ “รายงานปัญหา” ส่งคำถามมาก่อน แล้วทีมงานจะตอบกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok az kaldı! Bu arada sorunu Hata Bildir'den ilet, ekip yanıtlasın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں بس تیار ہونے کو ہوں! فی الحال سوال مسئلہ بتائیں سے بھیجیے، ٹیم کا کوئی فرد جواب دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình gần xong rồi! Tạm thời hãy dùng Báo lỗi để hỏi, sẽ có người trong nhóm phản hồi."
          }
        }
      }
    },
    "sheets.ask.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخادم لا يجيب. تأكّد أنك متصل بالشبكة وجرّب ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino-র দিক থেকে সাড়া আসেনি। আপনি অনলাইন তো? মিলিয়ে নিয়ে আরেকবার পাঠিয়ে দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer from the server. Make sure you're online and give it another go."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang tugon mula sa server. Tiyaking may internet ka at subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर से उत्तर नहीं मिला। इंटरनेट जुड़ा है, यह पक्का करें, फिर आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak menjawab. Pastikan Anda sedang online, lalu coba sekali lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan tidak menjawab. Pastikan anda dalam talian, kemudian cuba sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server geeft geen antwoord. Kijk of je online bent en waag nog een poging."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ไม่ตอบ ลองเช็กว่าออนไลน์อยู่ แล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşamadım. İnternetine bakıp yeniden dene."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور سے جواب نہیں ملا۔ دیکھیے کہ آپ آن لائن ہیں، پھر ایک بار اور آزمائیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ không trả lời. Kiểm tra mạng của bạn rồi thử lại lần nữa."
          }
        }
      }
    },
    "sheets.ask.error.rejected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تصلني تلك الرسالة. أتستطيع صياغتها بشكل آخر؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বার্তাটি আমার কাছে পৌঁছায়নি। অন্যভাবে বলবেন?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That message didn't come through for me. Can you put it another way?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ko natanggap nang maayos ang mensaheng iyon. Puwede mo bang sabihin sa ibang paraan?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह संदेश मैं समझ न सका। क्या आप इसे दूसरे शब्दों में लिखेंगे?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan itu tak sampai ke saya. Bisakah ditulis dengan kalimat lain?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesej itu tidak sampai kepada saya. Boleh nyatakan dengan cara lain?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat bericht kwam bij mij niet goed aan. Kun je het anders zeggen?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันอ่านข้อความนั้นไม่ได้ ช่วยเขียนใหม่ให้ต่างไปอีกนิดได้ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesajı anlayamadım. Başka türlü yazabilir misin?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ پیغام مجھ تک نہیں پہنچا۔ کیا آپ اسے کسی اور انداز میں کہہ سکتے ہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình không nhận được tin nhắn đó. Bạn diễn đạt khác đi được không?"
          }
        }
      }
    },
    "sheets.ask.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يفوق ما أستطيع استلامه. احذف صورة وأرسل ثانيةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এত বড় আমার নেওয়ার সাধ্য নেই। একটা ছবি বাদ রেখে ফের পাঠিয়ে দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is more than I can take. Drop a photo and send again."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrang laki nito para sa akin. Tanggalin ang isang larawan at ipadala ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मेरी सीमा से बाहर है। एक छवि निकालें और दोबारा भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukurannya melebihi batas yang bisa saya terima. Buang satu foto, lalu kirim ulang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini melebihi apa yang saya mampu terima. Keluarkan sekeping foto dan hantar semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is meer dan ik aankan. Laat één foto weg en stuur het nog eens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความนี้ใหญ่เกินไป เอารูปออกสักรูปแล้วส่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bana çok büyük geldi. Fotoğraflardan birini çıkarıp tekrar gönder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اتنا بڑا میں نہیں لے سکتا۔ ایک تصویر نکال کر دوبارہ بھیجیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin này quá lớn với mình. Bớt đi một tấm ảnh rồi gửi lần nữa nhé."
          }
        }
      }
    },
    "sheets.ask.greeting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أهلًا، معك Nino 👋 أستطيع مساعدتك في كل مراحل التهيئة. أخبرني أولًا بما عندك: PS5 أم Xbox، تلفاز أم شاشة عرض، هاتف أم حاسوب. على أيّ جهاز تريد تشغيل Nino؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যালো! Nino বলছি 👋 সেটআপের যেকোনো ধাপে সহায়তা করতে পারি। প্রথমে জানান কী কী আছে: PS5 না Xbox, TV না কোনো মনিটর, মোবাইল না কমপিউটার। Nino কোনটিতে চালাবেন?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey there, I'm Nino 👋 I can help with any part of setting up. Tell me what you've got first: PS5 or Xbox, a TV or a monitor, a phone or a computer. Which one should Nino run on?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumusta, ako si Nino 👋 Matutulungan kita sa kahit anong bahagi ng setup. Sabihin mo muna kung anong gamit mo: PS5 ba o Xbox, TV ba o monitor, telepono ba o computer. Saan tatakbo si Nino?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते! Nino यहाँ है 👋 सेटअप में कहीं भी अटकें, मैं साथ हूँ। शुरुआत में बताएँ कि आपके उपकरण कौन-से हैं: PS5 है या Xbox, टीवी है या कोई मॉनिटर, और फ़ोन है या PC। Nino किस उपकरण पर चलाना है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halo, saya Nino 👋 Saya siap membantu di setiap langkah penyiapan. Ceritakan dulu perangkat Anda: konsolnya PS5 atau Xbox, layarnya TV atau monitor, lalu ponsel atau komputer. Nino mau dijalankan di perangkat yang mana?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai, saya Nino 👋 Saya boleh bantu dalam apa-apa bahagian persediaan. Pertama sekali, ceritakan peralatan anda: konsol (PS5 / Xbox), skrin (TV / monitor), dan peranti (telefon / komputer). Di mana Nino patut dijalankan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo, ik ben Nino 👋 Ik help je met elk deel van de installatie. Vertel eerst wat je hebt: PS5 of Xbox, een tv of een monitor, een telefoon of een computer. Waarop moet Nino draaien?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวัสดี ฉันคือ Nino 👋 ช่วยได้ทุกขั้นของการตั้งค่า บอกก่อนว่าคุณมีอะไรบ้าง เครื่องเกมเป็น PS5 หรือเป็น Xbox ต่อกับทีวีหรือมอนิเตอร์ แล้วมีมือถือหรือคอมเครื่องไหนอยู่ อยากให้ Nino ทำงานบนเครื่องไหน?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selam, ben Nino 👋 Kurulumun her adımında yardımcı olabilirim. Başlamak için elindekileri söyle: PS5 mi Xbox mu, TV mi monitör mü, telefon mu bilgisayar mı? Nino hangisinde çalışsın?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلام! میرا نام Nino ہے 👋 سیٹ اپ کے کسی بھی حصے میں مدد کر سکتا ہوں۔ پہلے یہ بتائیے کہ آپ کے پاس کیا کیا ہے: PS5 ہے یا Xbox؟ ٹی وی ہے یا مانیٹر؟ فون ہے یا کمپیوٹر؟ Nino کو کس پر چلائیں گے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin chào, Nino đây 👋 Bước thiết lập nào mình cũng hỗ trợ được. Trước tiên kể mình nghe bạn đang có những gì: PS5 hoặc Xbox, TV hoặc monitor, điện thoại hoặc máy tính. Nino sẽ chạy trên máy nào?"
          }
        }
      }
    },

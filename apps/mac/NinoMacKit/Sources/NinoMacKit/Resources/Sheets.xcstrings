    },
    "sheets.health.path.poolOnly.pack": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حزمة اللغة ناقصة: مجمّع Nino فقط"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাষা প্যাক নেই: শুধু Nino পুল"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language pack missing: Nino pool only"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulang ang language pack: Nino pool lang"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा पैक नहीं है: सिर्फ़ Nino पूल"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket bahasa belum ada: hanya pool Nino"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek bahasa tiada: kolam Nino sahaja"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taalpakket ontbreekt: alleen de Nino-pool"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแพ็กภาษา: ใช้ได้เฉพาะคลังกลาง Nino"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil paketi eksik: yalnız Nino havuzu"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زبان کا پیک موجود نہیں: صرف Nino پول"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiếu gói ngôn ngữ: chỉ còn kho chung Nino"
          }
        }
      }
    },
    "sheets.health.path.poolOnly.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الـ Mac الترجمة وحده: مجمّع Nino فقط"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac নিজে অনুবাদ করতে পারে না: শুধু Nino পুল"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac can't translate on its own: Nino pool only"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kayang magsalin ng Mac na ito nang mag-isa: Nino pool lang"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac खुद अनुवाद नहीं कर सकता: सिर्फ़ Nino पूल"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini tidak bisa menerjemahkan sendiri: hanya pool Nino"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini tidak boleh menterjemah sendiri: kolam Nino sahaja"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac kan niet zelf vertalen: alleen de Nino-pool"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้แปลเองไม่ได้: ใช้ได้เฉพาะคลังกลาง Nino"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac kendi başına çeviremiyor: yalnız Nino havuzu"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Mac خود ترجمہ نہیں کر سکتا: صرف Nino پول"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này không tự dịch được: chỉ còn kho chung Nino"
          }
        }
      }
    },
    "sheets.health.path.none.pack": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حزمة اللغة ناقصة ولا مفتاح: قد تبقى السطور بلا ترجمة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাষা প্যাক নেই, কি-ও নেই: লাইনগুলো অনূদিত না-ও হতে পারে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language pack missing and no key: lines may stay untranslated"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulang ang language pack at walang key: baka hindi maisalin ang mga linya"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा पैक नहीं और की भी नहीं: पंक्तियाँ बिना अनुवाद रह सकती हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket bahasa belum ada dan tanpa kunci: baris bisa tidak diterjemahkan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek bahasa tiada dan tiada kunci: baris mungkin tidak diterjemah"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taalpakket ontbreekt en geen sleutel: regels blijven mogelijk onvertaald"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแพ็กภาษาและไม่มีคีย์: บางบรรทัดอาจไม่ได้แปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil paketi eksik, anahtar yok: satırlar çevrilmeden kalabilir"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زبان کا پیک نہیں اور کلید بھی نہیں: سطریں بغیر ترجمے کے رہ سکتی ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiếu gói ngôn ngữ và không có khóa: các dòng có thể không được dịch"
          }
        }
      }
    },
    "sheets.health.path.none.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مفتاح ولا يستطيع هذا الـ Mac الترجمة وحده: قد تبقى السطور بلا ترجمة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কি নেই এবং এই Mac নিজে অনুবাদ করতে পারে না: লাইনগুলো অনূদিত না-ও হতে পারে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key and this Mac can't translate on its own: lines may stay untranslated"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang key at hindi kayang magsalin ng Mac na ito: baka hindi maisalin ang mga linya"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "की नहीं और यह Mac खुद अनुवाद नहीं कर सकता: पंक्तियाँ बिना अनुवाद रह सकती हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kunci dan Mac ini tidak bisa menerjemahkan sendiri: baris bisa tidak diterjemahkan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kunci dan Mac ini tidak boleh menterjemah sendiri: baris mungkin tidak diterjemah"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen sleutel en deze Mac kan niet zelf vertalen: regels blijven mogelijk onvertaald"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีคีย์และ Mac เครื่องนี้แปลเองไม่ได้: บางบรรทัดอาจไม่ได้แปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar yok, bu Mac kendi başına çeviremiyor: satırlar çevrilmeden kalabilir"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید نہیں اور یہ Mac خود ترجمہ نہیں کر سکتا: سطریں بغیر ترجمے کے رہ سکتی ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có khóa và máy Mac này không tự dịch được: các dòng có thể không được dịch"
          }
        }
      }
    },
    "sheets.health.advice.languagePack %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزّل حزمة %1$@ → %2$@ من إعدادات النظام › عام › اللغة والمنطقة › لغات الترجمة. ويمكنك أيضًا إضافة مفتاح من الإعدادات › الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংস › সাধারণ › ভাষা ও অঞ্চল › অনুবাদের ভাষা থেকে %1$@ → %2$@ প্যাক ডাউনলোড করুন। সেটিংস › অনুবাদ থেকে একটি কি-ও যোগ করতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the %1$@ → %2$@ pack in System Settings › General › Language & Region › Translation Languages. You can also add a key in Settings › Translation."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-download ang %1$@ → %2$@ pack sa System Settings › General › Language & Region › Translation Languages. Puwede ka ring magdagdag ng key sa Settings › Pagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्स › सामान्य › भाषा और क्षेत्र › अनुवाद भाषाएँ में जाकर %1$@ → %2$@ पैक डाउनलोड करें। सेटिंग्स › अनुवाद में की भी जोड़ सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh paket %1$@ → %2$@ di Pengaturan Sistem › Umum › Bahasa & Wilayah › Bahasa Terjemahan. Anda juga bisa menambahkan kunci di Pengaturan › Terjemahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun pek %1$@ → %2$@ di Tetapan Sistem › Umum › Bahasa & Rantau › Bahasa Terjemahan. Anda juga boleh menambah kunci di Tetapan › Terjemahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download het pakket %1$@ → %2$@ via Systeeminstellingen › Algemeen › Taal en regio › Vertaaltalen. Je kunt ook een sleutel toevoegen via Instellingen › Vertaling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดแพ็ก %1$@ → %2$@ ที่ การตั้งค่าระบบ › ทั่วไป › ภาษาและภูมิภาค › ภาษาสำหรับการแปล หรือเพิ่มคีย์ที่ การตั้งค่า › การแปล ก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ → %2$@ paketini Sistem Ayarları › Genel › Dil ve Bölge › Çeviri Dilleri'nden indirin. Ayarlar › Çeviri'den bir anahtar da ekleyebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم سیٹنگز › عمومی › زبان اور علاقہ › ترجمے کی زبانیں سے %1$@ → %2$@ پیک ڈاؤن لوڈ کریں۔ سیٹنگز › ترجمہ سے کلید بھی شامل کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải gói %1$@ → %2$@ trong Cài đặt hệ thống › Cài đặt chung › Ngôn ngữ & Vùng › Ngôn ngữ dịch. Bạn cũng có thể thêm khóa trong Cài đặt › Dịch."
          }
        }
      }
    },
    "sheets.health.advice.addKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاحًا من الإعدادات › الترجمة، أو فعّل المجمّع المشترك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস › অনুবাদ থেকে একটি কি যোগ করুন, অথবা শেয়ার করা পুল চালু করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a key in Settings › Translation, or turn on the shared pool."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng key sa Settings › Pagsasalin, o buksan ang shared pool."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स › अनुवाद में की जोड़ें या साझा पूल चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kunci di Pengaturan › Terjemahan, atau aktifkan pool bersama."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah kunci di Tetapan › Terjemahan, atau hidupkan kolam kongsi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een sleutel toe via Instellingen › Vertaling of zet de gedeelde pool aan."
          }
        },
        "th": {

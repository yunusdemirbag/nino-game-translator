# Nino web sitesi: Apache ayarları
# Uzantısız adresler (/gizlilik → gizlilik.html), .html'li adreslerden kalıcı yönlendirme,
# güvenlik başlıkları ve görseller için uzun önbellek.

Options -MultiViews -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType image/webp .webp

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index ve /index.html → /
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # Tarayıcının istediği /x.html ya da /x.html?… adresini /x'e kalıcı yönlendir.
  # THE_REQUEST'e bakılır; içteki yeniden yazma bu kurala takılmaz, döngü olmaz.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # /x → x.html (dosya varsa)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"

  # Sayfalar her seferinde denetlensin; görseller bir yıl önbellekte kalsın.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

# /img/ altındaki dosyalar (görsel adları değişince yeni adla yüklenir).
<If "%{REQUEST_URI} =~ m#^/img/#">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</If>

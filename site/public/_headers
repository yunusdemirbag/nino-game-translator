# Nino web sitesi: Cloudflare Pages başlıkları
# (Pages /gizlilik → gizlilik.html eşlemesini ve /x.html → /x yönlendirmesini kendisi yapar.)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/img/*
  Cache-Control: public, max-age=31536000, immutable
